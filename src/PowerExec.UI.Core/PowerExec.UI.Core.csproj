<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UI-neutrale Oberflächenlogik (ViewModels, Commands, Protokoll): kein WPF, kein WinUI.
    Wird von der WPF-App und später von der WinUI-App gemeinsam genutzt (siehe docs/MIGRATION-WINUI.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PowerExec</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerExec.Core\PowerExec.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beispiel-Script für die Einführung (WelcomeViewModel liest es aus dieser Assembly) -->
    <EmbeddedResource Include="..\..\samples\Get-DiskSpace.ps1" LogicalName="PowerExec.Sample.Get-DiskSpace.ps1" Link="Assets\Get-DiskSpace.ps1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PowerExec.UI.Core.Tests" />
  </ItemGroup>
</Project>
