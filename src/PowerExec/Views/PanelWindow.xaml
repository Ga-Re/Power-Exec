<Window x:Class="PowerExec.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        Title="Power-Exec"
        Style="{StaticResource AppWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="400" Height="700">
    <Window.Resources>

        <!-- Menü einer Gruppe (Ordner/Favoriten) -->
        <ContextMenu x:Key="GroupMenu" x:Shared="False">
            <MenuItem Header="Neuer Eintrag" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem Header="Webseite …" Command="{Binding NewEntryCommand}" CommandParameter="Url">
                    <MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ordner …" Command="{Binding NewEntryCommand}" CommandParameter="Folder">
                    <MenuItem.Icon><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remotedesktop …" Command="{Binding NewEntryCommand}" CommandParameter="Rdp">
                    <MenuItem.Icon><TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Befehl …" Command="{Binding NewEntryCommand}" CommandParameter="Command">
                    <MenuItem.Icon><TextBlock Text="&#xE756;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Dateien auswählen …" Command="{Binding AddFilesCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Aus Vorlagen …" Command="{Binding AddFromCatalogCommand}" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Aus Zwischenablage einfügen" Command="{Binding AddFromClipboardCommand}" InputGestureText="Strg+V"
                      Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Symbol ändern …" Command="{Binding ChooseIconCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Neue Untergruppe …" Command="{Binding NewSubgroupCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Umbenennen …" Command="{Binding RenameCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Nach oben" Command="{Binding MoveUpCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Nach unten" Command="{Binding MoveDownCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Gruppe exportieren …" Command="{Binding ExportCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}"
                      ToolTip="Eigene Einträge dieser Gruppe als Datei – z. B. für Kollegen">
                <MenuItem.Icon><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Einträge importieren …" Command="{Binding ImportCommand}" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Gruppe löschen …" Command="{Binding DeleteCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Neue Gruppe …" Command="{Binding NewGroupCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Im Explorer öffnen" Command="{Binding OpenInExplorerCommand}" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Neu einlesen" Command="{Binding RescanCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Andere einklappen" Command="{Binding CollapseOthersCommand}"/>
            <MenuItem Header="Alle einklappen" Command="{Binding CollapseAllCommand}"/>
            <MenuItem Header="Alle ausklappen" Command="{Binding ExpandAllCommand}"/>
            <MenuItem Header="Reihenfolge zurücksetzen (alphabetisch)" Command="{Binding ResetOrderCommand}"
                      Visibility="{Binding AllowReorder, Converter={StaticResource Vis}}"/>
            <Separator Visibility="{Binding IsFolder, Converter={StaticResource Vis}}"/>
            <MenuItem Header="Ordner im Panel ausblenden" Command="{Binding HideFolderCommand}" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}"
                      ToolTip="Die Einträge bleiben in eigenen Gruppen, Favoriten und der Suche">
                <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ordner-Einstellungen …" Command="{Binding FolderSettingsCommand}" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Menü eines Eintrags -->
        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="{Binding RunHeader}" Command="{Binding RunCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="In die Zwischenablage kopieren" Command="{Binding CopySnippetCommand}" Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Als Administrator" Command="{Binding RunAdminCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Als anderer Benutzer …" Command="{Binding RunAsUserCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE77B;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remote …" Command="{Binding RunRemoteCommand}" Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Profile verwalten …" Command="{Binding ManageProfilesCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Im Editor öffnen" Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Speicherort öffnen" Command="{Binding OpenLocationCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pfad kopieren" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Zu Favoriten hinzufügen" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <MenuItem.Icon><TextBlock Text="&#xE734;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Aus Favoriten entfernen" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE735;" Style="{StaticResource Icon}" Foreground="{DynamicResource Star}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="In Gruppe verschieben" ItemsSource="{Binding GroupChoices}" Visibility="{Binding HasGroupChoices, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="In neue Gruppe …" Command="{Binding NewGroupWithItemCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Aus Gruppe nehmen" Command="{Binding RemoveFromGroupCommand}" Visibility="{Binding IsInGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8E6;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Bearbeiten …" Command="{Binding EditCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplizieren …" Command="{Binding DuplicateCommand}" Visibility="{Binding CanDuplicate, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding SingleClickHeader}" Command="{Binding ToggleSingleClickCommand}" Visibility="{Binding CanToggleSingleClick, Converter={StaticResource Vis}}"
                      ToolTip="Ein Klick im Panel startet sofort (Details dann über dieses Menü)">
                <MenuItem.Icon><TextBlock Text="&#xE8B0;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Details anzeigen" Command="{Binding OpenDetailsCommand}" Visibility="{Binding IsSingleClick, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Entfernen …" Command="{Binding RemoveCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ausblenden" Command="{Binding HideCommand}" ToolTip="Wird als Ausschluss beim Ordner gespeichert"
                      Visibility="{Binding CanHide, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Typ-Kürzel -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Badge.Other.Bg}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Other.Fg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="PowerShell">
                    <Setter Property="Background" Value="{DynamicResource Badge.PowerShell.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.PowerShell.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Batch">
                    <Setter Property="Background" Value="{DynamicResource Badge.Batch.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Batch.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Executable">
                    <Setter Property="Background" Value="{DynamicResource Badge.Executable.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Executable.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="ConsoleSnapIn">
                    <Setter Property="Background" Value="{DynamicResource Badge.ConsoleSnapIn.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.ConsoleSnapIn.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Shortcut">
                    <Setter Property="Background" Value="{DynamicResource Badge.Shortcut.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Shortcut.Fg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Zeile ohne eigenen Rahmen; Hover/Auswahl macht der umgebende Border -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn.Standard}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Details eines ausgewählten Eintrags (in der Liste aufgeklappt, im Raster unten im Panel) -->
        <DataTemplate x:Key="ItemDetails">
            <StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding HasDescription, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasMeta, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False" Margin="0,0,0,6"
                                  Visibility="{Binding HasTags, Converter={StaticResource Vis}}"/>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{DynamicResource Status.Error}"/>
                        <TextBlock Text="{Binding HealthText}" FontSize="12" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Border Background="{DynamicResource Bg.Chip}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="11" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="Req" Text="{Binding RequirementsText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding RequirementsText, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding ParseError}" FontSize="12" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasParseError, Converter={StaticResource Vis}}"/>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Entsperren" Command="{Binding UnblockCommand}"
                                Height="26" MinHeight="26" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding BlockedText}" FontSize="12" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock x:Name="Sig" Text="{Binding SignatureText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,8"
                               Visibility="{Binding SignatureText, Converter={StaticResource Vis}}"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                            <!-- Ein Profil: normaler Button -->
                            <Button Style="{StaticResource Btn.Accent}" Command="{Binding RunCommand}" Height="30" MinHeight="30" Padding="12,0" FontSize="12"
                                    ToolTip="{Binding RunToolTip}" Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RunLabel}"/>
                                </StackPanel>
                            </Button>
                            <!-- Mehrere Profile: Split-Button (links Standardprofil, rechts Auswahl) -->
                            <Button Style="{StaticResource Btn.SplitLeft}" Command="{Binding RunCommand}" Height="30" MinHeight="30" Padding="12,0" FontSize="12"
                                    ToolTip="{Binding RunToolTip}" Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RunLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.SplitRight}" Height="30" MinHeight="30" Width="30" Padding="0"
                                    Click="ProfileMenuButton_Click" ToolTip="Anderes Startprofil ausführen"
                                    AutomationProperties.Name="Startprofil wählen"
                                    Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10"/>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding RunAdminCommand}" ToolTip="Als Administrator ausführen (UAC)"
                                Visibility="{Binding CanElevate, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Admin"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding RunAsUserCommand}" ToolTip="Als anderer Benutzer ausführen"
                                Visibility="{Binding CanElevate, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Als …"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding RunRemoteCommand}" ToolTip="Auf einem oder mehreren Remote-Rechnern ausführen"
                                Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Remote"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Width="30" Padding="0" ToolTip="Weitere Aktionen"
                                ContextMenu="{StaticResource ItemMenu}" Click="MenuButton_Click">
                            <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                    </WrapPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SignatureValid}" Value="True">
                    <Setter TargetName="Sig" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RequirementsWarn}" Value="True">
                    <Setter TargetName="Req" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kachel für die Rasteransicht (kompakt: kleiner, eine Zeile) -->
        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Row" CornerRadius="6" Background="Transparent" Margin="1" Width="74" BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                    AllowDrop="True" PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                    DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <Button Style="{StaticResource RowButton}" Command="{Binding SelectCommand}" ToolTip="{Binding ToolTipText}" MouseDoubleClick="Row_DoubleClick"
                        ContextMenu="{StaticResource ItemMenu}" ToolTipService.InitialShowDelay="700">
                    <Grid x:Name="TileGrid" Margin="3,6,3,4" Height="62">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="IconRow" Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TileIcon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Width="34" Height="22" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="TileImage" Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                            <c:IconPresenter x:Name="TileCustom" Icon="{Binding CustomIcon}" Size="26" Foreground="{DynamicResource Text.Primary}"
                                             Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Status.Error}" Margin="0,0,2,0"
                                       Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}" ToolTip="{Binding HealthText}"/>
                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Star}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <TextBlock x:Name="TileName" Grid.Row="1" Text="{Binding DisplayName}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,3,0,0" VerticalAlignment="Top"/>
                    </Grid>
                </Button>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Row" Property="Width" Value="60"/>
                    <Setter TargetName="TileGrid" Property="Height" Value="46"/>
                    <Setter TargetName="TileGrid" Property="Margin" Value="2,4,2,2"/>
                    <Setter TargetName="IconRow" Property="Height" Value="24"/>
                    <Setter TargetName="TileImage" Property="Width" Value="20"/>
                    <Setter TargetName="TileImage" Property="Height" Value="20"/>
                    <Setter TargetName="TileCustom" Property="Size" Value="20"/>
                    <Setter TargetName="TileIcon" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Setter.Value>
                    </Setter>
                    <Setter TargetName="TileName" Property="TextWrapping" Value="NoWrap"/>
                    <Setter TargetName="TileName" Property="FontSize" Value="10.5"/>
                    <Setter TargetName="TileName" Property="Margin" Value="0,2,0,0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate">
            <Border x:Name="Row" CornerRadius="6" Background="Transparent" Margin="0,1" BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                    AllowDrop="True" PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                    DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Command="{Binding SelectCommand}" ToolTip="{Binding ToolTipText}" MouseDoubleClick="Row_DoubleClick"
                            ContextMenu="{StaticResource ItemMenu}" ToolTipService.InitialShowDelay="900">
                        <Grid x:Name="RowGrid" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="BadgeBox" Width="36" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Border Style="{StaticResource Badge}" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,-1,0,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding BadgeText}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                <c:IconPresenter Icon="{Binding CustomIcon}" Size="24" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"
                                                 Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="NameText" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                    <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Star}"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}" ToolTip="Favorit"/>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding HasParseError, Converter={StaticResource Vis}}" ToolTip="{Binding ParseError}"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}" ToolTip="{Binding BlockedText}"/>
                                    <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource Vis}}" ToolTip="Benötigt Administratorrechte (#Requires)"/>
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" ToolTip="{Binding Notes}"/>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Status.Error}"
                                               Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}" ToolTip="{Binding HealthText}"/>
                                </DockPanel>
                                <TextBlock x:Name="Syn" Text="{Binding Synopsis}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemDetails}" Focusable="False" Margin="54,0,8,4"
                                    Visibility="{Binding IsSelected, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Syn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="RowGrid" Property="Margin" Value="8,4"/>
                    <Setter TargetName="NameText" Property="FontSize" Value="13"/>
                    <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="NameText" Property="MaxWidth" Value="320"/>
                    <Setter TargetName="BadgeBox" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.82" ScaleY="0.82"/></Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                    <Setter TargetName="Syn" Property="TextWrapping" Value="Wrap"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Gruppe (Ordner, Favoriten, eigene Gruppe mit Untergruppen) -->
        <DataTemplate x:Key="GroupTemplate">
                <Border x:Name="GroupBox" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Margin="0,2,0,0"
                        AllowDrop="True" DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop">
                <StackPanel>
                    <Border x:Name="GroupHeader" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="0" Background="Transparent" AllowDrop="True"
                            PreviewMouseLeftButtonDown="GroupHeader_PreviewMouseLeftButtonDown" PreviewMouseMove="GroupHeader_PreviewMouseMove"
                            DragOver="GroupHeader_DragOver" DragLeave="GroupHeader_DragLeave" Drop="GroupHeader_Drop">
                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Btn.Subtle}" Command="{Binding ToggleCommand}" HorizontalContentAlignment="Stretch"
                                Padding="8,0" Height="32" ContextMenu="{StaticResource GroupMenu}" Foreground="{DynamicResource Text.Secondary}"
                                ToolTip="Klick: ein-/ausklappen · Rechtsklick: Menü" ToolTipService.InitialShowDelay="1200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Grid Grid.Column="1" Margin="8,0">
                                    <c:IconPresenter Icon="{Binding CustomIcon}" Size="16" Foreground="{DynamicResource Text.Primary}"
                                                     Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Star}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="32" Height="32" ToolTip="Menü"
                                ContextMenu="{StaticResource GroupMenu}" Click="MenuButton_Click">
                            <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                    </Grid>
                    </Border>
                    <TextBlock Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Vis}}" FontSize="12"
                               Foreground="{DynamicResource Status.Warning}" Margin="38,0,8,6" TextWrapping="Wrap"/>
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsGrid, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}"/>
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate><WrapPanel Margin="4,0,0,0"/></ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <!-- Untergruppen -->
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource GroupTemplate}" Focusable="False" Margin="14,0,0,0"/>
                    </StackPanel>
                    <Border Margin="8,0,8,8" Padding="10,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}"
                            Visibility="{Binding ShowDropHint, Converter={StaticResource Vis}}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.Tertiary}"
                                   Text="Einträge hierher ziehen – auch Dateien, Ordner oder Links aus dem Explorer und Browser. Rechtsklick: neuer Eintrag."/>
                    </Border>
                </StackPanel>
                </Border>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="PanelBorder" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Panel}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True"
            AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfzeile: Titel und Arbeitsbereich schrumpfen, die Knöpfe bleiben immer sichtbar -->
            <Grid Margin="14,10,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition MaxWidth="130">
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspaces}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Accent}">
                    <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccent}" FontSize="14"/>
                </Border>
                <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Power-Exec"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiPanel}" Value="True">
                                    <Setter Property="Text" Value="{Binding PanelName}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Column="2" x:Name="WorkspaceBox" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" MinHeight="28" Height="28"
                          ItemsSource="{Binding Workspaces}" SelectedItem="{Binding ActiveWorkspace, Mode=OneWay}" SelectionChanged="Workspace_SelectionChanged"
                          ToolTip="Arbeitsbereich wechseln (gilt für alle Panels)" Visibility="{Binding HasWorkspaces, Converter={StaticResource Vis}}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Command="{Binding ToggleGridCommand}" ToolTip="{Binding LayoutToolTip}">
                        <TextBlock Text="{Binding LayoutGlyph}" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Width="32" IsChecked="{Binding IsCompact}" ToolTip="Kompakt: Liste einzeilig, Raster mit kleinen Kacheln">
                        <TextBlock Text="&#xE73F;" Style="{StaticResource Icon}" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Width="32" IsChecked="{Binding IsPinned}" ToolTip="Anheften: Panel bleibt offen">
                        <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="15"/>
                    </ToggleButton>
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Command="{Binding SettingsCommand}" ToolTip="Einstellungen">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Update-Hinweis -->
            <StackPanel Grid.Row="1">
            <Border Margin="16,0,16,10" Padding="12,10" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                    BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding UpdateVisible, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpdateSubtitle}" FontSize="12" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Btn.Accent}" Content="Jetzt aktualisieren" Command="{Binding UpdateNowCommand}" Height="28" MinHeight="28" FontSize="12"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="Später" Command="{Binding UpdateLaterCommand}" Height="28" MinHeight="28" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Margin="16,0,16,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                    BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding PendingText, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="Prüfen" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                            Command="{Binding ReviewPendingCommand}" MinHeight="26" Height="26" Padding="8,0"/>
                    <TextBlock Text="{Binding PendingText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            </StackPanel>

            <!-- Suche -->
            <Grid Grid.Row="2" Margin="16,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="38"
                         Padding="30,0,8,0" Tag="Scripte, Programme, Synopsis durchsuchen" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         AutomationProperties.Name="Suchen"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <Border HorizontalAlignment="Right" Margin="0,0,8,0" Padding="6,1" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Border.Control}"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSearching}" Value="False"/>
                                        <Condition Binding="{Binding HasHotkey}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding HotkeyHint}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                </Border>
                <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="Suche leeren"
                        Command="{Binding ClearSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                </Button>
            </Grid>

            <!-- Filter -->
            <WrapPanel Grid.Row="3" Margin="16,10,16,4">
                <RadioButton Style="{StaticResource Chip}" Content="Alle" GroupName="TypeFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=All}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Scripte" GroupName="TypeFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=Scripts}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Programme" GroupName="TypeFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=Programs}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Favoriten" GroupName="TypeFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=Favorites}"/>
            </WrapPanel>

            <!-- Warnung: Ordner nicht erreichbar -->
            <Border Grid.Row="4" Margin="16,4,16,2" Padding="10,6" CornerRadius="6" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}"
                    BorderThickness="1" Visibility="{Binding FolderWarning, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Status.Warning}"/>
                    <TextBlock Text="{Binding FolderWarning}" FontSize="12" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Liste -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8"
                          Background="Transparent">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Neue Gruppe …" Command="{Binding NewGroupCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Neuer Eintrag">
                            <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                            <MenuItem Header="Webseite …" Command="{Binding NewEntryCommand}" CommandParameter="Url"/>
                            <MenuItem Header="Ordner …" Command="{Binding NewEntryCommand}" CommandParameter="Folder"/>
                            <MenuItem Header="Remotedesktop …" Command="{Binding NewEntryCommand}" CommandParameter="Rdp"/>
                            <MenuItem Header="SSH-Verbindung …" Command="{Binding NewEntryCommand}" CommandParameter="Ssh"/>
                            <MenuItem Header="Snippet …" Command="{Binding NewEntryCommand}" CommandParameter="Snippet"/>
                            <MenuItem Header="Windows-Werkzeug …" Command="{Binding NewEntryCommand}" CommandParameter="Tool"/>
                            <MenuItem Header="Befehl …" Command="{Binding NewEntryCommand}" CommandParameter="Command"/>
                            <MenuItem Header="Dateien auswählen …" Command="{Binding AddFilesCommand}"/>
                        </MenuItem>
                        <MenuItem Header="Aus Vorlagen …" Command="{Binding AddFromCatalogCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Aus Zwischenablage einfügen" Command="{Binding AddFromClipboardCommand}" InputGestureText="Strg+V">
                            <MenuItem.Icon><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Einträge importieren …" Command="{Binding ImportEntriesCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Raster" Command="{Binding ToggleGridCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding IsGrid, Converter={StaticResource Vis}}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Kompakt" Command="{Binding ToggleCompactCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding IsCompact, Converter={StaticResource Vis}}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Einstellungen …" Command="{Binding SettingsCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel>
                    <StackPanel Visibility="{Binding HasNoFolders, Converter={StaticResource Vis}}" Margin="16,32,16,0">
                        <TextBlock Text="Noch keine Ordner festgelegt." FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Power-Exec durchsucht die Ordner, die du in den Einstellungen angibst, nach Scripten und Programmen."
                                   Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,6,0,12"/>
                        <Button Style="{StaticResource Btn.Accent}" Content="Ordner hinzufügen" Command="{Binding AddFolderCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" Margin="16,32,16,0" TextAlignment="Center"
                               Style="{StaticResource Caption}" Text="Keine Treffer. Die Suche umfasst Name, Synopsis und Beschreibung."/>

                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Größe per Ziehen: Griffe am Innenrand (Lage setzt PlaceGrips) -->
            <Thumb x:Name="WidthGrip" Grid.RowSpan="8" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Panel.ZIndex="10"
                   DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" ToolTip="Breite ändern">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="HeightGrip" Grid.RowSpan="8" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Panel.ZIndex="10"
                   DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" ToolTip="Höhe ändern">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- Raster: Details des ausgewählten Eintrags -->
            <Border Grid.Row="6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="16,10,12,4" MaxHeight="320">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGrid}" Value="True"/>
                                    <Condition Binding="{Binding HasSelection}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" ToolTip="Auswahl aufheben" Click="ClearSelection_Click">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                            </Button>
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Synopsis}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemDetails}" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fußzeile -->
            <Border Grid.Row="7" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}">
                <DockPanel Margin="16,4,8,4">
                    <Button Style="{StaticResource Btn.Icon}" DockPanel.Dock="Right" Command="{Binding RescanCommand}" ToolTip="Ordner neu einlesen">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" DockPanel.Dock="Right" Command="{Binding NewGroupCommand}" ToolTip="Neue Gruppe">
                        <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
