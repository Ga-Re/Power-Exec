<Window x:Class="PowerExec.Desktop.Views.PanelWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
        xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
        Title="{l:T 'Power-Exec'}"
        Style="{StaticResource AppWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="400" Height="700">
    <Window.Resources>
      <ResourceDictionary>
        <!-- Gruppenkopf: ohne eigene Hover-Fläche (hervorgehoben wird der Rahmen der Gruppe) -->
        <Style x:Key="GroupHeaderButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Punkt in der Gruppenfarbe (ohne Farbe: neutral) -->
        <Style x:Key="GroupDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Text.Tertiary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasColor}" Value="True">
                    <Setter Property="Fill" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Menü einer Gruppe (Ordner/Favoriten) -->
        <!-- Ein Menü je Fenster für alle Gruppen: erst beim Öffnen an die Gruppe gebunden (früher je Gruppe zweimal erzeugt) -->
        <ContextMenu x:Key="GroupMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:T 'New subgroup …'}" Command="{Binding NewSubgroupCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'New entry'}" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem Header="{l:T 'New entry …'}" Command="{Binding NewEntryCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T 'Website …'}" Command="{Binding NewEntryCommand}" CommandParameter="Url">
                    <MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Folder …'}" Command="{Binding NewEntryCommand}" CommandParameter="Folder">
                    <MenuItem.Icon><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Remote Desktop …'}" Command="{Binding NewEntryCommand}" CommandParameter="Rdp">
                    <MenuItem.Icon><TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'SSH connection …'}" Command="{Binding NewEntryCommand}" CommandParameter="Ssh">
                    <MenuItem.Icon><TextBlock Text="&#xE756;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'PowerShell snippet …'}" Command="{Binding NewEntryCommand}" CommandParameter="Snippet">
                    <MenuItem.Icon><TextBlock Text="&#xE943;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Text snippet …'}" Command="{Binding NewEntryCommand}" CommandParameter="TextSnippet">
                    <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Windows tool …'}" Command="{Binding NewEntryCommand}" CommandParameter="Tool">
                    <MenuItem.Icon><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Command …'}" Command="{Binding NewEntryCommand}" CommandParameter="Command">
                    <MenuItem.Icon><TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Select files …'}" Command="{Binding AddFilesCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T 'From templates …'}" Command="{Binding AddFromCatalogCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Paste from clipboard'}" Command="{Binding AddFromClipboardCommand}" InputGestureText="Strg+V">
                    <MenuItem.Icon><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:T 'Appearance'}" Visibility="{Binding CanChangeLayout, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'Like the panel'}" Command="{Binding SetLayoutCommand}" CommandParameter="panel"
                          IsChecked="{Binding LayoutSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=panel}"/>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'List'}" Command="{Binding SetLayoutCommand}" CommandParameter="List"
                          IsChecked="{Binding LayoutSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=List}"/>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'Grid'}" Command="{Binding SetLayoutCommand}" CommandParameter="Grid"
                          IsChecked="{Binding LayoutSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Grid}"/>
            </MenuItem>
            <MenuItem Header="{l:T 'Item size'}" Visibility="{Binding CanChangeLayout, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8E9;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'Like the panel'}" Command="{Binding SetItemSizeCommand}" CommandParameter="panel"
                          IsChecked="{Binding ItemSizeSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=panel}"/>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'Small'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Small"
                          IsChecked="{Binding ItemSizeSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Small}"/>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'Medium'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Medium"
                          IsChecked="{Binding ItemSizeSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Medium}"/>
                <MenuItem Style="{StaticResource Menu.ItemWithRule}" Header="{l:T 'Large'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Large"
                          IsChecked="{Binding ItemSizeSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Large}"/>
            </MenuItem>
            <MenuItem Header="{l:T 'Color'}" Visibility="{Binding CanChangeLayout, Converter={StaticResource Vis}}" ItemsSource="{Binding ColorChoices}">
                <MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource Menu.ItemWithRule}">
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding Hex}"/>
                        <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                        <!-- Farbpunkt im Kopf statt als Icon: ein Icon-Element im Stil würde von allen Einträgen geteilt (nur der letzte zeigte seine Farbe) -->
                        <Setter Property="Header" Value="{Binding}"/>
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="14" Height="14" Fill="{Binding SwatchColor, Converter={StaticResource ArgbBrush}}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Stroke="{DynamicResource Border.Control}" StrokeThickness="1"/>
                                        <TextBlock x:Name="ActionIcon" Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="14" Margin="0,0,10,0" FontSize="{StaticResource Icon.L}"
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ActionIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Trennlinie zwischen den Farben und den Aktionen „Eigene Farbe …“ / „Farbe entfernen“ -->
                            <DataTrigger Binding="{Binding IsFirstAction}" Value="True">
                                <Setter Property="Tag" Value="Separator"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{l:T 'Rename …'}" Command="{Binding RenameCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Export group …'}" Command="{Binding ExportCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}"
                      ToolTip="{l:T 'Custom entries of this group as a file – e.g. for colleagues'}">
                <MenuItem.Icon><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Import entries …'}" Command="{Binding ImportCommand}" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Delete group …'}" Command="{Binding DeleteCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{l:T 'Open in Explorer'}" Command="{Binding OpenInExplorerCommand}" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Rescan'}" Command="{Binding RescanCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{l:T 'Collapse others'}" Command="{Binding CollapseOthersCommand}"/>
            <MenuItem Header="{l:T 'Collapse all'}" Command="{Binding CollapseAllCommand}"/>
            <MenuItem Header="{l:T 'Expand all'}" Command="{Binding ExpandAllCommand}"/>
            <MenuItem Header="{l:T 'Reset order (alphabetical)'}" Command="{Binding ResetOrderCommand}"
                      Visibility="{Binding AllowReorder, Converter={StaticResource Vis}}"/>
            <Separator Visibility="{Binding IsFolder, Converter={StaticResource Vis}}"/>
            <MenuItem Header="{l:T 'Hide in this workspace'}" Command="{Binding HideFolderCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}"
                      ToolTip="{l:T 'Show again: Settings › Workspaces'}">
                <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Configure group …'}" Command="{Binding FolderSettingsCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Menü eines Eintrags -->
        <!-- Ein Menü je Fenster für alle Einträge: erst beim Öffnen an den Eintrag gebunden (früher je Zeile 43 MenuItems beim Erzeugen) -->
        <ContextMenu x:Key="ItemMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding RunHeader}" Command="{Binding RunCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Copy to clipboard'}" Command="{Binding CopySnippetCommand}" Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'As administrator'}" Command="{Binding RunAdminCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'As different user …'}" Command="{Binding RunAsUserCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE77B;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Remote …'}" Command="{Binding RunRemoteCommand}" Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Manage profiles …'}" Command="{Binding ManageProfilesCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{l:T 'Schedule …'}" Command="{Binding ScheduleCommand}" ToolTip="{l:T 'Run once, daily or at an interval'}">
                <MenuItem.Icon><TextBlock Text="&#xE823;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Open in editor'}" Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Open storage location'}" Command="{Binding OpenLocationCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Copy path'}" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{l:T 'Add to favorites'}" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <MenuItem.Icon><TextBlock Text="&#xE734;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Remove from favorites'}" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE735;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Move to group'}" ItemsSource="{Binding GroupChoices}" Visibility="{Binding HasGroupChoices, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{l:T 'To new group …'}" Command="{Binding NewGroupWithItemCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Remove from group'}" Command="{Binding RemoveFromGroupCommand}" Visibility="{Binding IsInGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8E6;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{l:T 'Edit …'}" Command="{Binding EditCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Duplicate …'}" Command="{Binding DuplicateCommand}" Visibility="{Binding CanDuplicate, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding SingleClickHeader}" Command="{Binding ToggleSingleClickCommand}" Visibility="{Binding CanToggleSingleClick, Converter={StaticResource Vis}}"
                      ToolTip="{l:T 'A click in the panel starts immediately (details then via this menu)'}">
                <MenuItem.Icon><TextBlock Text="&#xE8B0;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Show details'}" Command="{Binding OpenDetailsCommand}" Visibility="{Binding IsSingleClick, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Remove …'}" Command="{Binding RemoveCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Hide'}" Command="{Binding HideCommand}" ToolTip="{l:T 'Saved as an exclusion on the folder'}"
                      Visibility="{Binding CanHide, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Typ-Kürzel -->
        <!-- Typ-Kürzel als dezente Pille: halbtransparente Typfarbe, feiner Rand, helle bzw. dunkle Schrift -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile.Inner}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Badge.Other.Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Badge.Other.Border}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Other.Fg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="PowerShell">
                    <Setter Property="Background" Value="{DynamicResource Badge.PowerShell.Bg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Badge.PowerShell.Border}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.PowerShell.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Batch">
                    <Setter Property="Background" Value="{DynamicResource Badge.Batch.Bg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Badge.Batch.Border}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Batch.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Executable">
                    <Setter Property="Background" Value="{DynamicResource Badge.Executable.Bg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Badge.Executable.Border}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Executable.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="ConsoleSnapIn">
                    <Setter Property="Background" Value="{DynamicResource Badge.ConsoleSnapIn.Bg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Badge.ConsoleSnapIn.Border}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.ConsoleSnapIn.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Shortcut">
                    <Setter Property="Background" Value="{DynamicResource Badge.Shortcut.Bg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Badge.Shortcut.Border}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Shortcut.Fg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Zeile ohne eigenen Rahmen; Hover/Auswahl macht der umgebende Border -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource Btn.Standard}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        </Style>

        <!-- Details eines ausgewählten Eintrags (in der Liste aufgeklappt, im Raster unten im Panel) -->
        <DataTemplate x:Key="ItemDetails">
            <StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding HasDescription, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Mono}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasMeta, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False" Margin="0,0,0,6"
                                  Visibility="{Binding HasTags, Converter={StaticResource Vis}}"/>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{DynamicResource Status.Error}"/>
                        <TextBlock Text="{Binding HealthText}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Border Background="{DynamicResource Bg.Chip}" CornerRadius="{DynamicResource Radius.Control}" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding Notes}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="Req" Text="{Binding RequirementsText}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding RequirementsText, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding ParseError}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasParseError, Converter={StaticResource Vis}}"/>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Unblock'}" Command="{Binding UnblockCommand}"
                                Height="26" MinHeight="26" FontSize="{StaticResource Font.Body}" Margin="8,0,0,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding BlockedText}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock x:Name="Sig" Text="{Binding SignatureText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,8"
                               Visibility="{Binding SignatureText, Converter={StaticResource Vis}}"/>
                    <!-- Parameter direkt im Panel; „Speichern als …“ legt ein Parameter-Set (Startprofil) an -->
                    <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            Visibility="{Binding HasInlineForm, Converter={StaticResource Vis}}">
                        <StackPanel DataContext="{Binding Inline}">
                            <TextBlock Text="{l:T 'Parameters'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,2"
                                                       Visibility="{Binding IsSwitch, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                            <TextBox x:Name="Field" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,0" FontSize="{StaticResource Font.Body}"
                                                     Tag="{Binding Placeholder}" ToolTip="{Binding Help}" Visibility="{Binding IsText, Converter={StaticResource Vis}}"
                                                     AutomationProperties.Name="{Binding Name}"/>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}" Height="28" FontSize="{StaticResource Font.Body}" Padding="10,0,8,0" VerticalContentAlignment="Center"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Name}"/>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" FontSize="{StaticResource Font.Body}" ToolTip="{Binding Help}"
                                                      Visibility="{Binding IsSwitch, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{l:T 'the script asks for it itself at launch (never saved)'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}"
                                                       Visibility="{Binding IsSecure, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Error}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource Btn.Accent}" Command="{Binding RunCommand}" Height="28" MinHeight="28" Padding="10,0" FontSize="{StaticResource Font.Body}"
                                        ToolTip="{l:T 'Run with these values (rights and target from the default profile)'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:T 'With these values'}"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Style="{StaticResource Btn.Subtle}" Command="{Binding SaveSetCommand}" Height="28" MinHeight="28" Padding="8,0" Margin="6,0,0,0"
                                        ToolTip="{l:T 'Save as parameter set – appears as a launch profile on the Run button'}">
                                    <TextBlock Text="{l:T 'Save as …'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Accent}"/>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                            <!-- Ein Profil: normaler Button -->
                            <ui:Button Style="{StaticResource Btn.Accent}" Command="{Binding RunCommand}" Height="30" MinHeight="30" Padding="12,0" FontSize="{StaticResource Font.Body}"
                                    ToolTip="{Binding RunToolTip}" Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RunLabel}"/>
                                </StackPanel>
                            </ui:Button>
                            <!-- Mehrere Profile: Split-Button (links Standardprofil, rechts Auswahl) -->
                            <Button Style="{StaticResource Btn.SplitLeft}" Command="{Binding RunCommand}" Height="30" MinHeight="30" Padding="12,0" FontSize="{StaticResource Font.Body}"
                                    ToolTip="{Binding RunToolTip}" Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RunLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.SplitRight}" Height="30" MinHeight="30" Width="30" Padding="0"
                                    Click="ProfileMenuButton_Click" ToolTip="{l:T 'Run another launch profile'}"
                                    AutomationProperties.Name="{l:T 'Choose launch profile'}"
                                    Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                            </Button>
                        </StackPanel>
                        <ui:Button Style="{StaticResource ActionButton}" Command="{Binding RunAdminCommand}" ToolTip="{l:T 'Run as administrator (UAC)'}"
                                Visibility="{Binding CanElevate, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'Admin'}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource ActionButton}" Command="{Binding RunAsUserCommand}" ToolTip="{l:T 'Run as different user'}"
                                Visibility="{Binding CanElevate, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'As …'}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource ActionButton}" Command="{Binding RunRemoteCommand}" ToolTip="{l:T 'Run on one or more remote computers'}"
                                Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'Remote'}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource ActionButton}" Width="30" Padding="0" ToolTip="{l:T 'More actions'}"
                                ContextMenu="{StaticResource ItemMenu}" Click="MenuButton_Click">
                            <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                        </ui:Button>
                    </WrapPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SignatureValid}" Value="True">
                    <Setter TargetName="Sig" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RequirementsWarn}" Value="True">
                    <Setter TargetName="Req" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kachel für die Rasteransicht (kompakt: kleiner, eine Zeile) -->
        <DataTemplate x:Key="TileTemplate">
            <!-- Schwebende Kachel: in Ruhe fast durchsichtig, beim Darüberfahren heller mit feinem Rand -->
            <Border x:Name="Row" CornerRadius="{DynamicResource Radius.Tile}" Background="{DynamicResource Bg.Tile}" Margin="2" Width="74" BorderBrush="Transparent" BorderThickness="1"
                    AllowDrop="True" PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                    DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <Button Style="{StaticResource RowButton}" Command="{Binding SelectCommand}" ToolTip="{Binding ToolTipText}" MouseDoubleClick="Row_DoubleClick"
                        ContextMenu="{StaticResource ItemMenu}" ToolTipService.InitialShowDelay="700">
                    <Grid x:Name="TileGrid" Margin="3,6,3,4" Height="62">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="IconRow" Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TileIcon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Width="34" Height="22" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="{StaticResource Font.Micro}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="TileImage" Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                            <c:IconPresenter x:Name="TileCustom" Icon="{Binding CustomIcon}" Size="26" Foreground="{DynamicResource Text.Primary}"
                                             Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XS}" Foreground="{DynamicResource Status.Error}" Margin="0,0,2,0"
                                       Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}" ToolTip="{Binding HealthText}"/>
                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XS}" Foreground="{DynamicResource Accent}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <TextBlock x:Name="TileName" Grid.Row="1" infra:Highlight.Parts="{Binding NameParts}" FontSize="{StaticResource Font.Caption}" TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,3,0,0" VerticalAlignment="Top"/>
                    </Grid>
                </Button>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Border.TileHover}"/>
                </Trigger>
                <!-- Mehrfachauswahl (Strg+Klick) -->
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Search.Highlight}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Border.TileHover}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter TargetName="Row" Property="Width" Value="60"/>
                    <Setter TargetName="TileGrid" Property="Height" Value="46"/>
                    <Setter TargetName="TileGrid" Property="Margin" Value="2,4,2,2"/>
                    <Setter TargetName="IconRow" Property="Height" Value="24"/>
                    <Setter TargetName="TileImage" Property="Width" Value="20"/>
                    <Setter TargetName="TileImage" Property="Height" Value="20"/>
                    <Setter TargetName="TileCustom" Property="Size" Value="20"/>
                    <Setter TargetName="TileIcon" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Setter.Value>
                    </Setter>
                    <Setter TargetName="TileName" Property="TextWrapping" Value="NoWrap"/>
                    <Setter TargetName="TileName" Property="FontSize" Value="{StaticResource Font.Caption}"/>
                    <Setter TargetName="TileName" Property="Margin" Value="0,2,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsLarge, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter TargetName="Row" Property="Width" Value="96"/>
                    <Setter TargetName="TileGrid" Property="Height" Value="84"/>
                    <Setter TargetName="IconRow" Property="Height" Value="40"/>
                    <Setter TargetName="TileImage" Property="Width" Value="34"/>
                    <Setter TargetName="TileImage" Property="Height" Value="34"/>
                    <Setter TargetName="TileCustom" Property="Size" Value="34"/>
                    <Setter TargetName="TileIcon" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value>
                    </Setter>
                    <Setter TargetName="TileName" Property="FontSize" Value="{StaticResource Font.BodyStrong}"/>
                    <Setter TargetName="TileName" Property="MaxHeight" Value="34"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate">
            <Border x:Name="Row" CornerRadius="{DynamicResource Radius.Card}" Background="Transparent" Margin="0,1" BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                    AllowDrop="True" PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                    DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Command="{Binding SelectCommand}" ToolTip="{Binding ToolTipText}" MouseDoubleClick="Row_DoubleClick"
                            ContextMenu="{StaticResource ItemMenu}" ToolTipService.InitialShowDelay="900">
                        <Grid x:Name="RowGrid" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Läuft gerade (lokaler Start in der Aktivitäten-Leiste) -->
                                <Border Margin="6,0,0,0" Padding="6,1,7,1" CornerRadius="{DynamicResource Radius.Tile}" Background="{DynamicResource Bg.Selected}" VerticalAlignment="Center"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" ToolTip="{l:T 'Running – details below in the activities'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="RunDot" Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{l:T 'running'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Zuletzt ausgeführt: wann -->
                                <TextBlock Text="{Binding RecentWhen}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding HasRecentWhen, Converter={StaticResource Vis}}"/>
                                <!-- Schnellstart-Taste (Favoriten) -->
                                <Border VerticalAlignment="Center" Margin="6,0,0,0" Padding="5,1" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1"
                                        BorderBrush="{DynamicResource Border.Control}" Visibility="{Binding HasQuickKey, Converter={StaticResource Vis}}"
                                        ToolTip="{l:T 'Quick start with this key – even without selecting the entry'}">
                                    <TextBlock Text="{Binding QuickKeyText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}"/>
                                </Border>
                            </StackPanel>
                            <Grid x:Name="BadgeBox" Width="36" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Border Style="{StaticResource Badge}" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="{StaticResource Font.Micro}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,-1,0,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding BadgeText}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                <c:IconPresenter Icon="{Binding CustomIcon}" Size="24" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"
                                                 Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="NameText" infra:Highlight.Parts="{Binding NameParts}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                    <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Accent}"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}" ToolTip="{l:T 'Favorite'}"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding IsFromCatalog, Converter={StaticResource Vis}}" ToolTip="{Binding CatalogToolTip}"/>
                                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="{DynamicResource Radius.Tile}" Background="{DynamicResource Bg.Chip}" VerticalAlignment="Center"
                                            Visibility="{Binding HasSchedule, Converter={StaticResource Vis}}" ToolTip="{Binding ScheduleToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XS}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ScheduleText}" FontSize="{StaticResource Font.Caption}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding HasParseError, Converter={StaticResource Vis}}" ToolTip="{Binding ParseError}"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}" ToolTip="{Binding BlockedText}"/>
                                    <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource Vis}}" ToolTip="{l:T 'Requires administrator rights (#Requires)'}"/>
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" ToolTip="{Binding Notes}"/>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Status.Error}"
                                               Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}" ToolTip="{Binding HealthText}"/>
                                </DockPanel>
                                <TextBlock x:Name="Syn" infra:Highlight.Parts="{Binding SynopsisParts}" FontSize="{StaticResource Font.Body}" Margin="0,2,0,0" Foreground="{DynamicResource Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemDetails}" Focusable="False" Margin="54,0,8,4"
                                    Visibility="{Binding IsSelected, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                </Trigger>
                <!-- „läuft“: Punkt pulsiert -->
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RunPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="RunDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RunPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Mehrfachauswahl (Strg+Klick) -->
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Search.Highlight}"/>
                    <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Syn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="RowGrid" Property="Margin" Value="8,4"/>
                    <Setter TargetName="NameText" Property="FontSize" Value="{StaticResource Font.BodyStrong}"/>
                    <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="NameText" Property="MaxWidth" Value="320"/>
                    <Setter TargetName="BadgeBox" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.82" ScaleY="0.82"/></Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsLarge, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter TargetName="RowGrid" Property="Margin" Value="10,10"/>
                    <Setter TargetName="NameText" Property="FontSize" Value="{StaticResource Font.Large}"/>
                    <Setter TargetName="NameText" Property="MaxWidth" Value="420"/>
                    <Setter TargetName="Syn" Property="FontSize" Value="{StaticResource Font.BodyStrong}"/>
                    <Setter TargetName="BadgeBox" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                    <Setter TargetName="Syn" Property="TextWrapping" Value="Wrap"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Gruppe (Ordner, Favoriten, eigene Gruppe mit Untergruppen) -->
        <DataTemplate x:Key="GroupTemplate">
            <!-- Gruppen ziehen: Lücke davor/dahinter; die gezogene Gruppe macht an ihrer alten Stelle Platz -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <c:DropGap IsOpen="{Binding GapBefore}" Label="{Binding DataContext.DragLabel, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                           DotBrush="{Binding DataContext.DragColor, RelativeSource={RelativeSource AncestorType=c:PanelRoot}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                           DragOver="DropGap_DragOver" Drop="DropGap_Drop"/>
                <Border x:Name="GroupBox" BorderThickness="1" Margin="0,2,0,0" CornerRadius="{DynamicResource Radius.Card}"
                        AllowDrop="True" DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop">
                <!-- Farbe der Gruppe als getönte Karte bzw. (Gruppen-Stil „Akzentstreifen“) einheitliche, halbtransparente Fluent-Karte
                     mit feinem Rand – über den Stil, damit die Drag-Hervorhebung zurückgesetzt werden kann -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding CardBackgroundColor, Converter={StaticResource ArgbBrush}}"/>
                        <Setter Property="BorderBrush" Value="{Binding CardBorderColor, Converter={StaticResource ArgbBrush}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Bg.GroupCard}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Border.GroupCard}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border x:Name="GroupHeader" CornerRadius="{DynamicResource Radius.Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="0" Background="Transparent" AllowDrop="True"
                            PreviewMouseLeftButtonDown="GroupHeader_PreviewMouseLeftButtonDown" PreviewMouseMove="GroupHeader_PreviewMouseMove"
                            DragOver="GroupHeader_DragOver" DragLeave="GroupHeader_DragLeave" Drop="GroupHeader_Drop">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GroupHeaderButton}" Command="{Binding ToggleCommand}" HorizontalContentAlignment="Stretch"
                                Padding="8,0" Height="32" ContextMenu="{StaticResource GroupMenu}" Foreground="{DynamicResource Text.Secondary}"
                                ToolTip="{l:T 'Click: expand/collapse · Right-click: menu'}" ToolTipService.InitialShowDelay="1200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Gruppen-Stil „Akzentstreifen“: schmaler senkrechter Streifen in Gruppenfarbe am linken Rand der Karte -->
                                <Border x:Name="AccentStripe" Width="4" Height="18" CornerRadius="{DynamicResource Radius.Bar}" HorizontalAlignment="Left" Margin="-4,0,0,0" Visibility="Collapsed"
                                        Background="{Binding AccentColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Text.Tertiary}"/>
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Grid Grid.Column="1" Margin="8,0">
                                    <c:IconPresenter Icon="{Binding CustomIcon}" Size="16" Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}">
                                        <c:IconPresenter.Style>
                                            <Style TargetType="c:IconPresenter">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:IconPresenter.Style>
                                    </c:IconPresenter>
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="{StaticResource Font.BodyStrong}"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="GroupTitle" Grid.Column="2" Text="{Binding Title}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- Knöpfe erst beim Darüberfahren: wachsen von 0 auf volle Breite und blenden ein, die Zahl gleitet dabei nach links -->
                        <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                            <StackPanel.LayoutTransform><ScaleTransform ScaleX="0"/></StackPanel.LayoutTransform>
                            <!-- Liste/Raster nur für diese Gruppe -->
                            <ui:Button x:Name="LayoutToggle" Style="{StaticResource Btn.Icon}" Width="28" Height="32" ToolTip="{Binding LayoutToolTip}"
                                    Command="{Binding ToggleLayoutCommand}">
                                <TextBlock Text="{Binding LayoutGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                            </ui:Button>
                            <!-- Menü erst beim Darüberfahren (wie Liste/Raster) – ruhigerer Gruppenkopf -->
                            <ui:Button x:Name="GroupMenuButton" Style="{StaticResource Btn.Icon}" Width="32" Height="32" ToolTip="{l:T 'Menu'}"
                                    ContextMenu="{StaticResource GroupMenu}" Click="MenuButton_Click">
                                <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    </Border>
                    <TextBlock Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Vis}}" FontSize="{StaticResource Font.Body}"
                               Foreground="{DynamicResource Status.Warning}" Margin="38,0,8,6" TextWrapping="Wrap"/>
                    <!-- Inhalt klappt beim Klick auf den Kopf weich auf und zu -->
                    <c:CollapsePanel Animate="{Binding AnimateExpand}" IsExpanded="{Binding IsExpanded}"
                                     AnimateResize="{Binding AnimateResize}" TransitionKey="{Binding IsGrid}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGrid}" Value="True">
                                            <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}"/>
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate><WrapPanel Margin="4,0,0,0"/></ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <!-- Option „Inhalte beim Ziehen zuklappen“: nur Gruppenköpfe -->
                                        <DataTrigger Binding="{Binding DataContext.GroupDragCompact, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <!-- Untergruppen -->
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource GroupTemplate}" Focusable="False" Margin="14,0,0,0"/>
                    </StackPanel>
                    </c:CollapsePanel>
                    <!-- Lücke für „als letzte Untergruppe“ (auch bei eingeklappter Gruppe sichtbar) -->
                    <c:DropGap IsOpen="{Binding GapInside}" Margin="14,0,4,0" Label="{Binding DataContext.DragLabel, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                           DotBrush="{Binding DataContext.DragColor, RelativeSource={RelativeSource AncestorType=c:PanelRoot}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                           DragOver="DropGap_DragOver" Drop="DropGap_Drop"/>
                    <Border Margin="8,0,8,8" Padding="10,10" CornerRadius="{DynamicResource Radius.Card}" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}"
                            Visibility="{Binding ShowDropHint, Converter={StaticResource Vis}}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Tertiary}"
                                   Text="{l:T 'Drag entries here – also files, folders or links from Explorer and the browser. Right-click: new entry.'}"/>
                    </Border>
                </StackPanel>
                </Border>
                <c:DropGap IsOpen="{Binding GapAfter}" Label="{Binding DataContext.DragLabel, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                           DotBrush="{Binding DataContext.DragColor, RelativeSource={RelativeSource AncestorType=c:PanelRoot}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                           DragOver="DropGap_DragOver" Drop="DropGap_Drop"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Gruppen-Stil „Akzentstreifen“: Streifen, Titel in Gruppenfarbe, etwas rundere Karte -->
                <DataTrigger Binding="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True">
                    <Setter TargetName="AccentStripe" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Chevron" Property="Margin" Value="8,0,0,0"/>
                    <Setter TargetName="GroupBox" Property="CornerRadius" Value="{DynamicResource Radius.Tile}"/>
                    <Setter TargetName="GroupHeader" Property="CornerRadius" Value="{DynamicResource Radius.Tile}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True"/>
                        <Condition Binding="{Binding HasColor}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GroupTitle" Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                </MultiDataTrigger>
                <!-- Akzentstreifen: beim Darüberfahren leuchtet der Kopf dezent in der Gruppenfarbe -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, ElementName=GroupHeader}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GroupHeader" Property="Background" Value="{Binding CardBackgroundColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Hover}"/>
                </MultiDataTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition SourceName="GroupHeader" Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="{StaticResource Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.04" Duration="{StaticResource Motion.Fast}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiTrigger.EnterActions>
                    <MultiTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                                 To="0" Duration="{StaticResource Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiTrigger.ExitActions>
                    <!-- Hover über dem Gruppenkopf: Rahmen der Gruppe hervorheben (statt grauer Fläche) -->
                    <Setter TargetName="GroupBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </MultiTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=GroupHeader}" Value="True"/>
                        <Condition Binding="{Binding HasColor}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GroupBox" Property="BorderBrush" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding CanChangeLayout}" Value="False">
                    <Setter TargetName="LayoutToggle" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- Gruppe wird hineingezogen: Rahmen der Zielgruppe hervorheben -->
                <DataTrigger Binding="{Binding GapInside}" Value="True">
                    <Setter TargetName="GroupBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="GroupBox" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

      </ResourceDictionary>
    </Window.Resources>

    <c:PanelRoot x:Name="PanelBorder" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Panel}"
            BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}" ClipToBounds="True"
            AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
        <c:PanelRoot.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </c:PanelRoot.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Milchglas (ApplyFrost): Helligkeitsschicht, darüber die Panelfarbe als Tönung -->
            <Grid x:Name="FrostLayer" Grid.RowSpan="8" IsHitTestVisible="False" Panel.ZIndex="-1" Visibility="Collapsed">
                <Border x:Name="FrostBrightness" CornerRadius="{DynamicResource Radius.Tile.Inner}"/>
                <Border x:Name="FrostTint" CornerRadius="{DynamicResource Radius.Tile.Inner}"/>
            </Grid>

            <!-- Kopfzeile: Titel und Arbeitsbereich schrumpfen, die Knöpfe bleiben immer sichtbar -->
            <Grid Margin="14,10,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition MaxWidth="130">
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspaces}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Programmsymbol von Power-Exec (Auflösung passend zur Skalierung, siehe PanelWindow.xaml.cs) -->
                <Image x:Name="HeaderLogo" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Power-Exec"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiPanel}" Value="True">
                                    <Setter Property="Text" Value="{Binding PanelName}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Column="2" x:Name="WorkspaceBox" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="{StaticResource Font.Body}" MinHeight="28" Height="28" Padding="10,0,8,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Workspaces}" SelectedItem="{Binding ActiveWorkspace, Mode=OneWay}" SelectionChanged="Workspace_SelectionChanged"
                          ToolTip="{l:T 'Switch workspace'}" Visibility="{Binding HasWorkspaces, Converter={StaticResource Vis}}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Command="{Binding ToggleGridCommand}" ToolTip="{Binding LayoutToolTip}">
                        <TextBlock Text="{Binding LayoutGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}"/>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Click="MenuButton_Click" ToolTip="{l:T 'Item size: small, medium, large'}">
                        <TextBlock Text="&#xE8E9;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T 'Small'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Small">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding ItemSize, Converter={StaticResource EqVis}, ConverterParameter=Small}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T 'Medium'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Medium">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding ItemSize, Converter={StaticResource EqVis}, ConverterParameter=Medium}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T 'Large'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Large">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding ItemSize, Converter={StaticResource EqVis}, ConverterParameter=Large}"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </ui:Button>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Width="32" IsChecked="{Binding ShowHistory}" ToolTip="{l:T 'History (Ctrl+H)'}"
                                  AutomationProperties.Name="{l:T 'History'}">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Width="32" IsChecked="{Binding IsPinned}" ToolTip="{l:T 'Pin: panel stays open'}">
                        <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}"/>
                    </ToggleButton>
                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Command="{Binding SettingsCommand}" ToolTip="{l:T 'Settings'}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}"/>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Update-Hinweis -->
            <StackPanel Grid.Row="1">
            <!-- Team-Katalog: Änderungen zum Übernehmen -->
            <Border Margin="16,0,16,10" Padding="12,8" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}"
                    BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Visibility="{Binding CatalogPending, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="{StaticResource Icon.L}" Margin="0,0,10,0"/>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Apply'}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                            Command="{Binding ApplyCatalogsCommand}" MinHeight="26" Height="26" Padding="8,0" />
                    <TextBlock Text="{Binding CatalogPending}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Status.Info.Text}"/>
                </DockPanel>
            </Border>
            <!-- Neu in dieser Version -->
            <Border Margin="16,0,16,10" Padding="12,10,6,10" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}"
                    BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Visibility="{Binding WhatsNewVisible, Converter={StaticResource Vis}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" VerticalAlignment="Top" Command="{Binding DismissWhatsNewCommand}"
                            ToolTip="{l:T 'Read – don\'t show again'}" AutomationProperties.Name="{l:T 'Close release notes'}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                    </ui:Button>
                    <TextBlock Text="&#xE789;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="{StaticResource Icon.XL}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding WhatsNewTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding WhatsNewItems}" Focusable="False" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Info.Text}" Margin="0,1,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'All release notes'}" Command="{Binding ShowAllWhatsNewCommand}" HorizontalAlignment="Left"
                                Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Padding="0" Margin="0,6,0,0" MinHeight="22" Height="22" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Margin="16,0,16,10" Padding="12,10" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}"
                    BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Visibility="{Binding UpdateVisible, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="{StaticResource Icon.XL}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpdateSubtitle}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Status.Info.Text}" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Update now'}" Command="{Binding UpdateNowCommand}" Height="28" MinHeight="28" FontSize="{StaticResource Font.Body}" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Later'}" Command="{Binding UpdateLaterCommand}" Height="28" MinHeight="28" FontSize="{StaticResource Font.Body}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Margin="16,0,16,10" Padding="12,8" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}"
                    BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Visibility="{Binding PendingText, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="{StaticResource Icon.L}" Margin="0,0,10,0"/>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Check'}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                            Command="{Binding ReviewPendingCommand}" MinHeight="26" Height="26" Padding="8,0" />
                    <TextBlock Text="{Binding PendingText}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            </StackPanel>

            <!-- Suche -->
            <Grid Grid.Row="2" Margin="16,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="38"
                         Padding="30,0,8,0" Tag="{l:T 'Search …'}" PreviewKeyDown="SearchBox_PreviewKeyDown" PreviewTextInput="SearchBox_PreviewTextInput"
                         TextChanged="SearchBox_TextChanged" SelectionChanged="SearchBox_SelectionChanged" LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                         PreviewMouseLeftButtonUp="SearchBox_PreviewMouseUp"
                         ToolTip="{Binding SearchHelp}" ToolTipService.InitialShowDelay="1500"
                         AutomationProperties.Name="{l:T 'Search'}" AutomationProperties.HelpText="{Binding SearchHelp}">
                    <TextBox.Resources><CornerRadius x:Key="TextBox.CornerRadius">12</CornerRadius></TextBox.Resources>
                </TextBox>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <Border HorizontalAlignment="Right" Margin="0,0,8,0" Padding="6,1" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" BorderBrush="{DynamicResource Border.Control}"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSearching}" Value="False"/>
                                        <Condition Binding="{Binding HasHotkey}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding HotkeyHint}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}"/>
                </Border>
                <!-- Vorschläge beim Tippen: #schlagwort, typ:, gruppe:, ist: (nur, was es gibt; mit Anzahl) -->
                <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True"
                       IsOpen="{Binding HasSuggestions, Mode=OneWay}" VerticalOffset="4" Width="{Binding ActualWidth, ElementName=SearchBox}">
                    <Border Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Window}" Padding="4" Margin="0,0,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                        <StackPanel>
                            <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedIndex="{Binding SuggestionIndex}" Background="Transparent" BorderThickness="0"
                                     MaxHeight="260" Focusable="False" PreviewMouseLeftButtonUp="SuggestionList_MouseUp" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock x:Name="Count" DockPanel.Dock="Right" Text="{Binding Count}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource Text.Tertiary}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Width="18" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <!-- Filterart (Schlagwort, Typ …): Symbol, normale Schrift, Pfeil – die Auswahl zeigt danach die Werte -->
                                            <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Count" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Label" Property="FontFamily" Value="{StaticResource AppFont}"/>
                                                <Setter TargetName="Label" Property="FontSize" Value="{StaticResource Font.BodyStrong}"/>
                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="8,4,8,2" Text="{l:T 'Enter or Tab accepts · ↑ ↓ select · Esc closes'}"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <ui:Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="{l:T 'Clear search'}"
                        Command="{Binding ClearSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                </ui:Button>
            </Grid>

            <!-- Aktive Filter (aus dem Suchfeld bzw. voreingestellt); gewählt werden sie über die Vorschläge beim Klick ins Suchfeld -->
            <StackPanel Grid.Row="3" Margin="16,8,16,2">
            <!-- Erkannte Filter aus dem Suchfeld (typ:, gruppe:, ist:, #schlagwort); ✕ entfernt sie -->
            <ItemsControl ItemsSource="{Binding SearchChips}" Margin="0,0,0,2" Focusable="False"
                          Visibility="{Binding HasSearchChips, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ChipBd" infra:Pill.IsEnabled="True" Height="24" Padding="10,0,2,0" Margin="0,0,6,4" Background="{DynamicResource Bg.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource Accent}" ToolTip="{Binding ToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChipText" Text="{Binding Label}" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                <ui:Button Style="{StaticResource Btn.Icon}" Width="20" Height="20" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                        ToolTip="{l:T 'Remove filter'}" AutomationProperties.Name="{l:T 'Remove filter'}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XS}"/>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource Status.Warning.Bg}"/>
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="{DynamicResource Status.Warning.Border}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- Warnung: Ordner nicht erreichbar -->
            <Border Grid.Row="4" Margin="16,4,16,2" Padding="10,6" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Warning.Bg}" BorderBrush="{DynamicResource Status.Warning.Border}"
                    BorderThickness="1" Visibility="{Binding FolderWarning, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,8,0" Foreground="{DynamicResource Status.Warning}"/>
                    <TextBlock Text="{Binding FolderWarning}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Liste -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="5" VerticalScrollBarVisibility="{Binding ShowListScrollBar, Mode=OneWay, Converter={StaticResource ScrollBarAuto}}" HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent" ScrollChanged="ListScroll_ScrollChanged">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Padding" Value="8,0,8,8"/>
                        <Style.Triggers>
                            <!-- Platz für die Sprungleiste -->
                            <DataTrigger Binding="{Binding ShowJumpRail}" Value="True">
                                <Setter Property="Padding" Value="8,0,20,8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T 'New group …'}" Command="{Binding NewGroupCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T 'New entry'}">
                            <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                            <MenuItem Header="{l:T 'New entry …'}" Command="{Binding NewEntryCommand}"/>
                            <Separator/>
                            <MenuItem Header="{l:T 'Website …'}" Command="{Binding NewEntryCommand}" CommandParameter="Url"/>
                            <MenuItem Header="{l:T 'Folder …'}" Command="{Binding NewEntryCommand}" CommandParameter="Folder"/>
                            <MenuItem Header="{l:T 'Remote Desktop …'}" Command="{Binding NewEntryCommand}" CommandParameter="Rdp"/>
                            <MenuItem Header="{l:T 'SSH connection …'}" Command="{Binding NewEntryCommand}" CommandParameter="Ssh"/>
                            <MenuItem Header="{l:T 'PowerShell snippet …'}" Command="{Binding NewEntryCommand}" CommandParameter="Snippet"/>
                            <MenuItem Header="{l:T 'Text snippet …'}" Command="{Binding NewEntryCommand}" CommandParameter="TextSnippet"/>
                            <MenuItem Header="{l:T 'Windows tool …'}" Command="{Binding NewEntryCommand}" CommandParameter="Tool"/>
                            <MenuItem Header="{l:T 'Command …'}" Command="{Binding NewEntryCommand}" CommandParameter="Command"/>
                            <MenuItem Header="{l:T 'Select files …'}" Command="{Binding AddFilesCommand}"/>
                            <Separator/>
                            <MenuItem Header="{l:T 'From templates …'}" Command="{Binding AddFromCatalogCommand}"/>
                            <MenuItem Header="{l:T 'Paste from clipboard'}" Command="{Binding AddFromClipboardCommand}" InputGestureText="Strg+V"/>
                        </MenuItem>
                        <MenuItem Header="{l:T 'Import entries …'}" Command="{Binding ImportEntriesCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{l:T 'Grid'}" Command="{Binding ToggleGridCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding IsGrid, Converter={StaticResource Vis}}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T 'Item size'}">
                            <MenuItem.Icon><TextBlock Text="&#xE8E9;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                            <MenuItem Header="{l:T 'Small'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Small"/>
                            <MenuItem Header="{l:T 'Medium'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Medium"/>
                            <MenuItem Header="{l:T 'Large'}" Command="{Binding SetItemSizeCommand}" CommandParameter="Large"/>
                        </MenuItem>
                        <MenuItem Header="{l:T 'Settings …'}" Command="{Binding SettingsCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel>
                    <StackPanel Visibility="{Binding HasNoFolders, Converter={StaticResource Vis}}" Margin="16,32,16,0">
                        <TextBlock Text="{l:T 'No group with a folder yet.'}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{l:T 'Create a group and choose a folder – it then shows its scripts and programs. You create custom entries with a right-click.'}"
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'New group …'}" Command="{Binding NewGroupCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" Margin="16,32,16,0" TextAlignment="Center"
                               Style="{StaticResource Caption}" Text="{l:T 'No results. Searches name, synopsis, description, note and tags. Clicking into the search box offers filters (tag, type, group, property).'}"/>

                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Größe per Ziehen: Griffe am Innenrand (Lage setzt PlaceGrips) -->
            <Thumb x:Name="WidthGrip" Grid.RowSpan="8" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Panel.ZIndex="10"
                   DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" ToolTip="{l:T 'Change width'}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="HeightGrip" Grid.RowSpan="8" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Panel.ZIndex="10"
                   DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" ToolTip="{l:T 'Change height'}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- Fixierter Kopf der aktuellen Gruppe (mit Pfad); Klick springt zum Gruppenkopf. Breite und Lage setzt der Code genau
                 auf die Karte der Gruppe (auch bei Untergruppen und Scrollbalken); Rahmen und Ecken wie die Karte, unten offen. -->
            <Button x:Name="StickyHeader" Grid.Row="5" VerticalAlignment="Top" Margin="8,0,20,0" Panel.ZIndex="10" Style="{StaticResource RowButton}"
                    DataContext="{Binding StickyGroup}" Command="{Binding DataContext.JumpToGroupCommand, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}"
                    CommandParameter="{Binding}" ToolTip="{l:T 'Jump to group header'}"
                    Visibility="{Binding DataContext.HasStickyGroup, RelativeSource={RelativeSource AncestorType=c:PanelRoot}, Converter={StaticResource Vis}}">
                <Border Background="{DynamicResource Bg.Panel}" BorderThickness="1,1,1,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card.Top}"/>
                            <Setter Property="BorderBrush" Value="{Binding CardBorderColor, Converter={StaticResource ArgbBrush}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasColor}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.GroupCard}"/>
                                    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile.Top}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border x:Name="StickyFill" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Default}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card.Top.Inner}"/>
                                <Setter Property="Background" Value="{Binding CardBackgroundColor, Converter={StaticResource ArgbBrush}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg.GroupCard}"/>
                                        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile.Top.Inner}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="{DynamicResource Radius.Bar}" Margin="-4,0,8,0"
                                    Background="{Binding AccentColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Text.Tertiary}"
                                    Visibility="{Binding DataContext.IsAccentGroups, RelativeSource={RelativeSource AncestorType=c:PanelRoot}, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding IconGlyph}" FontSize="{StaticResource Font.Body}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Breadcrumb}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Border>
            </Button>

            <!-- Sprungleiste: ein Punkt je Gruppe (Gruppenfarbe), Klick springt hin -->
            <ItemsControl Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,4,8" Panel.ZIndex="11" Focusable="False"
                          ItemsSource="{Binding Groups}" Visibility="{Binding ShowJumpRail, Converter={StaticResource Vis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="14" Height="16" Padding="0" Cursor="Hand" ToolTip="{Binding RailToolTip}" Focusable="False"
                                Command="{Binding DataContext.RailClickCommand, RelativeSource={RelativeSource AncestorType=c:PanelRoot}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Opacity="0.75" Style="{StaticResource GroupDot}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Width" Value="10"/>
                                            <Setter TargetName="Dot" Property="Height" Value="10"/>
                                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEquals}">
                                                    <Binding Path="Key"/>
                                                    <Binding Path="DataContext.StickyTopKey" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Dot" Property="Width" Value="10"/>
                                            <Setter TargetName="Dot" Property="Height" Value="10"/>
                                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Strg+K: Gruppe suchen und anspringen -->
            <Border Grid.Row="2" Grid.RowSpan="4" Margin="12,0,12,12" Panel.ZIndex="31" VerticalAlignment="Top"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                    Padding="8" Visibility="{Binding ShowGroupJump, Converter={StaticResource Vis}}" IsVisibleChanged="GroupJump_IsVisibleChanged">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="GroupJumpBox" DockPanel.Dock="Top" Height="34" Padding="8,0" Tag="{l:T 'Find group … (Enter jumps there, Esc closes)'}"
                             Text="{Binding GroupJumpText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="GroupJumpBox_PreviewKeyDown"
                             AutomationProperties.Name="{l:T 'Find group'}"/>
                    <ListBox x:Name="GroupJumpList" ItemsSource="{Binding GroupJumpResults}" SelectedItem="{Binding GroupJumpSelected}" Margin="0,6,0,0"
                             MaxHeight="320" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="GroupJumpList_MouseUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" DataContext="{Binding Group}" Style="{StaticResource GroupDot}"/>
                                    <StackPanel>
                                        <TextBlock infra:Highlight.Parts="{Binding TitleParts}" FontSize="{StaticResource Font.BodyStrong}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PathText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasPath, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Vorschau (Leertaste): Code mit Syntaxfarben, Parameter, Signatur, letzter Start.
                 Läuft in einem eigenen Fenster neben dem Panel (PeekWindow); die Karte zieht beim Start dorthin um. -->
            <Border x:Name="PeekCard" Grid.Row="2" Grid.RowSpan="4" Margin="10,0,10,10" Panel.ZIndex="29"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                    AutomationProperties.Name="{l:T 'Preview'}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Kopf -->
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6">
                        <ui:Button x:Name="PeekCloseButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28"
                                ToolTip="{l:T 'Close (Space or Esc)'}" AutomationProperties.Name="{l:T 'Close preview'}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                        </ui:Button>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" DataContext="{Binding Item}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" FontSize="{StaticResource Font.Micro}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Item.DisplayName}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{l:T '↑ ↓ next entry · Space closes'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Aktionen -->
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding Item.EditCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding Item.CanEdit, Converter={StaticResource Vis}}" ToolTip="{l:T 'Ctrl+E'}">
                                <TextBlock Text="{l:T 'Open in editor'}"/>
                            </ui:Button>
                            <ui:Button Style="{StaticResource Btn.Accent}" Command="{Binding Item.RunCommand}" ToolTip="{l:T 'Enter'}">
                                <TextBlock Text="{Binding Item.RunLabel}"/>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,8"
                                       Visibility="{Binding Description, Converter={StaticResource Vis}}"/>
                            <!-- Fakten -->
                            <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PeekLabel"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Item.SignatureText}" FontSize="{StaticResource Font.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Item.SignatureText, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding Item.RequirementsText}" FontSize="{StaticResource Font.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Item.RequirementsText, Converter={StaticResource Vis}}" Foreground="{DynamicResource Status.Warning}"/>
                            <TextBlock Text="{Binding Item.FolderInfo}" FontSize="{StaticResource Font.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Item.FolderInfo, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Secondary}"/>
                            <!-- Parameter -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasParameters, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:T 'Parameters'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,5">
                                                <TextBlock FontSize="{StaticResource Font.Body}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Code.Parameter}"/>
                                                    <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource Text.Tertiary}" FontSize="{StaticResource Font.Caption}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Help}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                                                           Visibility="{Binding HasHelp, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- Code -->
                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    Visibility="{Binding HasCode, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <TextBlock infra:CodeView.Segments="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource Font.Caption}"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                    </ScrollViewer>
                                    <TextBlock Text="{l:T '… truncated – complete in the editor'}" FontSize="{StaticResource Font.Caption}" Margin="0,6,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding CodeTruncated, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Verlauf (Strg+H): alle Starts mit Ergebnis; erneut mit gleichen Werten -->
            <Border Grid.Row="2" Grid.RowSpan="4" Margin="10,0,10,10" Panel.ZIndex="28"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                    Visibility="{Binding ShowHistory, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T 'History'}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleHistoryCommand}"
                                ToolTip="{l:T 'Close (Esc)'}" AutomationProperties.Name="{l:T 'Close history'}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                        </ui:Button>
                        <TextBlock Text="{l:T 'History'}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6">
                        <TextBox Height="32" Padding="8,0" Tag="{l:T 'Search history (name, computer, parameters) …'}" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:T 'Search history'}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'All'}" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Today'}" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=today}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Error'}" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=errors}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Remote'}" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=remote}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="{l:T 'No matching runs yet.'}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Visibility="{Binding HistoryEmpty, Converter={StaticResource Vis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                            <ItemsControl ItemsSource="{Binding HistoryRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="HRow" CornerRadius="{DynamicResource Radius.Card}" Padding="8,6" Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="72" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <Ellipse x:Name="HDot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top" Fill="{DynamicResource Text.Tertiary}"/>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="6,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Meta}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ParametersText}" FontSize="{StaticResource Font.Caption}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Text.Tertiary}"
                                                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasParameters, Converter={StaticResource Vis}}"/>
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <ui:Button Style="{StaticResource Btn.Subtle}" Command="{Binding RunAgainCommand}" Padding="6,0" Height="24" MinHeight="24"
                                                                ToolTip="{l:T 'Run again with exactly the same values, computers and rights'}">
                                                            <TextBlock Text="{l:T '↻ Same values'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource Btn.Subtle}" Command="{Binding RetryFailedCommand}" Padding="6,0" Height="24" MinHeight="24"
                                                                Visibility="{Binding CanRetryFailed, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="{Binding RetryText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Accent}"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource Btn.Subtle}" Command="{Binding OpenLogCommand}" Padding="6,0" Height="24" MinHeight="24"
                                                                Visibility="{Binding HasLog, Converter={StaticResource Vis}}" ToolTip="{l:T 'Show log file in Explorer'}">
                                                            <TextBlock Text="{l:T 'Log'}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Accent}"/>
                                                        </ui:Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Status.Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Status.Error}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Accent}"/></DataTrigger>
                                            <Trigger SourceName="HRow" Property="IsMouseOver" Value="True"><Setter TargetName="HRow" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Übersicht der Tastenkürzel (F1 oder „?“) -->
            <Border Grid.Row="4" Grid.RowSpan="2" Margin="12,4,12,12" Panel.ZIndex="30" VerticalAlignment="Top"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                    Padding="14,10,6,12" Visibility="{Binding ShowShortcuts, Converter={StaticResource Vis}}"
                    AutomationProperties.Name="{l:T 'Hotkey'}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleShortcutsCommand}"
                                ToolTip="{l:T 'Close (Esc)'}" AutomationProperties.Name="{l:T 'Close'}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                        </ui:Button>
                        <TextBlock Text="{l:T 'Hotkey'}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,1" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1,1,1,2" BorderBrush="{DynamicResource Border.Control}"
                                            Background="{DynamicResource Bg.Input}" HorizontalAlignment="Left" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Keys}" FontSize="{StaticResource Font.Caption}" FontFamily="Cascadia Mono, Consolas"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Grid.IsSharedSizeScope="True"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Hinweis nach einer Änderung mit „Rückgängig“ (Strg+Z) -->
            <Border x:Name="UndoToast" Grid.Row="5" VerticalAlignment="Bottom" Margin="12,0,12,10" Panel.ZIndex="20"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                    Padding="12,6,4,6" Visibility="{Binding HasUndoToast, Converter={StaticResource Vis}}"
                    MouseEnter="UndoToast_MouseEnter" MouseLeave="UndoToast_MouseLeave"
                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding UndoToast}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding DismissUndoCommand}"
                            ToolTip="{l:T 'Close hint'}" AutomationProperties.Name="{l:T 'Close hint'}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                    </ui:Button>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="Auto" Height="28" Padding="10,0" Margin="8,0,2,0"
                            Command="{Binding UndoCommand}" ToolTip="{l:T 'Undo (Ctrl+Z)'}">
                        <TextBlock Text="{l:T 'Undo'}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    </ui:Button>
                    <TextBlock Text="{Binding UndoToast}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource Font.Body}" MaxHeight="40"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Raster: Details des ausgewählten Eintrags (Panel oder seine Gruppe als Raster) -->
            <Border Grid.Row="6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="16,10,12,4" MaxHeight="320">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- auch wenn nur die Gruppe des Eintrags auf „Raster“ steht -->
                            <DataTrigger Binding="{Binding ShowTileDetails}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <DockPanel Margin="0,0,0,6">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" ToolTip="{l:T 'Clear selection'}" Click="ClearSelection_Click">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                            </ui:Button>
                            <TextBlock infra:Highlight.Parts="{Binding NameParts}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock infra:Highlight.Parts="{Binding SynopsisParts}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemDetails}" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fußzeile -->
            <Border Grid.Row="7" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}">
                <StackPanel>
                <!-- Mehrfachauswahl: nacheinander starten oder als Ablauf speichern -->
                <Border Margin="10,8,8,0" Padding="10,6,4,6" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Bg.Chip}"
                        Visibility="{Binding HasMultiSelection, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding ClearCheckedCommand}"
                                ToolTip="{l:T 'Clear selection'}" AutomationProperties.Name="{l:T 'Clear selection'}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding RunCheckedCommand}" Height="26" MinHeight="26" Padding="10,0" FontSize="{StaticResource Font.Body}" Margin="6,0,4,0"
                                ToolTip="{l:T 'Start in the order of selection; each waits for the previous one, abort on error'}">
                            <TextBlock Text="{l:T '▶ One after another'}"/>
                        </ui:Button>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Command="{Binding SaveCheckedAsWorkflowCommand}" Height="26" MinHeight="26" Padding="6,0">
                            <TextBlock Text="{l:T 'Save as workflow'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Accent}"/>
                        </ui:Button>
                        <TextBlock Text="{Binding MultiSelectionText}" FontSize="{StaticResource Font.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <!-- Aktivitäten: laufende und gerade beendete Starts -->
                <StackPanel Margin="12,8,8,2" Visibility="{Binding HasActivities, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding ActivitiesHeader}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="4,0,0,4"
                               Typography.Capitals="AllSmallCaps"/>
                    <ItemsControl ItemsSource="{Binding Activities}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ActRow" CornerRadius="{DynamicResource Radius.Card}" Padding="4,4,2,4" Background="Transparent">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding CancelCommand}"
                                                ToolTip="{l:T 'Cancel'}" AutomationProperties.Name="{l:T 'Cancel'}" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                                        </ui:Button>
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding DismissCommand}"
                                                ToolTip="{l:T 'Remove from list'}" AutomationProperties.Name="{l:T 'Remove'}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XS}" Foreground="{DynamicResource Text.Tertiary}"/>
                                        </ui:Button>
                                        <!-- Nach dem Ende: denselben Start wiederholen (gleiche Werte und gleiches Profil) -->
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="Auto" Height="26" Padding="6,0" Command="{Binding RestartCommand}"
                                                Visibility="{Binding CanRestart, Converter={StaticResource Vis}}" ToolTip="{l:T 'Run again with the same values'}"
                                                AutomationProperties.Name="{l:T 'Run again'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Foreground="{DynamicResource Accent}" Margin="0,0,5,0"/>
                                                <TextBlock Text="{l:T 'Run again'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="Auto" Height="26" Padding="8,0" Command="{Binding OpenCommand}"
                                                Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" ToolTip="{l:T 'Open result list'}">
                                            <TextBlock Text="{l:T 'Output'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        </ui:Button>
                                        <Grid Width="22" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="ActGlyph" Text="{Binding StatusGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Height="3" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                                         Visibility="{Binding HasProgress, Converter={StaticResource Vis}}"
                                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource Bg.Chip}" BorderThickness="0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter TargetName="ActGlyph" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="ActGlyph" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="ActGlyph" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                    </DataTrigger>
                                    <Trigger SourceName="ActRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ActRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <DockPanel Margin="16,4,8,4">
                    <ui:Button Style="{StaticResource Btn.Icon}" DockPanel.Dock="Right" Command="{Binding RescanCommand}" ToolTip="{l:T 'Rescan folders'}">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}"/>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Btn.Icon}" DockPanel.Dock="Right" Command="{Binding NewGroupCommand}" ToolTip="{l:T 'New group'}">
                        <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}"/>
                    </ui:Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"
                               Margin="8,0,4,0" ToolTip="{l:T 'Running UI and version; in parentheses the version installed by the installer'}"/>
                    <TextBlock Text="{Binding Footer}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </c:PanelRoot>
</Window>
