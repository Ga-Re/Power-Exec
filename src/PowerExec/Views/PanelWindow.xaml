<Window x:Class="PowerExec.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        xmlns:infra="clr-namespace:PowerExec.Infrastructure"
        Title="Power-Exec"
        Style="{StaticResource AppWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="400" Height="700">
    <Window.Resources>
        <!-- Gruppenkopf: ohne eigene Hover-Fläche (hervorgehoben wird der Rahmen der Gruppe) -->
        <Style x:Key="GroupHeaderButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Punkt in der Gruppenfarbe (ohne Farbe: neutral) -->
        <Style x:Key="GroupDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Text.Tertiary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasColor}" Value="True">
                    <Setter Property="Fill" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Menü einer Gruppe (Ordner/Favoriten) -->
        <!-- Ein Menü je Fenster für alle Gruppen: erst beim Öffnen an die Gruppe gebunden (früher je Gruppe zweimal erzeugt) -->
        <ContextMenu x:Key="GroupMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Neue Untergruppe …" Command="{Binding NewSubgroupCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Neuer Eintrag" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem Header="Neuer Eintrag …" Command="{Binding NewEntryCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Webseite …" Command="{Binding NewEntryCommand}" CommandParameter="Url">
                    <MenuItem.Icon><TextBlock Text="&#xE774;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ordner …" Command="{Binding NewEntryCommand}" CommandParameter="Folder">
                    <MenuItem.Icon><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remotedesktop …" Command="{Binding NewEntryCommand}" CommandParameter="Rdp">
                    <MenuItem.Icon><TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="SSH-Verbindung …" Command="{Binding NewEntryCommand}" CommandParameter="Ssh">
                    <MenuItem.Icon><TextBlock Text="&#xE756;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="PowerShell-Snippet …" Command="{Binding NewEntryCommand}" CommandParameter="Snippet">
                    <MenuItem.Icon><TextBlock Text="&#xE943;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Text-Snippet …" Command="{Binding NewEntryCommand}" CommandParameter="TextSnippet">
                    <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Windows-Werkzeug …" Command="{Binding NewEntryCommand}" CommandParameter="Tool">
                    <MenuItem.Icon><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Befehl …" Command="{Binding NewEntryCommand}" CommandParameter="Command">
                    <MenuItem.Icon><TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Dateien auswählen …" Command="{Binding AddFilesCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Aus Vorlagen …" Command="{Binding AddFromCatalogCommand}">
                    <MenuItem.Icon><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Aus Zwischenablage einfügen" Command="{Binding AddFromClipboardCommand}" InputGestureText="Strg+V">
                    <MenuItem.Icon><TextBlock Text="&#xE77F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Darstellung" Visibility="{Binding CanChangeLayout, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem Header="Wie das Panel" Command="{Binding SetLayoutCommand}" CommandParameter="panel" IsCheckable="False"
                          IsChecked="{Binding LayoutSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=panel}"/>
                <MenuItem Header="Liste" Command="{Binding SetLayoutCommand}" CommandParameter="List"
                          IsChecked="{Binding LayoutSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=List}"/>
                <MenuItem Header="Raster" Command="{Binding SetLayoutCommand}" CommandParameter="Grid"
                          IsChecked="{Binding LayoutSetting, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Grid}"/>
            </MenuItem>
            <MenuItem Header="Farbe" Visibility="{Binding CanChangeLayout, Converter={StaticResource Vis}}" ItemsSource="{Binding ColorChoices}">
                <MenuItem.Icon><TextBlock Text="&#xE790;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding Hex}"/>
                        <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                        <!-- Farbpunkt im Kopf statt als Icon: ein Icon-Element im Stil würde von allen Einträgen geteilt (nur der letzte zeigte seine Farbe) -->
                        <Setter Property="Header" Value="{Binding}"/>
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="14" Height="14" Fill="{Binding SwatchColor, Converter={StaticResource ArgbBrush}}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Stroke="{DynamicResource Border.Control}" StrokeThickness="1"/>
                                        <TextBlock x:Name="ActionIcon" Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="14" Margin="0,0,10,0" FontSize="13"
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ActionIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Trennlinie zwischen den Farben und den Aktionen „Eigene Farbe …“ / „Farbe entfernen“ -->
                            <DataTrigger Binding="{Binding IsFirstAction}" Value="True">
                                <Setter Property="Tag" Value="Separator"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Umbenennen …" Command="{Binding RenameCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Gruppe exportieren …" Command="{Binding ExportCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}"
                      ToolTip="Eigene Einträge dieser Gruppe als Datei – z. B. für Kollegen">
                <MenuItem.Icon><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Einträge importieren …" Command="{Binding ImportCommand}" Visibility="{Binding IsUserGroupOrCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Gruppe löschen …" Command="{Binding DeleteCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Im Explorer öffnen" Command="{Binding OpenInExplorerCommand}" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Neu einlesen" Command="{Binding RescanCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Andere einklappen" Command="{Binding CollapseOthersCommand}"/>
            <MenuItem Header="Alle einklappen" Command="{Binding CollapseAllCommand}"/>
            <MenuItem Header="Alle ausklappen" Command="{Binding ExpandAllCommand}"/>
            <MenuItem Header="Reihenfolge zurücksetzen (alphabetisch)" Command="{Binding ResetOrderCommand}"
                      Visibility="{Binding AllowReorder, Converter={StaticResource Vis}}"/>
            <Separator Visibility="{Binding IsFolder, Converter={StaticResource Vis}}"/>
            <MenuItem Header="In diesem Arbeitsbereich ausblenden" Command="{Binding HideFolderCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}"
                      ToolTip="Wieder einblenden: Einstellungen › Arbeitsbereiche">
                <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Gruppe konfigurieren …" Command="{Binding FolderSettingsCommand}" Visibility="{Binding IsUserGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Menü eines Eintrags -->
        <!-- Ein Menü je Fenster für alle Einträge: erst beim Öffnen an den Eintrag gebunden (früher je Zeile 43 MenuItems beim Erzeugen) -->
        <ContextMenu x:Key="ItemMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding RunHeader}" Command="{Binding RunCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="In die Zwischenablage kopieren" Command="{Binding CopySnippetCommand}" Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Als Administrator" Command="{Binding RunAdminCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Als anderer Benutzer …" Command="{Binding RunAsUserCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE77B;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remote …" Command="{Binding RunRemoteCommand}" Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Profile verwalten …" Command="{Binding ManageProfilesCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Planen …" Command="{Binding ScheduleCommand}" ToolTip="Einmal, täglich oder im Intervall starten">
                <MenuItem.Icon><TextBlock Text="&#xE823;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Im Editor öffnen" Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Speicherort öffnen" Command="{Binding OpenLocationCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pfad kopieren" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Zu Favoriten hinzufügen" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <MenuItem.Icon><TextBlock Text="&#xE734;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Aus Favoriten entfernen" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE735;" Style="{StaticResource Icon}" Foreground="{DynamicResource Star}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="In Gruppe verschieben" ItemsSource="{Binding GroupChoices}" Visibility="{Binding HasGroupChoices, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="In neue Gruppe …" Command="{Binding NewGroupWithItemCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Aus Gruppe nehmen" Command="{Binding RemoveFromGroupCommand}" Visibility="{Binding IsInGroup, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8E6;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Bearbeiten …" Command="{Binding EditCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplizieren …" Command="{Binding DuplicateCommand}" Visibility="{Binding CanDuplicate, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding SingleClickHeader}" Command="{Binding ToggleSingleClickCommand}" Visibility="{Binding CanToggleSingleClick, Converter={StaticResource Vis}}"
                      ToolTip="Ein Klick im Panel startet sofort (Details dann über dieses Menü)">
                <MenuItem.Icon><TextBlock Text="&#xE8B0;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Details anzeigen" Command="{Binding OpenDetailsCommand}" Visibility="{Binding IsSingleClick, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Entfernen …" Command="{Binding RemoveCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ausblenden" Command="{Binding HideCommand}" ToolTip="Wird als Ausschluss beim Ordner gespeichert"
                      Visibility="{Binding CanHide, Converter={StaticResource Vis}}">
                <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Icon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Typ-Kürzel -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Badge.Other.Bg}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Other.Fg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="PowerShell">
                    <Setter Property="Background" Value="{DynamicResource Badge.PowerShell.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.PowerShell.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Batch">
                    <Setter Property="Background" Value="{DynamicResource Badge.Batch.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Batch.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Executable">
                    <Setter Property="Background" Value="{DynamicResource Badge.Executable.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Executable.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="ConsoleSnapIn">
                    <Setter Property="Background" Value="{DynamicResource Badge.ConsoleSnapIn.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.ConsoleSnapIn.Fg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Shortcut">
                    <Setter Property="Background" Value="{DynamicResource Badge.Shortcut.Bg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.Shortcut.Fg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Zeile ohne eigenen Rahmen; Hover/Auswahl macht der umgebende Border -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn.Standard}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Details eines ausgewählten Eintrags (in der Liste aufgeklappt, im Raster unten im Panel) -->
        <DataTemplate x:Key="ItemDetails">
            <StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding HasDescription, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasMeta, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False" Margin="0,0,0,6"
                                  Visibility="{Binding HasTags, Converter={StaticResource Vis}}"/>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{DynamicResource Status.Error}"/>
                        <TextBlock Text="{Binding HealthText}" FontSize="12" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Border Background="{DynamicResource Bg.Chip}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="11" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="Req" Text="{Binding RequirementsText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding RequirementsText, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding ParseError}" FontSize="12" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasParseError, Converter={StaticResource Vis}}"/>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Entsperren" Command="{Binding UnblockCommand}"
                                Height="26" MinHeight="26" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding BlockedText}" FontSize="12" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock x:Name="Sig" Text="{Binding SignatureText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,8"
                               Visibility="{Binding SignatureText, Converter={StaticResource Vis}}"/>
                    <!-- Parameter direkt im Panel; „Speichern als …“ legt ein Parameter-Set (Startprofil) an -->
                    <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            Visibility="{Binding HasInlineForm, Converter={StaticResource Vis}}">
                        <StackPanel DataContext="{Binding Inline}">
                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,2"
                                                       Visibility="{Binding IsSwitch, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                            <TextBox x:Name="Field" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,0" FontSize="12"
                                                     Tag="{Binding Placeholder}" ToolTip="{Binding Help}" Visibility="{Binding IsText, Converter={StaticResource Vis}}"
                                                     AutomationProperties.Name="{Binding Name}"/>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}" Height="28" FontSize="12"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Name}"/>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" FontSize="12" ToolTip="{Binding Help}"
                                                      Visibility="{Binding IsSwitch, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="fragt das Script beim Start selbst (wird nie gespeichert)" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"
                                                       Visibility="{Binding IsSecure, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Error}" FontSize="11.5" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Accent}" Command="{Binding RunCommand}" Height="28" MinHeight="28" Padding="10,0" FontSize="12"
                                        ToolTip="Mit diesen Werten starten (Rechte und Ziel aus dem Standardprofil)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="Mit diesen Werten"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Subtle}" Command="{Binding SaveSetCommand}" Height="28" MinHeight="28" Padding="8,0" Margin="6,0,0,0"
                                        ToolTip="Als Parameter-Set speichern – erscheint als Startprofil am Ausführen-Knopf">
                                    <TextBlock Text="Speichern als …" FontSize="12" Foreground="{DynamicResource Accent}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                            <!-- Ein Profil: normaler Button -->
                            <Button Style="{StaticResource Btn.Accent}" Command="{Binding RunCommand}" Height="30" MinHeight="30" Padding="12,0" FontSize="12"
                                    ToolTip="{Binding RunToolTip}" Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RunLabel}"/>
                                </StackPanel>
                            </Button>
                            <!-- Mehrere Profile: Split-Button (links Standardprofil, rechts Auswahl) -->
                            <Button Style="{StaticResource Btn.SplitLeft}" Command="{Binding RunCommand}" Height="30" MinHeight="30" Padding="12,0" FontSize="12"
                                    ToolTip="{Binding RunToolTip}" Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RunLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.SplitRight}" Height="30" MinHeight="30" Width="30" Padding="0"
                                    Click="ProfileMenuButton_Click" ToolTip="Anderes Startprofil ausführen"
                                    AutomationProperties.Name="Startprofil wählen"
                                    Visibility="{Binding HasProfileMenu, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10"/>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding RunAdminCommand}" ToolTip="Als Administrator ausführen (UAC)"
                                Visibility="{Binding CanElevate, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Admin"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding RunAsUserCommand}" ToolTip="Als anderer Benutzer ausführen"
                                Visibility="{Binding CanElevate, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Als …"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding RunRemoteCommand}" ToolTip="Auf einem oder mehreren Remote-Rechnern ausführen"
                                Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Remote"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Width="30" Padding="0" ToolTip="Weitere Aktionen"
                                ContextMenu="{StaticResource ItemMenu}" Click="MenuButton_Click">
                            <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                    </WrapPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SignatureValid}" Value="True">
                    <Setter TargetName="Sig" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RequirementsWarn}" Value="True">
                    <Setter TargetName="Req" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kachel für die Rasteransicht (kompakt: kleiner, eine Zeile) -->
        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Row" CornerRadius="6" Background="Transparent" Margin="1" Width="74" BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                    AllowDrop="True" PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                    DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <Button Style="{StaticResource RowButton}" Command="{Binding SelectCommand}" ToolTip="{Binding ToolTipText}" MouseDoubleClick="Row_DoubleClick"
                        ContextMenu="{StaticResource ItemMenu}" ToolTipService.InitialShowDelay="700">
                    <Grid x:Name="TileGrid" Margin="3,6,3,4" Height="62">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="IconRow" Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TileIcon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Width="34" Height="22" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="TileImage" Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                            <c:IconPresenter x:Name="TileCustom" Icon="{Binding CustomIcon}" Size="26" Foreground="{DynamicResource Text.Primary}"
                                             Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Status.Error}" Margin="0,0,2,0"
                                       Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}" ToolTip="{Binding HealthText}"/>
                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Star}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <TextBlock x:Name="TileName" Grid.Row="1" infra:Highlight.Parts="{Binding NameParts}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,3,0,0" VerticalAlignment="Top"/>
                    </Grid>
                </Button>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                </Trigger>
                <!-- Mehrfachauswahl (Strg+Klick) -->
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Search.Highlight}"/>
                    <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Row" Property="Width" Value="60"/>
                    <Setter TargetName="TileGrid" Property="Height" Value="46"/>
                    <Setter TargetName="TileGrid" Property="Margin" Value="2,4,2,2"/>
                    <Setter TargetName="IconRow" Property="Height" Value="24"/>
                    <Setter TargetName="TileImage" Property="Width" Value="20"/>
                    <Setter TargetName="TileImage" Property="Height" Value="20"/>
                    <Setter TargetName="TileCustom" Property="Size" Value="20"/>
                    <Setter TargetName="TileIcon" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Setter.Value>
                    </Setter>
                    <Setter TargetName="TileName" Property="TextWrapping" Value="NoWrap"/>
                    <Setter TargetName="TileName" Property="FontSize" Value="10.5"/>
                    <Setter TargetName="TileName" Property="Margin" Value="0,2,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsLarge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Row" Property="Width" Value="96"/>
                    <Setter TargetName="TileGrid" Property="Height" Value="84"/>
                    <Setter TargetName="IconRow" Property="Height" Value="40"/>
                    <Setter TargetName="TileImage" Property="Width" Value="34"/>
                    <Setter TargetName="TileImage" Property="Height" Value="34"/>
                    <Setter TargetName="TileCustom" Property="Size" Value="34"/>
                    <Setter TargetName="TileIcon" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value>
                    </Setter>
                    <Setter TargetName="TileName" Property="FontSize" Value="12.5"/>
                    <Setter TargetName="TileName" Property="MaxHeight" Value="34"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate">
            <Border x:Name="Row" CornerRadius="6" Background="Transparent" Margin="0,1" BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                    AllowDrop="True" PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                    DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Command="{Binding SelectCommand}" ToolTip="{Binding ToolTipText}" MouseDoubleClick="Row_DoubleClick"
                            ContextMenu="{StaticResource ItemMenu}" ToolTipService.InitialShowDelay="900">
                        <Grid x:Name="RowGrid" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Läuft gerade (lokaler Start in der Aktivitäten-Leiste) -->
                                <Border Margin="6,0,0,0" Padding="6,1,7,1" CornerRadius="8" Background="{DynamicResource Bg.Selected}" VerticalAlignment="Center"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" ToolTip="Läuft gerade – Details unten in den Aktivitäten">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="RunDot" Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="läuft" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Zuletzt ausgeführt: wann -->
                                <TextBlock Text="{Binding RecentWhen}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding HasRecentWhen, Converter={StaticResource Vis}}"/>
                                <!-- Schnellstart-Taste (Favoriten) -->
                                <Border VerticalAlignment="Center" Margin="6,0,0,0" Padding="5,1" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource Border.Control}" Visibility="{Binding HasQuickKey, Converter={StaticResource Vis}}"
                                        ToolTip="Schnellstart mit dieser Taste – auch ohne den Eintrag auszuwählen">
                                    <TextBlock Text="{Binding QuickKeyText}" FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}"/>
                                </Border>
                            </StackPanel>
                            <Grid x:Name="BadgeBox" Width="36" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Border Style="{StaticResource Badge}" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,-1,0,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding BadgeText}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                <c:IconPresenter Icon="{Binding CustomIcon}" Size="24" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"
                                                 Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="NameText" infra:Highlight.Parts="{Binding NameParts}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                    <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Star}"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}" ToolTip="Favorit"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="10.5" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding IsFromCatalog, Converter={StaticResource Vis}}" ToolTip="{Binding CatalogToolTip}"/>
                                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="8" Background="{DynamicResource Bg.Chip}" VerticalAlignment="Center"
                                            Visibility="{Binding HasSchedule, Converter={StaticResource Vis}}" ToolTip="{Binding ScheduleToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ScheduleText}" FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding HasParseError, Converter={StaticResource Vis}}" ToolTip="{Binding ParseError}"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}" ToolTip="{Binding BlockedText}"/>
                                    <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource Vis}}" ToolTip="Benötigt Administratorrechte (#Requires)"/>
                                    <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" ToolTip="{Binding Notes}"/>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource Status.Error}"
                                               Visibility="{Binding HasHealthProblem, Converter={StaticResource Vis}}" ToolTip="{Binding HealthText}"/>
                                </DockPanel>
                                <TextBlock x:Name="Syn" infra:Highlight.Parts="{Binding SynopsisParts}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemDetails}" Focusable="False" Margin="54,0,8,4"
                                    Visibility="{Binding IsSelected, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                </Trigger>
                <!-- „läuft“: Punkt pulsiert -->
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RunPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="RunDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RunPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Mehrfachauswahl (Strg+Klick) -->
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Search.Highlight}"/>
                    <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Syn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="RowGrid" Property="Margin" Value="8,4"/>
                    <Setter TargetName="NameText" Property="FontSize" Value="13"/>
                    <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="NameText" Property="MaxWidth" Value="320"/>
                    <Setter TargetName="BadgeBox" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.82" ScaleY="0.82"/></Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsLarge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="RowGrid" Property="Margin" Value="10,10"/>
                    <Setter TargetName="NameText" Property="FontSize" Value="15.5"/>
                    <Setter TargetName="NameText" Property="MaxWidth" Value="420"/>
                    <Setter TargetName="Syn" Property="FontSize" Value="13"/>
                    <Setter TargetName="BadgeBox" Property="LayoutTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.25" ScaleY="1.25"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                    <Setter TargetName="Syn" Property="TextWrapping" Value="Wrap"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Gruppe (Ordner, Favoriten, eigene Gruppe mit Untergruppen) -->
        <DataTemplate x:Key="GroupTemplate">
            <!-- Gruppen ziehen: Lücke davor/dahinter; die gezogene Gruppe macht an ihrer alten Stelle Platz -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <c:DropGap IsOpen="{Binding GapBefore}" Label="{Binding DataContext.DragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.DragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="DropGap_DragOver" Drop="DropGap_Drop"/>
                <Border x:Name="GroupBox" CornerRadius="6" BorderThickness="1" Margin="0,2,0,0"
                        AllowDrop="True" DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop">
                <!-- Farbe der Gruppe als getönte Karte (über den Stil, damit die Drag-Hervorhebung zurückgesetzt werden kann) -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding CardBackgroundColor, Converter={StaticResource ArgbBrush}}"/>
                        <Setter Property="BorderBrush" Value="{Binding CardBorderColor, Converter={StaticResource ArgbBrush}}"/>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border x:Name="GroupHeader" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="0" Background="Transparent" AllowDrop="True"
                            PreviewMouseLeftButtonDown="GroupHeader_PreviewMouseLeftButtonDown" PreviewMouseMove="GroupHeader_PreviewMouseMove"
                            DragOver="GroupHeader_DragOver" DragLeave="GroupHeader_DragLeave" Drop="GroupHeader_Drop">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GroupHeaderButton}" Command="{Binding ToggleCommand}" HorizontalContentAlignment="Stretch"
                                Padding="8,0" Height="32" ContextMenu="{StaticResource GroupMenu}" Foreground="{DynamicResource Text.Secondary}"
                                ToolTip="Klick: ein-/ausklappen · Rechtsklick: Menü" ToolTipService.InitialShowDelay="1200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Grid Grid.Column="1" Margin="8,0">
                                    <c:IconPresenter Icon="{Binding CustomIcon}" Size="16" Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}">
                                        <c:IconPresenter.Style>
                                            <Style TargetType="c:IconPresenter">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:IconPresenter.Style>
                                    </c:IconPresenter>
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Star}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- Knöpfe erst beim Darüberfahren: wachsen von 0 auf volle Breite und blenden ein, die Zahl gleitet dabei nach links -->
                        <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                            <StackPanel.LayoutTransform><ScaleTransform ScaleX="0"/></StackPanel.LayoutTransform>
                            <!-- Liste/Raster nur für diese Gruppe -->
                            <Button x:Name="LayoutToggle" Style="{StaticResource Btn.Icon}" Width="28" Height="32" ToolTip="{Binding LayoutToolTip}"
                                    Command="{Binding ToggleLayoutCommand}">
                                <TextBlock Text="{Binding LayoutGlyph}" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                            <!-- Menü erst beim Darüberfahren (wie Liste/Raster) – ruhigerer Gruppenkopf -->
                            <Button x:Name="GroupMenuButton" Style="{StaticResource Btn.Icon}" Width="32" Height="32" ToolTip="Menü"
                                    ContextMenu="{StaticResource GroupMenu}" Click="MenuButton_Click">
                                <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Border>
                    <TextBlock Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Vis}}" FontSize="12"
                               Foreground="{DynamicResource Status.Warning}" Margin="38,0,8,6" TextWrapping="Wrap"/>
                    <!-- Inhalt klappt beim Klick auf den Kopf weich auf und zu -->
                    <c:CollapsePanel Animate="{Binding AnimateExpand}" IsExpanded="{Binding IsExpanded}"
                                     AnimateResize="{Binding AnimateResize}" TransitionKey="{Binding IsGrid}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGrid}" Value="True">
                                            <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}"/>
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate><WrapPanel Margin="4,0,0,0"/></ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <!-- Option „Inhalte beim Ziehen zuklappen“: nur Gruppenköpfe -->
                                        <DataTrigger Binding="{Binding DataContext.GroupDragCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        <!-- Untergruppen -->
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource GroupTemplate}" Focusable="False" Margin="14,0,0,0"/>
                    </StackPanel>
                    </c:CollapsePanel>
                    <!-- Lücke für „als letzte Untergruppe“ (auch bei eingeklappter Gruppe sichtbar) -->
                    <c:DropGap IsOpen="{Binding GapInside}" Margin="14,0,4,0" Label="{Binding DataContext.DragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.DragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="DropGap_DragOver" Drop="DropGap_Drop"/>
                    <Border Margin="8,0,8,8" Padding="10,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}"
                            Visibility="{Binding ShowDropHint, Converter={StaticResource Vis}}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.Tertiary}"
                                   Text="Einträge hierher ziehen – auch Dateien, Ordner oder Links aus dem Explorer und Browser. Rechtsklick: neuer Eintrag."/>
                    </Border>
                </StackPanel>
                </Border>
                <c:DropGap IsOpen="{Binding GapAfter}" Label="{Binding DataContext.DragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.DragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="DropGap_DragOver" Drop="DropGap_Drop"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition SourceName="GroupHeader" Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.04" Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiTrigger.EnterActions>
                    <MultiTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleX)"
                                                 To="0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HeaderTools" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiTrigger.ExitActions>
                    <!-- Hover über dem Gruppenkopf: Rahmen der Gruppe hervorheben (statt grauer Fläche) -->
                    <Setter TargetName="GroupBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </MultiTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=GroupHeader}" Value="True"/>
                        <Condition Binding="{Binding HasColor}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GroupBox" Property="BorderBrush" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding CanChangeLayout}" Value="False">
                    <Setter TargetName="LayoutToggle" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- Gruppe wird hineingezogen: Rahmen der Zielgruppe hervorheben -->
                <DataTrigger Binding="{Binding GapInside}" Value="True">
                    <Setter TargetName="GroupBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="GroupBox" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="PanelBorder" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Panel}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True"
            AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Milchglas: Schleier über dem Weichzeichner (Farbe setzt ApplyAppearance) -->
            <Border x:Name="FrostLayer" Grid.RowSpan="8" IsHitTestVisible="False" Panel.ZIndex="-1"/>

            <!-- Kopfzeile: Titel und Arbeitsbereich schrumpfen, die Knöpfe bleiben immer sichtbar -->
            <Grid Margin="14,10,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition MaxWidth="130">
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspaces}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Accent}">
                    <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccent}" FontSize="14"/>
                </Border>
                <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Power-Exec"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiPanel}" Value="True">
                                    <Setter Property="Text" Value="{Binding PanelName}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Column="2" x:Name="WorkspaceBox" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" MinHeight="28" Height="28"
                          ItemsSource="{Binding Workspaces}" SelectedItem="{Binding ActiveWorkspace, Mode=OneWay}" SelectionChanged="Workspace_SelectionChanged"
                          ToolTip="Arbeitsbereich wechseln" Visibility="{Binding HasWorkspaces, Converter={StaticResource Vis}}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Command="{Binding ToggleGridCommand}" ToolTip="{Binding LayoutToolTip}">
                        <TextBlock Text="{Binding LayoutGlyph}" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Click="MenuButton_Click" ToolTip="Elementgröße: Klein, Mittel, Groß">
                        <TextBlock Text="&#xE8E9;" Style="{StaticResource Icon}" FontSize="15"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Klein" Command="{Binding SetItemSizeCommand}" CommandParameter="Small">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding ItemSize, Converter={StaticResource EqVis}, ConverterParameter=Small}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Mittel" Command="{Binding SetItemSizeCommand}" CommandParameter="Medium">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding ItemSize, Converter={StaticResource EqVis}, ConverterParameter=Medium}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Groß" Command="{Binding SetItemSizeCommand}" CommandParameter="Large">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding ItemSize, Converter={StaticResource EqVis}, ConverterParameter=Large}"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Width="32" IsChecked="{Binding ShowHistory}" ToolTip="Verlauf (Strg+H)"
                                  AutomationProperties.Name="Verlauf">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Icon}" Width="32" IsChecked="{Binding IsPinned}" ToolTip="Anheften: Panel bleibt offen">
                        <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" FontSize="15"/>
                    </ToggleButton>
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Command="{Binding SettingsCommand}" ToolTip="Einstellungen">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Update-Hinweis -->
            <StackPanel Grid.Row="1">
            <!-- Team-Katalog: Änderungen zum Übernehmen -->
            <Border Margin="16,0,16,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                    BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding CatalogPending, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="Übernehmen" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                            Command="{Binding ApplyCatalogsCommand}" MinHeight="26" Height="26" Padding="8,0"/>
                    <TextBlock Text="{Binding CatalogPending}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Info.Text}"/>
                </DockPanel>
            </Border>
            <!-- Neu in dieser Version -->
            <Border Margin="16,0,16,10" Padding="12,10,6,10" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                    BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding WhatsNewVisible, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" VerticalAlignment="Top" Command="{Binding DismissWhatsNewCommand}"
                            ToolTip="Gelesen – nicht mehr anzeigen" AutomationProperties.Name="Neuerungen schließen">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                    <TextBlock Text="&#xE789;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding WhatsNewTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding WhatsNewItems}" Focusable="False" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Info.Text}" Margin="0,1,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Btn.Subtle}" Content="Alle Neuerungen" Command="{Binding ShowAllWhatsNewCommand}" HorizontalAlignment="Left"
                                Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Padding="0" Margin="0,6,0,0" MinHeight="22" Height="22"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Margin="16,0,16,10" Padding="12,10" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                    BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding UpdateVisible, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpdateSubtitle}" FontSize="12" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Btn.Accent}" Content="Jetzt aktualisieren" Command="{Binding UpdateNowCommand}" Height="28" MinHeight="28" FontSize="12"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="Später" Command="{Binding UpdateLaterCommand}" Height="28" MinHeight="28" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Margin="16,0,16,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                    BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding PendingText, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="Prüfen" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                            Command="{Binding ReviewPendingCommand}" MinHeight="26" Height="26" Padding="8,0"/>
                    <TextBlock Text="{Binding PendingText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            </StackPanel>

            <!-- Suche -->
            <Grid Grid.Row="2" Margin="16,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="38"
                         Padding="30,0,8,0" Tag="Suchen …" PreviewKeyDown="SearchBox_PreviewKeyDown" PreviewTextInput="SearchBox_PreviewTextInput"
                         TextChanged="SearchBox_TextChanged" SelectionChanged="SearchBox_SelectionChanged" LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                         PreviewMouseLeftButtonUp="SearchBox_PreviewMouseUp"
                         ToolTip="{Binding SearchHelp}" ToolTipService.InitialShowDelay="1500"
                         AutomationProperties.Name="Suchen" AutomationProperties.HelpText="{Binding SearchHelp}">
                    <TextBox.Resources><CornerRadius x:Key="TextBox.CornerRadius">12</CornerRadius></TextBox.Resources>
                </TextBox>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <Border HorizontalAlignment="Right" Margin="0,0,8,0" Padding="6,1" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Border.Control}"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSearching}" Value="False"/>
                                        <Condition Binding="{Binding HasHotkey}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding HotkeyHint}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                </Border>
                <!-- Vorschläge beim Tippen: #schlagwort, typ:, gruppe:, ist: (nur, was es gibt; mit Anzahl) -->
                <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True"
                       IsOpen="{Binding HasSuggestions, Mode=OneWay}" VerticalOffset="4" Width="{Binding ActualWidth, ElementName=SearchBox}">
                    <Border Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                        <StackPanel>
                            <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedIndex="{Binding SuggestionIndex}" Background="Transparent" BorderThickness="0"
                                     MaxHeight="260" Focusable="False" PreviewMouseLeftButtonUp="SuggestionList_MouseUp" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock x:Name="Count" DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource Text.Tertiary}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Width="18" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <!-- Filterart (Schlagwort, Typ …): Symbol, normale Schrift, Pfeil – die Auswahl zeigt danach die Werte -->
                                            <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Count" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Label" Property="FontFamily" Value="{StaticResource AppFont}"/>
                                                <Setter TargetName="Label" Property="FontSize" Value="13"/>
                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}" Margin="8,4,8,2" Text="Enter oder Tab übernimmt · ↑ ↓ wählen · Esc schließt"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="Suche leeren"
                        Command="{Binding ClearSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                </Button>
            </Grid>

            <!-- Aktive Filter (aus dem Suchfeld bzw. voreingestellt); gewählt werden sie über die Vorschläge beim Klick ins Suchfeld -->
            <StackPanel Grid.Row="3" Margin="16,8,16,2">
            <!-- Erkannte Filter aus dem Suchfeld (typ:, gruppe:, ist:, #schlagwort); ✕ entfernt sie -->
            <ItemsControl ItemsSource="{Binding SearchChips}" Margin="0,0,0,2" Focusable="False"
                          Visibility="{Binding HasSearchChips, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ChipBd" CornerRadius="12" Height="24" Padding="10,0,2,0" Margin="0,0,6,4" Background="{DynamicResource Bg.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource Accent}" ToolTip="{Binding ToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChipText" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                <Button Style="{StaticResource Btn.Icon}" Width="20" Height="20" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                        ToolTip="Filter entfernen" AutomationProperties.Name="Filter entfernen">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource Warn.Bg}"/>
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="{DynamicResource Warn.Border}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- Warnung: Ordner nicht erreichbar -->
            <Border Grid.Row="4" Margin="16,4,16,2" Padding="10,6" CornerRadius="6" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}"
                    BorderThickness="1" Visibility="{Binding FolderWarning, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Status.Warning}"/>
                    <TextBlock Text="{Binding FolderWarning}" FontSize="12" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Liste -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="5" VerticalScrollBarVisibility="{Binding ShowListScrollBar, Mode=OneWay, Converter={StaticResource ScrollBarAuto}}" HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent" ScrollChanged="ListScroll_ScrollChanged">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Padding" Value="8,0,8,8"/>
                        <Style.Triggers>
                            <!-- Platz für die Sprungleiste -->
                            <DataTrigger Binding="{Binding ShowJumpRail}" Value="True">
                                <Setter Property="Padding" Value="8,0,20,8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Neue Gruppe …" Command="{Binding NewGroupCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Neuer Eintrag">
                            <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                            <MenuItem Header="Neuer Eintrag …" Command="{Binding NewEntryCommand}"/>
                            <Separator/>
                            <MenuItem Header="Webseite …" Command="{Binding NewEntryCommand}" CommandParameter="Url"/>
                            <MenuItem Header="Ordner …" Command="{Binding NewEntryCommand}" CommandParameter="Folder"/>
                            <MenuItem Header="Remotedesktop …" Command="{Binding NewEntryCommand}" CommandParameter="Rdp"/>
                            <MenuItem Header="SSH-Verbindung …" Command="{Binding NewEntryCommand}" CommandParameter="Ssh"/>
                            <MenuItem Header="PowerShell-Snippet …" Command="{Binding NewEntryCommand}" CommandParameter="Snippet"/>
                            <MenuItem Header="Text-Snippet …" Command="{Binding NewEntryCommand}" CommandParameter="TextSnippet"/>
                            <MenuItem Header="Windows-Werkzeug …" Command="{Binding NewEntryCommand}" CommandParameter="Tool"/>
                            <MenuItem Header="Befehl …" Command="{Binding NewEntryCommand}" CommandParameter="Command"/>
                            <MenuItem Header="Dateien auswählen …" Command="{Binding AddFilesCommand}"/>
                            <Separator/>
                            <MenuItem Header="Aus Vorlagen …" Command="{Binding AddFromCatalogCommand}"/>
                            <MenuItem Header="Aus Zwischenablage einfügen" Command="{Binding AddFromClipboardCommand}" InputGestureText="Strg+V"/>
                        </MenuItem>
                        <MenuItem Header="Einträge importieren …" Command="{Binding ImportEntriesCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Raster" Command="{Binding ToggleGridCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Visibility="{Binding IsGrid, Converter={StaticResource Vis}}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Elementgröße">
                            <MenuItem.Icon><TextBlock Text="&#xE8E9;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                            <MenuItem Header="Klein" Command="{Binding SetItemSizeCommand}" CommandParameter="Small"/>
                            <MenuItem Header="Mittel" Command="{Binding SetItemSizeCommand}" CommandParameter="Medium"/>
                            <MenuItem Header="Groß" Command="{Binding SetItemSizeCommand}" CommandParameter="Large"/>
                        </MenuItem>
                        <MenuItem Header="Einstellungen …" Command="{Binding SettingsCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel>
                    <StackPanel Visibility="{Binding HasNoFolders, Converter={StaticResource Vis}}" Margin="16,32,16,0">
                        <TextBlock Text="Noch keine Gruppe mit Ordner." FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Lege eine Gruppe an und wähle einen Ordner – sie zeigt dann dessen Scripte und Programme. Eigene Einträge legst du per Rechtsklick an."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <Button Style="{StaticResource Btn.Accent}" Content="Neue Gruppe …" Command="{Binding NewGroupCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" Margin="16,32,16,0" TextAlignment="Center"
                               Style="{StaticResource Caption}" Text="Keine Treffer. Gesucht wird in Name, Synopsis, Beschreibung, Notiz und Schlagworten. Filter (Schlagwort, Typ, Gruppe, Merkmal) bietet ein Klick ins Suchfeld an."/>

                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Größe per Ziehen: Griffe am Innenrand (Lage setzt PlaceGrips) -->
            <Thumb x:Name="WidthGrip" Grid.RowSpan="8" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Panel.ZIndex="10"
                   DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" ToolTip="Breite ändern">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="HeightGrip" Grid.RowSpan="8" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Panel.ZIndex="10"
                   DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta" DragCompleted="Grip_DragCompleted" ToolTip="Höhe ändern">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Line" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- Fixierter Kopf der aktuellen Gruppe (mit Pfad); Klick springt zum Gruppenkopf -->
            <Button Grid.Row="5" VerticalAlignment="Top" Margin="8,0,20,0" Panel.ZIndex="10" Style="{StaticResource RowButton}"
                    DataContext="{Binding StickyGroup}" Command="{Binding DataContext.JumpToGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" ToolTip="Zum Gruppenkopf springen"
                    Visibility="{Binding DataContext.HasStickyGroup, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="6,6,0,0">
                    <Border Background="{Binding CardBackgroundColor, Converter={StaticResource ArgbBrush}}" Margin="-8,-6" Padding="8,6" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource ArgbBrush}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Breadcrumb}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Border>
            </Button>

            <!-- Sprungleiste: ein Punkt je Gruppe (Gruppenfarbe), Klick springt hin -->
            <ItemsControl Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,4,8" Panel.ZIndex="11" Focusable="False"
                          ItemsSource="{Binding Groups}" Visibility="{Binding ShowJumpRail, Converter={StaticResource Vis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="14" Height="16" Padding="0" Cursor="Hand" ToolTip="{Binding RailToolTip}" Focusable="False"
                                Command="{Binding DataContext.RailClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Opacity="0.75" Style="{StaticResource GroupDot}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Width" Value="10"/>
                                            <Setter TargetName="Dot" Property="Height" Value="10"/>
                                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEquals}">
                                                    <Binding Path="Key"/>
                                                    <Binding Path="DataContext.StickyTopKey" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Dot" Property="Width" Value="10"/>
                                            <Setter TargetName="Dot" Property="Height" Value="10"/>
                                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Strg+K: Gruppe suchen und anspringen -->
            <Border Grid.Row="2" Grid.RowSpan="4" Margin="12,0,12,12" Panel.ZIndex="31" VerticalAlignment="Top"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="8"
                    Padding="8" Visibility="{Binding ShowGroupJump, Converter={StaticResource Vis}}" IsVisibleChanged="GroupJump_IsVisibleChanged">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="GroupJumpBox" DockPanel.Dock="Top" Height="34" Padding="8,0" Tag="Gruppe suchen … (Enter springt hin, Esc schließt)"
                             Text="{Binding GroupJumpText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="GroupJumpBox_PreviewKeyDown"
                             AutomationProperties.Name="Gruppe suchen"/>
                    <ListBox x:Name="GroupJumpList" ItemsSource="{Binding GroupJumpResults}" SelectedItem="{Binding GroupJumpSelected}" Margin="0,6,0,0"
                             MaxHeight="320" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="GroupJumpList_MouseUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" DataContext="{Binding Group}" Style="{StaticResource GroupDot}"/>
                                    <StackPanel>
                                        <TextBlock infra:Highlight.Parts="{Binding TitleParts}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PathText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasPath, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Vorschau (Leertaste): Code mit Syntaxfarben, Parameter, Signatur, letzter Start -->
            <Border Grid.Row="2" Grid.RowSpan="4" Margin="10,0,10,10" Panel.ZIndex="29"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding DataContext.ShowPeek, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" DataContext="{Binding Peek}"
                    AutomationProperties.Name="Vorschau">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Kopf -->
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28"
                                Command="{Binding DataContext.ClosePeekCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Schließen (Leertaste oder Esc)" AutomationProperties.Name="Vorschau schließen">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                        </Button>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" DataContext="{Binding Item}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Item.DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="↑ ↓ nächster Eintrag · Leertaste schließt" FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Aktionen -->
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Standard}" Command="{Binding Item.EditCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding Item.CanEdit, Converter={StaticResource Vis}}" ToolTip="Strg+E">
                                <TextBlock Text="Im Editor öffnen"/>
                            </Button>
                            <Button Style="{StaticResource Btn.Accent}" Command="{Binding Item.RunCommand}" ToolTip="Enter">
                                <TextBlock Text="{Binding Item.RunLabel}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,8"
                                       Visibility="{Binding Description, Converter={StaticResource Vis}}"/>
                            <!-- Fakten -->
                            <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PeekLabel"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Item.SignatureText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Item.SignatureText, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding Item.RequirementsText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Item.RequirementsText, Converter={StaticResource Vis}}" Foreground="{DynamicResource Status.Warning}"/>
                            <TextBlock Text="{Binding Item.FolderInfo}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Item.FolderInfo, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Secondary}"/>
                            <!-- Parameter -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasParameters, Converter={StaticResource Vis}}">
                                <TextBlock Text="Parameter" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,5">
                                                <TextBlock FontSize="12">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Code.Parameter}"/>
                                                    <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource Text.Tertiary}" FontSize="11"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Help}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                                                           Visibility="{Binding HasHelp, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- Code -->
                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    Visibility="{Binding HasCode, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <TextBlock infra:CodeView.Segments="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                    </ScrollViewer>
                                    <TextBlock Text="… gekürzt – vollständig im Editor" FontSize="10.5" Margin="0,6,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding CodeTruncated, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Verlauf (Strg+H): alle Starts mit Ergebnis; erneut mit gleichen Werten -->
            <Border Grid.Row="2" Grid.RowSpan="4" Margin="10,0,10,10" Panel.ZIndex="28"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding ShowHistory, Converter={StaticResource Vis}}" AutomationProperties.Name="Verlauf">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleHistoryCommand}"
                                ToolTip="Schließen (Esc)" AutomationProperties.Name="Verlauf schließen">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                        </Button>
                        <TextBlock Text="Verlauf" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6">
                        <TextBox Height="32" Padding="8,0" Tag="Im Verlauf suchen (Name, Rechner, Parameter) …" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Im Verlauf suchen"/>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton Style="{StaticResource Chip}" Content="Alle" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Heute" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=today}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Fehler" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=errors}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Remote" GroupName="HistoryFilter" IsChecked="{Binding HistoryFilter, Converter={StaticResource Eq}, ConverterParameter=remote}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="Noch keine passenden Starts." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Visibility="{Binding HistoryEmpty, Converter={StaticResource Vis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                            <ItemsControl ItemsSource="{Binding HistoryRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="HRow" CornerRadius="6" Padding="8,6" Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="72" FontSize="11.5" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <Ellipse x:Name="HDot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top" Fill="{DynamicResource Text.Tertiary}"/>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="6,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ParametersText}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Text.Tertiary}"
                                                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasParameters, Converter={StaticResource Vis}}"/>
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <Button Style="{StaticResource Btn.Subtle}" Command="{Binding RunAgainCommand}" Padding="6,0" Height="24" MinHeight="24"
                                                                ToolTip="Mit genau denselben Werten, Rechnern und Rechten erneut starten">
                                                            <TextBlock Text="↻ Gleiche Werte" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Btn.Subtle}" Command="{Binding RetryFailedCommand}" Padding="6,0" Height="24" MinHeight="24"
                                                                Visibility="{Binding CanRetryFailed, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="{Binding RetryText}" FontSize="11.5" Foreground="{DynamicResource Accent}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Btn.Subtle}" Command="{Binding OpenLogCommand}" Padding="6,0" Height="24" MinHeight="24"
                                                                Visibility="{Binding HasLog, Converter={StaticResource Vis}}" ToolTip="Log-Datei im Explorer zeigen">
                                                            <TextBlock Text="Log" FontSize="11.5" Foreground="{DynamicResource Accent}"/>
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Status.Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Status.Error}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="HDot" Property="Fill" Value="{DynamicResource Accent}"/></DataTrigger>
                                            <Trigger SourceName="HRow" Property="IsMouseOver" Value="True"><Setter TargetName="HRow" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Übersicht der Tastenkürzel (F1 oder „?“) -->
            <Border Grid.Row="4" Grid.RowSpan="2" Margin="12,4,12,12" Panel.ZIndex="30" VerticalAlignment="Top"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="8"
                    Padding="14,10,6,12" Visibility="{Binding ShowShortcuts, Converter={StaticResource Vis}}"
                    AutomationProperties.Name="Tastenkürzel">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleShortcutsCommand}"
                                ToolTip="Schließen (Esc)" AutomationProperties.Name="Schließen">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                        </Button>
                        <TextBlock Text="Tastenkürzel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,1" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="{DynamicResource Border.Control}"
                                            Background="{DynamicResource Bg.Input}" HorizontalAlignment="Left" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Keys}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Grid.IsSharedSizeScope="True"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Hinweis nach einer Änderung mit „Rückgängig“ (Strg+Z) -->
            <Border x:Name="UndoToast" Grid.Row="5" VerticalAlignment="Bottom" Margin="12,0,12,10" Panel.ZIndex="20"
                    Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="8"
                    Padding="12,6,4,6" Visibility="{Binding HasUndoToast, Converter={StaticResource Vis}}"
                    MouseEnter="UndoToast_MouseEnter" MouseLeave="UndoToast_MouseLeave"
                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding UndoToast}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding DismissUndoCommand}"
                            ToolTip="Hinweis schließen" AutomationProperties.Name="Hinweis schließen">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="Auto" Height="28" Padding="10,0" Margin="8,0,2,0"
                            Command="{Binding UndoCommand}" ToolTip="Rückgängig (Strg+Z)">
                        <TextBlock Text="Rückgängig" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    </Button>
                    <TextBlock Text="{Binding UndoToast}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" MaxHeight="40"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Raster: Details des ausgewählten Eintrags -->
            <Border Grid.Row="6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="16,10,12,4" MaxHeight="320">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGrid}" Value="True"/>
                                    <Condition Binding="{Binding HasSelection}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" ToolTip="Auswahl aufheben" Click="ClearSelection_Click">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                            </Button>
                            <TextBlock infra:Highlight.Parts="{Binding NameParts}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock infra:Highlight.Parts="{Binding SynopsisParts}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemDetails}" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fußzeile -->
            <Border Grid.Row="7" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}">
                <StackPanel>
                <!-- Mehrfachauswahl: nacheinander starten oder als Ablauf speichern -->
                <Border Margin="10,8,8,0" Padding="10,6,4,6" CornerRadius="6" Background="{DynamicResource Bg.Chip}"
                        Visibility="{Binding HasMultiSelection, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding ClearCheckedCommand}"
                                ToolTip="Auswahl aufheben" AutomationProperties.Name="Auswahl aufheben">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding RunCheckedCommand}" Height="26" MinHeight="26" Padding="10,0" FontSize="12" Margin="6,0,4,0"
                                ToolTip="In der Reihenfolge der Auswahl starten; jeder wartet auf den vorigen, bei Fehler Abbruch">
                            <TextBlock Text="▶ Nacheinander"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Command="{Binding SaveCheckedAsWorkflowCommand}" Height="26" MinHeight="26" Padding="6,0">
                            <TextBlock Text="Als Ablauf speichern" FontSize="12" Foreground="{DynamicResource Accent}"/>
                        </Button>
                        <TextBlock Text="{Binding MultiSelectionText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <!-- Aktivitäten: laufende und gerade beendete Starts -->
                <StackPanel Margin="12,8,8,2" Visibility="{Binding HasActivities, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding ActivitiesHeader}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="4,0,0,4"
                               Typography.Capitals="AllSmallCaps"/>
                    <ItemsControl ItemsSource="{Binding Activities}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ActRow" CornerRadius="6" Padding="4,4,2,4" Background="Transparent">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding CancelCommand}"
                                                ToolTip="Abbrechen" AutomationProperties.Name="Abbrechen" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding DismissCommand}"
                                                ToolTip="Aus der Liste entfernen" AutomationProperties.Name="Entfernen"
                                                Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Text.Tertiary}"/>
                                        </Button>
                                        <!-- Nach dem Ende: denselben Start wiederholen (gleiche Werte und gleiches Profil) -->
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="Auto" Height="26" Padding="6,0" Command="{Binding RestartCommand}"
                                                Visibility="{Binding CanRestart, Converter={StaticResource Vis}}" ToolTip="Mit denselben Werten erneut starten"
                                                AutomationProperties.Name="Erneut starten">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,0,5,0"/>
                                                <TextBlock Text="Erneut starten" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="Auto" Height="26" Padding="8,0" Command="{Binding OpenCommand}"
                                                Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" ToolTip="Ergebnisliste öffnen">
                                            <TextBlock Text="Ausgabe" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        </Button>
                                        <Grid Width="22" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="ActGlyph" Text="{Binding StatusGlyph}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Height="3" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                                         Visibility="{Binding HasProgress, Converter={StaticResource Vis}}"
                                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource Bg.Chip}" BorderThickness="0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter TargetName="ActGlyph" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="ActGlyph" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="ActGlyph" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                    </DataTrigger>
                                    <Trigger SourceName="ActRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ActRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <DockPanel Margin="16,4,8,4">
                    <Button Style="{StaticResource Btn.Icon}" DockPanel.Dock="Right" Command="{Binding RescanCommand}" ToolTip="Ordner neu einlesen">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" DockPanel.Dock="Right" Command="{Binding NewGroupCommand}" ToolTip="Neue Gruppe">
                        <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="13"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center"
                               Margin="8,0,4,0" ToolTip="Laufende Oberfläche und Version; in Klammern die über den Installer installierte Version"/>
                    <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
