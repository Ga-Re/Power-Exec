<!-- Inhalt des Marktplatz-Fensters: Suche, Auswahl-Leiste und die Galerie der Karten bzw. die Quellen (Datenkontext: MarketplaceViewModel). -->
<UserControl x:Class="PowerExec.Desktop.Views.MarketplaceView"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:v="clr-namespace:PowerExec.Desktop.Views"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- Quellen -->
        <StackPanel Visibility="{Binding IsSourcesPage, Converter={StaticResource Vis}}" Margin="0,4,0,0">
            <DockPanel Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding AddSourceCommand}" Margin="12,0,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T 'Add source …'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="{l:T 'Add more marketplaces by repository URL (GitHub or GitLab) – e.g. your team\'s catalog. Third-party sources are confirmed once before the first installation.'}"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="0">
            <ItemsControl ItemsSource="{Binding SourceList}" Focusable="False" Margin="12,8,12,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Style="{StaticResource SubSetting}">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}"
                                       ToolTip="{l:T 'Remove source'}" AutomationProperties.Name="{l:T 'Remove source'}"
                                       Visibility="{Binding CanRemove, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                            </ui:Button>
                            <TextBlock DockPanel.Dock="Left" Width="22" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                        <Setter Property="ToolTip" Value="{l:T 'Not confirmed as trusted yet'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Trusted}" Value="True">
                                                <Setter Property="Text" Value="&#xE83F;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                <Setter Property="ToolTip" Value="{l:T 'Trusted'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Url}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SourceSummary" Text="{Binding Summary}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="SourceSummary" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>
        </StackPanel>
        <!-- Listen: Suche, Quelle, Aktualisieren -->
        <DockPanel Margin="0,0,0,8" Visibility="{Binding IsListPage, Converter={StaticResource Vis}}">
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="{l:T 'Reload marketplace'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T 'Update'}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
            <ComboBox DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" ItemsSource="{Binding SourceChoices}" SelectedValue="{Binding SourceFilter}"
                      DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Source'}"
                      Visibility="{Binding HasSeveralSources, Converter={StaticResource Vis}}"/>
            <Grid>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Search marketplace'}"
                         AutomationProperties.Name="{l:T 'Search marketplace'}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
            </Grid>
        </DockPanel>
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="2,0,0,8" Visibility="{Binding HasRows, Converter={StaticResource Vis}}"/>
        <c:InfoBar Severity="Error" Message="{Binding Error}"/>
        <Border Padding="12,8" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}" BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding InstallSelectedText}" Command="{Binding InstallSelectedCommand}" Margin="0,2,8,2"/>
                <ui:Button Style="{StaticResource Btn.Standard}" Content="{Binding UninstallSelectedText}" Command="{Binding UninstallSelectedCommand}" Margin="0,2,8,2"/>
                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Clear selection'}" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2"/>
            </WrapPanel>
        </Border>
        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="4,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource Vis}}"/>
        <TextBlock Text="{l:T 'No results.'}" Style="{StaticResource Caption}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
        <!-- Galerie: Karten mit Kopf (was der Eintrag ausführt); ein Klick klappt die Details über die ganze Zeile auf -->
        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Margin="0,4,0,0" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><c:CardGridPanel MinItemWidth="250" Gap="16"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="c:CardGridPanel.Span" Value="{Binding IsPreviewOpen}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MarketplaceItemRow}">
                    <Border x:Name="CardBd" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}" Padding="8" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding TogglePreviewCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CardColumn" Width="*"/>
                                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <!-- Kopf: Vorschauzeile auf Kategoriefarbe bzw. Design-Vorschau -->
                                <Grid DockPanel.Dock="Top" Height="88">
                                    <Border Background="{Binding BandColor}" CornerRadius="{DynamicResource Radius.Control}" Padding="12,8"
                                            Visibility="{Binding IsEntryOrScript, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding PreviewLine}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Caption}" Foreground="White"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" VerticalAlignment="Bottom"/>
                                        </DockPanel>
                                    </Border>
                                    <c:DesignPreview Design="{Binding DesignPreset}" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}" ToolTip="{Binding DesignBackdropText}"/>
                                    <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" MinWidth="0" AutomationProperties.Name="{l:T 'Select'}"/>
                                </Grid>
                                <!-- Fuß: Kategorie, Zustand, Details, Installieren -->
                                <DockPanel DockPanel.Dock="Bottom" Margin="8,8,4,4">
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" Padding="12,0" Height="28" MinHeight="28"
                                               Visibility="{Binding CanInstall, Converter={StaticResource Vis}}"/>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="0,0,4,0" Command="{Binding TogglePreviewCommand}"
                                               ToolTip="{l:T 'Show or hide details'}" AutomationProperties.Name="{l:T 'Show or hide details'}">
                                        <TextBlock x:Name="Chevron" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                                    </ui:Button>
                                    <TextBlock x:Name="State" DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Success}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CategoryText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <StackPanel Margin="8,12,8,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TypeText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" Margin="0,4,0,0"
                                               ToolTip="{Binding Description}"/>
                                    <TextBlock Text="{Binding Needs}" FontSize="{StaticResource Font.Caption}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" Visibility="{Binding Needs, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Details (aufgeklappt): Art, Ziel bzw. Code, benötigte Variablen, Deinstallieren -->
                            <Border x:Name="Details" Grid.Column="1" Visibility="Collapsed" Margin="12,0,0,0" Padding="16,12" CornerRadius="{DynamicResource Radius.Control}"
                                    Background="{DynamicResource Bg.Input}" Cursor="Arrow">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Standard}" Content="{l:T 'Uninstall'}" Command="{Binding UninstallCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding EntryKindText}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
                                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}"
                                                 MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" Padding="0"
                                                 Visibility="{Binding IsEntryOrScript, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding DesignBackdropText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{l:T 'Required variables'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="0,12,0,0"
                                                   Visibility="{Binding HasVariables, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding VariablesText}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasVariables, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewOpen}" Value="True">
                            <Setter TargetName="CardColumn" Property="Width" Value="280"/>
                            <Setter TargetName="DetailColumn" Property="Width" Value="*"/>
                            <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Accent}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
