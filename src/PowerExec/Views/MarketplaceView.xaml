<!-- Inhalt des Marktplatz-Fensters: Einträge, Scripte, Designs, Installiert, Quellen (Datenkontext: MarketplaceViewModel). -->
<UserControl x:Class="PowerExec.Desktop.Views.MarketplaceView"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:v="clr-namespace:PowerExec.Desktop.Views"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding IsListPage, Converter={StaticResource Vis}}"
                   Text="{l:T 'Ready-made entries, scripts and designs from Git folders – from the bundled marketplace and your own sources. Expand groups, check individual files or whole groups and download them. Entries and scripts end up in your custom entries in the group of your choice; you create any required variables once along the way.'}"/>
        <!-- Quellen -->
        <StackPanel Visibility="{Binding IsSourcesPage, Converter={StaticResource Vis}}" Margin="0,4,0,0">
            <DockPanel Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding AddSourceCommand}" Margin="12,0,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T 'Add source …'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="{l:T 'Add more marketplaces by repository URL (GitHub or GitLab) – e.g. your team\'s catalog. Third-party sources are confirmed once before the first installation.'}"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="0">
            <ItemsControl ItemsSource="{Binding SourceList}" Focusable="False" Margin="12,6,12,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Style="{StaticResource SubSetting}">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}"
                                       ToolTip="{l:T 'Remove source'}" AutomationProperties.Name="{l:T 'Remove source'}"
                                       Visibility="{Binding CanRemove, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                            </ui:Button>
                            <TextBlock DockPanel.Dock="Left" Width="22" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                        <Setter Property="ToolTip" Value="{l:T 'Not confirmed as trusted yet'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Trusted}" Value="True">
                                                <Setter Property="Text" Value="&#xE83F;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                <Setter Property="ToolTip" Value="{l:T 'Trusted'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Url}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SourceSummary" Text="{Binding Summary}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="SourceSummary" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>
        </StackPanel>
        <!-- Listen: Suche, Quelle, Aktualisieren -->
        <DockPanel Margin="0,16,0,6" Visibility="{Binding IsListPage, Converter={StaticResource Vis}}">
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="{l:T 'Reload marketplace'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T 'Update'}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
            <ComboBox DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" ItemsSource="{Binding SourceChoices}" SelectedValue="{Binding SourceFilter}"
                      DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Source'}"
                      Visibility="{Binding HasSeveralSources, Converter={StaticResource Vis}}"/>
            <Grid>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Search marketplace'}"
                         AutomationProperties.Name="{l:T 'Search marketplace'}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
            </Grid>
        </DockPanel>
        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="2,0,0,8" Visibility="{Binding HasRows, Converter={StaticResource Vis}}"/>
        <c:InfoBar Severity="Error" Message="{Binding Error}"/>
        <Border Padding="12,8" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}" BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding InstallSelectedText}" Command="{Binding InstallSelectedCommand}" Margin="0,2,6,2"/>
                <ui:Button Style="{StaticResource Btn.Standard}" Content="{Binding UninstallSelectedText}" Command="{Binding UninstallSelectedCommand}" Margin="0,2,6,2"/>
                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Clear selection'}" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2"/>
            </WrapPanel>
        </Border>
        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="4,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource Vis}}"/>
        <TextBlock Text="{l:T 'No results.'}" Style="{StaticResource Caption}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.Resources>
                    <!-- Ordner -->
                    <DataTemplate DataType="{x:Type vm:MarketplaceFolderRow}">
                        <Border x:Name="FolderRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,3" Background="Transparent">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" Width="28" IsThreeState="False" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Select folder'}"/>
                                <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Command="{Binding InstallCommand}" ToolTip="{l:T 'Download all files in this folder'}"
                                           Padding="8,0" MinHeight="28" Height="28">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:T 'Load folder'}" FontSize="{StaticResource Font.Body}"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleCommand}"
                                           ToolTip="{l:T 'Expand/collapse'}" AutomationProperties.Name="{l:T 'Expand or collapse'}">
                                    <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                                </ui:Button>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Cursor="Hand">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
                                    </TextBlock.InputBindings>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="  "/><Run Text="{Binding CountText, Mode=OneWay}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                            </DataTrigger>
                            <Trigger SourceName="FolderRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="FolderRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                    <!-- Datei -->
                    <DataTemplate DataType="{x:Type vm:MarketplaceItemRow}">
                        <Border x:Name="ItemRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,4" Background="Transparent">
                          <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="108"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Select'}"/>
                                <Border Grid.Column="1" Width="{Binding Indent}"/>
                                <DockPanel Grid.Column="2" Margin="32,0,10,0" VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                        <TextBlock Text="{Binding Needs}" FontSize="{StaticResource Font.Caption}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Needs, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DockPanel>
                                <!-- Design: dieselbe Vorschau wie unter Darstellung -->
                                <c:DesignPreview Grid.Column="3" Width="150" Height="84" Margin="0,2,12,2" Design="{Binding DesignPreset}"
                                                 Visibility="{Binding HasDesign, Converter={StaticResource Vis}}" ToolTip="{Binding DesignBackdropText}"/>
                                <TextBlock x:Name="State" Grid.Column="4" Text="{Binding StateText}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding TogglePreviewCommand}" ToolTip="{l:T 'Preview'}"
                                               AutomationProperties.Name="{l:T 'Preview'}" Visibility="{Binding IsEntryOrScript, Converter={StaticResource Vis}}">
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}"/>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding InstallCommand}" ToolTip="{Binding InstallText}"
                                               AutomationProperties.Name="{Binding InstallText}" Visibility="{Binding CanInstall, Converter={StaticResource Vis}}">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}"/>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding UninstallCommand}" ToolTip="{l:T 'Uninstall'}"
                                               AutomationProperties.Name="{l:T 'Uninstall'}" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                            <!-- Vorschau: Art, Ziel bzw. Code, benötigte Variablen mit Typ -->
                            <Border Margin="60,4,4,6" Padding="12,10" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    Visibility="{Binding IsPreviewOpen, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EntryKindText}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
                                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}"
                                             MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" BorderThickness="0" Background="Transparent" Padding="0"/>
                                    <TextBlock Text="{l:T 'Required variables'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"
                                               Visibility="{Binding HasVariables, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{Binding VariablesText}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasVariables, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                            <Trigger SourceName="ItemRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="ItemRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
