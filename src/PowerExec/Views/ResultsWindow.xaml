<Window x:Class="PowerExec.Views.ResultsWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title, StringFormat=Ergebnisse – {0}}" Style="{StaticResource AppWindow}"
        Width="1040" Height="700" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Themes/Fluent.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="FilterChip" TargetType="RadioButton" BasedOn="{StaticResource Chip}"/>
      </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="24,18,24,14">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'Abbrechen'}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding ToggleLogCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LogLabel}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'CSV exportieren'}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Accent}" Command="{Binding RetryFailedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'Fehlgeschlagene wiederholen'}"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="ResultFilter" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=all}">
                        <TextBlock Text="{Binding Total, StringFormat=Alle {0}}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="ResultFilter" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=ok}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Status.Success}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SuccessCount, StringFormat={}{0} erfolgreich}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="ResultFilter" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=err}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Status.Error}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ErrorCount, StringFormat={}{0} Fehler}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="ResultFilter" IsChecked="{Binding Filter, Converter={StaticResource Eq}, ConverterParameter=off}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE738;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Status.Warning}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UnreachableCount, StringFormat={}{0} nicht erreichbar}"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- Ansicht: Liste oder Kachelkarte -->
                    <Border Width="1" Height="20" Margin="6,0,12,0" Background="{DynamicResource Border.Default}" VerticalAlignment="Center"/>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="ResultView" IsChecked="{Binding ShowList, Mode=OneWay}"
                                 Command="{Binding SetViewCommand}" CommandParameter="list" ToolTip="{l:T 'Liste mit Ausgabe je Rechner'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{l:T 'Liste'}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="ResultView" IsChecked="{Binding ShowTiles, Mode=OneWay}"
                                 Command="{Binding SetViewCommand}" CommandParameter="tiles" ToolTip="{l:T 'Eine Kachel je Rechner – Stand auf einen Blick'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{l:T 'Kacheln'}"/>
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>

                <ProgressBar Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Bg.Chip}" BorderThickness="0"/>
                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}" BorderThickness="1"
                        Visibility="{Binding RunnerError, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding RunnerError}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Kachelkarte: eine Kachel je Rechner, Probleme zuerst; Klick zeigt die Ausgabe darunter -->
            <DockPanel Visibility="{Binding ShowTiles, Converter={StaticResource Vis}}">
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" MaxHeight="300"
                        Visibility="{Binding DataContext.HasSelectedTile, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" DataContext="{Binding SelectedTile}">
                    <DockPanel Margin="24,10,24,12">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding Computer}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText, StringFormat=' · {0}'}" Foreground="{DynamicResource Text.Secondary}"/>
                        </DockPanel>
                        <Border Padding="12,10" Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" MinHeight="0" VerticalScrollBarVisibility="Auto"
                                     Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,14,24,14">
                    <ItemsControl ItemsSource="{Binding VisibleTiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="92" Height="40" Margin="0,0,6,6" Padding="0" Cursor="Hand" ToolTip="{Binding TileToolTip}"
                                        Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding TileToolTip}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Tile" CornerRadius="5" Background="{DynamicResource Bg.Chip}" BorderThickness="2" BorderBrush="Transparent" Padding="6,2">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TileName" Text="{Binding Computer}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text.Primary}"/>
                                                    <TextBlock x:Name="TileStatus" Text="{Binding StatusText}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text.Secondary}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Tile.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Tile.Error}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Unreachable">
                                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Tile.Unreachable}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Tile.Running}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel Visibility="{Binding ShowList, Converter={StaticResource Vis}}">
                <Grid DockPanel.Dock="Top" Height="34" Margin="8,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{l:T 'Rechner'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{l:T 'Status'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{l:T 'Dauer'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{l:T 'Ausgabe'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisibleRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <ui:Button Command="{Binding ToggleCommand}" Style="{StaticResource Btn.Subtle}" HorizontalContentAlignment="Stretch" Padding="8,0,16,0"
                                                Height="44">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Computer}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Text="&#xE916;"
                                                               Foreground="{DynamicResource Text.Secondary}"/>
                                                    <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" Foreground="{DynamicResource Text.Secondary}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding FirstLine}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ui:Button>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="48,0,16,12" Padding="12,10"
                                                Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                                            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" MinHeight="0" Foreground="{DynamicResource Text.Secondary}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Success">
                                        <Setter TargetName="StatusIcon" Property="Text" Value="&#xE73E;"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter TargetName="StatusIcon" Property="Text" Value="&#xE711;"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Unreachable">
                                        <Setter TargetName="StatusIcon" Property="Text" Value="&#xE738;"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Column="1" Width="380" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1,0,0,0" Background="{DynamicResource Bg.Subtle}"
                    Visibility="{Binding ShowLog, Converter={StaticResource Vis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,8,8,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Log-Ordner öffnen'}" FontSize="12" Command="{Binding OpenLogFolderCommand}" />
                        <TextBlock Text="{l:T 'Log'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="14,4,14,14"
                             FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
