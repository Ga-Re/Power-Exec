<Window x:Class="PowerExec.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        Title="{Binding Title, StringFormat=Startprofile – {0}}" Style="{StaticResource AppWindow}"
        Width="1080" Height="860" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="1"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Eintrag -->
        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="24,16,24,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PathText}" Style="{StaticResource Mono}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Anzeigename im Panel" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding DisplayNamePlaceholder}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding DescriptionPlaceholder}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Gruppe" Style="{StaticResource FieldLabel}"/>
                    <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=LostFocus}"
                              ToolTip="Eigene Gruppe im Panel (leer = im Ordner bzw. unter „Eigene Einträge“). Neue Namen einfach eintippen."/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="6" Margin="0,10,0,0">
                    <TextBlock Text="Schlagworte" Style="{StaticResource FieldLabel}"/>
                    <c:TagBox TagsText="{Binding TagsText}" Suggestions="{Binding AllTags}" Placeholder="Enter fügt hinzu" ToolTip="Suche im Panel: #schlagwort"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="Notiz" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6"
                             Tag="z. B. „Nur nach Rücksprache mit dem DBA“ – erscheint im Panel und im Ausführen-Dialog"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Profilliste -->
            <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14">
                    <TextBlock DockPanel.Dock="Top" Text="Profile" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="8,0,0,6"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" FontSize="11" Margin="4,12,4,0"
                               Text="Im Panel startet ein Klick das Standardprofil. Die übrigen Profile stehen im Menü am Ausführen-Knopf."/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Style="{StaticResource Btn.Standard}" Content="+ Neues Profil" Command="{Binding AddCommand}" Margin="0,0,6,6" FontSize="12"/>
                        <Button Style="{StaticResource Btn.Standard}" Content="Duplizieren" Command="{Binding DuplicateCommand}" Margin="0,0,6,6" FontSize="12"/>
                        <Button Style="{StaticResource Btn.Standard}" Content="Löschen" Command="{Binding DeleteCommand}" Margin="0,0,6,6" FontSize="12"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}" Margin="0,0,0,4" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="12,9">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="8" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}"
                                                                    BorderThickness="1" Visibility="{Binding IsDefault, Converter={StaticResource Vis}}">
                                                                <TextBlock Text="Standard" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Info.Text}"/>
                                                            </Border>
                                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Status.Warning}"
                                                                       Visibility="{Binding RunAsAdmin, Converter={StaticResource Vis}}" ToolTip="Als Administrator"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Profil bearbeiten -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16" DataContext="{Binding Selected}">
                    <WrapPanel Margin="0,0,0,16">
                        <StackPanel Width="280" Margin="0,0,20,0">
                            <TextBlock Text="Profilname" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>
                        </StackPanel>
                        <CheckBox Content="Standardprofil (Klick im Panel)" IsChecked="{Binding IsDefault}" VerticalAlignment="Bottom" Margin="0,0,20,8"/>
                        <CheckBox Content="Vor dem Start bestätigen" IsChecked="{Binding ConfirmBeforeRun}" VerticalAlignment="Bottom" Margin="0,0,20,8"
                                  ToolTip="Sicherheitsabfrage „Wirklich ausführen?“ – sinnvoll für kritische Scripte"/>
                        <CheckBox IsChecked="{Binding RunAsAdmin}" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Status.Warning}" Margin="0,0,6,0"/>
                                <TextBlock Text="Als Administrator ausführen"/>
                            </StackPanel>
                        </CheckBox>
                    </WrapPanel>

                    <!-- Parameter (PowerShell) -->
                    <Border Style="{StaticResource SectionCard}"
                            Visibility="{Binding DataContext.HasParameters, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Parameter" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Fest = immer übergeben · Vorbelegt = im Dialog änderbar · Fragen = Feld bleibt leer" Style="{StaticResource Caption}" Margin="10,2,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="6,1,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                        Visibility="{Binding IsNotSecure, Converter={StaticResource Vis}}">
                                                    <UniformGrid Columns="3">
                                                        <RadioButton Style="{StaticResource Segment}" GroupName="{Binding GroupKey}" Content="Fest"
                                                                     IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Fixed}"/>
                                                        <RadioButton Style="{StaticResource Segment}" GroupName="{Binding GroupKey}" Content="Vorbelegt"
                                                                     IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Preset}"/>
                                                        <RadioButton Style="{StaticResource Segment}" GroupName="{Binding GroupKey}" Content="Fragen"
                                                                     IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Ask}"/>
                                                    </UniformGrid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSecure, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource Text.Secondary}"/>
                                                    <TextBlock Text="Wird immer beim Start abgefragt" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                                </StackPanel>
                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsValueEnabled}"
                                                             Visibility="{Binding IsText, Converter={StaticResource Vis}}" Tag="Wert"/>
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsEnabled="{Binding IsValueEnabled}"
                                                              Visibility="{Binding IsChoice, Converter={StaticResource Vis}}"/>
                                                    <CheckBox Content="Aktivieren" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsValueEnabled}"
                                                              Visibility="{Binding IsCheck, Converter={StaticResource Vis}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NoteIsWarning}" Value="True">
                                                <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Argumente (Programme) -->
                    <Border Style="{StaticResource SectionCard}"
                            Visibility="{Binding DataContext.IsProgram, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="Argumente" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="z. B. /v:SRV-APP02"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Werden beim Start an das Programm, die Verknüpfung oder das Batch-Script angehängt."/>
                        </StackPanel>
                    </Border>

                    <Grid Visibility="{Binding DataContext.IsPowerShell, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Ziel" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Columns="3">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ProfileTarget" Content="Dieser PC"
                                                     IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Local}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ProfileTarget" Content="Feste Rechner"
                                                     IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Fixed}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ProfileTarget" Content="Beim Start wählen"
                                                     IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Ask}"/>
                                    </UniformGrid>
                                </Border>
                                <TextBox Text="{Binding Machines, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}"
                                         Tag="Rechnernamen oder @Gruppe, mit Komma getrennt" Visibility="{Binding IsFixedTarget, Converter={StaticResource Vis}}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="Mehrere Rechner laufen parallel; danach erscheint die Ergebnisliste."/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Ausführen-Dialog" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Columns="3">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ProfileDialog" Content="Immer"
                                                     IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=Always}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ProfileDialog" Content="Nur wenn nötig"
                                                     IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=WhenNeeded}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ProfileDialog" Content="Nie"
                                                     IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=Never}"/>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="{Binding DialogHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <ComboBox Width="200" Margin="0,0,16,6" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Engine}"
                                              ItemsSource="{Binding DataContext.Engines, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="-NoExit" IsChecked="{Binding NoExit}" Margin="0,6,16,6"/>
                                    <CheckBox Content="-NoProfile" IsChecked="{Binding NoProfile}" Margin="0,6,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <CheckBox Content="Konsole nach Ende offen lassen" IsChecked="{Binding NoExit}"
                              Visibility="{Binding DataContext.IsProgram, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"
                              IsEnabled="{Binding DataContext.SupportsNoExit, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel>
                <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Padding="12,8" MaxHeight="90">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Selected.Preview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                    </ScrollViewer>
                </Border>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" MinWidth="110" Height="34" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96" Height="34" Click="Cancel_Click"/>
                    <TextBlock Text="{Binding SaveHint}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
