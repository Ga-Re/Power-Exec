<Window x:Class="PowerExec.Desktop.Views.ProfilesWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
        xmlns:v="clr-namespace:PowerExec.Desktop.Views"
        xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
        Title="{Binding WindowTitle}" Style="{StaticResource AppWindow}"
        Width="1060" Height="800" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Kachel im ersten Schritt -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                                Padding="16,16" Height="96">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Parameterzeile (ProfileParamViewModel) -->
        <DataTemplate x:Key="ParamRow">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TypeLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="8,1,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsValueEnabled}"
                             Visibility="{Binding IsText, Converter={StaticResource Vis}}" Tag="{l:T 'Value'}" AutomationProperties.Name="{Binding Name}"/>
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsEnabled="{Binding IsValueEnabled}"
                              Visibility="{Binding IsChoice, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Name}"/>
                    <CheckBox Content="{l:T 'Enable'}" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsValueEnabled}"
                              Visibility="{Binding IsCheck, Converter={StaticResource Vis}}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSecure, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock Text="{l:T 'Always asked at launch'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Visibility="{Binding IsNotSecure, Converter={StaticResource Vis}}">
                    <UniformGrid Columns="3">
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Fixed'}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Fixed}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Prefilled'}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Preset}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Ask'}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Ask}"/>
                    </UniformGrid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteIsWarning}" Value="True">
                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Variable bzw. Abfrage (ProfileVariableRowViewModel) -->
        <DataTemplate x:Key="VariableRow">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Token}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Token}"/>
                    <TextBlock Text="{Binding Origin}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding KindKey}"
                          Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Kind'}"
                          Visibility="{Binding IsQuery, Converter={StaticResource Vis}}"/>
                <TextBlock Grid.Column="1" Text="{l:T 'Value'}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Visibility="{Binding IsVariable, Converter={StaticResource Vis}}"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=200}" Tag="{Binding ValueHint}" AutomationProperties.Name="{l:T 'Value'}"/>
                    <TextBox Text="{Binding ChoicesText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Tag="{l:T 'more values, separated by ;'}" Margin="0,4,0,0"
                             Visibility="{Binding IsChoice, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T 'Choices'}"/>
                </StackPanel>
                <ui:Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Margin="8,0,0,0" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Remove variable'}"
                           AutomationProperties.Name="{l:T 'Remove variable'}" Visibility="{Binding IsProfileOnly, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                </ui:Button>
            </Grid>
        </DataTemplate>

        <!-- Ausführen als / wo (ProfileEditViewModel) -->
        <DataTemplate x:Key="RunAsBody">
            <StackPanel>
                <StackPanel Visibility="{Binding DataContext.ShowRunAs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Run as'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Current account'}" Width="140"
                                         IsChecked="{Binding RunMode, Converter={StaticResource Eq}, ConverterParameter=normal}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="140"
                                         IsChecked="{Binding RunMode, Converter={StaticResource Eq}, ConverterParameter=admin}"
                                         Visibility="{Binding DataContext.ShowAdminMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Foreground="{DynamicResource Status.Warning}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T 'Administrator'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Different user'}" Width="150"
                                         IsChecked="{Binding RunMode, Converter={StaticResource Eq}, ConverterParameter=other}"/>
                        </StackPanel>
                    </Border>
                    <c:CollapsePanel Animate="True" Fade="True" IsExpanded="{Binding RunMode, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=other}">
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{l:T 'For a different user, Power-Exec asks for the sign-in at every launch – it is never saved.'}"/>
                    </c:CollapsePanel>
                </StackPanel>
                <StackPanel Visibility="{Binding DataContext.ShowPsOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Where'}" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Width="130" Content="{l:T 'This PC'}" IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Local}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="130" Content="{l:T 'Fixed computers'}" IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Fixed}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="150" Content="{l:T 'Choose at launch'}" IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Ask}"/>
                        </StackPanel>
                    </Border>
                    <c:CollapsePanel Animate="True" Fade="True" IsExpanded="{Binding IsFixedTarget, Mode=OneWay}">
                        <c:MachineBox Text="{Binding Machines, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                    </c:CollapsePanel>
                    <TextBlock Text="{l:T 'PowerShell version'}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="230" HorizontalAlignment="Left" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Engine}"
                              ItemsSource="{Binding DataContext.Engines, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{l:T 'PowerShell version'}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Verhalten beim Start: Startblatt, Konsole, Rückfrage (ProfileEditViewModel) -->
        <DataTemplate x:Key="LaunchBody">
            <StackPanel>
                <StackPanel Visibility="{Binding DataContext.ShowPsOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Run dialog'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Width="110" Content="{l:T 'Always'}" IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=Always}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="130" Content="{l:T 'Only when needed'}" IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=WhenNeeded}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="110" Content="{l:T 'Never'}" IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=Never}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding DialogHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="{l:T 'Keep console open (-NoExit)'}" IsChecked="{Binding NoExit}" Margin="0,0,16,0"/>
                        <CheckBox Content="{l:T 'Without PowerShell profile (-NoProfile)'}" IsChecked="{Binding NoProfile}"/>
                    </WrapPanel>
                </StackPanel>
                <CheckBox Content="{l:T 'Keep console open after finishing'}" IsChecked="{Binding NoExit}" Margin="0,8,0,0"
                          Visibility="{Binding DataContext.ShowKeepOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                <CheckBox Content="{l:T 'Confirm before launch (“Really run?”)'}" IsChecked="{Binding ConfirmBeforeRun}" Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Startoptionen und Verhalten – ein Schlüssel bei Presets (ProfileEditViewModel) -->
        <DataTemplate x:Key="WindowBody">
            <StackPanel>
                <v:CustomEntryForm DataContext="{Binding Options}" Visibility="{Binding HasOptions, Converter={StaticResource Vis}}" Margin="0,0,0,4"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LaunchBody}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <!-- Argumente (ProfileEditViewModel) -->
        <DataTemplate x:Key="ArgsBody">
            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Tag="{l:T 'optional, e.g. /v:SRV-APP02'}"
                     AutomationProperties.Name="{l:T 'Additional arguments at launch'}"/>
        </DataTemplate>

        <!-- Eigenes Ziel bzw. eigener Code eines Presets (ProfileEditViewModel) -->
        <DataTemplate x:Key="TargetBody">
            <StackPanel>
                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged, Delay=250}" FontFamily="{DynamicResource MonoFont}"
                         Visibility="{Binding UsesTarget, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T 'Target of this preset'}"/>
                <TextBox Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged, Delay=250}" FontFamily="{DynamicResource MonoFont}" AcceptsReturn="True" AcceptsTab="True"
                         MinHeight="120" MaxHeight="320" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8"
                         Visibility="{Binding UsesCode, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T 'Code of this preset'}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Vorschau: Aufruf und Code (ProfileEditViewModel) -->
        <DataTemplate x:Key="PreviewBody">
            <StackPanel>
                <TextBlock Text="{l:T 'Call'}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="10,8">
                    <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                             FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                </Border>
                <StackPanel Visibility="{Binding HasCode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Command="{Binding EditCodeCommand}" Padding="8,0" Height="26" MinHeight="26"
                                   FontSize="{StaticResource Font.Caption}" Visibility="{Binding CanEditFile, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:T 'Edit'}"/>
                            </StackPanel>
                        </ui:Button>
                        <TextBlock Text="{l:T 'Code'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="10,8"
                            Visibility="{Binding IsReadingCode, Converter={StaticResource Vis}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <TextBlock infra:CodeView.Segments="{Binding CodeSegments}" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource Font.Body}"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Visibility="{Binding IsEditingCode, Converter={StaticResource Vis}}">
                        <Border Padding="12,8" Margin="0,0,0,8" CornerRadius="{DynamicResource Radius.Card}" BorderThickness="1"
                                Background="{DynamicResource Status.Warning.Bg}" BorderBrush="{DynamicResource Status.Warning.Border}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Save to file'}" Command="{Binding SaveCodeCommand}" Margin="8,0,0,0"/>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Discard'}" Command="{Binding CancelEditCodeCommand}" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding EditWarning}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <TextBox Text="{Binding EditableCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" AcceptsReturn="True" AcceptsTab="True"
                                 MinHeight="220" MaxHeight="480" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8" AutomationProperties.Name="{l:T 'Script code'}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CodeStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Eine Abweichung eines Presets (PresetValueRow): Bezeichnung, „statt …“, ×, darunter der Editor -->
        <DataTemplate x:Key="PresetRow">
            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="0,10,0,6" infra:NavigationMotion.Appear="True">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding RemoveCommand}"
                                   ToolTip="{l:T 'Remove – takes the value from ★ Standard again'}" AutomationProperties.Name="{l:T 'Remove deviation'}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                        </ui:Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BaseText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,8,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip="{Binding BaseText}"/>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource TargetBody}" Focusable="False"
                                    Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=target}"/>
                    <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource RunAsBody}" Focusable="False"
                                    Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=runas}"/>
                    <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource WindowBody}" Focusable="False"
                                    Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=window}"/>
                    <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource ArgsBody}" Focusable="False"
                                    Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=args}"/>
                    <ContentControl Content="{Binding Param}" ContentTemplate="{StaticResource ParamRow}" Focusable="False"
                                    Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=param}"/>
                    <ContentControl Content="{Binding Variable}" ContentTemplate="{StaticResource VariableRow}" Focusable="False"
                                    Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=var}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Ein Preset in der Liste: zugeklappt Name und Abweichungen, aufgeklappt bearbeitbar -->
        <DataTemplate x:Key="PresetCard">
            <Border x:Name="Card" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Tile}" Margin="0,0,0,8">
                <StackPanel>
                    <Button Command="{Binding SelectCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding Name}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Tile}" Padding="16,12">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" MinWidth="22" Height="22" Padding="7,0" infra:Pill.IsEnabled="True" Background="{DynamicResource Bg.Chip}"
                                    VerticalAlignment="Center" Visibility="{Binding HasOwnValues, Converter={StaticResource Vis}}" ToolTip="{Binding InheritText}">
                                <TextBlock Text="{Binding OwnCount}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="ArrowTurn"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" Width="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PresetSummary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                    </Button>
                    <c:CollapsePanel Animate="True" Fade="True" IsExpanded="{Binding IsSelected, Mode=OneWay}">
                    <StackPanel Margin="16,0,16,14">
                        <DockPanel Margin="0,4,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding TestCommand}" Margin="8,0,0,0" ToolTip="{l:T 'Start with this preset once (not recorded)'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{l:T 'Test'}"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Make standard'}" Command="{Binding MakeStandardCommand}" Margin="8,0,0,0"
                                           ToolTip="{l:T 'This preset becomes ★ Standard; the others then keep their differences to it'}"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Duplicate'}" Command="{Binding DuplicatePresetCommand}" Margin="8,0,0,0"/>
                                <ui:Button Style="{StaticResource Btn.Icon}" Width="34" Height="34" Command="{Binding RemovePresetCommand}" Margin="8,0,0,0"
                                           ToolTip="{l:T 'Delete preset'}" AutomationProperties.Name="{l:T 'Delete preset'}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                </ui:Button>
                            </StackPanel>
                            <StackPanel Width="260" HorizontalAlignment="Left">
                                <TextBlock Text="{l:T 'Name'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'Preset name'}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Standard wurde nach dem Anpassen geändert -->
                        <c:CollapsePanel Animate="True" Fade="True" IsExpanded="{Binding HasStandardChanged, Mode=OneWay}">
                            <Border Padding="12,8" Margin="0,0,0,8" CornerRadius="{DynamicResource Radius.Card}" BorderThickness="1"
                                    Background="{DynamicResource Status.Warning.Bg}" BorderBrush="{DynamicResource Status.Warning.Border}">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Keep mine'}" Command="{Binding DismissStandardChangeCommand}" Margin="8,0,0,0"/>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Take over Standard'}" Command="{Binding AdoptStandardCommand}" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding StandardChangedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </c:CollapsePanel>

                        <TextBlock Text="{l:T 'No deviations yet – the preset starts exactly like ★ Standard.'}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Visibility="{Binding HasOwnRows, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding OwnRows}" ItemTemplate="{StaticResource PresetRow}" Focusable="False"/>
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T '+ Change a value …'}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Click="AddPresetValue_Click" IsEnabled="{Binding CanAddKeys}">
                            <ui:Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding AddableKeys}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Label}"/>
                                            <Setter Property="Command" Value="{Binding Command}"/>
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                    </c:CollapsePanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowTurn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.167">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.167">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Kopf: Symbol, Anzeigename, Beschreibung, Art, Ausprobieren ===== -->
        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="24,16,24,16" Visibility="{Binding ShowForm, Converter={StaticResource Vis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                    <ui:Button Width="60" Height="60" Style="{StaticResource Btn.Standard}" Padding="0" Command="{Binding Entry.ChooseIconCommand}"
                            IsEnabled="{Binding HasEntry}" ToolTip="{l:T 'Choose icon (Fluent 2, Heroicons, emoji, custom image)'}">
                        <Grid>
                            <c:IconPresenter Icon="{Binding Entry.Icon}" Size="32" Visibility="{Binding Entry.HasIcon, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <Image Source="{Binding Entry.AutoIcon, Converter={StaticResource IconImage}}" Width="32" Height="32" Visibility="{Binding Entry.ShowAutoIcon, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="{Binding Entry.Badge}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Entry.ShowBadge, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.Hero}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsScannedFile, Converter={StaticResource Vis}}"/>
                        </Grid>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Automatic'}" Command="{Binding Entry.ClearIconCommand}" FontSize="{StaticResource Font.Caption}" Padding="4,0" MinHeight="22" Height="22"
                            Margin="0,4,0,0" HorizontalAlignment="Center" ToolTip="{l:T 'Use favicon, program or folder icon'}"
                            Visibility="{Binding Entry.HasIcon, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top">
                    <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding DefaultProfile.TestCommand}" HorizontalAlignment="Right"
                               ToolTip="{l:T 'Start with ★ Standard once (not recorded)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T 'Test'}"/>
                        </StackPanel>
                    </ui:Button>
                    <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,8,0,0"/>
                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Change type …'}" Command="{Binding ChangeKindCommand}" FontSize="{StaticResource Font.Body}" Padding="8,0" MinHeight="26" Height="26"
                            HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" Visibility="{Binding CanChangeKind, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBox x:Name="NameBox" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HeaderNameHint}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"
                             ToolTip="{l:T 'Display name in the panel'}"/>
                    <TextBox Text="{Binding HeaderDescription, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HeaderDescriptionHint}" Margin="0,8,0,0"
                             ToolTip="{l:T 'Description in the panel'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Schritt 1: Art wählen ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowKindPicker, Converter={StaticResource Vis}}">
            <StackPanel Margin="24,16,24,8">
                <DockPanel Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Back to entry'}" Command="{Binding BackToFormCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.Header}" FontWeight="SemiBold"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Tile}" Command="{Binding DataContext.PickKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.Hero}" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Subtitle}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:T 'Or'}" Style="{StaticResource FieldLabel}" Margin="0,8,0,8"/>
                <Border Style="{StaticResource SectionCard}" Padding="16,12" Visibility="{Binding HasClipboardSuggestion, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Apply'}" Command="{Binding UseClipboardCommand}" Margin="12,0,0,0" />
                        <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XXL}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'From the clipboard'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClipboardText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <WrapPanel>
                    <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding CatalogCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0"/><TextBlock Text="{l:T 'From templates …'}"/></StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding FilesCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0"/><TextBlock Text="{l:T 'Select files …'}"/></StackPanel>
                    </ui:Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Schritt 2: Navigation links, Abschnitt rechts ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowForm, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0" Padding="10,12">
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" AutomationProperties.Name="{l:T 'Sections'}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="EntrySections" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                         AutomationProperties.Name="{Binding Label}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Visibility="{Binding HasBadge, Converter={StaticResource Vis}}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Font.Body}"/>
                                </DockPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ScrollViewer Grid.Column="1" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,18,24,8">

                    <!-- Allgemein: Ziel bzw. Datei, Schlagworte, Notiz -->
                    <StackPanel infra:NavigationMotion.Appear="True" Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=general}">
                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasEntry, Converter={StaticResource Vis}}">
                            <v:CustomEntryForm DataContext="{Binding Entry}"/>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsScannedFile, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FileKindText}" Style="{StaticResource CardTitle}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Show in Explorer'}" Command="{Binding OpenFileLocationCommand}" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Item.FullPath, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding FileInfo}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FileParametersText}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Tags'}" Style="{StaticResource CardTitle}"/>
                                <c:TagBox TagsText="{Binding TagsText}" Suggestions="{Binding AllTagsList}" Placeholder="{l:T 'Enter adds the tag'}" ToolTip="{l:T 'Search in the panel: #tag'}" Margin="0,8,0,0"/>
                                <TextBlock Text="{l:T 'The group is changed directly in the panel by dragging.'}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Note'}" Style="{StaticResource CardTitle}"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" Margin="0,8,0,0"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,8"
                                         Tag="{l:T 'e.g. “Only after consulting the DBA” – appears in the panel and the Run dialog'}"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding RevealPresetsCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}" HorizontalContentAlignment="Stretch"
                                Visibility="{Binding CanRevealPresets, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T 'Create preset'}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}" Padding="16,12" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Create preset'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'e.g. the same page for test and production – a preset changes single values like a variable. Only then does the “Presets” section appear.'}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Parameter -->
                    <StackPanel infra:NavigationMotion.Appear="True" Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=parameters}">
                        <TextBlock Text="{l:T 'Parameters'}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{l:T 'Values of ★ Standard. Fixed = always passed · Prefilled = editable at launch · Ask = field stays empty. Presets change single values.'}" Style="{StaticResource PageHint}"/>
                        <Border Style="{StaticResource SectionCard}" Padding="18,4">
                            <ItemsControl ItemsSource="{Binding DefaultProfile.Parameters}" ItemTemplate="{StaticResource ParamRow}" Focusable="False"/>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <ContentControl Content="{Binding DefaultProfile}" ContentTemplate="{StaticResource PreviewBody}" Focusable="False"/>
                        </Border>
                    </StackPanel>

                    <!-- Variablen -->
                    <StackPanel infra:NavigationMotion.Appear="True" Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=variables}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T '+ Variable'}" Command="{Binding DefaultProfile.AddVariableCommand}"
                                       VerticalAlignment="Top" ToolTip="{l:T 'Variable only for this entry, used as \{\{$Name\}\}'}"/>
                            <TextBlock Text="{l:T 'Variables'}" Style="{StaticResource PageTitle}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="{l:T 'Queries \{\{Name\}\} are asked at launch – with a suggestion, as a choice or with a fixed value. \{\{$Variables\}\} take the value set here before the global one. Quick choice in the text: \{\{Server:A;B;C\}\}.'}"/>
                        <Border Style="{StaticResource SectionCard}" Padding="18,4">
                            <StackPanel>
                                <TextBlock Text="{l:T 'No variables yet – use \{\{Name\}\} in the target or code, or add one.'}" Style="{StaticResource Caption}" Margin="0,10"
                                           Visibility="{Binding DefaultProfile.HasVariables, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                <ItemsControl ItemsSource="{Binding DefaultProfile.Variables}" ItemTemplate="{StaticResource VariableRow}" Focusable="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Start bzw. Öffnen mit -->
                    <StackPanel infra:NavigationMotion.Appear="True" Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=start}">
                        <TextBlock Text="{Binding StartSectionLabel}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{l:T 'How ★ Standard starts. Presets can change single values.'}" Style="{StaticResource PageHint}"/>
                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding ShowRunAsSection, Converter={StaticResource Vis}}">
                            <ContentControl Content="{Binding DefaultProfile}" ContentTemplate="{StaticResource RunAsBody}" Focusable="False"/>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding DefaultProfile.HasOptions, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                            <v:CustomEntryForm DataContext="{Binding DefaultProfile.Options}"/>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding ShowProgramArgs, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Arguments'}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <ContentControl Content="{Binding DefaultProfile}" ContentTemplate="{StaticResource ArgsBody}" Focusable="False"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <ContentControl Content="{Binding DefaultProfile}" ContentTemplate="{StaticResource PreviewBody}" Focusable="False"/>
                        </Border>
                    </StackPanel>

                    <!-- Presets -->
                    <StackPanel infra:NavigationMotion.Appear="True" Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=presets}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T '+ Preset'}" Command="{Binding AddCommand}" VerticalAlignment="Top"/>
                            <TextBlock Text="{l:T 'Presets'}" Style="{StaticResource PageTitle}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="{l:T 'A preset only stores what differs from ★ Standard – everything else it takes over automatically. In the panel a click starts ★ Standard, right-click or the arrow shows the presets.'}"/>
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                                Padding="16,12" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="★" Foreground="{DynamicResource Star}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding DefaultProfile.Name}" FontWeight="SemiBold" Width="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Basis · starts with a click in the panel'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetCard}" Focusable="False"/>
                        <TextBlock Text="{l:T 'No presets yet. “+ Preset” creates one that starts like ★ Standard – then change single values.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasPresets, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    </StackPanel>

                    <!-- Verhalten -->
                    <StackPanel infra:NavigationMotion.Appear="True" Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=behavior}">
                        <TextBlock Text="{l:T 'Behavior'}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{l:T 'What happens on a click and at launch.'}" Style="{StaticResource PageHint}"/>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'In the panel'}" Style="{StaticResource CardTitle}"/>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding SingleClick}" Content="{l:T 'Start with one click (instead of expanding the entry in the panel)'}"/>
                                <DockPanel Margin="0,12,0,0">
                                    <ComboBox DockPanel.Dock="Right" Width="250" ItemsSource="{Binding AskProfileChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding AskProfile}" AutomationProperties.Name="{l:T 'Ask for the preset at launch'}"/>
                                    <TextBlock Text="{l:T 'Ask for the preset at launch'}" VerticalAlignment="Center"
                                               ToolTip="{l:T 'Only with several presets – the choice appears in the same window as the values for \{\{placeholders\}\}'}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'At launch'}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <ContentControl Content="{Binding DefaultProfile}" ContentTemplate="{StaticResource LaunchBody}" Focusable="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ===== Fußzeile ===== -->
        <Border Grid.Row="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" MinWidth="110" Height="34" Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="96" Height="34" Click="Cancel_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FirstError}" Foreground="{DynamicResource Status.Error}" FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding FirstError, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Status.Error}" FontSize="{StaticResource Font.Body}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding SaveHint}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
