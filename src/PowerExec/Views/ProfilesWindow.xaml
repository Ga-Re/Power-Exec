<Window x:Class="PowerExec.Desktop.Views.ProfilesWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
        xmlns:v="clr-namespace:PowerExec.Desktop.Views"
        Title="{Binding WindowTitle}" Style="{StaticResource AppWindow}"
        Width="900" Height="800" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Kachel im ersten Schritt -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Tile}"
                                Padding="16,16" Height="96">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Parameterzeile eines Profils -->
        <DataTemplate x:Key="ParamRow">
            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="Note" Text="{Binding Note}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsNotSecure, Converter={StaticResource Vis}}">
                        <UniformGrid Columns="3">
                            <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Fixed'}"
                                         IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Fixed}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Prefilled'}"
                                         IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Preset}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Ask'}"
                                         IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Ask}"/>
                        </UniformGrid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSecure, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock Text="{l:T 'Always asked at launch'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsValueEnabled}"
                                 Visibility="{Binding IsText, Converter={StaticResource Vis}}" Tag="Wert"/>
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsEnabled="{Binding IsValueEnabled}"
                                  Visibility="{Binding IsChoice, Converter={StaticResource Vis}}"/>
                        <CheckBox Content="{l:T 'Enable'}" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsValueEnabled}"
                                  Visibility="{Binding IsCheck, Converter={StaticResource Vis}}"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteIsWarning}" Value="True">
                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Startverhalten eines Profils (Standardprofil und „Weitere Startprofile“) -->
        <DataTemplate x:Key="ProfileOptions">
            <StackPanel>
                <!-- Startoptionen der Art (Browser, Anzeige, Öffnen mit …) -->
                <v:CustomEntryForm DataContext="{Binding Options}" Visibility="{Binding HasOptions, Converter={StaticResource Vis}}" Margin="0,0,0,4"/>
                <StackPanel Visibility="{Binding DataContext.ShowRunAs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                <TextBlock Text="{l:T 'Run as'}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Current account'}" Width="140"
                                     IsChecked="{Binding RunMode, Converter={StaticResource Eq}, ConverterParameter=normal}"/>
                        <RadioButton Style="{StaticResource Segment}" Width="140"
                                     IsChecked="{Binding RunMode, Converter={StaticResource Eq}, ConverterParameter=admin}"
                                     Visibility="{Binding DataContext.ShowAdminMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Foreground="{DynamicResource Status.Warning}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Administrator'}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Different user'}" Width="150"
                                     IsChecked="{Binding RunMode, Converter={StaticResource Eq}, ConverterParameter=other}"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{l:T 'For a different user, Power-Exec asks for the sign-in at every launch – it is never saved.'}"
                           Visibility="{Binding RunMode, Converter={StaticResource EqVis}, ConverterParameter=other}"/>
                </StackPanel>

                <!-- PowerShell -->
                <StackPanel Visibility="{Binding DataContext.ShowPsOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Where'}" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Width="130" Content="{l:T 'This PC'}"
                                         IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Local}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="130" Content="{l:T 'Fixed computers'}"
                                         IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Fixed}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="150" Content="{l:T 'Choose at launch'}"
                                         IsChecked="{Binding Target, Converter={StaticResource Eq}, ConverterParameter=Ask}"/>
                        </StackPanel>
                    </Border>
                    <c:MachineBox Text="{Binding Machines, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                  Visibility="{Binding IsFixedTarget, Converter={StaticResource Vis}}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <ComboBox Width="210" Margin="0,0,16,8" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Engine}"
                                  ItemsSource="{Binding DataContext.Engines, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <CheckBox Content="{l:T 'Keep console open (-NoExit)'}" IsChecked="{Binding NoExit}" Margin="0,8,16,8"/>
                        <CheckBox Content="{l:T 'Without profile (-NoProfile)'}" IsChecked="{Binding NoProfile}" Margin="0,8,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{l:T 'Run dialog'}" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Width="110" Content="{l:T 'Always'}"
                                         IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=Always}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="130" Content="{l:T 'Only when needed'}"
                                         IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=WhenNeeded}"/>
                            <RadioButton Style="{StaticResource Segment}" Width="110" Content="{l:T 'Never'}"
                                         IsChecked="{Binding Dialog, Converter={StaticResource Eq}, ConverterParameter=Never}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding DialogHint}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    <StackPanel Visibility="{Binding DataContext.HasParameters, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                        <TextBlock Text="{l:T 'Parameters'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                        <TextBlock Text="{l:T 'Fixed = always passed · Prefilled = editable in the dialog · Ask = field stays empty'}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParamRow}" Focusable="False"/>
                    </StackPanel>
                </StackPanel>

                <!-- Programme -->
                <StackPanel Visibility="{Binding DataContext.ShowProgramArgs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Additional arguments at launch'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'optional, e.g. /v:SRV-APP02'}"/>
                    <CheckBox Content="{l:T 'Keep console open after finishing'}" IsChecked="{Binding NoExit}" Margin="0,8,0,0"
                              Visibility="{Binding DataContext.SupportsNoExit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <CheckBox Content="{l:T 'Confirm before launch (“Really run?”)'}" IsChecked="{Binding ConfirmBeforeRun}" Margin="0,12,0,0"/>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Kopf: Symbol, Anzeigename, Beschreibung ===== -->
        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="24,16,24,16" Visibility="{Binding ShowForm, Converter={StaticResource Vis}}">
            <DockPanel>
                <!-- Symbol -->
                <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                    <ui:Button Width="60" Height="60" Style="{StaticResource Btn.Standard}" Padding="0" Command="{Binding Entry.ChooseIconCommand}"
                            IsEnabled="{Binding HasEntry}" ToolTip="{l:T 'Choose icon (Fluent 2, Heroicons, emoji, custom image)'}">
                        <Grid>
                            <c:IconPresenter Icon="{Binding Entry.Icon}" Size="32" Visibility="{Binding Entry.HasIcon, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <Image Source="{Binding Entry.AutoIcon, Converter={StaticResource IconImage}}" Width="32" Height="32" Visibility="{Binding Entry.ShowAutoIcon, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="{Binding Entry.Badge}" FontSize="{StaticResource Font.Body}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Entry.ShowBadge, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.Hero}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsScannedFile, Converter={StaticResource Vis}}"/>
                        </Grid>
                    </ui:Button>
                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Automatic'}" Command="{Binding Entry.ClearIconCommand}" FontSize="{StaticResource Font.Caption}" Padding="4,0" MinHeight="22" Height="22"
                            Margin="0,4,0,0" HorizontalAlignment="Center" ToolTip="{l:T 'Use favicon, program or folder icon'}"
                            Visibility="{Binding Entry.HasIcon, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                </StackPanel>
                <!-- Art -->
                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Change type …'}" Command="{Binding ChangeKindCommand}" FontSize="{StaticResource Font.Body}" Padding="8,0" MinHeight="26" Height="26"
                            HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" Visibility="{Binding CanChangeKind, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBox x:Name="NameBox" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HeaderNameHint}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"
                             ToolTip="{l:T 'Display name in the panel'}"/>
                    <TextBox Text="{Binding HeaderDescription, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding HeaderDescriptionHint}" Margin="0,8,0,0"
                             ToolTip="{l:T 'Description in the panel'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,16,24,8">

                <!-- ===== Schritt 1: Art wählen ===== -->
                <StackPanel Visibility="{Binding ShowKindPicker, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Back to entry'}" Command="{Binding BackToFormCommand}"
                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.Header}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Tile}" Command="{Binding DataContext.PickKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.Hero}" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Subtitle}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{l:T 'Or'}" Style="{StaticResource FieldLabel}" Margin="0,8,0,8"/>
                    <Border Style="{StaticResource SectionCard}" Padding="16,12" Visibility="{Binding HasClipboardSuggestion, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Apply'}" Command="{Binding UseClipboardCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XXL}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:T 'From the clipboard'}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ClipboardText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <WrapPanel>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding CatalogCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0"/><TextBlock Text="{l:T 'From templates …'}"/></StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding FilesCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0"/><TextBlock Text="{l:T 'Select files …'}"/></StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>

                <!-- ===== Schritt 2: Formular ===== -->
                <StackPanel Visibility="{Binding ShowForm, Converter={StaticResource Vis}}">
                    <!-- Art-spezifische Felder -->
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasEntry, Converter={StaticResource Vis}}">
                        <v:CustomEntryForm DataContext="{Binding Entry}"/>
                    </Border>

                    <!-- Datei aus einer smarten Gruppe -->
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsScannedFile, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Show in Explorer'}" Command="{Binding OpenFileLocationCommand}" />
                                <TextBlock Text="{Binding FileKindText}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Text="{Binding Item.FullPath, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding FileInfo}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FileParametersText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Startprofile: Liste links, Einstellungen rechts -->
                    <Border Style="{StaticResource SectionCard}" Padding="0">
                        <StackPanel>
                            <StackPanel Margin="20,16,20,12">
                                <TextBlock Text="{l:T 'Launch profiles'}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{l:T '★ = default (click in the panel). More profiles are in the panel in the menu on the Run button.'}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,1,0" CornerRadius="{DynamicResource Radius.Tile.BottomLeft}">
                                    <DockPanel Margin="12,12">
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T '+ New'}" Command="{Binding AddCommand}" Margin="0,0,8,8" FontSize="{StaticResource Font.Body}" />
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Duplicate'}" Command="{Binding DuplicateCommand}" Margin="0,0,8,8" FontSize="{StaticResource Font.Body}" />
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Delete'}" Command="{Binding DeleteCommand}" Margin="0,0,8,8" FontSize="{StaticResource Font.Body}" />
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding SelectCommand}" Margin="0,0,0,4" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}" HorizontalContentAlignment="Stretch">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="{DynamicResource Radius.Card}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="12,8">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="★" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" Visibility="{Binding IsDefault, Converter={StaticResource Vis}}"/>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0">
                                    <StackPanel Margin="20,12,20,16" DataContext="{Binding Selected}">
                                        <WrapPanel>
                                            <StackPanel Width="240" Margin="0,0,16,0">
                                                <TextBlock Text="{l:T 'Profile name'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <CheckBox Content="{l:T 'Default profile (click in the panel)'}" IsChecked="{Binding IsDefault}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileOptions}" Focusable="False" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Allgemein: Gruppe, Schlagworte, Ein-Klick, Notiz -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Organize'}" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Group'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=LostFocus}"
                                              ToolTip="{l:T 'Group in the panel (empty = in the smart group or under “Custom entries”). Just type new names.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T 'Tags'}" Style="{StaticResource FieldLabel}"/>
                                    <c:TagBox TagsText="{Binding TagsText}" Suggestions="{Binding AllTagsList}" Placeholder="{l:T 'Enter adds the tag'}" ToolTip="{l:T 'Search in the panel: #tag'}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding SingleClick}" Content="{l:T 'Start with one click (instead of expanding the entry in the panel)'}"/>
                            <DockPanel Margin="0,12,0,0">
                                <ComboBox DockPanel.Dock="Right" Width="250" ItemsSource="{Binding AskProfileChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding AskProfile}" AutomationProperties.Name="{l:T 'Ask for the profile at launch'}"/>
                                <TextBlock Text="{l:T 'Ask for the profile at launch'}" VerticalAlignment="Center"
                                           ToolTip="{l:T 'Only with several profiles – the choice appears in the same window as the values for \{\{placeholders\}\}'}"/>
                            </DockPanel>
                            <TextBlock Text="{l:T 'Note'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="90"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,8"
                                     Tag="{l:T 'e.g. “Only after consulting the DBA” – appears in the panel and the Run dialog'}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Fußzeile ===== -->
        <Border Grid.Row="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel>
                <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="12,8" MaxHeight="76"
                        Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowForm}" Value="True"/>
                                        <Condition Binding="{Binding ShowStartSection}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Selected.Preview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                    </ScrollViewer>
                </Border>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" MinWidth="110" Height="34" Margin="8,0,0,0" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="96" Height="34" Click="Cancel_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FirstError}" Foreground="{DynamicResource Status.Error}" FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding FirstError, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Status.Error}" FontSize="{StaticResource Font.Body}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding SaveHint}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
