<Window x:Class="PowerExec.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power-Exec" Style="{StaticResource AppWindow}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Prompt" Style="{StaticResource Caption}" Margin="0,4,0,14" TextWrapping="Wrap"/>
        <!-- Je Möglichkeit eine große Schaltfläche mit Symbol, Titel und Erklärung -->
        <ItemsControl x:Name="Options" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Btn.Standard}" Margin="0,0,0,8" Padding="12,10" HorizontalContentAlignment="Stretch" Click="Option_Click"
                            AutomationProperties.Name="{Binding Title}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox x:Name="ForAll" Margin="2,4,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96"/>
        </StackPanel>
    </StackPanel>
</Window>
