<Window x:Class="PowerExec.Views.ScheduleWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title, StringFormat=Planen – {0}}" Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height" MaxHeight="760" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary Source="/Themes/Fluent.xaml"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
                       Text="{l:T 'Startet automatisch, solange Power-Exec läuft (mit „Mit Windows starten“ also dauerhaft). Das Ergebnis steht im Verlauf (Strg+H).'}"/>

            <!-- Bestehende Zeitpläne -->
            <StackPanel Visibility="{Binding HasExisting, Converter={StaticResource Vis}}" Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Neuer Zeitplan'}" Command="{Binding NewCommand}" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{l:T 'Geplant'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Existing}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,6" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Zeitplan entfernen'}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11"/>
                                    </ui:Button>
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding EditCommand}" ToolTip="{l:T 'Bearbeiten'}">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="11"/>
                                    </ui:Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding NextText}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Art -->
            <WrapPanel Margin="0,0,0,10">
                <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Einmal'}" GroupName="Kind" IsChecked="{Binding IsOnce}"/>
                <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Täglich / Wochentage'}" GroupName="Kind" IsChecked="{Binding IsDaily}"/>
                <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Wiederholen alle …'}" GroupName="Kind" IsChecked="{Binding IsInterval}"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsOnce, Converter={StaticResource Vis}}" Margin="0,0,0,10">
                <TextBox Width="120" Height="32" Padding="8,0" Text="{Binding OnceDate, UpdateSourceTrigger=PropertyChanged}" Tag="TT.MM.JJJJ" AutomationProperties.Name="{l:T 'Datum'}"/>
                <TextBox Width="80" Height="32" Padding="8,0" Margin="8,0,0,0" Text="{Binding OnceTime, UpdateSourceTrigger=PropertyChanged}" Tag="HH:MM" AutomationProperties.Name="{l:T 'Uhrzeit'}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding IsDaily, Converter={StaticResource Vis}}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T 'um'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="80" Height="32" Padding="8,0" Text="{Binding DailyTime, UpdateSourceTrigger=PropertyChanged}" Tag="HH:MM" AutomationProperties.Name="{l:T 'Uhrzeit'}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Days}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,12,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInterval, Converter={StaticResource Vis}}" Margin="0,0,0,10">
                <TextBox Width="80" Height="32" Padding="8,0" Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'Intervall in Minuten'}"/>
                <TextBlock Text="{l:T 'Minuten'}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}">
                <TextBlock Text="{l:T 'Startprofil'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ProfileName}" Width="200" Height="30"/>
            </StackPanel>
            <CheckBox Content="{l:T 'Nur bei Fehlern benachrichtigen'}" IsChecked="{Binding NotifyOnlyOnError}" Margin="0,0,0,6"/>
            <CheckBox Content="{l:T 'Verpasste Termine nachholen (Power-Exec lief nicht)'}" IsChecked="{Binding CatchUp}" Margin="0,0,0,6"/>
            <CheckBox Content="{l:T 'Aktiv'}" IsChecked="{Binding Enabled}" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="{l:T 'Fragt ein Startprofil nach Werten, Rechnern oder einer Anmeldung, erscheint zur geplanten Zeit der Dialog. Für unbeaufsichtigte Läufe ein Profil mit festen Werten wählen.'}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Schließen'}" IsCancel="True" MinWidth="96" Click="Close_Click" />
                <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" MinWidth="96" Margin="8,0,0,0" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
