<Window x:Class="PowerExec.Desktop.Views.SettingsWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
        xmlns:v="clr-namespace:PowerExec.Desktop.Views"
        xmlns:s="clr-namespace:PowerExec.Desktop.Views.Settings"
        xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Power-Exec – Settings'}" Style="{StaticResource AppWindow}"
        Width="1120" Height="800" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            Navigation (WPF UI): einklappbarer Rand (☰), einklappbare Oberkategorien, Zurück-Schaltfläche über den Verlauf
            der Abschnitte. Die Leiste
            navigiert zu leeren Seiten (SettingsSectionPage); die Abschnitte liegen im Inhaltsbereich (ContentOverlay).
            Abschnitt ↔ Auswahl gleicht SettingsWindow.xaml.cs ab.
        -->
        <ui:NavigationView x:Name="Nav" Grid.ColumnSpan="2" PaneDisplayMode="Left" IsBackButtonVisible="Visible" IsPaneToggleVisible="True"
                           OpenPaneLength="250" PaneTitle="{l:T 'Settings'}" HeaderVisibility="Collapsed" FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T 'General'}" TargetPageTag="general" TargetPageType="{x:Type v:SettingsSectionPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE713;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Inhalte: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Content'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Content'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Groups'}" TargetPageTag="groups" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Custom entries'}" TargetPageTag="custom" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE71B;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Tags'}" TargetPageTag="tags" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8EC;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Variables'}" TargetPageTag="variables" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE943;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Workspaces'}" TargetPageTag="workspaces" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Marktplatz: eigene Oberkategorie mit den Kategorien des Repositorys -->
                <ui:NavigationViewItem Content="{l:T 'Marketplace'}" IsExpanded="False" AutomationProperties.Name="{l:T 'Marketplace'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE719;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Entries'}" TargetPageTag="market-entries" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE71B;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Scripts'}" TargetPageTag="market-scripts" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE756;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Designs'}" TargetPageTag="market-designs" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Installed'}" TargetPageTag="market-installed" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE73E;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Sources'}" TargetPageTag="market-sources" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE774;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Panel: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Panel'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Panel'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE737;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Appearance'}" TargetPageTag="look" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Behavior'}" TargetPageTag="behavior" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE823;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Ausführung: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Execution'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Execution'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE768;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'PowerShell'}" TargetPageTag="exec" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE756;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Remote'}" TargetPageTag="remote" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE968;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Computer groups'}" TargetPageTag="machines" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE7F4;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Hilfe: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Help'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Help'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE897;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Examples'}" TargetPageTag="samples" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE943;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Diagnostics'}" TargetPageTag="diag" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE9D9;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <TextBlock Text="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Style="{StaticResource Caption}" Margin="16,8,0,12"/>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.ContentOverlay>
        <DockPanel>
        <!-- Suche (wie PowerToys oben in der Mitte) -->
        <Grid DockPanel.Dock="Top" Margin="28,12,28,4" MaxWidth="520" HorizontalAlignment="Stretch">
            <TextBox x:Name="SettingsSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" Tag="{l:T 'Search settings'}">
                    <TextBox.Resources><CornerRadius x:Key="TextBox.CornerRadius">12</CornerRadius></TextBox.Resources>
                </TextBox>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" PlacementTarget="{Binding ElementName=SettingsSearch}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="True" Width="{Binding ActualWidth, ElementName=SettingsSearch}">
                <Border Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Padding="4" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalContentAlignment="Stretch" Padding="10,4" MinHeight="40"
                                        Command="{Binding DataContext.OpenSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.BodyStrong}"/>
                                        <TextBlock Text="{Binding Page}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
        <!-- Update-Hinweis: erscheint in allen Bereichen, sobald eine neue Version gefunden wurde -->
        <Border DockPanel.Dock="Top" Margin="16,12,28,4" Padding="14,12" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Info.Bg}"
                BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="{StaticResource Icon.XXL}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Release notes'}" Command="{Binding ReleaseNotesCommand}" Margin="0,0,8,0" />
                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Update now'}" Command="{Binding InstallUpdateCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerTitle}" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}"/>
                    <TextBlock Text="{Binding Update.Subtitle}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Status.Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Power-Exec will be closed and restarted; unsaved changes here will be lost.'}"
                               FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,4,28,28">

                <!-- Die Seiten liegen übereinander; jede blendet sich über „Section“ selbst ein (Views/Settings/) -->
                <s:CustomEntriesPage/>
                <s:MachineGroupsPage/>
                <s:TagsPage/>
                <s:MarketplacePage/>
                <s:VariablesPage/>
                <s:WorkspacesPage/>
                <s:GeneralPage/>
                <s:GroupsPage/>
                <s:PanelBehaviorPage/>
                <s:PanelAppearancePage/>
                <s:PowerShellPage/>
                <s:RemotePage/>
                <s:SamplesPage/>
                <s:DiagnosticsPage/>

            </Grid>
        </ScrollViewer>
        </DockPanel>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Close'}" MinWidth="110" Height="34" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Discard changes'}" Height="34" Click="Revert_Click"
                        ToolTip="{l:T 'Restore the state from when settings were opened'}" />
                <!-- Speicherstand: „Speichert …“ während der kurzen Wartezeit, danach „Alle Änderungen gespeichert“ -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{l:T 'Changes are applied and saved automatically – there\'s no need for a Save button.'}">
                    <TextBlock x:Name="SaveIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource Icon.L}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource Status.Success}"/>
                    <TextBlock x:Name="SaveHint" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{l:T 'All changes saved'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Snackbar: kurze Rückmeldung unten, blendet nach einigen Sekunden aus -->
        <Border x:Name="SnackbarHost" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Padding="16,10" CornerRadius="{DynamicResource Radius.Tile}" BorderThickness="1" Visibility="Collapsed" Opacity="0" MaxWidth="640" Panel.ZIndex="100"
                Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="SnackbarShift" Y="12"/></Border.RenderTransform>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource Icon.L}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource Status.Success}"/>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" MinHeight="28" Margin="12,0,0,0" Click="SnackbarClose_Click"
                           ToolTip="{l:T 'Close'}" AutomationProperties.Name="{l:T 'Close message'}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource Icon.S}"/>
                </ui:Button>
                <TextBlock x:Name="SnackbarText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
