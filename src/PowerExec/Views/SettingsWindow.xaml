<Window x:Class="PowerExec.Views.SettingsWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        xmlns:v="clr-namespace:PowerExec.Views"
        xmlns:vm="clr-namespace:PowerExec.ViewModels;assembly=PowerExec.UI.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Power-Exec – Settings'}" Style="{StaticResource AppWindow}"
        Width="1120" Height="800" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Themes/Fluent.xaml"/></ResourceDictionary.MergedDictionaries>

        <!-- Löschen-Kreuz auf Design-Kacheln: beim Darüberfahren sanft rot -->
        <Style x:Key="DeleteDesignButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource Bg.CardAlt}" BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock x:Name="Glyph" Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#33E81123" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#80E81123" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#E81123" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Farbkachel wie in den Windows-Einstellungen: Quadrat, ausgewählt mit Rahmen und Häkchen -->
        <DataTemplate x:Key="ColorTile">
            <Button Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,6,6" Cursor="Hand"
                    AutomationProperties.Name="{Binding ToolTip}" FocusVisualStyle="{StaticResource FocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="46" Height="46">
                            <Border x:Name="Swatch" CornerRadius="4" Background="{Binding SwatchColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Panel}"
                                    BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"/>
                            <Border x:Name="Ring" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Text.Primary}" Visibility="Collapsed"/>
                            <Border x:Name="Check" Width="18" Height="18" CornerRadius="0,4,0,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource Text.Primary}" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Bg.Window}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
                            <!-- Gruppenkarte, rekursiv: Untergruppen liegen als Karten im Rahmen der übergeordneten Gruppe -->
        <DataTemplate x:Key="CategoryCardTemplate">
                                <!-- Gruppen ziehen: Lücke über/unter der Karte; die gezogene Gruppe macht Platz -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <c:DropGap IsOpen="{Binding GapBefore}" OpenHeight="44"
                                               Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                               Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" MinHeight="0"
                                        AllowDrop="True" DragOver="GroupCard_DragOver" DragLeave="GroupCard_DragLeave" Drop="GroupCard_Drop">
                                    <StackPanel>
                                        <DockPanel Margin="6,6,8,6" MinHeight="44" Background="Transparent" Cursor="SizeAll"
                                                   PreviewMouseLeftButtonDown="GroupCard_PreviewMouseDown" PreviewMouseMove="GroupCard_PreviewMouseMove"
                                                   ToolTip="{l:T 'Drag to move the group – dropped onto the middle of another group it becomes a subgroup. Right-click: new subgroup'}">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:T 'New subgroup …'}" Command="{Binding NewSubgroupCommand}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{l:T 'Rename …'}" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="{l:T 'Choose icon …'}" Command="{Binding ChooseIconCommand}"/>
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Margin="2,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="{l:T 'Expand/collapse folders and entries'}" Visibility="{Binding IsSmart, Converter={StaticResource Vis}, ConverterParameter=hidden}">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Width="34" Height="34" MinHeight="34" Padding="0" Command="{Binding ChooseIconCommand}"
                                                    ToolTip="{l:T 'Choose icon'}" Margin="4,0,12,0">
                                                <Grid>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="18" Foreground="{DynamicResource Text.Primary}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                    <TextBlock x:Name="DefaultGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Text.Tertiary}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                </Grid>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Height="22" Padding="8,0" CornerRadius="11" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}"
                                                        BorderThickness="1" Margin="0,0,8,0" Visibility="{Binding Folder.HasPending, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding Folder.PendingCount, StringFormat={}{0} neu}" FontSize="11" Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                                                </Border>
                                                <ComboBox Width="150" Margin="0,0,4,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding ColorOwn}" SelectedValuePath="Key"
                                                          ToolTip="{l:T 'Group color (subgroups inherit it)'}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Command="{Binding CustomColorCommand}" ToolTip="{l:T 'Pick your own color in the color picker'}">
                                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ComboBox Width="125" Margin="4,0,8,0" ItemsSource="{Binding LayoutList}" SelectedValue="{Binding Layout}"
                                                          DisplayMemberPath="Value" SelectedValuePath="Key" ToolTip="{l:T 'How this group looks in the panel'}"/>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="{l:T 'Rename (display name)'}">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Delete group (after confirmation)'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Smarte Gruppe: Ordner und seine Einträge -->
                                        <ContentControl Content="{Binding Folder}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSmart}" Value="True"/>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Ordner -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg.CardAlt}" Padding="16,12">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Detach folder'}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                                                                            ToolTip="{l:T 'Stop scanning the folder; the group stays as a normal group'}" />
                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Browse …'}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                                                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'Path, e.g. C:\\Scripts or \\\\server\\share'}"/>
                                                                </DockPanel>
                                                                <WrapPanel Margin="0,10,0,0">
                                                                    <CheckBox Content="{l:T 'Include subfolders'}" IsChecked="{Binding Recursive}" Margin="0,0,20,6" VerticalAlignment="Center"/>
                                                                    <CheckBox Content="{l:T 'Subfolders as subgroups in the panel'}" IsChecked="{Binding SubfoldersAsGroups}" IsEnabled="{Binding Recursive}"
                                                                              Margin="0,0,20,6" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{l:T 'File extensions:'}" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource Text.Secondary}"/>
                                                                    <StackPanel Margin="0,0,0,6">
                                                                        <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                                                                 Tag="{l:T 'empty = default; e.g. .ps1; .cmd'}" FontFamily="{StaticResource MonoFont}"
                                                                                 ToolTip="{l:T 'Separated by semicolons, e.g. .ps1; .cmd; .exe'}"/>
                                                                        <TextBlock Text="{Binding ExtensionsError}" FontSize="11" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" MaxWidth="220"
                                                                                   Visibility="{Binding ExtensionsError, Converter={StaticResource Vis}}"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="{l:T ' · Last scan: '}"/><Run Text="{Binding Status, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Einträge -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                                            <StackPanel>
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBlock Text="{l:T 'New files:'}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                        <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="1" Width="330">
                                            <UniformGrid Columns="2">
                                                <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Show automatically'}" IsChecked="{Binding AutoShow}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Only after approval'}" IsChecked="{Binding RequireApproval}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </WrapPanel>

                                    <Border Visibility="{Binding HasPending, Converter={StaticResource Vis}}" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                                            Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Approve all'}" Command="{Binding ApproveAllCommand}" Height="30" MinHeight="30" FontSize="12" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Keep hidden'}" Command="{Binding DismissPendingCommand}" Height="30" MinHeight="30" FontSize="12" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Show all'}" Command="{Binding AllOnCommand}" Height="28" MinHeight="28" FontSize="12" />
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'None'}" Command="{Binding AllOffCommand}" Height="28" MinHeight="28" FontSize="12" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <Grid Width="240" Margin="0,0,10,0" DockPanel.Dock="Left">
                                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="28,0,8,0" Tag="{l:T 'Search in this folder'}" Height="30" MinHeight="30"/>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource Text.Secondary}"/>
                                        </Grid>
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'All'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Scripts'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=scripts}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Programs'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=programs}"/>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:T 'Panel'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{l:T 'Entry'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{l:T 'Launch profiles'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{l:T 'Admin'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding VisibleRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" MinHeight="50" Background="Transparent">
                                                    <Grid x:Name="RowGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="250"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsVisibleInPanel}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat={}{0} im Panel anzeigen}"/>
                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Width="36" Height="22" CornerRadius="4" Background="{DynamicResource Badge.Other.Bg}"
                                                                    Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Badge.Other.Fg}"/>
                                                            </Border>
                                                            <Image Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="22" Height="22" HorizontalAlignment="Left" Margin="7,0,0,0"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,6,12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="9" Background="{DynamicResource Accent}"
                                                                        Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                                                    <TextBlock Text="{l:T 'NEW'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                                </Border>
                                                                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="9" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}" BorderThickness="1"
                                                                        Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}"
                                                                        ToolTip="{l:T 'Downloaded from the internet – approve it in the panel via “Unblock”'}">
                                                                    <TextBlock Text="{l:T 'BLOCKED'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Status.Warning}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Info}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding ProfilesText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProfileDetail}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Status.Warning}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{l:T 'Yes'}" FontSize="12" Foreground="{DynamicResource Status.Warning}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="5" Style="{StaticResource Btn.Icon}" Width="34" Height="34" Command="{Binding ConfigureCommand}"
                                                                ToolTip="{l:T 'Launch profiles'}" Visibility="{Binding CanToggle, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsVisibleInPanel}" Value="False">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l:T 'No entries for this search.'}" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding NoRows, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{l:T 'No entries yet – the folder is being scanned …'}" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding HasNoEntries, Converter={StaticResource Vis}}"/>

                                    <WrapPanel Margin="0,12,0,0">
                                        <TextBlock Text="{l:T 'Pattern exclusions:'}" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                        <ItemsControl ItemsSource="{Binding Exclusions}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="26" CornerRadius="13" Background="{DynamicResource Excl.Bg}" BorderBrush="{DynamicResource Excl.Border}"
                                                            BorderThickness="1" Padding="10,0,2,0" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource Excl.Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                                            <ui:Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                                                    ToolTip="{l:T 'Remove exclusion'}" Foreground="{DynamicResource Excl.Text}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="28" MinHeight="28" Margin="0,0,6,6"
                                                 Tag="{l:T 'e.g. *.exe or *\\Archive\\*'}" FontSize="12"/>
                                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T '+ Pattern'}" Command="{Binding AddExclusionCommand}" Height="28" MinHeight="28"
                                                FontSize="12" Margin="0,0,0,6" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="{l:T 'Individual files are shown or hidden with the checkbox. Patterns apply immediately; the list updates after scanning.'}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <!-- Untergruppen im Rahmen dieser Gruppe; Lücke „als letzte Untergruppe“ -->
                                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource CategoryCardTemplate}" Focusable="False" Margin="14,2,12,0"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource Vis}}"/>
                                        <c:DropGap IsOpen="{Binding GapInside}" Margin="14,0,12,0" OpenHeight="44"
                                                   Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                                   Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                    </StackPanel>
                                </Border>
                                    <c:DropGap IsOpen="{Binding GapAfter}" OpenHeight="44"
                                               Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                               Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSmart}" Value="True">
                                        <Setter TargetName="DefaultGlyph" Property="Text" Value="&#xE8B7;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Folder.IsHighlighted}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <!-- Gruppe wird hineingezogen: Rahmen der Zielgruppe hervorheben -->
                                    <DataTrigger Binding="{Binding GapInside}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="GroupCard" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
        <!-- Feste Gruppe (Schloss): verschiebbar wie eine Gruppe, aber ohne Untergruppen, Farbe oder Löschen -->
        <DataTemplate x:Key="FixedCardTemplate">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <c:DropGap IsOpen="{Binding GapBefore}" OpenHeight="44"
                           Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" MinHeight="0" Background="{DynamicResource Bg.CardAlt}"
                        AllowDrop="True" DragOver="GroupCard_DragOver" DragLeave="GroupCard_DragLeave" Drop="GroupCard_Drop">
                    <StackPanel>
                        <DockPanel Margin="6,6,12,6" MinHeight="44" Background="Transparent" Cursor="SizeAll"
                                   PreviewMouseLeftButtonDown="GroupCard_PreviewMouseDown" PreviewMouseMove="GroupCard_PreviewMouseMove"
                                   ToolTip="{l:T 'Fixed group – drag to move it. Show or hide per workspace.'}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Margin="2,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="34,0,12,0" CornerRadius="4">
                                <TextBlock Text="{Binding FixedGlyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Text.Secondary}"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Zuletzt ausgeführt: wie viele -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecentFixed, Converter={StaticResource Vis}}">
                                    <Slider Width="140" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding DataContext.RecentRunsCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="{Binding DataContext.RecentRunsText, RelativeSource={RelativeSource AncestorType=Window}}" Width="80" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Manage …'}" Visibility="{Binding IsCustomFixed, Converter={StaticResource Vis}}"
                                        Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="custom" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               VerticalAlignment="Center" ToolTip="{l:T 'Fixed group: cannot be deleted'}" AutomationProperties.Name="{l:T 'Fixed group'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FixedDescription}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <c:DropGap IsOpen="{Binding GapAfter}" OpenHeight="44"
                           Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            Navigation (WPF UI): einklappbarer Rand (☰), einklappbare Oberkategorien, Zurück-Schaltfläche über den Verlauf
            der Abschnitte. Die Leiste
            navigiert zu leeren Seiten (SettingsSectionPage); die Abschnitte liegen im Inhaltsbereich (ContentOverlay).
            Abschnitt ↔ Auswahl gleicht SettingsWindow.xaml.cs ab.
        -->
        <ui:NavigationView x:Name="Nav" Grid.ColumnSpan="2" PaneDisplayMode="Left" IsBackButtonVisible="Visible" IsPaneToggleVisible="True"
                           OpenPaneLength="250" PaneTitle="{l:T 'Settings'}" HeaderVisibility="Collapsed" FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T 'General'}" TargetPageTag="general" TargetPageType="{x:Type v:SettingsSectionPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE713;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Inhalte: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Content'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Content'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Groups'}" TargetPageTag="groups" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Custom entries'}" TargetPageTag="custom" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE71B;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Tags'}" TargetPageTag="tags" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8EC;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Variables'}" TargetPageTag="variables" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE943;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Workspaces'}" TargetPageTag="workspaces" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Marktplatz: eigene Oberkategorie mit den Kategorien des Repositorys -->
                <ui:NavigationViewItem Content="{l:T 'Marketplace'}" IsExpanded="False" AutomationProperties.Name="{l:T 'Marketplace'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE719;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Entries'}" TargetPageTag="market-entries" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE71B;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Scripts'}" TargetPageTag="market-scripts" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE756;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Designs'}" TargetPageTag="market-designs" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Installed'}" TargetPageTag="market-installed" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE73E;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Sources'}" TargetPageTag="market-sources" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE774;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Panel: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Panel'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Panel'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE737;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Appearance'}" TargetPageTag="look" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Behavior'}" TargetPageTag="behavior" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE823;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Ausführung: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Execution'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Execution'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE768;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'PowerShell'}" TargetPageTag="exec" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE756;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Remote'}" TargetPageTag="remote" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE968;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Computer groups'}" TargetPageTag="machines" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE7F4;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Hilfe: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Help'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Help'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE897;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Examples'}" TargetPageTag="samples" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE943;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Diagnostics'}" TargetPageTag="diag" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE9D9;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <TextBlock Text="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Style="{StaticResource Caption}" Margin="16,8,0,12"/>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.ContentOverlay>
        <DockPanel>
        <!-- Suche (wie PowerToys oben in der Mitte) -->
        <Grid DockPanel.Dock="Top" Margin="28,12,28,4" MaxWidth="520" HorizontalAlignment="Stretch">
            <TextBox x:Name="SettingsSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" Tag="{l:T 'Search settings'}">
                    <TextBox.Resources><CornerRadius x:Key="TextBox.CornerRadius">12</CornerRadius></TextBox.Resources>
                </TextBox>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" PlacementTarget="{Binding ElementName=SettingsSearch}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="True" Width="{Binding ActualWidth, ElementName=SettingsSearch}">
                <Border Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalContentAlignment="Stretch" Padding="10,4" MinHeight="40"
                                        Command="{Binding DataContext.OpenSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"/>
                                        <TextBlock Text="{Binding Page}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
        <!-- Update-Hinweis: erscheint in allen Bereichen, sobald eine neue Version gefunden wurde -->
        <Border DockPanel.Dock="Top" Margin="16,12,28,4" Padding="14,12" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="18" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Release notes'}" Command="{Binding ReleaseNotesCommand}" Margin="0,0,8,0" />
                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Update now'}" Command="{Binding InstallUpdateCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Update.Subtitle}" FontSize="12" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Power-Exec will be closed and restarted; unsaved changes here will be lost.'}"
                               FontSize="11" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,4,28,28">

                <!-- Eigene Einträge -->
                <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=custom}">
                <StackPanel DataContext="{Binding EntryList}">
                    <TextBlock Text="{l:T 'Custom entries'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Websites, folders, Remote Desktop, SSH, snippets, Windows tools, commands and individual files. ⚙ edits an entry; select several to move, export or delete them. Entries can be dragged straight into the panel to sort them into a group.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Werkzeugleiste -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource Btn.Accent}" Click="NewEntryMenu_Click" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'New'}"/>
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0"/></StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T 'New entry …'}" Command="{Binding NewCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T 'Website …'}" Command="{Binding NewCommand}" CommandParameter="Url"/>
                                        <MenuItem Header="{l:T 'Folder …'}" Command="{Binding NewCommand}" CommandParameter="Folder"/>
                                        <MenuItem Header="{l:T 'Remote Desktop …'}" Command="{Binding NewCommand}" CommandParameter="Rdp"/>
                                        <MenuItem Header="{l:T 'SSH connection …'}" Command="{Binding NewCommand}" CommandParameter="Ssh"/>
                                        <MenuItem Header="{l:T 'PowerShell snippet …'}" Command="{Binding NewCommand}" CommandParameter="Snippet"/>
                                        <MenuItem Header="{l:T 'Text snippet …'}" Command="{Binding NewCommand}" CommandParameter="TextSnippet"/>
                                        <MenuItem Header="{l:T 'Windows tool …'}" Command="{Binding NewCommand}" CommandParameter="Tool"/>
                                        <MenuItem Header="{l:T 'Command …'}" Command="{Binding NewCommand}" CommandParameter="Command"/>
                                        <MenuItem Header="{l:T 'File …'}" Command="{Binding NewCommand}" CommandParameter="File"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T 'From templates …'}" Command="{Binding CatalogCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </ui:Button>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Import …'}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Search (name, target, code, #tag)'}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <!-- Typ-Filter: die häufigsten als Chips, der Rest im Dropdown – bleibt auch in schmalen Fenstern einzeilig -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'All'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Websites'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Url}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Snippets'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Snippet}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'RDP/SSH'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=remote}"/>
                        <ComboBox Width="170" Margin="4,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding MoreKinds}" SelectedValue="{Binding MoreKind}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{l:T 'More types'}"/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding CheckCommand}"
                                ToolTip="{l:T 'Check websites, folders, files, RDP/SSH ports and programs (selection or all visible)'}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="{Binding CheckText}"/></StackPanel>
                        </ui:Button>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="190" ItemsSource="{Binding GroupFilters}" SelectedValue="{Binding GroupFilter}" DisplayMemberPath="Value" SelectedValuePath="Key">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Style.Triggers>
                                            <!-- Trennlinie zwischen festen Filtern und Gruppen -->
                                            <DataTrigger Binding="{Binding Key}" Value="—sep">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ComboBoxItem">
                                                            <Separator Margin="8,4" Background="{DynamicResource Border.Default}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding TagFilters}" SelectedValue="{Binding TagFilter}" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Mehrfachauswahl -->
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox Width="190" IsEditable="True" ItemsSource="{Binding MoveTargets}" Text="{Binding MoveTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Move to group'}" Command="{Binding MoveSelectedCommand}" Margin="0,2,10,2" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Export …'}" Command="{Binding ExportCommand}" Margin="0,2,6,2" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Delete'}" Command="{Binding RemoveSelectedCommand}" Margin="0,2,6,2" />
                            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Clear selection'}" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Text="{l:T 'No custom entries yet. “New” (also from templates) – or in the panel via drag &amp; drop, Ctrl+V and right-click.'}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{l:T 'No results for search and filter.'}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding NoMatches, Converter={StaticResource Vis}}"/>

                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <!-- Kopfzeile -->
                            <Grid Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'All'}" FontSize="11" Padding="2,0" MinHeight="22" Height="22" Command="{Binding SelectAllCommand}"
                                        Grid.ColumnSpan="2" HorizontalAlignment="Left" ToolTip="{l:T 'Select all visible'}" />
                                <TextBlock Grid.Column="2" Text="{l:T 'Entry'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{l:T 'Group / tags'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding VisibleRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="EntryRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,5" Background="Transparent"
                                                PreviewMouseLeftButtonDown="EntryRow_PreviewMouseLeftButtonDown" PreviewMouseMove="EntryRow_PreviewMouseMove"
                                                ToolTip="{l:T 'Drag into the panel to sort it in (to the screen edge, the panel slides out)'}" ToolTipService.InitialShowDelay="1500">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="76"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Width="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Width="32" Height="20" CornerRadius="4" Background="{DynamicResource Badge.Other.Bg}"
                                                            Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Badge.Other.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Source="{Binding Image, Converter={StaticResource IconImage}}" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0"
                                                           Visibility="{Binding HasImage, Converter={StaticResource Vis}}"/>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="20" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Primary}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="8,1,0,0"/>
                                                        <TextBlock Text="&#xE8B0;" Style="{StaticResource Icon}" FontSize="11" Margin="6,1,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                                                   ToolTip="{l:T 'Starts with one click'}" Visibility="{Binding SingleClick, Converter={StaticResource Vis}}"/>
                                                        <TextBlock Text="{}{{…}}" FontSize="11" Margin="6,1,0,0" Foreground="{DynamicResource Accent}" ToolTip="{l:T 'With placeholders'}"
                                                                   Visibility="{Binding HasPlaceholders, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False"/>
                                                </StackPanel>
                                                <Ellipse x:Name="Dot" Grid.Column="4" Width="9" Height="9" Fill="{DynamicResource Text.Disabled}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         ToolTip="{Binding HealthText}"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding EditCommand}" ToolTip="{l:T 'Edit'}">
                                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Remove'}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="EntryRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EntryRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="EntryRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthOk}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthOk}" Value="False">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>

                <!-- Rechnergruppen -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=machines}">
                    <TextBlock Text="{l:T 'Computer groups'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Groups bundle computers. In the Run dialog you pick a group with one click; in launch profiles you enter it as @Name (e.g. @Webservers). Groups are resolved at launch – changes apply immediately to all profiles.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding AddGroupCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Add group'}"/></StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding ImportGroupFromListCommand}" Margin="8,0,0,0"
                                   ToolTip="{l:T 'New group from a name list or CSV file – dynamic, with filters'}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Import group from list …'}"/></StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <TextBlock Text="{l:T 'No groups yet.'}" Style="{StaticResource Caption}" Visibility="{Binding HasNoGroups, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding MachineGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8,8,16,8" MinHeight="0">
                                    <StackPanel>
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="{l:T 'Show computers'}" Margin="0,0,6,0">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Delete group'}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding ExportCommand}"
                                                       ToolTip="{l:T 'Export group (CSV or text)'}" AutomationProperties.Name="{l:T 'Export'}">
                                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding SyncNowCommand}"
                                                       Visibility="{Binding CanSync, Converter={StaticResource Vis}}"
                                                       ToolTip="{l:T 'Sync now (read from AD or the list)'}" AutomationProperties.Name="{l:T 'Sync'}">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </ui:Button>
                                            <TextBlock Text="@" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource Text.Secondary}"/>
                                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Group name'}"/>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                                       Margin="12,0,8,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="36,0,0,4">
                                        <!-- Quelle: feste Liste, dynamisch aus einer Liste (Datei mit Filtern) oder aus dem AD (Regeln) -->
                                        <DockPanel Margin="0,8,0,0">
                                            <ComboBox DockPanel.Dock="Right" Width="210" ItemsSource="{Binding Sources}" SelectedValue="{Binding Source}"
                                                      DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{l:T 'Computer group source'}"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{l:T 'Source'}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"
                                                           Text="{l:T 'Dynamic groups are refreshed at startup and regularly – the last found list also applies offline.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Dynamisch aus einer Liste: Datei, Namensspalte, Filter -->
                                        <StackPanel Visibility="{Binding IsListSource, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{l:T 'List'}" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Choose file …'}" Command="{Binding ChooseListCommand}" Margin="6,0,0,0"/>
                                                <TextBox Text="{Binding ListPath, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Tag="{l:T 'Text (one computer per line) or CSV with columns'}"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8" Visibility="{Binding IsCsv, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{l:T 'Names in'}" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding ListColumns}" SelectedItem="{Binding NameColumn}"
                                                          AutomationProperties.Name="{l:T 'Column with the computer names'}"/>
                                            </DockPanel>
                                            <TextBlock Text="{l:T 'Filters – all must match (for a name list by name, for a CSV by every column)'}"
                                                       Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding ListFilters}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="30" Command="{Binding RemoveCommand}"
                                                                       ToolTip="{l:T 'Remove filter'}" AutomationProperties.Name="{l:T 'Remove filter'}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                            </ui:Button>
                                                            <ComboBox DockPanel.Dock="Left" Width="190" ItemsSource="{Binding Columns}" SelectedItem="{Binding Column}"
                                                                      AutomationProperties.Name="{l:T 'Column'}"/>
                                                            <ComboBox DockPanel.Dock="Left" Width="170" Margin="6,0,0,0" ItemsSource="{Binding Operators}" DisplayMemberPath="Value"
                                                                      SelectedValuePath="Key" SelectedValue="{Binding Operator}" AutomationProperties.Name="{l:T 'Comparison'}"/>
                                                            <TextBox Margin="6,0,4,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="{l:T 'Value (with “equals”, * and ? work)'}"
                                                                     Visibility="{Binding NeedsValue, Converter={StaticResource Vis}}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Left" Command="{Binding AddFilterCommand}" Padding="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="{l:T 'Filter (AND)'}" Foreground="{DynamicResource Accent}"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MachinesInline}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Secondary}" MaxHeight="90"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsStatic, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding Machines, UpdateSourceTrigger=PropertyChanged, Delay=300}" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6"
                                                 FontFamily="{StaticResource MonoFont}" Margin="0,8,0,0" Tag="{l:T 'One computer per line (or separated by commas)'}"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Sort'}" Command="{Binding SortCommand}" Margin="8,0,0,0" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Import CSV/text …'}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBox Text="{Binding AdQuery, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'AD: SRV-*  ·  OU=Server,DC=company,DC=local  ·  (operatingSystem=*Server*)'}"
                                                     Width="380" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Add from AD'}" Command="{Binding AdSearchCommand}" Margin="8,0,0,0" HorizontalAlignment="Left" />
                                        </DockPanel>
                                        </StackPanel>
                                        <!-- Regelblöcke: innerhalb UND, zwischen den Blöcken ODER -->
                                        <StackPanel Visibility="{Binding IsDynamic, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{l:T 'From OU'}" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding PickOuCommand}" Margin="6,0,0,0"
                                                           ToolTip="{l:T 'Show the OU tree from Active Directory and select an OU'}" AutomationProperties.Name="{l:T 'Select OU'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{l:T 'Choose OU …'}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                                <TextBox Text="{Binding SearchBase, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Tag="{l:T 'empty = whole domain · e.g. OU=Server,DC=company,DC=local'}"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{l:T 'OR'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="12,4,0,4"
                                                                       Visibility="{Binding IsFirst, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="10,8" Background="{DynamicResource Bg.CardAlt}">
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding RemoveCommand}"
                                                                                ToolTip="{l:T 'Remove block'}" AutomationProperties.Name="{l:T 'Remove block'}">
                                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11"/>
                                                                        </ui:Button>
                                                                        <TextBlock Text="{l:T 'All rules match'}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Margin="0,0,0,6">
                                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="30" Command="{Binding RemoveCommand}"
                                                                                            ToolTip="{l:T 'Remove rule'}" AutomationProperties.Name="{l:T 'Remove rule'}">
                                                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                                                    </ui:Button>
                                                                                    <!-- Attribut: Vorgabe wählen oder eigenes LDAP-Attribut eintippen -->
                                                                                    <ComboBox DockPanel.Dock="Left" Width="190" IsEditable="True" ItemsSource="{Binding AttributeChoices}" DisplayMemberPath="Value"
                                                                                              Text="{Binding AttributeText, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'Attribute – you can also type your own LDAP attribute'}"/>
                                                                                    <ComboBox DockPanel.Dock="Left" Width="170" Margin="6,0,0,0" ItemsSource="{Binding Operators}" DisplayMemberPath="Value"
                                                                                              SelectedValuePath="Key" SelectedValue="{Binding Operator}"/>
                                                                                    <TextBox Margin="6,0,4,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="{Binding ValueHint}"
                                                                                             Visibility="{Binding NeedsValue, Converter={StaticResource Vis}}"/>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Left" Command="{Binding AddRuleCommand}" Padding="6,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                                                                            <TextBlock Text="{l:T 'Rule (AND)'}" Foreground="{DynamicResource Accent}"/>
                                                                        </StackPanel>
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Margin="0,8,0,0">
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding SyncNowCommand}" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{l:T 'Read from AD now'}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Standard}" HorizontalAlignment="Left" Command="{Binding AddBlockCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{l:T 'Block (OR)'}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </DockPanel>
                                            <TextBlock Text="{Binding RulesError}" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasRulesError, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MachinesInline}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Secondary}" MaxHeight="90"/>
                                            <Expander Header="{l:T 'Show LDAP filter'}" Margin="0,6,0,0" FontSize="11">
                                                <TextBox Text="{Binding FilterPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                         Padding="6,4" Margin="0,4,0,0"/>
                                            </Expander>
                                        </StackPanel>
                                        </StackPanel>
                                        <!-- Rückmeldung (Synchronisieren, Export, OU) – auch im eingeklappten Zustand -->
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="11" Margin="36,6,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Status, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{l:T 'The AD search runs with your signed-in account. A name with * as wildcard, an OU (all computers in it) or your own LDAP filter in parentheses.'}"/>
                    <c:SettingsCard Icon="&#xE895;" Header="{l:T 'Refresh dynamic groups'}" Margin="0,12,0,0"
                                    Description="{l:T 'At Power-Exec startup and then at this interval in the background. Without a connection to AD, the last found list stays.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding AdSyncIntervals}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding AdSyncIntervalHours}"/>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Inhalte › Schlagworte -->
                <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=tags}">
                <StackPanel DataContext="{Binding TagList}">
                    <TextBlock Text="{l:T 'Tags'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'All tags of your entries. In the panel, #tag in the search filters by tag. Renaming to an existing name merges both.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Find tag'}"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                    </Grid>
                    <TextBlock Text="{l:T 'No tags yet. You assign them in the entry dialog under “Sort”.'}" Style="{StaticResource Caption}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4" MinHeight="0">
                                    <StackPanel>
                                        <DockPanel Margin="6,6,8,6">
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="{l:T 'Show entries'}">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox Width="170" Margin="0,0,2,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding Color}" SelectedValuePath="Key" ToolTip="{l:T 'Tag color'}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Margin="0,0,8,0" Command="{Binding CustomColorCommand}"
                                                        ToolTip="{l:T 'Pick your own color in the color picker'}" AutomationProperties.Name="{l:T 'Custom color'}">
                                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="{l:T 'Rename or merge'}">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding DeleteCommand}" ToolTip="{l:T 'Remove from all entries'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Border Background="{Binding ChipColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Chip}" CornerRadius="11" Padding="10,2,10,3">
                                                    <TextBlock Text="{Binding Tag, StringFormat=#{0}}" FontSize="13"/>
                                                </Border>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                                Background="{DynamicResource Bg.CardAlt}" Padding="44,8,16,10">
                                            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel x:Name="TagEntryRow" Background="Transparent" Margin="0,1">
                                                            <!-- ✕ nimmt nur diesem Eintrag das Schlagwort -->
                                                            <ui:Button x:Name="TagEntryRemove" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Opacity="0.55"
                                                                    Command="{Binding RemoveCommand}" ToolTip="{l:T 'Remove tag from this entry'}" AutomationProperties.Name="{l:T 'Remove'}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                            </ui:Button>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="TagEntryRow" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TagEntryRemove" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Grid>

                <!-- Marktplatz (eigener Bereich): Einträge, Scripte, Designs, Installiert, Quellen – aus Git-Ordnern -->
                <StackPanel Visibility="{Binding DataContext.IsMarketplaceSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" DataContext="{Binding MarketplacePage}">
                    <TextBlock Text="{Binding DataContext.PageTitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding IsListPage, Converter={StaticResource Vis}}"
                               Text="{l:T 'Ready-made entries, scripts and designs from Git folders – from the bundled marketplace and your own sources. Expand groups, check individual files or whole groups and download them. Entries and scripts end up in your custom entries in the group of your choice; you create any required variables once along the way.'}"/>
                    <!-- Quellen -->
                    <StackPanel Visibility="{Binding IsSourcesPage, Converter={StaticResource Vis}}" Margin="0,4,0,0">
                        <DockPanel Margin="0,0,0,12">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding AddSourceCommand}" Margin="12,0,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T 'Add source …'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="{l:T 'Add more marketplaces by repository URL (GitHub or GitLab) – e.g. your team\'s catalog. Third-party sources are confirmed once before the first installation.'}"/>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                        <ItemsControl ItemsSource="{Binding SourceList}" Focusable="False" Margin="12,6,12,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Style="{StaticResource SubSetting}">
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}"
                                                   ToolTip="{l:T 'Remove source'}" AutomationProperties.Name="{l:T 'Remove source'}"
                                                   Visibility="{Binding CanRemove, Converter={StaticResource Vis}}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                                        </ui:Button>
                                        <TextBlock DockPanel.Dock="Left" Width="22" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBar.Warning.Icon}"/>
                                                    <Setter Property="ToolTip" Value="{l:T 'Not confirmed as trusted yet'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trusted}" Value="True">
                                                            <Setter Property="Text" Value="&#xE83F;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBar.Success.Icon}"/>
                                                            <Setter Property="ToolTip" Value="{l:T 'Trusted'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Url}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SourceSummary" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter TargetName="SourceSummary" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Border>
                    </StackPanel>
                    <!-- Listen: Suche, Quelle, Aktualisieren -->
                    <DockPanel Margin="0,16,0,6" Visibility="{Binding IsListPage, Converter={StaticResource Vis}}">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="{l:T 'Reload marketplace'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Update'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ComboBox DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" ItemsSource="{Binding SourceChoices}" SelectedValue="{Binding SourceFilter}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Source'}"
                                  Visibility="{Binding HasSeveralSources, Converter={StaticResource Vis}}"/>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Search marketplace'}"
                                     AutomationProperties.Name="{l:T 'Search marketplace'}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="2,0,0,8" Visibility="{Binding HasRows, Converter={StaticResource Vis}}"/>
                    <c:InfoBar Severity="Error" Message="{Binding Error}"/>
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding InstallSelectedText}" Command="{Binding InstallSelectedCommand}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{Binding UninstallSelectedText}" Command="{Binding UninstallSelectedCommand}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Clear selection'}" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Border>
                    <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="4,8"
                                     Visibility="{Binding IsLoading, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{l:T 'No results.'}" Style="{StaticResource Caption}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.Resources>
                                <!-- Ordner -->
                                <DataTemplate DataType="{x:Type vm:MarketplaceFolderRow}">
                                    <Border x:Name="FolderRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,3" Background="Transparent">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Width="28" IsThreeState="False" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Select folder'}"/>
                                            <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Command="{Binding InstallCommand}" ToolTip="{l:T 'Download all files in this folder'}"
                                                       Padding="8,0" MinHeight="28" Height="28">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{l:T 'Load folder'}" FontSize="12"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleCommand}"
                                                       ToolTip="{l:T 'Expand/collapse'}" AutomationProperties.Name="{l:T 'Expand or collapse'}">
                                                <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10"/>
                                            </ui:Button>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
                                                </TextBlock.InputBindings>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="  "/><Run Text="{Binding CountText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                        </DataTrigger>
                                        <Trigger SourceName="FolderRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FolderRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                                <!-- Datei -->
                                <DataTemplate DataType="{x:Type vm:MarketplaceItemRow}">
                                    <Border x:Name="ItemRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,4" Background="Transparent">
                                      <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="108"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Select'}"/>
                                            <Border Grid.Column="1" Width="{Binding Indent}"/>
                                            <DockPanel Grid.Column="2" Margin="32,0,10,0" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                                    <TextBlock Text="{Binding Needs}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Needs, Converter={StaticResource Vis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- Design: dieselbe Vorschau wie unter Darstellung -->
                                            <c:DesignPreview Grid.Column="3" Width="150" Height="84" Margin="0,2,12,2" Design="{Binding DesignPreset}"
                                                             Visibility="{Binding HasDesign, Converter={StaticResource Vis}}" ToolTip="{Binding DesignBackdropText}"/>
                                            <TextBlock x:Name="State" Grid.Column="4" Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding TogglePreviewCommand}" ToolTip="{l:T 'Preview'}"
                                                           AutomationProperties.Name="{l:T 'Preview'}" Visibility="{Binding IsEntryOrScript, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding InstallCommand}" ToolTip="{Binding InstallText}"
                                                           AutomationProperties.Name="{Binding InstallText}" Visibility="{Binding CanInstall, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding UninstallCommand}" ToolTip="{l:T 'Uninstall'}"
                                                           AutomationProperties.Name="{l:T 'Uninstall'}" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Vorschau: Art, Ziel bzw. Code, benötigte Variablen mit Typ -->
                                        <Border Margin="60,4,4,6" Padding="12,10" CornerRadius="6" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                                Visibility="{Binding IsPreviewOpen, Converter={StaticResource Vis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding EntryKindText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
                                                <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" BorderThickness="0" Background="Transparent" Padding="0"/>
                                                <TextBlock Text="{l:T 'Required variables'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,0"
                                                           Visibility="{Binding HasVariables, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="{Binding VariablesText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasVariables, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </Border>
                                      </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="ItemRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter TargetName="ItemRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <!-- Variablen: {{$Name}} in Texten, Links, Befehlen und Code -->
                <StackPanel Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqVis}, ConverterParameter=variables}" DataContext="{Binding VariablesPage}">
                    <TextBlock Text="{l:T 'Variables'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{l:T 'Write variables as \{\{$Name\}\} in texts, links, commands, targets, PowerShell code and script parameters – Power-Exec inserts the value at launch without asking. Normal \{\{placeholders\}\} are still asked for before launch.'}"/>

                    <TextBlock Text="{l:T 'Built-in'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE787;" Header="{l:T 'Date, time, user, computer, clipboard'}"
                                        Description="{l:T 'Always available. You set the format of date and time here.'}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Builtins}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Style="{StaticResource SubSetting}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Preview}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"
                                                       MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Token}" FontFamily="{StaticResource MonoFont}" Width="190" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ComboBox DockPanel.Dock="Right" Width="220" IsEditable="True" ItemsSource="{Binding DateFormats}"
                                          Text="{Binding DateFormat, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Date format'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Format of \{\{$Date\}\}'}"/>
                                    <TextBlock Text="{l:T '.NET format, e.g. dd.MM.yyyy or yyyy-MM-dd.'}" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ComboBox DockPanel.Dock="Right" Width="220" IsEditable="True" ItemsSource="{Binding TimeFormats}"
                                          Text="{Binding TimeFormat, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Time format'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Format of \{\{$Time\}\}'}"/>
                                    <TextBlock Text="{l:T '.NET format, e.g. HH:mm or HH:mm:ss.'}" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <!-- Eigene Variablen als kompakte Tabelle (wie „Eigene Einträge“): Suche, Häkchen, Bearbeiten im Dialog -->
                    <TextBlock Text="{l:T 'Custom variables'}" Style="{StaticResource SettingsSection}"/>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding AddCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'New'}"/></StackPanel>
                        </ui:Button>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Search variables (name, value, description)'}"
                                     AutomationProperties.Name="{l:T 'Search variables'}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Delete'}" Command="{Binding RemoveSelectedCommand}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Clear selection'}" Command="{Binding SelectAllCommand}" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Border>
                    <TextBlock Text="{l:T 'No custom variables yet – e.g. \{\{$CompanyName\}\} for the company name in signatures and replies.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding HasNoItems, Converter={StaticResource Vis}}"/>
                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasNoItems, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <Grid Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="108"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'All'}" FontSize="11" Padding="2,0" MinHeight="22" Height="22" Command="{Binding SelectAllCommand}"
                                           HorizontalAlignment="Left" ToolTip="{l:T 'Select all visible'}"/>
                                <TextBlock Grid.Column="1" Text="{l:T 'Variable'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{l:T 'Kind'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{l:T 'Current value'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding VisibleItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="VarRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,5" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="108"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Select'}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Token}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding KindText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Preview}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding CopyTokenCommand}" ToolTip="{l:T 'Copy \{\{$Name\}\}'}">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding EditCommand}" ToolTip="{l:T 'Edit'}">
                                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Delete'}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="VarRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="VarRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="VarRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Arbeitsbereiche -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=workspaces}">
                    <TextBlock Text="{l:T 'Workspaces'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Workspaces show a selection of your groups – e.g. per customer or task. Groups, folders and custom entries exist only once; each workspace has its own favorites, “Recently run”, launch profiles and collapsed groups. You can also switch in the panel header and the tray menu.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding Workspaces}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0" MinHeight="0">
                                    <StackPanel>
                                        <DockPanel Margin="6,8,12,8">
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="{l:T 'Choose the groups of this workspace'}" Margin="0,0,8,0">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Info.Bg}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{l:T 'Active'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Groups …'}" Command="{Binding ToggleCommand}" Margin="0,0,8,0" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Switch'}" Command="{Binding ActivateCommand}" Margin="0,0,8,0"
                                                        ToolTip="{l:T 'Applies the settings and switches the workspace'}" />
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Delete'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBox Width="280" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                                Background="{DynamicResource Bg.CardAlt}" Padding="20,10,16,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'These groups appear in the panel (Favorites, Recently run and Search show everything):'}" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <TextBlock Text="{l:T 'No groups created yet.'}" Style="{StaticResource Caption}"
                                                           Visibility="{Binding Groups.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Margin="{Binding IndentLeft, Converter={StaticResource LeftMargin}}" Padding="6,0,0,0" MinHeight="30">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Grid Width="18" Margin="0,0,8,0">
                                                                        <c:IconPresenter Icon="{Binding Icon}" Size="15" Foreground="{DynamicResource Text.Primary}"
                                                                                         Visibility="{Binding Icon, Converter={StaticResource Vis}}"/>
                                                                        <TextBlock x:Name="WsGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                                                                   Visibility="{Binding Icon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                                                               VerticalAlignment="Center" ToolTip="{l:T 'Fixed group'}" Visibility="{Binding IsFixed, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                    <Setter TargetName="WsGlyph" Property="Text" Value="{Binding FixedGlyph}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:SettingsCard Icon="&#xE710;" Header="{l:T 'New workspace'}" Description="{l:T '“Copy current” copies favorites, launch profiles and group selection.'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="220" Text="{Binding NewWorkspace, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Name, e.g. Customer A'}" VerticalAlignment="Center"/>
                                <CheckBox Content="{l:T 'Copy current'}" IsChecked="{Binding CopyWorkspace}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="{l:T 'Copy favorites, launch profiles and group selection'}"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Create'}" Command="{Binding AddWorkspaceCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Allgemein -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=general}">
                    <TextBlock Text="{l:T 'General'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Team catalogs'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE716;" Header="{l:T 'Shared entries from the team'}" IsExpanded="True"
                                        Description="{l:T 'Put an exported group (right-click › Export) on a share and subscribe to it here. Power-Exec checks for changes at startup and every 30 minutes. Catalog entries are read-only; favorites and custom entries in the group stay local.'}">
                        <c:SettingsExpander.HeaderContent>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Check now'}" Command="{Binding CheckCatalogsCommand}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"
                                            Visibility="{Binding HasCatalogs, Converter={StaticResource Vis}}" />
                                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Subscribe …'}" Command="{Binding SubscribeCatalogCommand}" />
                                </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <TextBlock Text="{l:T 'No team catalog subscribed yet.'}" Style="{StaticResource Caption}" Margin="0,10,0,4"
                                       Visibility="{Binding HasCatalogs, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            <c:InfoBar Severity="Error" Message="{Binding CatalogError}" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding CatalogRows}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource Bg.CardAlt}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Apply'}" Command="{Binding ApplyCommand}" Foreground="{DynamicResource Accent}"
                                                            Visibility="{Binding HasPending, Converter={StaticResource Vis}}" />
                                                    <CheckBox Content="{l:T 'apply automatically'}" IsChecked="{Binding AutoApply}" VerticalAlignment="Center" Margin="8,0" FontSize="12"/>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Unsubscribe (entries are removed)'}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CatStatus" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                <Setter TargetName="CatStatus" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </c:SettingsExpander>
                    <TextBlock Text="{l:T 'Version and updates'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE895;" Header="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Description="{Binding UpdateStatus}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Introduction'}" Command="{Binding ShowWelcomeCommand}" Foreground="{DynamicResource Accent}"
                                        ToolTip="{l:T 'Run the setup assistant again (folders, edge, hotkey)'}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Release notes'}" Command="{Binding CurrentReleaseNotesCommand}" Foreground="{DynamicResource Accent}"
                                        ToolTip="{l:T 'What\'s new in this version? (GitHub)'}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Check for updates'}" Command="{Binding CheckUpdatesCommand}" />
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CheckUpdatesOnStart}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T 'Check for updates at startup'}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IncludePrereleases}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{l:T 'Include pre-releases'}"/>
                                    <TextBlock Text="{l:T 'New features earlier – may still contain bugs.'}" Style="{StaticResource Caption}" FontSize="12"/></StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{Binding RepoText}" Command="{Binding OpenRepoCommand}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T 'Source (GitHub Releases, SHA-256 verified)'}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <TextBlock Text="{l:T 'Language'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE775;" Header="{l:T 'Display language'}" Description="{l:T 'Like Windows: the Windows language if Power-Exec has a translation for it, otherwise English.'}">
                        <ComboBox Width="190" ItemsSource="{Binding LanguageList}" SelectedValue="{Binding Language}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  AutomationProperties.Name="{l:T 'Display language'}"/>
                    </c:SettingsCard>
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,4,0,0"
                            Visibility="{Binding LanguageChangePending, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Restart now'}" Command="{Binding RestartCommand}" Margin="12,0,0,0"/>
                            <TextBlock Text="{l:T 'The new language applies after Power-Exec restarts.'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{l:T 'Start'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7E8;" Header="{l:T 'Start with Windows'}" Description="{l:T 'Power-Exec starts in the background after sign-in.'}">
                        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
                    </c:SettingsCard>

                    <TextBlock Text="{l:T 'Backup and restore'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE8F1;" Header="{l:T 'Back up settings'}"
                                        Description="{l:T 'Groups, smart groups, launch profiles, favorites, workspaces, custom entries and computer list as a file – for backup or another PC. Passwords are never included.'}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Export …'}" Command="{Binding ExportCommand}" />
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Import …'}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <DockPanel Style="{StaticResource SubSetting}">
                            <TextBlock Text="{l:T 'Settings file'}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding SettingsFile}" Style="{StaticResource Mono}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </c:SettingsExpander>
                </StackPanel>

                <!-- Gruppen (inkl. smarter Gruppen = Ordner) -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=groups}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding NewGroupCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'New group'}"/></StackPanel>
                        </ui:Button>
                        <TextBlock Text="{l:T 'Groups'}" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{l:T 'Groups organize the panel. Drag a group to another position or onto the middle of another group to make it a subgroup; right-click creates a subgroup. In the panel you drag entries into any group. Which groups a workspace shows is set under Workspaces.'}"/>

                    <TextBlock Text="{l:T 'Your groups'}" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="4,0,0,8" TextWrapping="Wrap"
                               Text="{l:T 'Groups with a lock (Recently run, Favorites, Custom entries) are fixed: movable but not deletable. Whether they appear in the panel is set per workspace.'}"/>
                    <TextBlock Text="{l:T 'No groups yet – “New group” at the top right or right-click in the panel.'}" Style="{StaticResource Caption}" Margin="4,0,0,8"
                               Visibility="{Binding Categories.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <ItemsControl ItemsSource="{Binding CategoryRoots}" Focusable="False">
                        <ItemsControl.ItemTemplateSelector>
                            <v:CategoryTemplateSelector Group="{StaticResource CategoryCardTemplate}" Fixed="{StaticResource FixedCardTemplate}"/>
                        </ItemsControl.ItemTemplateSelector>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap"
                               Text="{l:T 'Deleting removes the group including subgroups (after confirmation). Entries dragged in reappear in their smart group or under “Custom entries”; files stay unchanged.'}"/>

                    <TextBlock Text="{l:T 'For all smart groups (folders)'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE8A5;" Header="{l:T 'Default file extensions'}" Description="{l:T 'Applies to smart groups without their own setting. Separated by semicolons, e.g. .ps1; .cmd; .exe'}">
                            <StackPanel Width="300">
                                <TextBox Text="{Binding DefaultExtensions, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T '.ps1; .cmd; .exe'}"/>
                                <TextBlock Text="{Binding DefaultExtensionsError}" FontSize="11" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DefaultExtensionsError, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D8;" Header="{l:T 'Global exclusions'}" Description="{l:T 'Apply to all folders, separated by semicolons. “Hide” in the panel creates exclusions on the respective folder.'}">
                            <TextBox Width="300" Text="{Binding GlobalExcludes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'e.g. *.bak.ps1; *\\Old\\*'}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72C;" Header="{l:T 'Rescan automatically on changes'}" Description="{l:T 'New, renamed or deleted files appear immediately.'}">
                            <ui:ToggleSwitch IsChecked="{Binding AutoRescan}" AutomationProperties.Name="{l:T 'Rescan automatically on changes'}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Timeout for unreachable folders'}" Description="{l:T 'If a folder (e.g. a network share) doesn\'t respond in time, the panel shows the last scanned state.'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="2" Maximum="60" TickFrequency="1" Value="{Binding ScanTimeoutSeconds}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ScanTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Panel › Verhalten -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=behavior}">
                    <TextBlock Text="{l:T 'Behavior'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'When the panel slides out and in, and how you open it.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Slide out and collapse'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE823;" Header="{l:T 'Dwell time before sliding out'}" Description="{l:T 'Prevents accidental opening when passing by.'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0" Maximum="1000" TickFrequency="50" Value="{Binding HoverDelayMs}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HoverDelayMs, StringFormat={}{0} ms}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE81C;" Header="{l:T 'Collapse after leaving'}" Description="{l:T 'Time until the panel slides back in.'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0" Maximum="2000" TickFrequency="100" Value="{Binding CollapseDelayMs}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CollapseDelayMs, StringFormat={}{0} ms}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE740;" Header="{l:T 'Hide while full-screen programs run'}" Description="{l:T 'The hover zone rests while a video, presentation, game or Remote Desktop session runs full screen. The hotkey keeps working.'}">
                        <ui:ToggleSwitch IsChecked="{Binding HideHotZoneInFullscreen}" />
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Drag groups'}" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Text="{l:T 'When moving a group – in the panel and under Groups – a gap with a placeholder opens at the target. In the panel, you choose the level between two groups by dragging sideways: right goes deeper, left goes higher.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,0,8"/>
                    <c:SettingsCard Icon="&#xE7C2;" Header="{l:T 'Drag image at the mouse pointer'}" Description="{l:T 'A small badge with name, color and number of subgroups follows the mouse.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragGhost}" AutomationProperties.Name="{l:T 'Drag image at the mouse pointer'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8AB;" Header="{l:T 'Open gap smoothly'}" Description="{l:T 'Groups slide aside when the gap opens. Also follows the “Animation” setting under Appearance.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragAnimate}" AutomationProperties.Name="{l:T 'Open gap smoothly'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8C4;" Header="{l:T 'Collapse contents while dragging'}" Description="{l:T 'While dragging, the panel shows only group headers and the group list only compact cards – shorter distances with many entries.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragCollapse}" AutomationProperties.Name="{l:T 'Collapse contents while dragging'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE946;" Header="{l:T 'Reason at invalid places'}" Description="{l:T 'Instead of just a no-entry sign, the mouse pointer shows why the group can\'t be dropped here.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragExplain}" AutomationProperties.Name="{l:T 'Reason at invalid places'}" />
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Open'}" Style="{StaticResource SettingsSection}"/>
                    <StackPanel DataContext="{Binding Panel}">
                        <c:SettingsCard Icon="&#xE765;" Header="{l:T 'Hotkey'}" Description="{l:T 'Opens the panel and puts the cursor in the search box. To change it, click into the field and press the combination.'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="{l:T 'Click and press the desired key combination'}"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Remove'}" Margin="8,0,0,0" Command="{Binding ClearHotkeyCommand}" />
                            </StackPanel>
                        </c:SettingsCard>
                        <c:SettingsCard Icon="&#xE721;" Header="{l:T 'Hotkey opens the search in the middle of the screen'}"
                                        Description="{l:T 'Spotlight mode: a floating search window with the best matches – no mouse trip to the edge. Tab switches to the full panel. The hover zone still opens the panel.'}">
                            <ui:ToggleSwitch IsChecked="{Binding HotkeyOpensSpotlight}" AutomationProperties.Name="{l:T 'Spotlight mode'}" />
                        </c:SettingsCard>
                        <c:InfoBar Severity="Error" Message="{Binding DataContext.HotkeyError, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel › Darstellung -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=look}">
                    <TextBlock Text="{l:T 'Appearance'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Everything about the look: design, entries, panel and hover zone.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>

                    <TextBlock Text="{l:T 'General'}" Style="{StaticResource SettingsSection}"/>
                    <!-- Designvorlagen: ein Klick setzt Design, Panelfarbe, Hintergrund, Deckkraft, Milchglas und Akzent; eingeklappt nur die aktuelle -->
                    <c:SettingsExpander Icon="&#xE771;" Header="{l:T 'Design templates'}" Description="{Binding CurrentPresetText}"
                                        IsExpanded="{Binding PresetsExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <c:DesignPreview Width="132" Height="70" Design="{Binding CurrentDesign}" ToolTip="{Binding CurrentPresetText}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel Margin="0,10,0,4">
                            <TextBlock Text="{l:T 'Sets design, panel color, background, opacity, frosted glass and accent color at once – adjustable individually afterwards.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding DesignPresets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Feste Kachelgröße; das Löschen-Kreuz liegt innerhalb der Kachel oben rechts -->
                                        <Grid Width="168" Height="176" Margin="0,0,8,8">
                                        <Button Command="{Binding ApplyCommand}" Padding="0" Cursor="Hand" ToolTip="{Binding Description}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Bg.CardAlt}" Padding="8">
                                                        <StackPanel>
                                                            <c:DesignPreview Height="84" Design="{Binding Preset}"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding BackdropText}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Height="30" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Eigene Designs: löschen -->
                                        <Button Style="{StaticResource DeleteDesignButton}" Margin="0,12,12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding DeleteCommand}" ToolTip="{l:T 'Delete custom design'}" AutomationProperties.Name="{l:T 'Delete custom design'}"
                                                Visibility="{Binding IsCustom, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Style="{StaticResource Btn.Standard}" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding SaveDesignCommand}"
                                       ToolTip="{l:T 'Save the panel\'s color, background, opacity, frosted glass and accent as your own template'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T 'Save current design …'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </c:SettingsExpander>
                    <c:SettingsCard Icon="&#xE790;" Header="{l:T 'Design'}" Description="{l:T 'Light or dark for all windows. If a Windows contrast theme is active, Power-Exec uses its colors automatically.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Themes}" SelectedValue="{Binding Theme}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D3;" Header="{l:T 'Font and item size'}" Description="{l:T 'Enlarges text and controls in the panel and all windows (in addition to Windows scaling).'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="80" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding UiScalePercent}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Font and item size'}"/>
                                <TextBlock Text="{Binding UiScalePercent, StringFormat={}{0} %}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <Border Margin="0,0,0,4" Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1"
                            Visibility="{Binding IsHighContrast, Converter={StaticResource Vis}}">
                        <TextBlock Text="{l:T 'Windows contrast theme is active: panel color, opacity, frosted glass and accent color are ignored so everything stays readable.'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Info.Text}"/>
                    </Border>
                    <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Animation'}" Description="{l:T 'How the panel slides out and in.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Animations}" SelectedValue="{Binding Animation}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8B9;" Header="{l:T 'Show icons'}" Description="{l:T 'Program icons, folder icon, Remote Desktop icon and website favicons (loaded once and cached). Scripts keep their abbreviation.'}">
                        <ui:ToggleSwitch IsChecked="{Binding ShowProgramIcons}" />
                    </c:SettingsCard>
                    <StackPanel DataContext="{Binding Panel}">
                    <c:SettingsCard Icon="&#xE8FD;" Header="{l:T 'View'}" Description="{l:T 'Entries as a list or as a grid (tiles). Can also be switched in the panel header.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Layouts}" SelectedValue="{Binding Layout}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8E9;" Header="{l:T 'Item size'}" Description="{l:T 'Size of the entries in list and grid. Can also be switched in the panel header.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ItemSizes}" SelectedValue="{Binding ItemSize}"/>
                    </c:SettingsCard>

                    <TextBlock Text="{l:T 'Panel'}" Style="{StaticResource SettingsSection}"/>
                    <!-- Panelfarbe wie die Akzentfarbe in den Windows-Einstellungen: Auswahl und Chevron rechts, darunter die Farbkacheln -->
                    <c:SettingsExpander Icon="&#xE790;" Header="{l:T 'Panel color'}" Description="{l:T 'Panel background. With light colors the text automatically turns dark.'}"
                                        IsExpanded="{Binding ColorsExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="32" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Background="{Binding PreviewColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Panel}"
                                        BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" ToolTip="{Binding PreviewText}"/>
                                <ComboBox Width="170" ItemsSource="{Binding ColorModeList}" SelectedValue="{Binding ColorMode}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Panel color'}"/>
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Use Windows accent color'}"
                                                 IsChecked="{Binding DataContext.UseWindowsAccent, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Use Windows accent color'}"/>
                                    <TextBlock Text="{l:T 'On: hover zone, selection and buttons in the Windows accent color (Personalization › Colors). Off: in the chosen panel color – lightened or darkened to match.'}"
                                               Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}"
                                       Visibility="{Binding DataContext.UseWindowsAccent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                                            Background="{Binding AccentPreview, Converter={StaticResource ArgbBrush}, ConverterParameter=Accent}"/>
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Choose color'}" Command="{Binding PickAccentCommand}"/>
                                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'From panel color'}" Command="{Binding ResetAccentCommand}" Margin="6,0,0,0"
                                               Visibility="{Binding HasAccentColor, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Custom accent color'}"/>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12">
                                        <Run Text="{l:T 'Current:'}"/> <Run Text="{Binding AccentText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{l:T 'The panel uses the surface of the light or dark design. For your own color, choose “Manual” above.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,10"
                                       Visibility="{Binding ShowManualColors, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            <StackPanel Margin="0,8,0,4" Visibility="{Binding ShowManualColors, Converter={StaticResource Vis}}">
                                <StackPanel Visibility="{Binding HasRecentColors, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{l:T 'Recently used colors'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding RecentColors}" ItemTemplate="{StaticResource ColorTile}" Focusable="False" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{l:T 'Panel colors'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding PanelColorChoices}" ItemTemplate="{StaticResource ColorTile}" Focusable="False" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="500" HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="{l:T 'Windows colors'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding WindowsColors}" ItemTemplate="{StaticResource ColorTile}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="500" HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowManualColors, Converter={StaticResource Vis}}">
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Show colors'}" Command="{Binding PickColorCommand}"
                                           VerticalAlignment="Center" ToolTip="{l:T 'Pick your own color in the color picker'}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Custom colors'}"/>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12">
                                        <Run Text="{l:T 'Current:'}"/> <Run Text="{Binding CustomColor, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    <!-- Hintergrund: Auswahl und Chevron rechts, darunter die Regler der gewählten Variante -->
                    <c:SettingsExpander Icon="&#xE81E;" Header="{l:T 'Background'}" Description="{Binding BackdropDescription}"
                                        IsExpanded="{Binding BackdropExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <ComboBox Width="230" ItemsSource="{Binding Backdrops}" SelectedValue="{Binding Backdrop}"
                                      DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Background'}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowGlass, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GlassBlur}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding GlassBlur}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Blur strength'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Blur strength'}"/>
                                    <TextBlock Text="{l:T 'How strongly the desktop behind the panel is blurred.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowGlass, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GlassSaturation, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding GlassSaturation}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Saturation'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Saturation'}"/>
                                    <TextBlock Text="{l:T 'Color intensity of the desktop behind the glass (100 % = unchanged).'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowFrost, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Frost, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Frost}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Frosted glass'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Frosted glass'}"/>
                                    <TextBlock Text="{Binding FrostDescription}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowOpacity, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PanelOpacity, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding PanelOpacity}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Opacity'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Opacity'}"/>
                                    <TextBlock Text="{Binding OpacityDescription}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    <c:SettingsExpander Icon="&#xE8A0;" Header="{l:T 'Mini dock at the edge'}"
                                        Description="{l:T 'Narrow bar with the favorites on the chosen edge – one click starts, “⋯” opens the full panel. Replaces the hover zone.'}"
                                        IsExpanded="{Binding DockExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <ui:ToggleSwitch IsChecked="{Binding ShowDock}" AutomationProperties.Name="{l:T 'Mini dock at the edge'}" VerticalAlignment="Center"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" IsEnabled="{Binding ShowDock}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DockCount}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DockCount}"
                                        VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Favorites in the mini dock'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'How many favorites to show'}"/>
                                    <TextBlock Text="{l:T 'In the order of the “Favorites” group. The dock rests while the panel is open or a full-screen program runs.'}"
                                               Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    <c:SettingsCard Icon="&#xE8A1;" Header="{l:T 'Group style'}"
                                    Description="{l:T 'Accent stripe: calm, semi-transparent cards – the group color only as a stripe, in the icon and in the title. Colored cards: the whole group is tinted in its color.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding GroupStyles}" SelectedValue="{Binding GroupStyle}" AutomationProperties.Name="{l:T 'Group style'}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8FD;" Header="{l:T 'Jump bar'}" Description="{l:T 'With two or more groups, one dot per group on the right of the panel – click jumps there, clicking again collapses it.'}">
                        <ui:ToggleSwitch IsChecked="{Binding ShowJumpRail}" AutomationProperties.Name="{l:T 'Jump bar'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7C4;" Header="{l:T 'Scroll bars'}" Description="{l:T 'While hidden, the list can still be scrolled with the mouse wheel, the arrow keys or the jump bar.'}">
                        <ui:ToggleSwitch IsChecked="{Binding ShowScrollBar}" AutomationProperties.Name="{l:T 'Scroll bars'}" />
                    </c:SettingsCard>

                    <c:SettingsExpander Icon="&#xE9A6;" Header="{l:T 'Panel dimensions'}" Description="{l:T 'Width, height and position – can also be changed directly on the panel by dragging its inner edge.'}"
                                        IsExpanded="{Binding SizeExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <TextBlock Text="{Binding SizeSummary}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PanelWidth, StringFormat={}{0} px}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="280" Maximum="900" TickFrequency="20" Value="{Binding PanelWidth}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Width'}"/>
                                <TextBlock Text="{l:T 'Width'}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PanelHeightPercent, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="30" Maximum="100" TickFrequency="5" Value="{Binding PanelHeightPercent}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Height'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Height'}"/>
                                    <TextBlock Text="{l:T 'Share of the screen height (without taskbar). 100 % = full height.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding IsPartialHeight, Converter={StaticResource Vis}}">
                                <ComboBox DockPanel.Dock="Right" Width="236" ItemsSource="{Binding PanelAlignments}" SelectedValue="{Binding PanelAlignment}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Position'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Position on the edge'}"/>
                                    <TextBlock Text="{l:T 'Where the smaller panel appears along the edge.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <TextBlock Text="{l:T 'Hover zone'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7F4;" Header="{l:T 'Screen edge'}" Description="{l:T 'Which edge the hover zone is on and the panel slides out from.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EdgeList}" SelectedValue="{Binding Edge}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7F4;" Header="{l:T 'Monitor'}" Description="{l:T 'With “All monitors”, the hotkey opens the panel on the monitor with the mouse pointer.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Monitors}" SelectedValue="{Binding MonitorChoice}"/>
                    </c:SettingsCard>
                    <c:SettingsExpander Icon="&#xE8A0;" Header="{l:T 'Hover zone'}" Description="{l:T 'Trigger area at the edge – in the accent or panel color.'}"
                                        IsExpanded="{Binding HotZoneExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <ComboBox Width="200" ItemsSource="{Binding HotZones}" SelectedValue="{Binding HotZone}"
                                      DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Hover zone position'}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding IsHotZoneMiddle, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HotZoneLength, StringFormat={}{0} px}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="50" Maximum="1200" TickFrequency="25" Value="{Binding HotZoneLength}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Hover zone length'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Length'}"/>
                                    <TextBlock Text="{l:T 'Extent along the edge, centered.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HotZoneThickness, StringFormat={}{0} px}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding HotZoneThickness}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Hover zone width'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Width / sensitivity'}"/>
                                    <TextBlock Text="{l:T 'How far the trigger area reaches from the edge into the screen. Wider = easier to hit, but more noticeable.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    </StackPanel>
                </StackPanel>

                <!-- PowerShell -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=exec}">
                    <TextBlock Text="{l:T 'PowerShell'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Defaults for running scripts. An entry\'s launch profiles (⚙) can override them.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Start'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE70F;" Header="{l:T 'Parameters directly in the panel'}"
                                    Description="{l:T 'Expanding a script shows a small form with its parameters. “Save as …” creates a parameter set as a launch profile.'}">
                        <ui:ToggleSwitch IsChecked="{Binding InlineParameters}" AutomationProperties.Name="{l:T 'Parameters directly in the panel'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE756;" Header="{l:T 'Default PowerShell (local)'}" Description="{l:T 'If PowerShell 7 is missing, Windows PowerShell 5.1 is used automatically.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EnginesList}" SelectedValue="{Binding DefaultEngine}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72E;" Header="{l:T 'Execution Policy'}" Description="{l:T 'Only applies to scripts started by Power-Exec.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Policies}" SelectedValue="{Binding ExecutionPolicy}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE77B;" Header="{l:T 'Start without profile (-NoProfile)'}" Description="{l:T 'Faster start, no side effects from the PowerShell profile.'}">
                        <ui:ToggleSwitch IsChecked="{Binding NoProfile}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7C4;" Header="{l:T 'Keep console open after finishing (-NoExit)'}" Description="{l:T 'So the output stays visible.'}">
                        <ui:ToggleSwitch IsChecked="{Binding NoExit}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE77B;" Header="{l:T 'Ask for the profile at launch'}"
                                    Description="{l:T 'If an entry has several launch profiles, Power-Exec asks which one before launching – in the same window as the values for \{\{placeholders\}\}. Can be set differently per entry (edit entry).'}">
                        <ui:ToggleSwitch IsChecked="{Binding AskProfile}" AutomationProperties.Name="{l:T 'Ask for the profile at launch'}" />
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Editor'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE70F;" Header="{l:T 'Editor for “Open in editor”'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Editors}" SelectedValue="{Binding Editor}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8E5;" Header="{l:T 'Custom editor'}" Description="{l:T 'Path to the EXE'}" Visibility="{Binding IsCustomEditor, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="320" Text="{Binding EditorPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'C:\\Program Files\\Notepad++\\notepad++.exe'}"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Browse …'}" Command="{Binding BrowseEditorCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Good to know'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE946;" Header="{l:T 'How Power-Exec runs scripts'}" Description="{l:T 'Network drives, companion files, delegation'}">
                        <StackPanel Margin="0,6">
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="{l:T 'Network paths: '}"/><Run Text="{l:T 'Mapped drives are converted to UNC paths before launch – elevated processes and other accounts don\'t see mapped drives.'}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="{l:T 'Companion files for remote: '}"/><Run Text="{l:T '“Send script folder along” copies modules and files via the remote session and deletes them afterwards. Permanently with “PowerExec: CopyFolder” under .NOTES.'}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="{l:T 'Delegation (CredSSP): '}"/><Run Text="{l:T 'is deliberately not supported because credentials would be passed on to the target computer.'}"/></TextBlock>
                        </StackPanel>
                    </c:SettingsExpander>
                </StackPanel>

                <!-- Remote -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=remote}">
                    <TextBlock Text="{l:T 'Remote'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Run on other computers via WinRM, one at a time or in parallel on many.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Connection'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE968;" Header="{l:T 'PowerShell for remote'}" Description="{l:T 'Most servers only have 5.1. PowerShell 7 only if the PowerShell.7 endpoint exists.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RemoteEngines}" SelectedValue="{Binding RemoteEngine}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72E;" Header="{l:T 'Remote via HTTPS (port 5986)'}" Description="{l:T 'For computers outside the domain or when WinRM is only reachable via HTTPS. An HTTPS listener must be set up on the target.'}">
                        <ui:ToggleSwitch IsChecked="{Binding RemoteUseSsl}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Connection timeout per computer'}" Description="{l:T 'After that, the computer counts as unreachable.'}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="10" Maximum="300" TickFrequency="10" Value="{Binding RemoteTimeoutSeconds}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RemoteTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE902;" Header="{l:T 'Concurrent connections'}" Description="{l:T 'For bulk execution.'}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="1" Maximum="64" TickFrequency="1" Value="{Binding ThrottleLimit}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ThrottleLimit}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Results'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xEA8F;" Header="{l:T 'Notify when a remote run finishes'}" Description="{l:T 'Windows notification with a summary; a click opens the result list.'}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnFinish}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8B7;" Header="{l:T 'Log folder'}" Description="{Binding LogFolderDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Change …'}" Command="{Binding BrowseLogFolderCommand}" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Open'}" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Computers and sign-in'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7F4;" Header="{l:T 'Recently used computers'}" Description="{Binding MachinesText}">
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Clear list'}" Command="{Binding ClearMachinesCommand}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D7;" Header="{l:T 'Credentials'}" Description="{l:T 'Asked for at every launch and never saved.'}">
                        <TextBlock Text="{l:T 'Always ask'}" Foreground="{DynamicResource Text.Secondary}"/>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Hilfe › Beispiele -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=samples}">
                    <TextBlock Text="{l:T 'Examples'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Ready-made sample scripts to try out and as a template for your own scripts.'}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{l:T 'Sample scripts'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE943;" Header="{l:T 'Create sample scripts'}"
                                    Description="{l:T 'System info, network test, disk space, large files, installed programs, error log, temp cleanup and passwords – under Documents › Power-Exec › Scripts (existing files stay unchanged), shown in the panel as the group “Examples”.'}">
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Create'}" Command="{Binding AddSamplesCommand}"/>
                    </c:SettingsCard>
                    <c:InfoBar Message="{Binding SamplesStatus}" Severity="{Binding SamplesSeverity}"/>
                </StackPanel>

                <!-- Diagnose & Daten -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=diag}">
                    <TextBlock Text="{l:T 'Diagnostics'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Log for troubleshooting and folder scan times.'}" Style="{StaticResource Caption}"/>

                    <TextBlock Text="{l:T 'Folder scanning'}" Style="{StaticResource SettingsSection}"/>

                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Folder'}" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding FolderTimes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock x:Name="Info" DockPanel.Dock="Right" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                <Setter TargetName="Info" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SystemInfo}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:T 'Log'}" Style="{StaticResource SettingsSection}"/>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Update'}" Command="{Binding RefreshLogCommand}" FontSize="12" />
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Copy log'}" Command="{Binding CopyLogCommand}" FontSize="12" Margin="8,0,0,0" />
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Open folder'}" Command="{Binding OpenAppLogFolderCommand}" FontSize="12" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Log'}" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="{Binding LogFile}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Height="280">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="10,8"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"
                                       Text="{l:T 'If there are problems, use “Copy log” and send the text along – it contains the version, folder status and the latest messages, but no passwords.'}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
        </DockPanel>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Close'}" MinWidth="110" Height="34" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Discard changes'}" Height="34" Click="Revert_Click"
                        ToolTip="{l:T 'Restore the state from when settings were opened'}" />
                <!-- Speicherstand: „Speichert …“ während der kurzen Wartezeit, danach „Alle Änderungen gespeichert“ -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{l:T 'Changes are applied and saved automatically – there\'s no need for a Save button.'}">
                    <TextBlock x:Name="SaveIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource InfoBar.Success.Icon}"/>
                    <TextBlock x:Name="SaveHint" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{l:T 'All changes saved'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Snackbar: kurze Rückmeldung unten, blendet nach einigen Sekunden aus -->
        <Border x:Name="SnackbarHost" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Padding="16,10" CornerRadius="8" BorderThickness="1" Visibility="Collapsed" Opacity="0" MaxWidth="640" Panel.ZIndex="100"
                Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="SnackbarShift" Y="12"/></Border.RenderTransform>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource InfoBar.Success.Icon}"/>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" MinHeight="28" Margin="12,0,0,0" Click="SnackbarClose_Click"
                           ToolTip="{l:T 'Close'}" AutomationProperties.Name="{l:T 'Close message'}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                </ui:Button>
                <TextBlock x:Name="SnackbarText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
