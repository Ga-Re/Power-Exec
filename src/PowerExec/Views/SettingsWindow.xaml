<Window x:Class="PowerExec.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        Title="Power-Exec – Einstellungen" Style="{StaticResource AppWindow}"
        Width="1120" Height="800" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation (wie PowerToys: Symbole, Kategorien) -->
        <DockPanel Margin="10,12,6,12">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Style="{StaticResource Caption}" Margin="14,8,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel.Resources>
                        <!-- Überschrift eines Bereichs: Klick klappt ihn ein und aus -->
                        <Style x:Key="NavSegment" TargetType="Button">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="0,12,0,2"/>
                            <Setter Property="ToolTip" Value="Ein- oder ausklappen"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,5,0,5">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=general}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Allgemein"/></StackPanel>
                    </RadioButton>
                    <Button Style="{StaticResource NavSegment}" Command="{Binding ToggleNavCommand}" CommandParameter="content">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavContent}" Value="False"><Setter Property="Text" Value="&#xE76C;"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Inhalte"/>
                        </DockPanel>
                    </Button>
                    <StackPanel Visibility="{Binding NavContent, Converter={StaticResource Vis}}">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=groups}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Gruppen"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=custom}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Eigene Einträge"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=tags}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Schlagworte"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=workspaces}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Arbeitsbereiche"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Button Style="{StaticResource NavSegment}" Command="{Binding ToggleNavCommand}" CommandParameter="panel">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavPanel}" Value="False"><Setter Property="Text" Value="&#xE76C;"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Panel"/>
                        </DockPanel>
                    </Button>
                    <StackPanel Visibility="{Binding NavPanel, Converter={StaticResource Vis}}">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=look}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Darstellung"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=behavior}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Verhalten"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Button Style="{StaticResource NavSegment}" Command="{Binding ToggleNavCommand}" CommandParameter="exec">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavExec}" Value="False"><Setter Property="Text" Value="&#xE76C;"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Ausführung"/>
                        </DockPanel>
                    </Button>
                    <StackPanel Visibility="{Binding NavExec, Converter={StaticResource Vis}}">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=exec}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="PowerShell"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=remote}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Remote"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=machines}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Rechnergruppen"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Button Style="{StaticResource NavSegment}" Command="{Binding ToggleNavCommand}" CommandParameter="help">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavHelp}" Value="False"><Setter Property="Text" Value="&#xE76C;"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Hilfe"/>
                        </DockPanel>
                    </Button>
                    <StackPanel Visibility="{Binding NavHelp, Converter={StaticResource Vis}}">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=diag}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0"/><TextBlock Text="Diagnose"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="1">
        <!-- Suche (wie PowerToys oben in der Mitte) -->
        <Grid DockPanel.Dock="Top" Margin="28,12,28,4" MaxWidth="520" HorizontalAlignment="Stretch">
            <TextBox x:Name="SettingsSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" Tag="Nach Einstellungen suchen"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" PlacementTarget="{Binding ElementName=SettingsSearch}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="True" Width="{Binding ActualWidth, ElementName=SettingsSearch}">
                <Border Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Subtle}" HorizontalContentAlignment="Stretch" Padding="10,4" MinHeight="40"
                                        Command="{Binding DataContext.OpenSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"/>
                                        <TextBlock Text="{Binding Page}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
        <!-- Update-Hinweis: erscheint in allen Bereichen, sobald eine neue Version gefunden wurde -->
        <Border DockPanel.Dock="Top" Margin="16,12,28,4" Padding="14,12" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="18" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource Btn.Standard}" Content="Versionshinweise" Command="{Binding ReleaseNotesCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn.Accent}" Content="Jetzt aktualisieren" Command="{Binding InstallUpdateCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Update.Subtitle}" FontSize="12" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Power-Exec wird dabei beendet und neu gestartet; nicht gespeicherte Änderungen hier gehen verloren."
                               FontSize="11" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,4,28,28">

                <!-- Eigene Einträge -->
                <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=custom}">
                <StackPanel DataContext="{Binding EntryList}">
                    <TextBlock Text="Eigene Einträge" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Webseiten, Ordner, Remotedesktop, SSH, Snippets, Windows-Werkzeuge, Befehle und einzelne Dateien. ⚙ bearbeitet einen Eintrag; mehrere markieren zum Verschieben, Exportieren oder Löschen. Einträge lassen sich direkt ins Panel ziehen, um sie in eine Gruppe einzusortieren."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Werkzeugleiste -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Accent}" Click="NewEntryMenu_Click" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="Neu"/>
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0"/></StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Neuer Eintrag …" Command="{Binding NewCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Webseite …" Command="{Binding NewCommand}" CommandParameter="Url"/>
                                        <MenuItem Header="Ordner …" Command="{Binding NewCommand}" CommandParameter="Folder"/>
                                        <MenuItem Header="Remotedesktop …" Command="{Binding NewCommand}" CommandParameter="Rdp"/>
                                        <MenuItem Header="SSH-Verbindung …" Command="{Binding NewCommand}" CommandParameter="Ssh"/>
                                        <MenuItem Header="PowerShell-Snippet …" Command="{Binding NewCommand}" CommandParameter="Snippet"/>
                                        <MenuItem Header="Text-Snippet …" Command="{Binding NewCommand}" CommandParameter="TextSnippet"/>
                                        <MenuItem Header="Windows-Werkzeug …" Command="{Binding NewCommand}" CommandParameter="Tool"/>
                                        <MenuItem Header="Befehl …" Command="{Binding NewCommand}" CommandParameter="Command"/>
                                        <MenuItem Header="Datei …" Command="{Binding NewCommand}" CommandParameter="File"/>
                                        <Separator/>
                                        <MenuItem Header="Aus Vorlagen …" Command="{Binding CatalogCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource Btn.Standard}" Content="Importieren …" Command="{Binding ImportCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="Suchen (Name, Ziel, Code, #schlagwort)"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Chip}" Content="Alle" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Webseiten" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Url}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Ordner" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Folder}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="RDP" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Rdp}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="SSH" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Ssh}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Snippets" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Snippet}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Werkzeuge" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Tool}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Befehle" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Command}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Dateien" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=File}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Mit Problemen" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=problems}"/>
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding CheckCommand}"
                                ToolTip="Webseiten, Ordner, Dateien, RDP-/SSH-Ports und Programme prüfen (Auswahl bzw. alle sichtbaren)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="{Binding CheckText}"/></StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="190" ItemsSource="{Binding GroupFilters}" SelectedValue="{Binding GroupFilter}" DisplayMemberPath="Value" SelectedValuePath="Key">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Style.Triggers>
                                            <!-- Trennlinie zwischen festen Filtern und Gruppen -->
                                            <DataTrigger Binding="{Binding Key}" Value="—sep">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ComboBoxItem">
                                                            <Separator Margin="8,4" Background="{DynamicResource Border.Default}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding TagFilters}" SelectedValue="{Binding TagFilter}" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Mehrfachauswahl -->
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox Width="190" IsEditable="True" ItemsSource="{Binding MoveTargets}" Text="{Binding MoveTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="In Gruppe verschieben" Command="{Binding MoveSelectedCommand}" Margin="0,2,10,2"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="Exportieren …" Command="{Binding ExportCommand}" Margin="0,2,6,2"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="Löschen" Command="{Binding RemoveSelectedCommand}" Margin="0,2,6,2"/>
                            <Button Style="{StaticResource Btn.Subtle}" Content="Auswahl aufheben" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Border>

                    <TextBlock Text="Noch keine eigenen Einträge. „Neu“ (auch aus Vorlagen) – oder im Panel per Drag &amp; Drop, Strg+V und Rechtsklick." Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="Keine Treffer für Suche und Filter." Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding NoMatches, Converter={StaticResource Vis}}"/>

                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <!-- Kopfzeile -->
                            <Grid Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Btn.Subtle}" Content="Alle" FontSize="11" Padding="2,0" MinHeight="22" Height="22" Command="{Binding SelectAllCommand}"
                                        Grid.ColumnSpan="2" HorizontalAlignment="Left" ToolTip="Alle sichtbaren auswählen"/>
                                <TextBlock Grid.Column="2" Text="Eintrag" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Gruppe / Schlagworte" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RowsView}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="EntryRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,5" Background="Transparent"
                                                PreviewMouseLeftButtonDown="EntryRow_PreviewMouseLeftButtonDown" PreviewMouseMove="EntryRow_PreviewMouseMove"
                                                ToolTip="Zum Einsortieren ins Panel ziehen (an den Bildschirmrand, das Panel fährt aus)" ToolTipService.InitialShowDelay="1500">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="76"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Width="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Width="32" Height="20" CornerRadius="4" Background="{DynamicResource Badge.Other.Bg}"
                                                            Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Badge.Other.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Source="{Binding Image}" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0"
                                                           Visibility="{Binding HasImage, Converter={StaticResource Vis}}"/>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="20" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Primary}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="8,1,0,0"/>
                                                        <TextBlock Text="&#xE8B0;" Style="{StaticResource Icon}" FontSize="11" Margin="6,1,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                                                   ToolTip="Startet mit einem Klick" Visibility="{Binding SingleClick, Converter={StaticResource Vis}}"/>
                                                        <TextBlock Text="{}{{…}}" FontSize="11" Margin="6,1,0,0" Foreground="{DynamicResource Accent}" ToolTip="Mit Platzhaltern"
                                                                   Visibility="{Binding HasPlaceholders, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False"/>
                                                </StackPanel>
                                                <Ellipse x:Name="Dot" Grid.Column="4" Width="9" Height="9" Fill="{DynamicResource Text.Disabled}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         ToolTip="{Binding HealthText}"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding EditCommand}" ToolTip="Bearbeiten">
                                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="Entfernen">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="EntryRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EntryRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="EntryRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthOk}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthOk}" Value="False">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>

                <!-- Rechnergruppen -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=machines}">
                    <TextBlock Text="Rechnergruppen" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Gruppen fassen Rechner zusammen. Im Ausführen-Dialog wählst du eine Gruppe mit einem Klick aus; in Startprofilen trägst du sie als @Name ein (z. B. @Webserver). Gruppen werden beim Start aufgelöst – Änderungen gelten sofort für alle Profile." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Style="{StaticResource Btn.Standard}" Command="{Binding AddGroupCommand}" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="Gruppe hinzufügen"/></StackPanel>
                    </Button>
                    <TextBlock Text="Noch keine Gruppen." Style="{StaticResource Caption}" Visibility="{Binding HasNoGroups, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding MachineGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8,8,16,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="Rechner anzeigen" Margin="0,0,6,0">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="Gruppe löschen">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </Button>
                                            <TextBlock Text="@" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource Text.Secondary}"/>
                                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Name der Gruppe"/>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                                       Margin="12,0,8,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="36,0,0,4">
                                        <TextBox Text="{Binding Machines, UpdateSourceTrigger=PropertyChanged, Delay=300}" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6"
                                                 FontFamily="{StaticResource MonoFont}" Margin="0,8,0,0" Tag="Ein Rechner pro Zeile (oder durch Komma getrennt)"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Standard}" Content="Sortieren" Command="{Binding SortCommand}" Margin="8,0,0,0"/>
                                                <Button Style="{StaticResource Btn.Standard}" Content="CSV/Text importieren …" Command="{Binding ImportCommand}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding AdQuery, UpdateSourceTrigger=PropertyChanged}" Tag="AD: SRV-*  ·  OU=Server,DC=firma,DC=local  ·  (operatingSystem=*Server*)"
                                                     Width="380" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            <Button Style="{StaticResource Btn.Standard}" Content="Aus AD hinzufügen" Command="{Binding AdSearchCommand}" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Status, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Die AD-Suche läuft mit deinem angemeldeten Konto. Name mit * als Platzhalter, eine OU (alle Computer darin) oder ein eigener LDAP-Filter in Klammern."/>
                </StackPanel>

                <!-- Inhalte › Schlagworte -->
                <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=tags}">
                <StackPanel DataContext="{Binding TagList}">
                    <TextBlock Text="Schlagworte" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Alle Schlagworte deiner Einträge. Im Panel filtert #schlagwort in der Suche. Umbenennen auf einen vorhandenen Namen führt beide zusammen."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="Schlagwort suchen"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                    </Grid>
                    <TextBlock Text="Noch keine Schlagworte. Du vergibst sie im Eintragsdialog unter „Einordnen“." Style="{StaticResource Caption}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4">
                                    <StackPanel>
                                        <DockPanel Margin="6,6,8,6">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="Einträge anzeigen">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox Width="170" Margin="0,0,8,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding Color}" SelectedValuePath="Key" ToolTip="Farbe des Schlagworts">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="Umbenennen oder zusammenführen">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding DeleteCommand}" ToolTip="Von allen Einträgen entfernen">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Border Background="{Binding ChipBrush}" CornerRadius="11" Padding="10,2,10,3">
                                                    <TextBlock Text="{Binding Tag, StringFormat=#{0}}" FontSize="13"/>
                                                </Border>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                                Background="{DynamicResource Bg.CardAlt}" Padding="44,8,16,10">
                                            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding}" Margin="0,2"/></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Grid>

                <!-- Arbeitsbereiche -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=workspaces}">
                    <TextBlock Text="Arbeitsbereiche" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Arbeitsbereiche zeigen eine Auswahl deiner Gruppen – z. B. je Kunde oder Aufgabe. Gruppen, Ordner und eigene Einträge gibt es nur einmal; jeder Arbeitsbereich hat eigene Favoriten, „Zuletzt ausgeführt“, Startprofile und eingeklappte Gruppen. Wechseln geht auch im Panel-Kopf und im Tray-Menü."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding Workspaces}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <DockPanel Margin="6,8,12,8">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="Gruppen dieses Arbeitsbereichs auswählen" Margin="0,0,8,0">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Info.Bg}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                                <Button Style="{StaticResource Btn.Standard}" Content="Gruppen …" Command="{Binding ToggleCommand}" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource Btn.Standard}" Content="Wechseln" Command="{Binding ActivateCommand}" Margin="0,0,8,0"
                                                        ToolTip="Übernimmt die Einstellungen und wechselt den Arbeitsbereich"/>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="Löschen">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBox Width="280" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                                Background="{DynamicResource Bg.CardAlt}" Padding="20,10,16,12">
                                            <StackPanel>
                                                <TextBlock Text="Diese Gruppen erscheinen im Panel (Favoriten, Zuletzt ausgeführt und Suche zeigen alles):" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <TextBlock Text="Noch keine Gruppen angelegt." Style="{StaticResource Caption}"
                                                           Visibility="{Binding Groups.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Margin="{Binding Indent}" Padding="6,0,0,0" MinHeight="30">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Grid Width="18" Margin="0,0,8,0">
                                                                        <c:IconPresenter Icon="{Binding Icon}" Size="15" Foreground="{DynamicResource Text.Primary}"
                                                                                         Visibility="{Binding Icon, Converter={StaticResource Vis}}"/>
                                                                        <TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                                                                   Visibility="{Binding Icon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Neuer Arbeitsbereich" Style="{StaticResource RowTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="280" Text="{Binding NewWorkspace, UpdateSourceTrigger=PropertyChanged}" Tag="Name, z. B. Kunde A"/>
                                <CheckBox Content="Aktuellen kopieren" IsChecked="{Binding CopyWorkspace}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Favoriten, Startprofile und Gruppenauswahl übernehmen"/>
                                <Button Style="{StaticResource Btn.Standard}" Content="Anlegen" Command="{Binding AddWorkspaceCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Allgemein -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=general}">
                    <TextBlock Text="Allgemein" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Version und Updates" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE895;" Header="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Description="{Binding UpdateStatus}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Subtle}" Content="Einführung" Command="{Binding ShowWelcomeCommand}" Foreground="{DynamicResource Accent}"
                                        ToolTip="Einführungs-Assistent erneut starten (Ordner, Rand, Tastenkürzel)" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Subtle}" Content="Versionshinweise" Command="{Binding CurrentReleaseNotesCommand}" Foreground="{DynamicResource Accent}"
                                        ToolTip="Was ist neu in dieser Version? (GitHub)" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Accent}" Content="Nach Updates suchen" Command="{Binding CheckUpdatesCommand}"/>
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckUpdatesOnStart}" VerticalAlignment="Center"/>
                                <TextBlock Text="Beim Start nach Updates suchen" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludePrereleases}" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Vorabversionen einbeziehen"/>
                                    <TextBlock Text="Neue Funktionen früher – können noch Fehler enthalten." Style="{StaticResource Caption}" FontSize="12"/></StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{Binding RepoText}" Command="{Binding OpenRepoCommand}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Quelle (GitHub Releases, SHA-256-geprüft)" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <TextBlock Text="Start" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7E8;" Header="Mit Windows starten" Description="Power-Exec startet nach der Anmeldung im Hintergrund.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}"/>
                    </c:SettingsCard>

                    <TextBlock Text="Sichern und Wiederherstellen" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE8F1;" Header="Einstellungen sichern"
                                        Description="Gruppen, smarte Gruppen, Startprofile, Favoriten, Arbeitsbereiche, eigene Einträge und Rechnerliste als Datei – zum Sichern oder für einen anderen PC. Kennwörter sind nie enthalten.">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Standard}" Content="Exportieren …" Command="{Binding ExportCommand}"/>
                                <Button Style="{StaticResource Btn.Standard}" Content="Importieren …" Command="{Binding ImportCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <DockPanel Style="{StaticResource SubSetting}">
                            <TextBlock Text="Einstellungsdatei" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding SettingsFile}" Style="{StaticResource Mono}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </c:SettingsExpander>
                </StackPanel>

                <!-- Gruppen (inkl. smarter Gruppen = Ordner) -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=groups}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Click="NewEntryMenu_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="Neu"/>
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0"/></StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Gruppe …" Command="{Binding NewGroupCommand}"/>
                                    <MenuItem Header="Smarte Gruppe (Ordner) …" Command="{Binding NewSmartGroupCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="Gruppen" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Gruppen ordnen das Panel. Eine smarte Gruppe liest einen Ordner ein und zeigt seine Scripte und Programme. Einträge ziehst du im Panel per Drag &amp; Drop in jede Gruppe. Welche Gruppen ein Arbeitsbereich zeigt, legst du unter Arbeitsbereiche fest."/>

                    <TextBlock Text="Feste Gruppen" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE734;" Header="Favoriten" Description="Mit ☆ markierte Einträge, ganz oben im Panel.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowFavorites}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE81C;" Header="Zuletzt ausgeführt" Description="Die zuletzt gestarteten Einträge (je Arbeitsbereich).">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowRecent, Converter={StaticResource Vis}}" Margin="0,0,16,0">
                                <Slider Width="140" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RecentRunsCount}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RecentRunsText}" Width="80" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowRecent}"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE71B;" Header="Eigene Einträge" Description="Eigene Einträge, die (noch) in keiner Gruppe liegen. Erscheint nur, wenn es solche gibt.">
                        <Button Style="{StaticResource Btn.Standard}" Content="Verwalten …" Command="{Binding SelectSectionCommand}" CommandParameter="custom"/>
                    </c:SettingsCard>

                    <TextBlock Text="Deine Gruppen" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Text="Noch keine Gruppen – „Neu“ oben rechts oder im Panel per Rechtsklick." Style="{StaticResource Caption}" Margin="4,0,0,8"
                               Visibility="{Binding Categories.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="{Binding CardMargin}">
                                    <StackPanel>
                                        <DockPanel Margin="6,6,8,6" MinHeight="44">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="Ordner und Einträge ein-/ausklappen" Visibility="{Binding IsSmart, Converter={StaticResource Vis}, ConverterParameter=hidden}">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Width="34" Height="34" MinHeight="34" Padding="0" Command="{Binding ChooseIconCommand}"
                                                    ToolTip="Symbol wählen" Margin="4,0,12,0">
                                                <Grid>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="18" Foreground="{DynamicResource Text.Primary}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                    <TextBlock x:Name="DefaultGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Text.Tertiary}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                </Grid>
                                            </Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Height="22" Padding="8,0" CornerRadius="11" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}"
                                                        BorderThickness="1" Margin="0,0,8,0" Visibility="{Binding Folder.HasPending, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding Folder.PendingCount, StringFormat={}{0} neu}" FontSize="11" Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                                                </Border>
                                                <ComboBox Width="150" Margin="0,0,4,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding ColorOwn}" SelectedValuePath="Key"
                                                          ToolTip="Farbe der Gruppe (Untergruppen übernehmen sie)">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Command="{Binding CustomColorCommand}" ToolTip="Eigene Farbe (#RRGGBB)">
                                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </Button>
                                                <ComboBox Width="125" Margin="4,0,8,0" ItemsSource="{Binding LayoutList}" SelectedValue="{Binding Layout}"
                                                          DisplayMemberPath="Value" SelectedValuePath="Key" ToolTip="Darstellung dieser Gruppe im Panel"/>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="Umbenennen (Anzeigename)">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding UpCommand}" ToolTip="Nach oben">
                                                    <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="11"/>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding DownCommand}" ToolTip="Nach unten">
                                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11"/>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="Gruppe löschen (nach Rückfrage)">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Smarte Gruppe: Ordner und seine Einträge -->
                                        <ContentControl Content="{Binding Folder}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSmart}" Value="True"/>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Ordner -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg.CardAlt}" Padding="16,12">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="Ordner trennen" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                                                                            ToolTip="Ordner nicht mehr einlesen; die Gruppe bleibt als normale Gruppe"/>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
                                                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" Tag="Pfad, z. B. C:\Scripts oder \\server\freigabe"/>
                                                                </DockPanel>
                                                                <WrapPanel Margin="0,10,0,0">
                                                                    <CheckBox Content="Unterordner einbeziehen" IsChecked="{Binding Recursive}" Margin="0,0,20,6" VerticalAlignment="Center"/>
                                                                    <CheckBox Content="Unterordner im Panel als Untergruppen" IsChecked="{Binding SubfoldersAsGroups}" IsEnabled="{Binding Recursive}"
                                                                              Margin="0,0,20,6" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Dateiendungen:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource Text.Secondary}"/>
                                                                    <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,0,6"
                                                                             Tag="leer = Standard" FontFamily="{StaticResource MonoFont}"/>
                                                                </WrapPanel>
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text=" · Letzter Scan: "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Einträge -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                                            <StackPanel>
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBlock Text="Neue Dateien:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                        <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="1" Width="330">
                                            <UniformGrid Columns="2">
                                                <RadioButton Style="{StaticResource Segment}" Content="Automatisch anzeigen" IsChecked="{Binding AutoShow}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="Erst nach Freigabe" IsChecked="{Binding RequireApproval}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </WrapPanel>

                                    <Border Visibility="{Binding HasPending, Converter={StaticResource Vis}}" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                                            Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Accent}" Content="Alle freigeben" Command="{Binding ApproveAllCommand}" Height="30" MinHeight="30" FontSize="12"/>
                                                <Button Style="{StaticResource Btn.Standard}" Content="Ausgeblendet lassen" Command="{Binding DismissPendingCommand}" Height="30" MinHeight="30" FontSize="12" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Style="{StaticResource Btn.Standard}" Content="Alle anzeigen" Command="{Binding AllOnCommand}" Height="28" MinHeight="28" FontSize="12"/>
                                            <Button Style="{StaticResource Btn.Standard}" Content="Keine" Command="{Binding AllOffCommand}" Height="28" MinHeight="28" FontSize="12" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Grid Width="240" Margin="0,0,10,0" DockPanel.Dock="Left">
                                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="28,0,8,0" Tag="In diesem Ordner suchen" Height="30" MinHeight="30"/>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource Text.Secondary}"/>
                                        </Grid>
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource Chip}" Content="Alle" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="Scripte" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=scripts}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="Programme" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=programs}"/>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Panel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="Eintrag" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Startprofile" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Admin" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding RowsView}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" MinHeight="50" Background="Transparent">
                                                    <Grid x:Name="RowGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="250"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsVisibleInPanel}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat={}{0} im Panel anzeigen}"/>
                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Width="36" Height="22" CornerRadius="4" Background="{DynamicResource Badge.Other.Bg}"
                                                                    Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Badge.Other.Fg}"/>
                                                            </Border>
                                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" Margin="7,0,0,0"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,6,12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="9" Background="{DynamicResource Accent}"
                                                                        Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                                                    <TextBlock Text="NEU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                                </Border>
                                                                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="9" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}" BorderThickness="1"
                                                                        Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}"
                                                                        ToolTip="Aus dem Internet heruntergeladen – im Panel über „Entsperren“ freigeben">
                                                                    <TextBlock Text="BLOCKIERT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Status.Warning}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Info}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding ProfilesText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProfileDetail}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Status.Warning}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Ja" FontSize="12" Foreground="{DynamicResource Status.Warning}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="5" Style="{StaticResource Btn.Icon}" Width="34" Height="34" Command="{Binding ConfigureCommand}"
                                                                ToolTip="Startprofile" Visibility="{Binding CanToggle, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsVisibleInPanel}" Value="False">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Keine Einträge für diese Suche." Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding NoRows, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="Noch keine Einträge – der Ordner wird eingelesen …" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding HasNoEntries, Converter={StaticResource Vis}}"/>

                                    <WrapPanel Margin="0,12,0,0">
                                        <TextBlock Text="Muster-Ausschlüsse:" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                        <ItemsControl ItemsSource="{Binding Exclusions}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="26" CornerRadius="13" Background="{DynamicResource Excl.Bg}" BorderBrush="{DynamicResource Excl.Border}"
                                                            BorderThickness="1" Padding="10,0,2,0" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource Excl.Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                                            <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                                                    ToolTip="Ausschluss entfernen" Foreground="{DynamicResource Excl.Text}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="28" MinHeight="28" Margin="0,0,6,6"
                                                 Tag="z. B. *.exe oder *\Archiv\*" FontSize="12"/>
                                        <Button Style="{StaticResource Btn.Standard}" Content="+ Muster" Command="{Binding AddExclusionCommand}" Height="28" MinHeight="28"
                                                FontSize="12" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="Einzelne Dateien werden über den Haken ein- und ausgeblendet. Muster werden sofort angewendet; die Liste aktualisiert sich nach dem Einlesen."/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSmart}" Value="True">
                                        <Setter TargetName="DefaultGlyph" Property="Text" Value="&#xE8B7;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Folder.IsHighlighted}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap"
                               Text="Löschen entfernt die Gruppe samt Untergruppen (nach Rückfrage). Hineingezogene Einträge erscheinen wieder in ihrer smarten Gruppe bzw. unter „Eigene Einträge“; Dateien bleiben unverändert."/>

                    <TextBlock Text="Für alle smarten Gruppen (Ordner)" Style="{StaticResource SettingsSection}"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="300" Text="{Binding DefaultExtensions, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Standard-Dateiendungen" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Gilt für smarte Gruppen ohne eigene Angabe. Durch Leerzeichen getrennt." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="300" Text="{Binding GlobalExcludes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     VerticalAlignment="Center" Tag="z. B. *.bak.ps1; *\Old\*"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Globale Ausschlüsse" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Gelten für alle Ordner, mit Semikolon getrennt. „Ausblenden“ im Panel legt Ausschlüsse beim jeweiligen Ordner an." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRescan}" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Bei Änderungen automatisch neu einlesen" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Neue, umbenannte oder gelöschte Dateien erscheinen sofort." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="180" Minimum="2" Maximum="60" TickFrequency="1" Value="{Binding ScanTimeoutSeconds}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ScanTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Zeitlimit für nicht erreichbare Ordner" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Antwortet ein Ordner (z. B. eine Freigabe) nicht rechtzeitig, zeigt das Panel den zuletzt eingelesenen Stand." Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Panel › Verhalten -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=behavior}">
                    <TextBlock Text="Verhalten" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Wann das Panel aus- und einfährt und wie du es öffnest." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="Ausfahren und Einklappen" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE823;" Header="Verweilzeit bis zum Ausfahren" Description="Verhindert ungewolltes Öffnen beim Vorbeifahren.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0" Maximum="1000" TickFrequency="50" Value="{Binding HoverDelayMs}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HoverDelayMs, StringFormat={}{0} ms}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE81C;" Header="Einklappen nach Verlassen" Description="Zeit, bis das Panel wieder einfährt.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0" Maximum="2000" TickFrequency="100" Value="{Binding CollapseDelayMs}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CollapseDelayMs, StringFormat={}{0} ms}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE740;" Header="Bei Vollbild-Programmen ausblenden" Description="Die Hover-Zone ruht, solange ein Video, eine Präsentation, ein Spiel oder eine Remotedesktop-Sitzung im Vollbild läuft. Das Tastenkürzel funktioniert weiter.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideHotZoneInFullscreen}"/>
                    </c:SettingsCard>
                    <TextBlock Text="Öffnen" Style="{StaticResource SettingsSection}"/>
                    <StackPanel DataContext="{Binding Panel}">
                        <c:SettingsCard Icon="&#xE765;" Header="Tastenkürzel" Description="Öffnet das Panel und setzt den Cursor ins Suchfeld. Zum Ändern ins Feld klicken und die Kombination drücken.">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Klicken und die gewünschte Tastenkombination drücken"/>
                                <Button Style="{StaticResource Btn.Standard}" Content="Entfernen" Margin="8,0,0,0" Command="{Binding ClearHotkeyCommand}"/>
                            </StackPanel>
                        </c:SettingsCard>
                        <TextBlock Text="{Binding DataContext.HotkeyError, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Error}"
                                   FontSize="12" Margin="4,0,0,6" Visibility="{Binding DataContext.HotkeyError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                        <c:SettingsCard Icon="&#xE71C;" Header="Vorausgewählter Filter" Description="Dieser Filter ist ausgewählt, wenn das Panel aufgeht.">
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Filters}" SelectedValue="{Binding DefaultFilter}"/>
                        </c:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <!-- Panel › Darstellung -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=look}">
                    <TextBlock Text="Darstellung" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Alles rund um das Aussehen: Design, Einträge, Panel und Hover-Zone." Style="{StaticResource Caption}" TextWrapping="Wrap"/>

                    <TextBlock Text="Allgemein" Style="{StaticResource SettingsSection}"/>
                    <!-- Designvorlagen: ein Klick setzt Design, Panelfarbe, Deckkraft, Acrylic und Akzent -->
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Designvorlagen" FontWeight="SemiBold"/>
                            <TextBlock Text="Setzt Design, Panelfarbe, Deckkraft, Acrylic, Akzentfarbe und Fensterhintergrund auf einmal – einzeln anpassbar." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <ItemsControl ItemsSource="{Binding DesignPresets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding ApplyCommand}" Width="150" Margin="0,0,8,8" Padding="0" Cursor="Hand" ToolTip="{Binding Description}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Bg.CardAlt}" Padding="8">
                                                        <StackPanel>
                                                            <Border Height="44" CornerRadius="4" Background="{Binding Swatch}" Padding="8,6">
                                                                <StackPanel>
                                                                    <Border Height="5" Width="54" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource Accent}"/>
                                                                    <Border Height="4" Width="80" HorizontalAlignment="Left" CornerRadius="2" Margin="0,6,0,0" Background="{Binding Ink}" Opacity="0.5"/>
                                                                    <Border Height="4" Width="64" HorizontalAlignment="Left" CornerRadius="2" Margin="0,4,0,0" Background="{Binding Ink}" Opacity="0.3"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Height="30"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <c:SettingsCard Icon="&#xE790;" Header="Design" Description="Hell oder dunkel für alle Fenster. Ist in Windows ein Kontrastdesign aktiv, verwendet Power-Exec automatisch dessen Farben.">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Themes}" SelectedValue="{Binding Theme}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE2B1;" Header="Akzentfarbe von Windows übernehmen"
                                    Description="Knöpfe, Auswahl und Hover-Zone nutzen die Akzentfarbe aus den Windows-Einstellungen (Personalisierung › Farben) – passend aufgehellt bzw. abgedunkelt.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseWindowsAccent}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE81E;" Header="Mica in Fenstern" Description="{Binding MicaDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseMica}" IsEnabled="{Binding IsMicaSupported}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D3;" Header="Schrift- und Elementgröße" Description="Vergrößert Schrift und Bedienelemente im Panel und in allen Fenstern (zusätzlich zur Windows-Skalierung).">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="80" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding UiScalePercent}" VerticalAlignment="Center"
                                        AutomationProperties.Name="Schrift- und Elementgröße"/>
                                <TextBlock Text="{Binding UiScalePercent, StringFormat={}{0} %}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <Border Margin="0,0,0,4" Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1"
                            Visibility="{Binding IsHighContrast, Converter={StaticResource Vis}}">
                        <TextBlock Text="Kontrastdesign von Windows ist aktiv: Panelfarbe, Deckkraft, Acrylic und Akzentfarbe werden ignoriert, damit alles gut lesbar bleibt." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Info.Text}"/>
                    </Border>
                    <c:SettingsCard Icon="&#xE916;" Header="Animation" Description="Wie das Panel aus- und einfährt.">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Animations}" SelectedValue="{Binding Animation}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8B9;" Header="Symbole anzeigen" Description="Programmsymbole, Ordnersymbol, Remotedesktop-Symbol und Favicons von Webseiten (einmal geladen und zwischengespeichert). Scripte behalten ihr Kürzel.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowProgramIcons}"/>
                    </c:SettingsCard>
                    <StackPanel DataContext="{Binding Panel}">
                    <c:SettingsCard Icon="&#xE8FD;" Header="Ansicht" Description="Einträge als Liste oder als Raster (Kacheln). Auch über den Panel-Kopf umschaltbar.">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Layouts}" SelectedValue="{Binding Layout}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8E9;" Header="Elementgröße" Description="Größe der Einträge in Liste und Raster. Auch über den Panel-Kopf umschaltbar.">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ItemSizes}" SelectedValue="{Binding ItemSize}"/>
                    </c:SettingsCard>

                    <TextBlock Text="Panel" Style="{StaticResource SettingsSection}"/>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,4">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="150" Height="40" CornerRadius="6" Background="{Binding PreviewBrush}"
                                        BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" ToolTip="{Binding PreviewText}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Panelfarbe" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Hintergrund des Panels. Bei hellen Farben wird die Schrift automatisch dunkel." Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ColorPresets}" Focusable="False" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,8,8" Cursor="Hand"
                                                AutomationProperties.Name="{Binding Name}" FocusVisualStyle="{StaticResource FocusVisual}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel Width="76">
                                                        <Border x:Name="Ring" Width="40" Height="40" CornerRadius="20" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                                                            <Border CornerRadius="15" Background="{Binding Swatch}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1">
                                                                <TextBlock Text="A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Text.Primary}" x:Name="DesignMark" Visibility="Collapsed"/>
                                                            </Border>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Hex}" Value="">
                                                            <Setter TargetName="DesignMark" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Eigene Farbe:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Text.Secondary}"/>
                                <TextBox Width="120" Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="#RRGGBB"
                                         FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="{Binding ColorError}" Foreground="{DynamicResource Status.Error}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding ColorError, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <c:SettingsCard Icon="&#xE7B3;" Header="Acrylic (Hintergrund weichzeichnen)"
                                    Description="Der Desktop hinter dem Panel erscheint verschwommen, getönt mit der Panelfarbe – wie das Startmenü von Windows 11. Unter 72 % Deckkraft wirkt es am stärksten.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Acrylic}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xEF1F;" Header="Deckkraft" Description="Unter 100 % scheint der Desktop leicht durch; Schrift bleibt voll deckend.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="50" Maximum="100" TickFrequency="5" Value="{Binding PanelOpacity}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PanelOpacity, StringFormat={}{0} %}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE9A6;" Header="Breite" Description="Breite und Höhe lassen sich auch direkt am Panel per Ziehen am Innenrand ändern.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="280" Maximum="900" TickFrequency="20" Value="{Binding PanelWidth}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PanelWidth, StringFormat={}{0} px}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE9A6;" Header="Höhe" Description="Anteil der Bildschirmhöhe (ohne Taskleiste). 100 % = ganze Höhe.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="30" Maximum="100" TickFrequency="5" Value="{Binding PanelHeightPercent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PanelHeightPercent, StringFormat={}{0} %}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8A0;" Header="Lage" Description="Wo das kleinere Panel entlang der Kante erscheint. „An der Hover-Zone“ öffnet es auf Höhe des Auslösebereichs." Visibility="{Binding IsPartialHeight, Converter={StaticResource Vis}}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding PanelAlignments}" SelectedValue="{Binding PanelAlignment}"/>
                    </c:SettingsCard>

                    <TextBlock Text="Hover-Zone" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7F4;" Header="Bildschirmrand" Description="An welchem Rand die Hover-Zone liegt und das Panel ausfährt.">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EdgeList}" SelectedValue="{Binding Edge}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7F4;" Header="Monitor" Description="Bei „Alle Monitore“ öffnet das Tastenkürzel das Panel auf dem Monitor mit dem Mauszeiger.">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Monitors}" SelectedValue="{Binding MonitorChoice}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8A0;" Header="Lage" Description="Lage des Auslösebereichs am Rand. Die Hover-Zone hat die Panelfarbe (ohne eigene Farbe: Akzentfarbe).">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding HotZones}" SelectedValue="{Binding HotZone}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE9A6;" Header="Länge" Description="Ausdehnung entlang der Kante, mittig ausgerichtet." Visibility="{Binding IsHotZoneMiddle, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="50" Maximum="1200" TickFrequency="25" Value="{Binding HotZoneLength}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HotZoneLength, StringFormat={}{0} px}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE9A6;" Header="Breite" Description="Wie weit der Auslösebereich vom Rand nach innen reicht. Breiter = leichter zu treffen, aber auffälliger.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding HotZoneThickness}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HotZoneThickness, StringFormat={}{0} px}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    </StackPanel>
                </StackPanel>

                <!-- PowerShell -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=exec}">
                    <TextBlock Text="PowerShell" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Standardwerte für den Start von Scripten. Startprofile eines Eintrags (⚙) können sie überschreiben." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="Start" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE756;" Header="Standard-PowerShell (lokal)" Description="Fehlt PowerShell 7, wird automatisch Windows PowerShell 5.1 verwendet.">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EnginesList}" SelectedValue="{Binding DefaultEngine}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72E;" Header="Execution Policy" Description="Gilt nur für die von Power-Exec gestarteten Scripte.">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Policies}" SelectedValue="{Binding ExecutionPolicy}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE77B;" Header="Ohne Profil starten (-NoProfile)" Description="Schnellerer Start, keine Seiteneffekte aus dem PowerShell-Profil.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NoProfile}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7C4;" Header="Konsole nach Ende offen lassen (-NoExit)" Description="Damit die Ausgabe sichtbar bleibt.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NoExit}"/>
                    </c:SettingsCard>
                    <TextBlock Text="Editor" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE70F;" Header="Editor für „Im Editor öffnen“">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Editors}" SelectedValue="{Binding Editor}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8E5;" Header="Eigener Editor" Description="Pfad zur EXE" Visibility="{Binding IsCustomEditor, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="320" Text="{Binding EditorPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="C:\Program Files\Notepad++\notepad++.exe"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseEditorCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="Gut zu wissen" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE946;" Header="So startet Power-Exec Scripte" Description="Netzlaufwerke, Begleitdateien, Delegation">
                        <StackPanel Margin="0,6">
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="Netzwerkpfade: "/><Run Text="Verbundene Laufwerke werden vor dem Start in UNC-Pfade umgewandelt – erhöhte Prozesse und andere Konten sehen keine verbundenen Laufwerke."/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="Begleitdateien bei Remote: "/><Run Text="„Scriptordner mitsenden“ kopiert Module und Dateien über die Remote-Sitzung und löscht sie danach. Dauerhaft mit „PowerExec: CopyFolder“ unter .NOTES."/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="Delegation (CredSSP): "/><Run Text="wird bewusst nicht unterstützt, weil Anmeldedaten an den Zielrechner weitergegeben würden."/></TextBlock>
                        </StackPanel>
                    </c:SettingsExpander>
                </StackPanel>

                <!-- Remote -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=remote}">
                    <TextBlock Text="Remote" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Ausführung auf anderen Rechnern über WinRM, einzeln oder parallel auf vielen." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="Verbindung" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE968;" Header="PowerShell bei Remote" Description="Auf den meisten Servern gibt es nur 5.1. PowerShell 7 nur, wenn der Endpunkt PowerShell.7 existiert.">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RemoteEngines}" SelectedValue="{Binding RemoteEngine}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72E;" Header="Remote über HTTPS (Port 5986)" Description="Für Rechner außerhalb der Domäne bzw. wenn WinRM nur per HTTPS erreichbar ist. Auf dem Ziel muss ein HTTPS-Listener eingerichtet sein.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RemoteUseSsl}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE916;" Header="Verbindungs-Timeout pro Rechner" Description="Danach gilt der Rechner als nicht erreichbar.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="10" Maximum="300" TickFrequency="10" Value="{Binding RemoteTimeoutSeconds}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RemoteTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE902;" Header="Gleichzeitige Verbindungen" Description="Für die Massenausführung.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="1" Maximum="64" TickFrequency="1" Value="{Binding ThrottleLimit}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ThrottleLimit}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="Ergebnisse" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xEA8F;" Header="Benachrichtigen, wenn ein Remote-Lauf fertig ist" Description="Windows-Benachrichtigung mit Zusammenfassung; ein Klick öffnet die Ergebnisliste.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyOnFinish}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8B7;" Header="Log-Ordner" Description="{Binding LogFolderDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Standard}" Content="Ändern …" Command="{Binding BrowseLogFolderCommand}"/>
                            <Button Style="{StaticResource Btn.Standard}" Content="Öffnen" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="Rechner und Anmeldung" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7F4;" Header="Zuletzt verwendete Rechner" Description="{Binding MachinesText}">
                        <Button Style="{StaticResource Btn.Standard}" Content="Liste leeren" Command="{Binding ClearMachinesCommand}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D7;" Header="Anmeldedaten" Description="Werden bei jedem Start abgefragt und nie gespeichert.">
                        <TextBlock Text="Immer abfragen" Foreground="{DynamicResource Text.Secondary}"/>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Diagnose & Daten -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=diag}">
                    <TextBlock Text="Diagnose" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Protokoll für die Fehlersuche und Einlesezeiten der Ordner." Style="{StaticResource Caption}"/>

                    <TextBlock Text="Einlesen der Ordner" Style="{StaticResource SettingsSection}"/>

                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Ordner" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding FolderTimes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock x:Name="Info" DockPanel.Dock="Right" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                <Setter TargetName="Info" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SystemInfo}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Protokoll" Style="{StaticResource SettingsSection}"/>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Standard}" Content="Aktualisieren" Command="{Binding RefreshLogCommand}" FontSize="12"/>
                                    <Button Style="{StaticResource Btn.Standard}" Content="Protokoll kopieren" Command="{Binding CopyLogCommand}" FontSize="12" Margin="8,0,0,0"/>
                                    <Button Style="{StaticResource Btn.Standard}" Content="Ordner öffnen" Command="{Binding OpenAppLogFolderCommand}" FontSize="12" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Protokoll" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="{Binding LogFile}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Height="280">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="10,8"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"
                                       Text="Bei Problemen „Protokoll kopieren“ und den Text mitschicken – er enthält Version, Ordner-Status und die letzten Meldungen, aber keine Kennwörter."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="Schließen" MinWidth="110" Height="34" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Änderungen verwerfen" Height="34" Click="Revert_Click"
                        ToolTip="Stand beim Öffnen der Einstellungen wiederherstellen"/>
                <TextBlock x:Name="SaveHint" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Text="Änderungen werden sofort übernommen."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
