<Window x:Class="PowerExec.Views.SettingsWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        xmlns:v="clr-namespace:PowerExec.Views"
        xmlns:vm="clr-namespace:PowerExec.ViewModels;assembly=PowerExec.UI.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Power-Exec – Einstellungen'}" Style="{StaticResource AppWindow}"
        Width="1120" Height="800" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Themes/Fluent.xaml"/></ResourceDictionary.MergedDictionaries>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Farbkachel wie in den Windows-Einstellungen: Quadrat, ausgewählt mit Rahmen und Häkchen -->
        <DataTemplate x:Key="ColorTile">
            <Button Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,6,6" Cursor="Hand"
                    AutomationProperties.Name="{Binding ToolTip}" FocusVisualStyle="{StaticResource FocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="46" Height="46">
                            <Border x:Name="Swatch" CornerRadius="4" Background="{Binding SwatchColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Panel}"
                                    BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"/>
                            <Border x:Name="Ring" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Text.Primary}" Visibility="Collapsed"/>
                            <Border x:Name="Check" Width="18" Height="18" CornerRadius="0,4,0,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource Text.Primary}" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Bg.Window}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
                            <!-- Gruppenkarte, rekursiv: Untergruppen liegen als Karten im Rahmen der übergeordneten Gruppe -->
        <DataTemplate x:Key="CategoryCardTemplate">
                                <!-- Gruppen ziehen: Lücke über/unter der Karte; die gezogene Gruppe macht Platz -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <c:DropGap IsOpen="{Binding GapBefore}" OpenHeight="44"
                                               Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                               Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" MinHeight="0"
                                        AllowDrop="True" DragOver="GroupCard_DragOver" DragLeave="GroupCard_DragLeave" Drop="GroupCard_Drop">
                                    <StackPanel>
                                        <DockPanel Margin="6,6,8,6" MinHeight="44" Background="Transparent" Cursor="SizeAll"
                                                   PreviewMouseLeftButtonDown="GroupCard_PreviewMouseDown" PreviewMouseMove="GroupCard_PreviewMouseMove"
                                                   ToolTip="{l:T 'Ziehen, um die Gruppe zu verschieben – auf die Mitte einer anderen Gruppe gezogen wird sie zur Untergruppe. Rechtsklick: neue Untergruppe'}">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:T 'Neue Untergruppe …'}" Command="{Binding NewSubgroupCommand}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{l:T 'Umbenennen …'}" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="{l:T 'Symbol wählen …'}" Command="{Binding ChooseIconCommand}"/>
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Margin="2,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="{l:T 'Ordner und Einträge ein-/ausklappen'}" Visibility="{Binding IsSmart, Converter={StaticResource Vis}, ConverterParameter=hidden}">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Width="34" Height="34" MinHeight="34" Padding="0" Command="{Binding ChooseIconCommand}"
                                                    ToolTip="{l:T 'Symbol wählen'}" Margin="4,0,12,0">
                                                <Grid>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="18" Foreground="{DynamicResource Text.Primary}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                    <TextBlock x:Name="DefaultGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Text.Tertiary}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                </Grid>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Height="22" Padding="8,0" CornerRadius="11" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}"
                                                        BorderThickness="1" Margin="0,0,8,0" Visibility="{Binding Folder.HasPending, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding Folder.PendingCount, StringFormat={}{0} neu}" FontSize="11" Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                                                </Border>
                                                <ComboBox Width="150" Margin="0,0,4,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding ColorOwn}" SelectedValuePath="Key"
                                                          ToolTip="{l:T 'Farbe der Gruppe (Untergruppen übernehmen sie)'}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Command="{Binding CustomColorCommand}" ToolTip="{l:T 'Eigene Farbe im Farbwähler aussuchen'}">
                                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ComboBox Width="125" Margin="4,0,8,0" ItemsSource="{Binding LayoutList}" SelectedValue="{Binding Layout}"
                                                          DisplayMemberPath="Value" SelectedValuePath="Key" ToolTip="{l:T 'Darstellung dieser Gruppe im Panel'}"/>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="{l:T 'Umbenennen (Anzeigename)'}">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Gruppe löschen (nach Rückfrage)'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Smarte Gruppe: Ordner und seine Einträge -->
                                        <ContentControl Content="{Binding Folder}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSmart}" Value="True"/>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Ordner -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg.CardAlt}" Padding="16,12">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Ordner trennen'}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                                                                            ToolTip="{l:T 'Ordner nicht mehr einlesen; die Gruppe bleibt als normale Gruppe'}" />
                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Durchsuchen …'}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                                                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'Pfad, z. B. C:\\Scripts oder \\\\server\\freigabe'}"/>
                                                                </DockPanel>
                                                                <WrapPanel Margin="0,10,0,0">
                                                                    <CheckBox Content="{l:T 'Unterordner einbeziehen'}" IsChecked="{Binding Recursive}" Margin="0,0,20,6" VerticalAlignment="Center"/>
                                                                    <CheckBox Content="{l:T 'Unterordner im Panel als Untergruppen'}" IsChecked="{Binding SubfoldersAsGroups}" IsEnabled="{Binding Recursive}"
                                                                              Margin="0,0,20,6" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{l:T 'Dateiendungen:'}" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource Text.Secondary}"/>
                                                                    <StackPanel Margin="0,0,0,6">
                                                                        <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                                                                 Tag="{l:T 'leer = Standard; z. B. .ps1; .cmd'}" FontFamily="{StaticResource MonoFont}"
                                                                                 ToolTip="{l:T 'Mit Semikolon getrennt, z. B. .ps1; .cmd; .exe'}"/>
                                                                        <TextBlock Text="{Binding ExtensionsError}" FontSize="11" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" MaxWidth="220"
                                                                                   Visibility="{Binding ExtensionsError, Converter={StaticResource Vis}}"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="{l:T ' · Letzter Scan: '}"/><Run Text="{Binding Status, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Einträge -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                                            <StackPanel>
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBlock Text="{l:T 'Neue Dateien:'}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                        <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="1" Width="330">
                                            <UniformGrid Columns="2">
                                                <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Automatisch anzeigen'}" IsChecked="{Binding AutoShow}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Erst nach Freigabe'}" IsChecked="{Binding RequireApproval}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </WrapPanel>

                                    <Border Visibility="{Binding HasPending, Converter={StaticResource Vis}}" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                                            Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Alle freigeben'}" Command="{Binding ApproveAllCommand}" Height="30" MinHeight="30" FontSize="12" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Ausgeblendet lassen'}" Command="{Binding DismissPendingCommand}" Height="30" MinHeight="30" FontSize="12" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Alle anzeigen'}" Command="{Binding AllOnCommand}" Height="28" MinHeight="28" FontSize="12" />
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Keine'}" Command="{Binding AllOffCommand}" Height="28" MinHeight="28" FontSize="12" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <Grid Width="240" Margin="0,0,10,0" DockPanel.Dock="Left">
                                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="28,0,8,0" Tag="{l:T 'In diesem Ordner suchen'}" Height="30" MinHeight="30"/>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource Text.Secondary}"/>
                                        </Grid>
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Alle'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Scripte'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=scripts}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Programme'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=programs}"/>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:T 'Panel'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{l:T 'Eintrag'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{l:T 'Startprofile'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{l:T 'Admin'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding VisibleRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" MinHeight="50" Background="Transparent">
                                                    <Grid x:Name="RowGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="250"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsVisibleInPanel}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat={}{0} im Panel anzeigen}"/>
                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Width="36" Height="22" CornerRadius="4" Background="{DynamicResource Badge.Other.Bg}"
                                                                    Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Badge.Other.Fg}"/>
                                                            </Border>
                                                            <Image Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="22" Height="22" HorizontalAlignment="Left" Margin="7,0,0,0"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,6,12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="9" Background="{DynamicResource Accent}"
                                                                        Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                                                    <TextBlock Text="{l:T 'NEU'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                                </Border>
                                                                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="9" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}" BorderThickness="1"
                                                                        Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}"
                                                                        ToolTip="{l:T 'Aus dem Internet heruntergeladen – im Panel über „Entsperren“ freigeben'}">
                                                                    <TextBlock Text="{l:T 'BLOCKIERT'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Status.Warning}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Info}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding ProfilesText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProfileDetail}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Status.Warning}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{l:T 'Ja'}" FontSize="12" Foreground="{DynamicResource Status.Warning}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="5" Style="{StaticResource Btn.Icon}" Width="34" Height="34" Command="{Binding ConfigureCommand}"
                                                                ToolTip="{l:T 'Startprofile'}" Visibility="{Binding CanToggle, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsVisibleInPanel}" Value="False">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l:T 'Keine Einträge für diese Suche.'}" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding NoRows, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{l:T 'Noch keine Einträge – der Ordner wird eingelesen …'}" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding HasNoEntries, Converter={StaticResource Vis}}"/>

                                    <WrapPanel Margin="0,12,0,0">
                                        <TextBlock Text="{l:T 'Muster-Ausschlüsse:'}" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                        <ItemsControl ItemsSource="{Binding Exclusions}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="26" CornerRadius="13" Background="{DynamicResource Excl.Bg}" BorderBrush="{DynamicResource Excl.Border}"
                                                            BorderThickness="1" Padding="10,0,2,0" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource Excl.Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                                            <ui:Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                                                    ToolTip="{l:T 'Ausschluss entfernen'}" Foreground="{DynamicResource Excl.Text}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="28" MinHeight="28" Margin="0,0,6,6"
                                                 Tag="{l:T 'z. B. *.exe oder *\\Archiv\\*'}" FontSize="12"/>
                                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T '+ Muster'}" Command="{Binding AddExclusionCommand}" Height="28" MinHeight="28"
                                                FontSize="12" Margin="0,0,0,6" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="{l:T 'Einzelne Dateien werden über den Haken ein- und ausgeblendet. Muster werden sofort angewendet; die Liste aktualisiert sich nach dem Einlesen.'}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <!-- Untergruppen im Rahmen dieser Gruppe; Lücke „als letzte Untergruppe“ -->
                                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource CategoryCardTemplate}" Focusable="False" Margin="14,2,12,0"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource Vis}}"/>
                                        <c:DropGap IsOpen="{Binding GapInside}" Margin="14,0,12,0" OpenHeight="44"
                                                   Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                                   Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                    </StackPanel>
                                </Border>
                                    <c:DropGap IsOpen="{Binding GapAfter}" OpenHeight="44"
                                               Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                               Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSmart}" Value="True">
                                        <Setter TargetName="DefaultGlyph" Property="Text" Value="&#xE8B7;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Folder.IsHighlighted}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <!-- Gruppe wird hineingezogen: Rahmen der Zielgruppe hervorheben -->
                                    <DataTrigger Binding="{Binding GapInside}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="GroupCard" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
        <!-- Feste Gruppe (Schloss): verschiebbar wie eine Gruppe, aber ohne Untergruppen, Farbe oder Löschen -->
        <DataTemplate x:Key="FixedCardTemplate">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <c:DropGap IsOpen="{Binding GapBefore}" OpenHeight="44"
                           Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" MinHeight="0" Background="{DynamicResource Bg.CardAlt}"
                        AllowDrop="True" DragOver="GroupCard_DragOver" DragLeave="GroupCard_DragLeave" Drop="GroupCard_Drop">
                    <StackPanel>
                        <DockPanel Margin="6,6,12,6" MinHeight="44" Background="Transparent" Cursor="SizeAll"
                                   PreviewMouseLeftButtonDown="GroupCard_PreviewMouseDown" PreviewMouseMove="GroupCard_PreviewMouseMove"
                                   ToolTip="{l:T 'Feste Gruppe – ziehen, um sie zu verschieben. Ein- und ausblenden je Arbeitsbereich.'}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Margin="2,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="34,0,12,0" CornerRadius="4">
                                <TextBlock Text="{Binding FixedGlyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Text.Secondary}"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Zuletzt ausgeführt: wie viele -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecentFixed, Converter={StaticResource Vis}}">
                                    <Slider Width="140" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding DataContext.RecentRunsCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="{Binding DataContext.RecentRunsText, RelativeSource={RelativeSource AncestorType=Window}}" Width="80" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Verwalten …'}" Visibility="{Binding IsCustomFixed, Converter={StaticResource Vis}}"
                                        Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="custom" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               VerticalAlignment="Center" ToolTip="{l:T 'Feste Gruppe: kann nicht gelöscht werden'}" AutomationProperties.Name="{l:T 'Feste Gruppe'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FixedDescription}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <c:DropGap IsOpen="{Binding GapAfter}" OpenHeight="44"
                           Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            Navigation (WPF UI): einklappbarer Rand (☰), einklappbare Oberkategorien, Zurück-Schaltfläche über den Verlauf
            der Abschnitte. Die Leiste
            navigiert zu leeren Seiten (SettingsSectionPage); die Abschnitte liegen im Inhaltsbereich (ContentOverlay).
            Abschnitt ↔ Auswahl gleicht SettingsWindow.xaml.cs ab.
        -->
        <ui:NavigationView x:Name="Nav" Grid.ColumnSpan="2" PaneDisplayMode="Left" IsBackButtonVisible="Visible" IsPaneToggleVisible="True"
                           OpenPaneLength="250" PaneTitle="Einstellungen" HeaderVisibility="Collapsed" FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T 'Allgemein'}" TargetPageTag="general" TargetPageType="{x:Type v:SettingsSectionPage}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE713;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Inhalte: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Inhalte'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Inhalte'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Gruppen'}" TargetPageTag="groups" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Eigene Einträge'}" TargetPageTag="custom" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE71B;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Schlagworte'}" TargetPageTag="tags" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8EC;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Marktplatz'}" TargetPageTag="marketplace" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE719;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Variablen'}" TargetPageTag="variables" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE943;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Arbeitsbereiche'}" TargetPageTag="workspaces" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Panel: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Panel'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Panel'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE737;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Darstellung'}" TargetPageTag="look" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE790;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Verhalten'}" TargetPageTag="behavior" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE823;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Ausführung: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Ausführung'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Ausführung'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE768;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'PowerShell'}" TargetPageTag="exec" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE756;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Remote'}" TargetPageTag="remote" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE968;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Rechnergruppen'}" TargetPageTag="machines" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE7F4;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <!-- Hilfe: einklappbare Oberkategorie (Klick klappt auf/zu, navigiert selbst nicht) -->
                <ui:NavigationViewItem Content="{l:T 'Hilfe'}" IsExpanded="True" AutomationProperties.Name="{l:T 'Hilfe'}">
                    <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE897;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{l:T 'Beispiele'}" TargetPageTag="samples" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE943;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{l:T 'Diagnose'}" TargetPageTag="diag" TargetPageType="{x:Type v:SettingsSectionPage}">
                            <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE9D9;" FontFamily="{StaticResource IconFont}"/></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <TextBlock Text="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Style="{StaticResource Caption}" Margin="16,8,0,12"/>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.ContentOverlay>
        <DockPanel>
        <!-- Suche (wie PowerToys oben in der Mitte) -->
        <Grid DockPanel.Dock="Top" Margin="28,12,28,4" MaxWidth="520" HorizontalAlignment="Stretch">
            <TextBox x:Name="SettingsSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,0,8,0" Tag="{l:T 'Nach Einstellungen suchen'}">
                    <TextBox.Resources><CornerRadius x:Key="TextBox.CornerRadius">12</CornerRadius></TextBox.Resources>
                </TextBox>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" PlacementTarget="{Binding ElementName=SettingsSearch}" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="True" Width="{Binding ActualWidth, ElementName=SettingsSearch}">
                <Border Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalContentAlignment="Stretch" Padding="10,4" MinHeight="40"
                                        Command="{Binding DataContext.OpenSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"/>
                                        <TextBlock Text="{Binding Page}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
        <!-- Update-Hinweis: erscheint in allen Bereichen, sobald eine neue Version gefunden wurde -->
        <Border DockPanel.Dock="Top" Margin="16,12,28,4" Padding="14,12" CornerRadius="6" Background="{DynamicResource Info.Bg}"
                BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="18" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Versionshinweise'}" Command="{Binding ReleaseNotesCommand}" Margin="0,0,8,0" />
                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Jetzt aktualisieren'}" Command="{Binding InstallUpdateCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Update.Subtitle}" FontSize="12" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Power-Exec wird dabei beendet und neu gestartet; nicht gespeicherte Änderungen hier gehen verloren.'}"
                               FontSize="11" Foreground="{DynamicResource Info.Text}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,4,28,28">

                <!-- Eigene Einträge -->
                <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=custom}">
                <StackPanel DataContext="{Binding EntryList}">
                    <TextBlock Text="{l:T 'Eigene Einträge'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Webseiten, Ordner, Remotedesktop, SSH, Snippets, Windows-Werkzeuge, Befehle und einzelne Dateien. ⚙ bearbeitet einen Eintrag; mehrere markieren zum Verschieben, Exportieren oder Löschen. Einträge lassen sich direkt ins Panel ziehen, um sie in eine Gruppe einzusortieren.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Werkzeugleiste -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource Btn.Accent}" Click="NewEntryMenu_Click" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Neu'}"/>
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0"/></StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T 'Neuer Eintrag …'}" Command="{Binding NewCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T 'Webseite …'}" Command="{Binding NewCommand}" CommandParameter="Url"/>
                                        <MenuItem Header="{l:T 'Ordner …'}" Command="{Binding NewCommand}" CommandParameter="Folder"/>
                                        <MenuItem Header="{l:T 'Remotedesktop …'}" Command="{Binding NewCommand}" CommandParameter="Rdp"/>
                                        <MenuItem Header="{l:T 'SSH-Verbindung …'}" Command="{Binding NewCommand}" CommandParameter="Ssh"/>
                                        <MenuItem Header="{l:T 'PowerShell-Snippet …'}" Command="{Binding NewCommand}" CommandParameter="Snippet"/>
                                        <MenuItem Header="{l:T 'Text-Snippet …'}" Command="{Binding NewCommand}" CommandParameter="TextSnippet"/>
                                        <MenuItem Header="{l:T 'Windows-Werkzeug …'}" Command="{Binding NewCommand}" CommandParameter="Tool"/>
                                        <MenuItem Header="{l:T 'Befehl …'}" Command="{Binding NewCommand}" CommandParameter="Command"/>
                                        <MenuItem Header="{l:T 'Datei …'}" Command="{Binding NewCommand}" CommandParameter="File"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T 'Aus Vorlagen …'}" Command="{Binding CatalogCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </ui:Button>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Importieren …'}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Suchen (Name, Ziel, Code, #schlagwort)'}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <!-- Typ-Filter: die häufigsten als Chips, der Rest im Dropdown – bleibt auch in schmalen Fenstern einzeilig -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Alle'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Webseiten'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Url}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Snippets'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=Snippet}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="{l:T 'RDP/SSH'}" GroupName="EntryKind" IsChecked="{Binding KindFilter, Converter={StaticResource Eq}, ConverterParameter=remote}"/>
                        <ComboBox Width="170" Margin="4,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding MoreKinds}" SelectedValue="{Binding MoreKind}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{l:T 'Weitere Typen'}"/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding CheckCommand}"
                                ToolTip="{l:T 'Webseiten, Ordner, Dateien, RDP-/SSH-Ports und Programme prüfen (Auswahl bzw. alle sichtbaren)'}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="{Binding CheckText}"/></StackPanel>
                        </ui:Button>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="190" ItemsSource="{Binding GroupFilters}" SelectedValue="{Binding GroupFilter}" DisplayMemberPath="Value" SelectedValuePath="Key">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Style.Triggers>
                                            <!-- Trennlinie zwischen festen Filtern und Gruppen -->
                                            <DataTrigger Binding="{Binding Key}" Value="—sep">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ComboBoxItem">
                                                            <Separator Margin="8,4" Background="{DynamicResource Border.Default}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding TagFilters}" SelectedValue="{Binding TagFilter}" DisplayMemberPath="Value" SelectedValuePath="Key"/>
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Mehrfachauswahl -->
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox Width="190" IsEditable="True" ItemsSource="{Binding MoveTargets}" Text="{Binding MoveTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'In Gruppe verschieben'}" Command="{Binding MoveSelectedCommand}" Margin="0,2,10,2" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Exportieren …'}" Command="{Binding ExportCommand}" Margin="0,2,6,2" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Löschen'}" Command="{Binding RemoveSelectedCommand}" Margin="0,2,6,2" />
                            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Auswahl aufheben'}" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2" />
                        </WrapPanel>
                    </Border>

                    <TextBlock Text="{l:T 'Noch keine eigenen Einträge. „Neu“ (auch aus Vorlagen) – oder im Panel per Drag &amp; Drop, Strg+V und Rechtsklick.'}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{l:T 'Keine Treffer für Suche und Filter.'}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding NoMatches, Converter={StaticResource Vis}}"/>

                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <!-- Kopfzeile -->
                            <Grid Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Alle'}" FontSize="11" Padding="2,0" MinHeight="22" Height="22" Command="{Binding SelectAllCommand}"
                                        Grid.ColumnSpan="2" HorizontalAlignment="Left" ToolTip="{l:T 'Alle sichtbaren auswählen'}" />
                                <TextBlock Grid.Column="2" Text="{l:T 'Eintrag'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{l:T 'Gruppe / Schlagworte'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding VisibleRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="EntryRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,5" Background="Transparent"
                                                PreviewMouseLeftButtonDown="EntryRow_PreviewMouseLeftButtonDown" PreviewMouseMove="EntryRow_PreviewMouseMove"
                                                ToolTip="{l:T 'Zum Einsortieren ins Panel ziehen (an den Bildschirmrand, das Panel fährt aus)'}" ToolTipService.InitialShowDelay="1500">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="76"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Width="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Width="32" Height="20" CornerRadius="4" Background="{DynamicResource Badge.Other.Bg}"
                                                            Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Badge.Other.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Source="{Binding Image, Converter={StaticResource IconImage}}" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0"
                                                           Visibility="{Binding HasImage, Converter={StaticResource Vis}}"/>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="20" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" Foreground="{DynamicResource Text.Primary}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="8,1,0,0"/>
                                                        <TextBlock Text="&#xE8B0;" Style="{StaticResource Icon}" FontSize="11" Margin="6,1,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                                                   ToolTip="{l:T 'Startet mit einem Klick'}" Visibility="{Binding SingleClick, Converter={StaticResource Vis}}"/>
                                                        <TextBlock Text="{}{{…}}" FontSize="11" Margin="6,1,0,0" Foreground="{DynamicResource Accent}" ToolTip="{l:T 'Mit Platzhaltern'}"
                                                                   Visibility="{Binding HasPlaceholders, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False"/>
                                                </StackPanel>
                                                <Ellipse x:Name="Dot" Grid.Column="4" Width="9" Height="9" Fill="{DynamicResource Text.Disabled}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         ToolTip="{Binding HealthText}"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding EditCommand}" ToolTip="{l:T 'Bearbeiten'}">
                                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Entfernen'}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="EntryRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EntryRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="EntryRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthOk}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthOk}" Value="False">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>

                <!-- Rechnergruppen -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=machines}">
                    <TextBlock Text="{l:T 'Rechnergruppen'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Gruppen fassen Rechner zusammen. Im Ausführen-Dialog wählst du eine Gruppe mit einem Klick aus; in Startprofilen trägst du sie als @Name ein (z. B. @Webserver). Gruppen werden beim Start aufgelöst – Änderungen gelten sofort für alle Profile.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding AddGroupCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Gruppe hinzufügen'}"/></StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding ImportGroupFromListCommand}" Margin="8,0,0,0"
                                   ToolTip="{l:T 'Neue Gruppe aus einer Namensliste oder CSV-Datei – dynamisch, mit Filtern'}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Gruppe aus Liste importieren …'}"/></StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <TextBlock Text="{l:T 'Noch keine Gruppen.'}" Style="{StaticResource Caption}" Visibility="{Binding HasNoGroups, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding MachineGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8,8,16,8" MinHeight="0">
                                    <StackPanel>
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="{l:T 'Rechner anzeigen'}" Margin="0,0,6,0">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Gruppe löschen'}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding ExportCommand}"
                                                       ToolTip="{l:T 'Gruppe exportieren (CSV oder Text)'}" AutomationProperties.Name="{l:T 'Exportieren'}">
                                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding SyncNowCommand}"
                                                       Visibility="{Binding CanSync, Converter={StaticResource Vis}}"
                                                       ToolTip="{l:T 'Jetzt synchronisieren (aus dem AD bzw. der Liste lesen)'}" AutomationProperties.Name="{l:T 'Synchronisieren'}">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </ui:Button>
                                            <TextBlock Text="@" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource Text.Secondary}"/>
                                            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Name der Gruppe'}"/>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                                       Margin="12,0,8,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsExpanded, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="36,0,0,4">
                                        <!-- Quelle: feste Liste, dynamisch aus einer Liste (Datei mit Filtern) oder aus dem AD (Regeln) -->
                                        <DockPanel Margin="0,8,0,0">
                                            <ComboBox DockPanel.Dock="Right" Width="210" ItemsSource="{Binding Sources}" SelectedValue="{Binding Source}"
                                                      DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{l:T 'Quelle der Rechnergruppe'}"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{l:T 'Quelle'}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"
                                                           Text="{l:T 'Dynamische Gruppen werden beim Start und regelmäßig aktualisiert – die zuletzt gefundene Liste gilt auch offline.'}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Dynamisch aus einer Liste: Datei, Namensspalte, Filter -->
                                        <StackPanel Visibility="{Binding IsListSource, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{l:T 'Liste'}" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Datei wählen …'}" Command="{Binding ChooseListCommand}" Margin="6,0,0,0"/>
                                                <TextBox Text="{Binding ListPath, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Tag="{l:T 'Text (ein Rechner pro Zeile) oder CSV mit Spalten'}"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8" Visibility="{Binding IsCsv, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{l:T 'Namen in'}" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding ListColumns}" SelectedItem="{Binding NameColumn}"
                                                          AutomationProperties.Name="{l:T 'Spalte mit den Rechnernamen'}"/>
                                            </DockPanel>
                                            <TextBlock Text="{l:T 'Filter – alle müssen zutreffen (bei einer Namensliste nach dem Namen, bei einer CSV nach jeder Spalte)'}"
                                                       Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding ListFilters}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="30" Command="{Binding RemoveCommand}"
                                                                       ToolTip="{l:T 'Filter entfernen'}" AutomationProperties.Name="{l:T 'Filter entfernen'}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                            </ui:Button>
                                                            <ComboBox DockPanel.Dock="Left" Width="190" ItemsSource="{Binding Columns}" SelectedItem="{Binding Column}"
                                                                      AutomationProperties.Name="{l:T 'Spalte'}"/>
                                                            <ComboBox DockPanel.Dock="Left" Width="170" Margin="6,0,0,0" ItemsSource="{Binding Operators}" DisplayMemberPath="Value"
                                                                      SelectedValuePath="Key" SelectedValue="{Binding Operator}" AutomationProperties.Name="{l:T 'Vergleich'}"/>
                                                            <TextBox Margin="6,0,4,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="{l:T 'Wert (bei „ist gleich“ gehen * und ?)'}"
                                                                     Visibility="{Binding NeedsValue, Converter={StaticResource Vis}}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Left" Command="{Binding AddFilterCommand}" Padding="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="{l:T 'Filter (UND)'}" Foreground="{DynamicResource Accent}"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MachinesInline}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Secondary}" MaxHeight="90"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsStatic, Converter={StaticResource Vis}}">
                                        <TextBox Text="{Binding Machines, UpdateSourceTrigger=PropertyChanged, Delay=300}" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6"
                                                 FontFamily="{StaticResource MonoFont}" Margin="0,8,0,0" Tag="{l:T 'Ein Rechner pro Zeile (oder durch Komma getrennt)'}"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Sortieren'}" Command="{Binding SortCommand}" Margin="8,0,0,0" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'CSV/Text importieren …'}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBox Text="{Binding AdQuery, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'AD: SRV-*  ·  OU=Server,DC=firma,DC=local  ·  (operatingSystem=*Server*)'}"
                                                     Width="380" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Aus AD hinzufügen'}" Command="{Binding AdSearchCommand}" Margin="8,0,0,0" HorizontalAlignment="Left" />
                                        </DockPanel>
                                        </StackPanel>
                                        <!-- Regelblöcke: innerhalb UND, zwischen den Blöcken ODER -->
                                        <StackPanel Visibility="{Binding IsDynamic, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{l:T 'Ab OU'}" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding PickOuCommand}" Margin="6,0,0,0"
                                                           ToolTip="{l:T 'OU-Baum aus dem Active Directory anzeigen und eine OU auswählen'}" AutomationProperties.Name="{l:T 'OU auswählen'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{l:T 'OU wählen …'}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                                <TextBox Text="{Binding SearchBase, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Tag="{l:T 'leer = ganze Domäne · z. B. OU=Server,DC=firma,DC=local'}"/>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{l:T 'ODER'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="12,4,0,4"
                                                                       Visibility="{Binding IsFirst, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="10,8" Background="{DynamicResource Bg.CardAlt}">
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding RemoveCommand}"
                                                                                ToolTip="{l:T 'Block entfernen'}" AutomationProperties.Name="{l:T 'Block entfernen'}">
                                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11"/>
                                                                        </ui:Button>
                                                                        <TextBlock Text="{l:T 'Alle Regeln treffen zu'}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <DockPanel Margin="0,0,0,6">
                                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="30" Command="{Binding RemoveCommand}"
                                                                                            ToolTip="{l:T 'Regel entfernen'}" AutomationProperties.Name="{l:T 'Regel entfernen'}">
                                                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                                                    </ui:Button>
                                                                                    <!-- Attribut: Vorgabe wählen oder eigenes LDAP-Attribut eintippen -->
                                                                                    <ComboBox DockPanel.Dock="Left" Width="190" IsEditable="True" ItemsSource="{Binding AttributeChoices}" DisplayMemberPath="Value"
                                                                                              Text="{Binding AttributeText, UpdateSourceTrigger=LostFocus}" ToolTip="{l:T 'Attribut – eigenes LDAP-Attribut eintippen geht auch'}"/>
                                                                                    <ComboBox DockPanel.Dock="Left" Width="170" Margin="6,0,0,0" ItemsSource="{Binding Operators}" DisplayMemberPath="Value"
                                                                                              SelectedValuePath="Key" SelectedValue="{Binding Operator}"/>
                                                                                    <TextBox Margin="6,0,4,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="{Binding ValueHint}"
                                                                                             Visibility="{Binding NeedsValue, Converter={StaticResource Vis}}"/>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Left" Command="{Binding AddRuleCommand}" Padding="6,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                                                                            <TextBlock Text="{l:T 'Regel (UND)'}" Foreground="{DynamicResource Accent}"/>
                                                                        </StackPanel>
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Margin="0,8,0,0">
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding SyncNowCommand}" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{l:T 'Jetzt aus dem AD lesen'}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Standard}" HorizontalAlignment="Left" Command="{Binding AddBlockCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{l:T 'Block (ODER)'}"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </DockPanel>
                                            <TextBlock Text="{Binding RulesError}" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasRulesError, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MachinesInline}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Secondary}" MaxHeight="90"/>
                                            <Expander Header="{l:T 'LDAP-Filter anzeigen'}" Margin="0,6,0,0" FontSize="11">
                                                <TextBox Text="{Binding FilterPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                         Padding="6,4" Margin="0,4,0,0"/>
                                            </Expander>
                                        </StackPanel>
                                        </StackPanel>
                                        <!-- Rückmeldung (Synchronisieren, Export, OU) – auch im eingeklappten Zustand -->
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="11" Margin="36,6,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Status, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{l:T 'Die AD-Suche läuft mit deinem angemeldeten Konto. Name mit * als Platzhalter, eine OU (alle Computer darin) oder ein eigener LDAP-Filter in Klammern.'}"/>
                    <c:SettingsCard Icon="&#xE895;" Header="{l:T 'Dynamische Gruppen aktualisieren'}" Margin="0,12,0,0"
                                    Description="{l:T 'Beim Start von Power-Exec und danach in diesem Abstand im Hintergrund. Ohne Verbindung zum AD bleibt die zuletzt gefundene Liste.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding AdSyncIntervals}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding AdSyncIntervalHours}"/>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Inhalte › Schlagworte -->
                <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=tags}">
                <StackPanel DataContext="{Binding TagList}">
                    <TextBlock Text="{l:T 'Schlagworte'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Alle Schlagworte deiner Einträge. Im Panel filtert #schlagwort in der Suche. Umbenennen auf einen vorhandenen Namen führt beide zusammen.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Schlagwort suchen'}"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                    </Grid>
                    <TextBlock Text="{l:T 'Noch keine Schlagworte. Du vergibst sie im Eintragsdialog unter „Einordnen“.'}" Style="{StaticResource Caption}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4" MinHeight="0">
                                    <StackPanel>
                                        <DockPanel Margin="6,6,8,6">
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="{l:T 'Einträge anzeigen'}">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox Width="170" Margin="0,0,2,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding Color}" SelectedValuePath="Key" ToolTip="{l:T 'Farbe des Schlagworts'}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Margin="0,0,8,0" Command="{Binding CustomColorCommand}"
                                                        ToolTip="{l:T 'Eigene Farbe im Farbwähler aussuchen'}" AutomationProperties.Name="{l:T 'Eigene Farbe'}">
                                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="{l:T 'Umbenennen oder zusammenführen'}">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding DeleteCommand}" ToolTip="{l:T 'Von allen Einträgen entfernen'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Border Background="{Binding ChipColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Chip}" CornerRadius="11" Padding="10,2,10,3">
                                                    <TextBlock Text="{Binding Tag, StringFormat=#{0}}" FontSize="13"/>
                                                </Border>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                                Background="{DynamicResource Bg.CardAlt}" Padding="44,8,16,10">
                                            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel x:Name="TagEntryRow" Background="Transparent" Margin="0,1">
                                                            <!-- ✕ nimmt nur diesem Eintrag das Schlagwort -->
                                                            <ui:Button x:Name="TagEntryRemove" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Opacity="0.55"
                                                                    Command="{Binding RemoveCommand}" ToolTip="{l:T 'Schlagwort von diesem Eintrag entfernen'}" AutomationProperties.Name="{l:T 'Entfernen'}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                            </ui:Button>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="TagEntryRow" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TagEntryRemove" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Grid>

                <!-- Marktplatz: Einträge, Scripte und Designs aus Git-Ordnern -->
                <StackPanel Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqVis}, ConverterParameter=marketplace}" DataContext="{Binding MarketplacePage}">
                    <TextBlock Text="{l:T 'Marktplatz'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{l:T 'Fertige Einträge, Scripte und Designs aus Git-Ordnern – aus dem mitgelieferten Marktplatz und aus eigenen Quellen. Ordner aufklappen, einzelne Dateien oder ganze Ordner anhaken und herunterladen. Einträge und Scripte landen in den eigenen Einträgen in der Gruppe deiner Wahl; benötigte Variablen fragt Power-Exec einmal ab.'}"/>
                    <DockPanel Margin="0,16,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="{l:T 'Marktplatz neu laden'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Aktualisieren'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Marktplatz durchsuchen'}"
                                     AutomationProperties.Name="{l:T 'Marktplatz durchsuchen'}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <!-- Quellen: mitgelieferte und eigene Repositorys; fremde Quellen werden vor der ersten Installation bestätigt -->
                    <c:SettingsExpander Icon="&#xE774;" Header="{l:T 'Quellen'}" Margin="0,0,0,8"
                                        Description="{l:T 'Weitere Marktplätze per Repository-URL (GitHub oder GitLab) hinzufügen – z. B. den Katalog deines Teams.'}">
                        <c:SettingsExpander.HeaderContent>
                            <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding AddSourceCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T 'Quelle hinzufügen …'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </c:SettingsExpander.HeaderContent>
                        <ItemsControl ItemsSource="{Binding SourceList}" Focusable="False" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Style="{StaticResource SubSetting}">
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}"
                                                   ToolTip="{l:T 'Quelle entfernen'}" AutomationProperties.Name="{l:T 'Quelle entfernen'}"
                                                   Visibility="{Binding CanRemove, Converter={StaticResource Vis}}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"/>
                                        </ui:Button>
                                        <TextBlock DockPanel.Dock="Left" Width="22" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBar.Warning.Icon}"/>
                                                    <Setter Property="ToolTip" Value="Noch nicht als vertrauenswürdig bestätigt"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trusted}" Value="True">
                                                            <Setter Property="Text" Value="&#xE83F;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBar.Success.Icon}"/>
                                                            <Setter Property="ToolTip" Value="Vertrauenswürdig"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Url}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SourceSummary" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter TargetName="SourceSummary" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:SettingsExpander>
                    <!-- Tabs nach Art; Ordner aufklappbar, Häkchen auf Ordnern und Dateien -->
                    <DockPanel Margin="0,0,0,8">
                        <ComboBox DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" ItemsSource="{Binding SourceChoices}" SelectedValue="{Binding SourceFilter}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Quelle'}"
                                  Visibility="{Binding HasSeveralSources, Converter={StaticResource Vis}}"/>
                        <WrapPanel>
                            <RadioButton Style="{StaticResource TabHeader}" Content="{Binding EntryTabText}" GroupName="MarketTab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=Entry}"/>
                            <RadioButton Style="{StaticResource TabHeader}" Content="{Binding ScriptTabText}" GroupName="MarketTab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=Script}"/>
                            <RadioButton Style="{StaticResource TabHeader}" Content="{Binding DesignTabText}" GroupName="MarketTab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=Design}"/>
                            <RadioButton Style="{StaticResource TabHeader}" Content="{Binding InstalledTabText}" GroupName="MarketTab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=Installed}"/>
                        </WrapPanel>
                    </DockPanel>
                    <c:InfoBar Severity="Error" Message="{Binding Error}"/>
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding InstallSelectedText}" Command="{Binding InstallSelectedCommand}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{Binding UninstallSelectedText}" Command="{Binding UninstallSelectedCommand}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Auswahl aufheben'}" Command="{Binding ClearSelectionCommand}" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Border>
                    <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="4,8"
                                     Visibility="{Binding IsLoading, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{l:T 'Keine Treffer.'}" Style="{StaticResource Caption}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.Resources>
                                <!-- Ordner -->
                                <DataTemplate DataType="{x:Type vm:MarketplaceFolderRow}">
                                    <Border x:Name="FolderRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,3" Background="Transparent">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Width="28" IsThreeState="False" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Ordner auswählen'}"/>
                                            <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Command="{Binding InstallCommand}" ToolTip="{l:T 'Alle Dateien des Ordners herunterladen'}"
                                                       Padding="8,0" MinHeight="28" Height="28">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{l:T 'Ordner laden'}" FontSize="12"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding ToggleCommand}"
                                                       ToolTip="{l:T 'Auf-/zuklappen'}" AutomationProperties.Name="{l:T 'Auf- oder zuklappen'}">
                                                <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10"/>
                                            </ui:Button>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}"/>
                                                </TextBlock.InputBindings>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="  "/><Run Text="{Binding CountText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                        </DataTrigger>
                                        <Trigger SourceName="FolderRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FolderRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                                <!-- Datei -->
                                <DataTemplate DataType="{x:Type vm:MarketplaceItemRow}">
                                    <Border x:Name="ItemRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,4" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Auswählen'}"/>
                                            <Border Grid.Column="1" Width="{Binding Indent}"/>
                                            <DockPanel Grid.Column="2" Margin="32,0,10,0" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                                    <TextBlock Text="{Binding Needs}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Needs, Converter={StaticResource Vis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock x:Name="State" Grid.Column="3" Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding InstallCommand}" ToolTip="{Binding InstallText}"
                                                           AutomationProperties.Name="{Binding InstallText}" Visibility="{Binding CanInstall, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding UninstallCommand}" ToolTip="{l:T 'Deinstallieren'}"
                                                           AutomationProperties.Name="{l:T 'Deinstallieren'}" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="ItemRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter TargetName="ItemRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <!-- Variablen: {{$Name}} in Texten, Links, Befehlen und Code -->
                <StackPanel Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqVis}, ConverterParameter=variables}" DataContext="{Binding VariablesPage}">
                    <TextBlock Text="{l:T 'Variablen'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{l:T 'Variablen schreibst du als \{\{$Name\}\} in Texte, Links, Befehle, Ziele, PowerShell-Code und Script-Parameter – Power-Exec setzt den Wert beim Start ein, ohne zu fragen. Normale \{\{Platzhalter\}\} werden weiterhin vor dem Start abgefragt.'}"/>

                    <TextBlock Text="{l:T 'Eingebaut'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE787;" Header="{l:T 'Datum, Uhrzeit, Benutzer, Computer, Zwischenablage'}"
                                        Description="{l:T 'Immer verfügbar. Das Format von Datum und Uhrzeit stellst du hier ein.'}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Builtins}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Style="{StaticResource SubSetting}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Preview}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"
                                                       MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Token}" FontFamily="{StaticResource MonoFont}" Width="190" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ComboBox DockPanel.Dock="Right" Width="220" IsEditable="True" ItemsSource="{Binding DateFormats}"
                                          Text="{Binding DateFormat, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Datumsformat'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Format von \{\{$Date\}\}'}"/>
                                    <TextBlock Text="{l:T '.NET-Format, z. B. dd.MM.yyyy oder yyyy-MM-dd.'}" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ComboBox DockPanel.Dock="Right" Width="220" IsEditable="True" ItemsSource="{Binding TimeFormats}"
                                          Text="{Binding TimeFormat, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Uhrzeitformat'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Format von \{\{$Time\}\}'}"/>
                                    <TextBlock Text="{l:T '.NET-Format, z. B. HH:mm oder HH:mm:ss.'}" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <!-- Eigene Variablen als kompakte Tabelle (wie „Eigene Einträge“): Suche, Häkchen, Bearbeiten im Dialog -->
                    <TextBlock Text="{l:T 'Eigene Variablen'}" Style="{StaticResource SettingsSection}"/>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding AddCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Neu'}"/></StackPanel>
                        </ui:Button>
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Variablen suchen (Name, Wert, Beschreibung)'}"
                                     AutomationProperties.Name="{l:T 'Variablen suchen'}"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                    </DockPanel>
                    <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Löschen'}" Command="{Binding RemoveSelectedCommand}" Margin="0,2,6,2"/>
                            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Auswahl aufheben'}" Command="{Binding SelectAllCommand}" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Border>
                    <TextBlock Text="{l:T 'Noch keine eigenen Variablen – z. B. \{\{$CompanyName\}\} für den Firmennamen in Signaturen und Antworten.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding HasNoItems, Converter={StaticResource Vis}}"/>
                    <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasNoItems, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <Grid Margin="10,8,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="108"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Alle'}" FontSize="11" Padding="2,0" MinHeight="22" Height="22" Command="{Binding SelectAllCommand}"
                                           HorizontalAlignment="Left" ToolTip="{l:T 'Alle sichtbaren auswählen'}"/>
                                <TextBlock Grid.Column="1" Text="{l:T 'Variable'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{l:T 'Art'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{l:T 'Aktueller Wert'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding VisibleItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="VarRow" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="10,5" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="108"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Auswählen'}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Token}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding KindText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Preview}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding CopyTokenCommand}" ToolTip="{l:T '\{\{$Name\}\} kopieren'}">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding EditCommand}" ToolTip="{l:T 'Bearbeiten'}">
                                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Löschen'}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="VarRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="VarRow" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="VarRow" Property="Background" Value="{DynamicResource Bg.Selected}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Arbeitsbereiche -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=workspaces}">
                    <TextBlock Text="{l:T 'Arbeitsbereiche'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Arbeitsbereiche zeigen eine Auswahl deiner Gruppen – z. B. je Kunde oder Aufgabe. Gruppen, Ordner und eigene Einträge gibt es nur einmal; jeder Arbeitsbereich hat eigene Favoriten, „Zuletzt ausgeführt“, Startprofile und eingeklappte Gruppen. Wechseln geht auch im Panel-Kopf und im Tray-Menü.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding Workspaces}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0" MinHeight="0">
                                    <StackPanel>
                                        <DockPanel Margin="6,8,12,8">
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="{l:T 'Gruppen dieses Arbeitsbereichs auswählen'}" Margin="0,0,8,0">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Info.Bg}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{l:T 'Aktiv'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Gruppen …'}" Command="{Binding ToggleCommand}" Margin="0,0,8,0" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Wechseln'}" Command="{Binding ActivateCommand}" Margin="0,0,8,0"
                                                        ToolTip="{l:T 'Übernimmt die Einstellungen und wechselt den Arbeitsbereich'}" />
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Löschen'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBox Width="280" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                                Background="{DynamicResource Bg.CardAlt}" Padding="20,10,16,12">
                                            <StackPanel>
                                                <TextBlock Text="{l:T 'Diese Gruppen erscheinen im Panel (Favoriten, Zuletzt ausgeführt und Suche zeigen alles):'}" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <TextBlock Text="{l:T 'Noch keine Gruppen angelegt.'}" Style="{StaticResource Caption}"
                                                           Visibility="{Binding Groups.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Margin="{Binding IndentLeft, Converter={StaticResource LeftMargin}}" Padding="6,0,0,0" MinHeight="30">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Grid Width="18" Margin="0,0,8,0">
                                                                        <c:IconPresenter Icon="{Binding Icon}" Size="15" Foreground="{DynamicResource Text.Primary}"
                                                                                         Visibility="{Binding Icon, Converter={StaticResource Vis}}"/>
                                                                        <TextBlock x:Name="WsGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                                                                   Visibility="{Binding Icon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                                                               VerticalAlignment="Center" ToolTip="{l:T 'Feste Gruppe'}" Visibility="{Binding IsFixed, Converter={StaticResource Vis}}"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                    <Setter TargetName="WsGlyph" Property="Text" Value="{Binding FixedGlyph}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:SettingsCard Icon="&#xE710;" Header="{l:T 'Neuer Arbeitsbereich'}" Description="{l:T '„Aktuellen kopieren“ übernimmt Favoriten, Startprofile und Gruppenauswahl.'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="220" Text="{Binding NewWorkspace, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Name, z. B. Kunde A'}" VerticalAlignment="Center"/>
                                <CheckBox Content="{l:T 'Aktuellen kopieren'}" IsChecked="{Binding CopyWorkspace}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="{l:T 'Favoriten, Startprofile und Gruppenauswahl übernehmen'}"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Anlegen'}" Command="{Binding AddWorkspaceCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Allgemein -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=general}">
                    <TextBlock Text="{l:T 'Allgemein'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Team-Kataloge'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE716;" Header="{l:T 'Gemeinsame Einträge vom Team'}" IsExpanded="True"
                                        Description="{l:T 'Eine exportierte Gruppe (Rechtsklick › Exportieren) auf einer Freigabe ablegen und hier abonnieren. Power-Exec prüft beim Start und alle 30 Minuten auf Änderungen. Katalogeinträge sind schreibgeschützt; Favoriten und eigene Einträge in der Gruppe bleiben lokal.'}">
                        <c:SettingsExpander.HeaderContent>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Jetzt prüfen'}" Command="{Binding CheckCatalogsCommand}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"
                                            Visibility="{Binding HasCatalogs, Converter={StaticResource Vis}}" />
                                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Abonnieren …'}" Command="{Binding SubscribeCatalogCommand}" />
                                </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Noch kein Team-Katalog abonniert.'}" Style="{StaticResource Caption}" Margin="0,10,0,4"
                                       Visibility="{Binding HasCatalogs, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            <c:InfoBar Severity="Error" Message="{Binding CatalogError}" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding CatalogRows}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource Bg.CardAlt}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Übernehmen'}" Command="{Binding ApplyCommand}" Foreground="{DynamicResource Accent}"
                                                            Visibility="{Binding HasPending, Converter={StaticResource Vis}}" />
                                                    <CheckBox Content="{l:T 'automatisch übernehmen'}" IsChecked="{Binding AutoApply}" VerticalAlignment="Center" Margin="8,0" FontSize="12"/>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Abbestellen (Einträge werden entfernt)'}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                                    </ui:Button>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CatStatus" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                <Setter TargetName="CatStatus" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </c:SettingsExpander>
                    <TextBlock Text="{l:T 'Version und Updates'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE895;" Header="{Binding CurrentVersion, StringFormat=Power-Exec {0}}" Description="{Binding UpdateStatus}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Einführung'}" Command="{Binding ShowWelcomeCommand}" Foreground="{DynamicResource Accent}"
                                        ToolTip="{l:T 'Einführungs-Assistent erneut starten (Ordner, Rand, Tastenkürzel)'}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Versionshinweise'}" Command="{Binding CurrentReleaseNotesCommand}" Foreground="{DynamicResource Accent}"
                                        ToolTip="{l:T 'Was ist neu in dieser Version? (GitHub)'}" Margin="0,0,8,0" />
                                <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Nach Updates suchen'}" Command="{Binding CheckUpdatesCommand}" />
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CheckUpdatesOnStart}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T 'Beim Start nach Updates suchen'}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IncludePrereleases}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{l:T 'Vorabversionen einbeziehen'}"/>
                                    <TextBlock Text="{l:T 'Neue Funktionen früher – können noch Fehler enthalten.'}" Style="{StaticResource Caption}" FontSize="12"/></StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{Binding RepoText}" Command="{Binding OpenRepoCommand}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T 'Quelle (GitHub Releases, SHA-256-geprüft)'}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <TextBlock Text="{l:T 'Start'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7E8;" Header="{l:T 'Mit Windows starten'}" Description="{l:T 'Power-Exec startet nach der Anmeldung im Hintergrund.'}">
                        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
                    </c:SettingsCard>

                    <TextBlock Text="{l:T 'Sichern und Wiederherstellen'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE8F1;" Header="{l:T 'Einstellungen sichern'}"
                                        Description="{l:T 'Gruppen, smarte Gruppen, Startprofile, Favoriten, Arbeitsbereiche, eigene Einträge und Rechnerliste als Datei – zum Sichern oder für einen anderen PC. Kennwörter sind nie enthalten.'}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Exportieren …'}" Command="{Binding ExportCommand}" />
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Importieren …'}" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <DockPanel Style="{StaticResource SubSetting}">
                            <TextBlock Text="{l:T 'Einstellungsdatei'}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding SettingsFile}" Style="{StaticResource Mono}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </c:SettingsExpander>
                </StackPanel>

                <!-- Gruppen (inkl. smarter Gruppen = Ordner) -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=groups}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding NewGroupCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="{l:T 'Neue Gruppe'}"/></StackPanel>
                        </ui:Button>
                        <TextBlock Text="{l:T 'Gruppen'}" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{l:T 'Gruppen ordnen das Panel. Ziehe eine Gruppe an eine andere Stelle oder auf die Mitte einer anderen Gruppe, um sie zur Untergruppe zu machen; Rechtsklick legt eine Untergruppe an. Einträge ziehst du im Panel per Drag &amp; Drop in jede Gruppe. Welche Gruppen ein Arbeitsbereich zeigt, legst du unter Arbeitsbereiche fest.'}"/>

                    <TextBlock Text="{l:T 'Deine Gruppen'}" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="4,0,0,8" TextWrapping="Wrap"
                               Text="{l:T 'Gruppen mit Schloss (Zuletzt ausgeführt, Favoriten, Eigene Einträge) sind fest: verschiebbar, aber nicht löschbar. Ob sie im Panel erscheinen, legst du je Arbeitsbereich fest.'}"/>
                    <TextBlock Text="{l:T 'Noch keine Gruppen – „Neue Gruppe“ oben rechts oder im Panel per Rechtsklick.'}" Style="{StaticResource Caption}" Margin="4,0,0,8"
                               Visibility="{Binding Categories.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <ItemsControl ItemsSource="{Binding CategoryRoots}" Focusable="False">
                        <ItemsControl.ItemTemplateSelector>
                            <v:CategoryTemplateSelector Group="{StaticResource CategoryCardTemplate}" Fixed="{StaticResource FixedCardTemplate}"/>
                        </ItemsControl.ItemTemplateSelector>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap"
                               Text="{l:T 'Löschen entfernt die Gruppe samt Untergruppen (nach Rückfrage). Hineingezogene Einträge erscheinen wieder in ihrer smarten Gruppe bzw. unter „Eigene Einträge“; Dateien bleiben unverändert.'}"/>

                    <TextBlock Text="{l:T 'Für alle smarten Gruppen (Ordner)'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE8A5;" Header="{l:T 'Standard-Dateiendungen'}" Description="{l:T 'Gilt für smarte Gruppen ohne eigene Angabe. Mit Semikolon getrennt, z. B. .ps1; .cmd; .exe'}">
                            <StackPanel Width="300">
                                <TextBox Text="{Binding DefaultExtensions, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T '.ps1; .cmd; .exe'}"/>
                                <TextBlock Text="{Binding DefaultExtensionsError}" FontSize="11" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DefaultExtensionsError, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D8;" Header="{l:T 'Globale Ausschlüsse'}" Description="{l:T 'Gelten für alle Ordner, mit Semikolon getrennt. „Ausblenden“ im Panel legt Ausschlüsse beim jeweiligen Ordner an.'}">
                            <TextBox Width="300" Text="{Binding GlobalExcludes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'z. B. *.bak.ps1; *\\Old\\*'}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72C;" Header="{l:T 'Bei Änderungen automatisch neu einlesen'}" Description="{l:T 'Neue, umbenannte oder gelöschte Dateien erscheinen sofort.'}">
                            <ui:ToggleSwitch IsChecked="{Binding AutoRescan}" AutomationProperties.Name="{l:T 'Bei Änderungen automatisch neu einlesen'}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Zeitlimit für nicht erreichbare Ordner'}" Description="{l:T 'Antwortet ein Ordner (z. B. eine Freigabe) nicht rechtzeitig, zeigt das Panel den zuletzt eingelesenen Stand.'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="2" Maximum="60" TickFrequency="1" Value="{Binding ScanTimeoutSeconds}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ScanTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Panel › Verhalten -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=behavior}">
                    <TextBlock Text="{l:T 'Verhalten'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Wann das Panel aus- und einfährt und wie du es öffnest.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Ausfahren und Einklappen'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE823;" Header="{l:T 'Verweilzeit bis zum Ausfahren'}" Description="{l:T 'Verhindert ungewolltes Öffnen beim Vorbeifahren.'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0" Maximum="1000" TickFrequency="50" Value="{Binding HoverDelayMs}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HoverDelayMs, StringFormat={}{0} ms}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE81C;" Header="{l:T 'Einklappen nach Verlassen'}" Description="{l:T 'Zeit, bis das Panel wieder einfährt.'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="0" Maximum="2000" TickFrequency="100" Value="{Binding CollapseDelayMs}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CollapseDelayMs, StringFormat={}{0} ms}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE740;" Header="{l:T 'Bei Vollbild-Programmen ausblenden'}" Description="{l:T 'Die Hover-Zone ruht, solange ein Video, eine Präsentation, ein Spiel oder eine Remotedesktop-Sitzung im Vollbild läuft. Das Tastenkürzel funktioniert weiter.'}">
                        <ui:ToggleSwitch IsChecked="{Binding HideHotZoneInFullscreen}" />
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Gruppen ziehen'}" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Text="{l:T 'Beim Verschieben einer Gruppe – im Panel und unter Gruppen – öffnet sich an der Zielstelle eine Lücke mit einem Platzhalter. Im Panel wählst du zwischen zwei Gruppen die Ebene, indem du seitlich ziehst: nach rechts tiefer, nach links höher.'}"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,0,8"/>
                    <c:SettingsCard Icon="&#xE7C2;" Header="{l:T 'Ziehbild am Mauszeiger'}" Description="{l:T 'Ein kleines Schild mit Name, Farbe und Zahl der Untergruppen folgt der Maus.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragGhost}" AutomationProperties.Name="{l:T 'Ziehbild am Mauszeiger'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8AB;" Header="{l:T 'Lücke weich öffnen'}" Description="{l:T 'Gruppen gleiten zur Seite, wenn sich die Lücke öffnet. Folgt außerdem der Einstellung „Animation“ unter Darstellung.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragAnimate}" AutomationProperties.Name="{l:T 'Lücke weich öffnen'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8C4;" Header="{l:T 'Inhalte beim Ziehen zuklappen'}" Description="{l:T 'Während des Ziehens zeigt das Panel nur Gruppenköpfe und die Gruppenliste nur kompakte Karten – kürzere Wege bei vielen Einträgen.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragCollapse}" AutomationProperties.Name="{l:T 'Inhalte beim Ziehen zuklappen'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE946;" Header="{l:T 'Begründung an ungültigen Stellen'}" Description="{l:T 'Statt nur eines Verbotszeichens steht am Mauszeiger, warum die Gruppe hier nicht abgelegt werden kann.'}">
                        <ui:ToggleSwitch IsChecked="{Binding GroupDragExplain}" AutomationProperties.Name="{l:T 'Begründung an ungültigen Stellen'}" />
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Öffnen'}" Style="{StaticResource SettingsSection}"/>
                    <StackPanel DataContext="{Binding Panel}">
                        <c:SettingsCard Icon="&#xE765;" Header="{l:T 'Tastenkürzel'}" Description="{l:T 'Öffnet das Panel und setzt den Cursor ins Suchfeld. Zum Ändern ins Feld klicken und die Kombination drücken.'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="{l:T 'Klicken und die gewünschte Tastenkombination drücken'}"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Entfernen'}" Margin="8,0,0,0" Command="{Binding ClearHotkeyCommand}" />
                            </StackPanel>
                        </c:SettingsCard>
                        <c:SettingsCard Icon="&#xE721;" Header="{l:T 'Tastenkürzel öffnet die Suche in der Bildschirmmitte'}"
                                        Description="{l:T 'Spotlight-Modus: ein schwebendes Suchfenster mit den besten Treffern – ohne Mausweg zum Rand. Tab wechselt ins volle Panel. Die Hover-Zone öffnet weiter das Panel.'}">
                            <ui:ToggleSwitch IsChecked="{Binding HotkeyOpensSpotlight}" AutomationProperties.Name="{l:T 'Spotlight-Modus'}" />
                        </c:SettingsCard>
                        <c:InfoBar Severity="Error" Message="{Binding DataContext.HotkeyError, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel › Darstellung -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=look}">
                    <TextBlock Text="{l:T 'Darstellung'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Alles rund um das Aussehen: Design, Einträge, Panel und Hover-Zone.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>

                    <TextBlock Text="{l:T 'Allgemein'}" Style="{StaticResource SettingsSection}"/>
                    <!-- Designvorlagen: ein Klick setzt Design, Panelfarbe, Hintergrund, Deckkraft, Milchglas und Akzent; eingeklappt nur die aktuelle -->
                    <c:SettingsExpander Icon="&#xE771;" Header="{l:T 'Designvorlagen'}" Description="{Binding CurrentPresetText}"
                                        IsExpanded="{Binding PresetsExpanded, Mode=TwoWay}">
                        <StackPanel Margin="0,10,0,4">
                            <TextBlock Text="{l:T 'Setzt Design, Panelfarbe, Hintergrund, Deckkraft, Milchglas und Akzentfarbe auf einmal – danach einzeln anpassbar.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding DesignPresets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="150" Margin="0,0,8,8">
                                        <Button Command="{Binding ApplyCommand}" Padding="0" Cursor="Hand" ToolTip="{Binding Description}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Bg.CardAlt}" Padding="8">
                                                        <StackPanel>
                                                            <Border Height="44" CornerRadius="4" Background="{Binding SwatchColor, Converter={StaticResource ArgbBrush}}" Padding="8,6">
                                                                <StackPanel>
                                                                    <Border Height="5" Width="54" HorizontalAlignment="Left" CornerRadius="2"
                                                                            Background="{Binding AccentSwatch, Converter={StaticResource ArgbBrush}, ConverterParameter=Accent}"/>
                                                                    <Border Height="4" Width="80" HorizontalAlignment="Left" CornerRadius="2" Margin="0,6,0,0" Background="{Binding InkColor, Converter={StaticResource ArgbBrush}}" Opacity="0.5"/>
                                                                    <Border Height="4" Width="64" HorizontalAlignment="Left" CornerRadius="2" Margin="0,4,0,0" Background="{Binding InkColor, Converter={StaticResource ArgbBrush}}" Opacity="0.3"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding BackdropText}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Height="30" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Eigene Designs: löschen -->
                                        <ui:Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" MinHeight="24" Padding="0" Margin="0,4,4,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding DeleteCommand}"
                                                   ToolTip="{l:T 'Eigenes Design löschen'}" AutomationProperties.Name="{l:T 'Eigenes Design löschen'}"
                                                   Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                                        </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Style="{StaticResource Btn.Standard}" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding SaveDesignCommand}"
                                       ToolTip="{l:T 'Farbe, Hintergrund, Deckkraft, Milchglas und Akzent des Panels als eigene Vorlage speichern'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T 'Aktuelles Design speichern …'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </c:SettingsExpander>
                    <c:SettingsCard Icon="&#xE790;" Header="{l:T 'Design'}" Description="{l:T 'Hell oder dunkel für alle Fenster. Ist in Windows ein Kontrastdesign aktiv, verwendet Power-Exec automatisch dessen Farben.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Themes}" SelectedValue="{Binding Theme}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D3;" Header="{l:T 'Schrift- und Elementgröße'}" Description="{l:T 'Vergrößert Schrift und Bedienelemente im Panel und in allen Fenstern (zusätzlich zur Windows-Skalierung).'}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="180" Minimum="80" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding UiScalePercent}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Schrift- und Elementgröße'}"/>
                                <TextBlock Text="{Binding UiScalePercent, StringFormat={}{0} %}" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                    </c:SettingsCard>
                    <Border Margin="0,0,0,4" Padding="12,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1"
                            Visibility="{Binding IsHighContrast, Converter={StaticResource Vis}}">
                        <TextBlock Text="{l:T 'Kontrastdesign von Windows ist aktiv: Panelfarbe, Deckkraft, Milchglas und Akzentfarbe werden ignoriert, damit alles gut lesbar bleibt.'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Info.Text}"/>
                    </Border>
                    <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Animation'}" Description="{l:T 'Wie das Panel aus- und einfährt.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Animations}" SelectedValue="{Binding Animation}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8B9;" Header="{l:T 'Symbole anzeigen'}" Description="{l:T 'Programmsymbole, Ordnersymbol, Remotedesktop-Symbol und Favicons von Webseiten (einmal geladen und zwischengespeichert). Scripte behalten ihr Kürzel.'}">
                        <ui:ToggleSwitch IsChecked="{Binding ShowProgramIcons}" />
                    </c:SettingsCard>
                    <StackPanel DataContext="{Binding Panel}">
                    <c:SettingsCard Icon="&#xE8FD;" Header="{l:T 'Ansicht'}" Description="{l:T 'Einträge als Liste oder als Raster (Kacheln). Auch über den Panel-Kopf umschaltbar.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Layouts}" SelectedValue="{Binding Layout}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8E9;" Header="{l:T 'Elementgröße'}" Description="{l:T 'Größe der Einträge in Liste und Raster. Auch über den Panel-Kopf umschaltbar.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ItemSizes}" SelectedValue="{Binding ItemSize}"/>
                    </c:SettingsCard>

                    <TextBlock Text="{l:T 'Panel'}" Style="{StaticResource SettingsSection}"/>
                    <!-- Panelfarbe wie die Akzentfarbe in den Windows-Einstellungen: Auswahl und Chevron rechts, darunter die Farbkacheln -->
                    <c:SettingsExpander Icon="&#xE790;" Header="{l:T 'Panelfarbe'}" Description="{l:T 'Hintergrund des Panels. Bei hellen Farben wird die Schrift automatisch dunkel.'}"
                                        IsExpanded="{Binding ColorsExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="32" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Background="{Binding PreviewColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Panel}"
                                        BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" ToolTip="{Binding PreviewText}"/>
                                <ComboBox Width="170" ItemsSource="{Binding ColorModeList}" SelectedValue="{Binding ColorMode}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Panelfarbe'}"/>
                            </StackPanel>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Akzentfarbe von Windows übernehmen'}"
                                                 IsChecked="{Binding DataContext.UseWindowsAccent, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Akzentfarbe von Windows übernehmen'}"/>
                                    <TextBlock Text="{l:T 'An: Hover-Zone, Auswahl und Knöpfe in der Akzentfarbe von Windows (Personalisierung › Farben). Aus: in der gewählten Panelfarbe – passend aufgehellt bzw. abgedunkelt.'}"
                                               Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}"
                                       Visibility="{Binding DataContext.UseWindowsAccent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"
                                            Background="{Binding AccentPreview, Converter={StaticResource ArgbBrush}, ConverterParameter=Accent}"/>
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Farbe wählen'}" Command="{Binding PickAccentCommand}"/>
                                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'Aus Panelfarbe'}" Command="{Binding ResetAccentCommand}" Margin="6,0,0,0"
                                               Visibility="{Binding HasAccentColor, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Eigene Akzentfarbe'}"/>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12">
                                        <Run Text="{l:T 'Aktuell:'}"/> <Run Text="{Binding AccentText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{l:T 'Das Panel nimmt die Fläche des hellen bzw. dunklen Designs. Für eine eigene Farbe oben „Manuell“ wählen.'}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,10"
                                       Visibility="{Binding ShowManualColors, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            <StackPanel Margin="0,8,0,4" Visibility="{Binding ShowManualColors, Converter={StaticResource Vis}}">
                                <StackPanel Visibility="{Binding HasRecentColors, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{l:T 'Zuletzt verwendete Farben'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding RecentColors}" ItemTemplate="{StaticResource ColorTile}" Focusable="False" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{l:T 'Panelfarben'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding PanelColorChoices}" ItemTemplate="{StaticResource ColorTile}" Focusable="False" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="500" HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="{l:T 'Windows-Farben'}" Style="{StaticResource RowTitle}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding WindowsColors}" ItemTemplate="{StaticResource ColorTile}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="500" HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowManualColors, Converter={StaticResource Vis}}">
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Farben anzeigen'}" Command="{Binding PickColorCommand}"
                                           VerticalAlignment="Center" ToolTip="{l:T 'Eigene Farbe im Farbwähler aussuchen'}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Benutzerdefinierte Farben'}"/>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="12">
                                        <Run Text="{l:T 'Aktuell:'}"/> <Run Text="{Binding CustomColor, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    <!-- Hintergrund: Auswahl und Chevron rechts, darunter die Regler der gewählten Variante -->
                    <c:SettingsExpander Icon="&#xE81E;" Header="{l:T 'Hintergrund'}" Description="{Binding BackdropDescription}"
                                        IsExpanded="{Binding BackdropExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <ComboBox Width="230" ItemsSource="{Binding Backdrops}" SelectedValue="{Binding Backdrop}"
                                      DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Hintergrund'}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowGlass, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GlassBlur}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding GlassBlur}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Blur-Stärke'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Blur-Stärke'}"/>
                                    <TextBlock Text="{l:T 'Wie stark der Desktop hinter dem Panel weichgezeichnet wird.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowGlass, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GlassSaturation, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding GlassSaturation}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Sättigung'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Sättigung'}"/>
                                    <TextBlock Text="{l:T 'Farbkraft des Desktops hinter dem Glas (100 % = unverändert).'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowFrost, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Frost, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Frost}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Milchglas'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Milchglas'}"/>
                                    <TextBlock Text="{Binding FrostDescription}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding ShowOpacity, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PanelOpacity, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding PanelOpacity}" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Deckkraft'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Deckkraft'}"/>
                                    <TextBlock Text="{Binding OpacityDescription}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    <c:SettingsExpander Icon="&#xE8A0;" Header="{l:T 'Mini-Dock am Rand'}"
                                        Description="{l:T 'Schmale Leiste mit den Favoriten am gewählten Rand – ein Klick startet, „⋯“ öffnet das volle Panel. Ersetzt die Hover-Zone.'}"
                                        IsExpanded="{Binding DockExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <ui:ToggleSwitch IsChecked="{Binding ShowDock}" AutomationProperties.Name="{l:T 'Mini-Dock am Rand'}" VerticalAlignment="Center"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" IsEnabled="{Binding ShowDock}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DockCount}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DockCount}"
                                        VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Favoriten im Mini-Dock'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Wie viele Favoriten anzeigen'}"/>
                                    <TextBlock Text="{l:T 'In der Reihenfolge der Gruppe „Favoriten“. Das Dock ruht, solange das Panel offen ist oder ein Vollbild-Programm läuft.'}"
                                               Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    <c:SettingsCard Icon="&#xE8A1;" Header="{l:T 'Gruppen-Stil'}"
                                    Description="{l:T 'Akzentstreifen: ruhige, halbtransparente Karten – die Gruppenfarbe nur als Streifen, im Symbol und im Titel. Farbige Karten: die ganze Gruppe ist in ihrer Farbe getönt.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding GroupStyles}" SelectedValue="{Binding GroupStyle}" AutomationProperties.Name="{l:T 'Gruppen-Stil'}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8FD;" Header="{l:T 'Sprungleiste'}" Description="{l:T 'Ab zwei Gruppen ein Punkt je Gruppe rechts im Panel – Klick springt hin, erneuter Klick klappt zu.'}">
                        <ui:ToggleSwitch IsChecked="{Binding ShowJumpRail}" AutomationProperties.Name="{l:T 'Sprungleiste'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7C4;" Header="{l:T 'Scrollbalken'}" Description="{l:T 'Ausgeblendet lässt sich die Liste weiter mit dem Mausrad, den Pfeiltasten oder der Sprungleiste bewegen.'}">
                        <ui:ToggleSwitch IsChecked="{Binding ShowScrollBar}" AutomationProperties.Name="{l:T 'Scrollbalken'}" />
                    </c:SettingsCard>

                    <c:SettingsExpander Icon="&#xE9A6;" Header="{l:T 'Panel-Abmessungen'}" Description="{l:T 'Breite, Höhe und Lage – auch direkt am Panel per Ziehen am Innenrand änderbar.'}"
                                        IsExpanded="{Binding SizeExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <TextBlock Text="{Binding SizeSummary}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PanelWidth, StringFormat={}{0} px}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="280" Maximum="900" TickFrequency="20" Value="{Binding PanelWidth}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Breite'}"/>
                                <TextBlock Text="{l:T 'Breite'}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PanelHeightPercent, StringFormat={}{0} %}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="30" Maximum="100" TickFrequency="5" Value="{Binding PanelHeightPercent}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Höhe'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Höhe'}"/>
                                    <TextBlock Text="{l:T 'Anteil der Bildschirmhöhe (ohne Taskleiste). 100 % = ganze Höhe.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding IsPartialHeight, Converter={StaticResource Vis}}">
                                <ComboBox DockPanel.Dock="Right" Width="236" ItemsSource="{Binding PanelAlignments}" SelectedValue="{Binding PanelAlignment}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Lage'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Lage am Rand'}"/>
                                    <TextBlock Text="{l:T 'Wo das kleinere Panel entlang der Kante erscheint.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>

                    <TextBlock Text="{l:T 'Hover-Zone'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7F4;" Header="{l:T 'Bildschirmrand'}" Description="{l:T 'An welchem Rand die Hover-Zone liegt und das Panel ausfährt.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EdgeList}" SelectedValue="{Binding Edge}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7F4;" Header="{l:T 'Monitor'}" Description="{l:T 'Bei „Alle Monitore“ öffnet das Tastenkürzel das Panel auf dem Monitor mit dem Mauszeiger.'}">
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Monitors}" SelectedValue="{Binding MonitorChoice}"/>
                    </c:SettingsCard>
                    <c:SettingsExpander Icon="&#xE8A0;" Header="{l:T 'Hover-Zone'}" Description="{l:T 'Auslösebereich am Rand – in der Akzent- bzw. Panelfarbe.'}"
                                        IsExpanded="{Binding HotZoneExpanded, Mode=TwoWay}">
                        <c:SettingsExpander.HeaderContent>
                            <ComboBox Width="200" ItemsSource="{Binding HotZones}" SelectedValue="{Binding HotZone}"
                                      DisplayMemberPath="Value" SelectedValuePath="Key" VerticalAlignment="Center" AutomationProperties.Name="{l:T 'Lage der Hover-Zone'}"/>
                        </c:SettingsExpander.HeaderContent>
                        <StackPanel>
                            <DockPanel Style="{StaticResource SubSetting}" Visibility="{Binding IsHotZoneMiddle, Converter={StaticResource Vis}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HotZoneLength, StringFormat={}{0} px}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="50" Maximum="1200" TickFrequency="25" Value="{Binding HotZoneLength}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Länge der Hover-Zone'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Länge'}"/>
                                    <TextBlock Text="{l:T 'Ausdehnung entlang der Kante, mittig ausgerichtet.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SubSetting}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HotZoneThickness, StringFormat={}{0} px}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Right" Width="180" Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding HotZoneThickness}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{l:T 'Breite der Hover-Zone'}"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:T 'Breite / Empfindlichkeit'}"/>
                                    <TextBlock Text="{l:T 'Wie weit der Auslösebereich vom Rand ins Bild ragt. Breiter = leichter zu treffen, aber auffälliger.'}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </c:SettingsExpander>
                    </StackPanel>
                </StackPanel>

                <!-- PowerShell -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=exec}">
                    <TextBlock Text="{l:T 'PowerShell'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Standardwerte für den Start von Scripten. Startprofile eines Eintrags (⚙) können sie überschreiben.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Start'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE70F;" Header="{l:T 'Parameter direkt im Panel'}"
                                    Description="{l:T 'Beim Aufklappen eines Scripts erscheint ein kleines Formular mit seinen Parametern. „Speichern als …“ legt ein Parameter-Set als Startprofil an.'}">
                        <ui:ToggleSwitch IsChecked="{Binding InlineParameters}" AutomationProperties.Name="{l:T 'Parameter direkt im Panel'}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE756;" Header="{l:T 'Standard-PowerShell (lokal)'}" Description="{l:T 'Fehlt PowerShell 7, wird automatisch Windows PowerShell 5.1 verwendet.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EnginesList}" SelectedValue="{Binding DefaultEngine}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72E;" Header="{l:T 'Execution Policy'}" Description="{l:T 'Gilt nur für die von Power-Exec gestarteten Scripte.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Policies}" SelectedValue="{Binding ExecutionPolicy}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE77B;" Header="{l:T 'Ohne Profil starten (-NoProfile)'}" Description="{l:T 'Schnellerer Start, keine Seiteneffekte aus dem PowerShell-Profil.'}">
                        <ui:ToggleSwitch IsChecked="{Binding NoProfile}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE7C4;" Header="{l:T 'Konsole nach Ende offen lassen (-NoExit)'}" Description="{l:T 'Damit die Ausgabe sichtbar bleibt.'}">
                        <ui:ToggleSwitch IsChecked="{Binding NoExit}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE77B;" Header="{l:T 'Beim Start nach dem Profil fragen'}"
                                    Description="{l:T 'Hat ein Eintrag mehrere Startprofile, fragt Power-Exec vor dem Start, welches – im selben Fenster wie die Werte für \{\{Platzhalter\}\}. Je Eintrag abweichend einstellbar (Eintrag bearbeiten).'}">
                        <ui:ToggleSwitch IsChecked="{Binding AskProfile}" AutomationProperties.Name="{l:T 'Beim Start nach dem Profil fragen'}" />
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Editor'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE70F;" Header="{l:T 'Editor für „Im Editor öffnen“'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Editors}" SelectedValue="{Binding Editor}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8E5;" Header="{l:T 'Eigener Editor'}" Description="{l:T 'Pfad zur EXE'}" Visibility="{Binding IsCustomEditor, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="320" Text="{Binding EditorPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="{l:T 'C:\\Program Files\\Notepad++\\notepad++.exe'}"/>
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Durchsuchen …'}" Command="{Binding BrowseEditorCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Gut zu wissen'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsExpander Icon="&#xE946;" Header="{l:T 'So startet Power-Exec Scripte'}" Description="{l:T 'Netzlaufwerke, Begleitdateien, Delegation'}">
                        <StackPanel Margin="0,6">
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="{l:T 'Netzwerkpfade: '}"/><Run Text="{l:T 'Verbundene Laufwerke werden vor dem Start in UNC-Pfade umgewandelt – erhöhte Prozesse und andere Konten sehen keine verbundenen Laufwerke.'}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="{l:T 'Begleitdateien bei Remote: '}"/><Run Text="{l:T '„Scriptordner mitsenden“ kopiert Module und Dateien über die Remote-Sitzung und löscht sie danach. Dauerhaft mit „PowerExec: CopyFolder“ unter .NOTES.'}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4"><Run FontWeight="SemiBold" Text="{l:T 'Delegation (CredSSP): '}"/><Run Text="{l:T 'wird bewusst nicht unterstützt, weil Anmeldedaten an den Zielrechner weitergegeben würden.'}"/></TextBlock>
                        </StackPanel>
                    </c:SettingsExpander>
                </StackPanel>

                <!-- Remote -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=remote}">
                    <TextBlock Text="{l:T 'Remote'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Ausführung auf anderen Rechnern über WinRM, einzeln oder parallel auf vielen.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Verbindung'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE968;" Header="{l:T 'PowerShell bei Remote'}" Description="{l:T 'Auf den meisten Servern gibt es nur 5.1. PowerShell 7 nur, wenn der Endpunkt PowerShell.7 existiert.'}">
                        <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RemoteEngines}" SelectedValue="{Binding RemoteEngine}"/>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE72E;" Header="{l:T 'Remote über HTTPS (Port 5986)'}" Description="{l:T 'Für Rechner außerhalb der Domäne bzw. wenn WinRM nur per HTTPS erreichbar ist. Auf dem Ziel muss ein HTTPS-Listener eingerichtet sein.'}">
                        <ui:ToggleSwitch IsChecked="{Binding RemoteUseSsl}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Verbindungs-Timeout pro Rechner'}" Description="{l:T 'Danach gilt der Rechner als nicht erreichbar.'}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="10" Maximum="300" TickFrequency="10" Value="{Binding RemoteTimeoutSeconds}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RemoteTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE902;" Header="{l:T 'Gleichzeitige Verbindungen'}" Description="{l:T 'Für die Massenausführung.'}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="1" Maximum="64" TickFrequency="1" Value="{Binding ThrottleLimit}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ThrottleLimit}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Ergebnisse'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xEA8F;" Header="{l:T 'Benachrichtigen, wenn ein Remote-Lauf fertig ist'}" Description="{l:T 'Windows-Benachrichtigung mit Zusammenfassung; ein Klick öffnet die Ergebnisliste.'}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnFinish}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8B7;" Header="{l:T 'Log-Ordner'}" Description="{Binding LogFolderDisplay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Ändern …'}" Command="{Binding BrowseLogFolderCommand}" />
                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Öffnen'}" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </c:SettingsCard>
                    <TextBlock Text="{l:T 'Rechner und Anmeldung'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE7F4;" Header="{l:T 'Zuletzt verwendete Rechner'}" Description="{Binding MachinesText}">
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Liste leeren'}" Command="{Binding ClearMachinesCommand}" />
                    </c:SettingsCard>
                    <c:SettingsCard Icon="&#xE8D7;" Header="{l:T 'Anmeldedaten'}" Description="{l:T 'Werden bei jedem Start abgefragt und nie gespeichert.'}">
                        <TextBlock Text="{l:T 'Immer abfragen'}" Foreground="{DynamicResource Text.Secondary}"/>
                    </c:SettingsCard>
                </StackPanel>

                <!-- Hilfe › Beispiele -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=samples}">
                    <TextBlock Text="{l:T 'Beispiele'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Fertige Beispielscripte zum Ausprobieren und als Vorlage für eigene Scripte.'}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{l:T 'Beispielscripte'}" Style="{StaticResource SettingsSection}"/>
                    <c:SettingsCard Icon="&#xE943;" Header="{l:T 'Beispielscripte anlegen'}"
                                    Description="{l:T 'Systeminfo, Netzwerktest, Speicherplatz, große Dateien, installierte Programme, Fehlerprotokoll, Temp aufräumen und Kennwörter – unter Dokumente › Power-Exec › Scripte (vorhandene Dateien bleiben unverändert), im Panel als Gruppe „Beispiele“.'}">
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Anlegen'}" Command="{Binding AddSamplesCommand}"/>
                    </c:SettingsCard>
                    <c:InfoBar Message="{Binding SamplesStatus}" Severity="{Binding SamplesSeverity}"/>
                </StackPanel>

                <!-- Diagnose & Daten -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=diag}">
                    <TextBlock Text="{l:T 'Diagnose'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:T 'Protokoll für die Fehlersuche und Einlesezeiten der Ordner.'}" Style="{StaticResource Caption}"/>

                    <TextBlock Text="{l:T 'Einlesen der Ordner'}" Style="{StaticResource SettingsSection}"/>

                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Ordner'}" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding FolderTimes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock x:Name="Info" DockPanel.Dock="Right" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                <Setter TargetName="Info" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SystemInfo}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:T 'Protokoll'}" Style="{StaticResource SettingsSection}"/>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshLogCommand}" FontSize="12" />
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Protokoll kopieren'}" Command="{Binding CopyLogCommand}" FontSize="12" Margin="8,0,0,0" />
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Ordner öffnen'}" Command="{Binding OpenAppLogFolderCommand}" FontSize="12" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Protokoll'}" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="{Binding LogFile}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Height="280">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="10,8"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"
                                       Text="{l:T 'Bei Problemen „Protokoll kopieren“ und den Text mitschicken – er enthält Version, Ordner-Status und die letzten Meldungen, aber keine Kennwörter.'}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
        </DockPanel>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Schließen'}" MinWidth="110" Height="34" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Änderungen verwerfen'}" Height="34" Click="Revert_Click"
                        ToolTip="{l:T 'Stand beim Öffnen der Einstellungen wiederherstellen'}" />
                <!-- Speicherstand: „Speichert …“ während der kurzen Wartezeit, danach „Alle Änderungen gespeichert“ -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{l:T 'Änderungen werden automatisch übernommen und gespeichert – ein Speichern-Knopf ist nicht nötig.'}">
                    <TextBlock x:Name="SaveIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource InfoBar.Success.Icon}"/>
                    <TextBlock x:Name="SaveHint" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{l:T 'Alle Änderungen gespeichert'}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Snackbar: kurze Rückmeldung unten, blendet nach einigen Sekunden aus -->
        <Border x:Name="SnackbarHost" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Padding="16,10" CornerRadius="8" BorderThickness="1" Visibility="Collapsed" Opacity="0" MaxWidth="640" Panel.ZIndex="100"
                Background="{DynamicResource Bg.Menu}" BorderBrush="{DynamicResource Border.Control}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="SnackbarShift" Y="12"/></Border.RenderTransform>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource InfoBar.Success.Icon}"/>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" MinHeight="28" Margin="12,0,0,0" Click="SnackbarClose_Click"
                           ToolTip="{l:T 'Schließen'}" AutomationProperties.Name="{l:T 'Meldung schließen'}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                </ui:Button>
                <TextBlock x:Name="SnackbarText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
