<Window x:Class="PowerExec.Desktop.Views.GroupPickerWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Power-Exec'}" Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"/>
        <TextBlock x:Name="Prompt" Style="{StaticResource Caption}" Margin="0,4,0,14" TextWrapping="Wrap"/>
        <!-- Vorhandene Gruppe -->
        <RadioButton x:Name="ExistingOption" GroupName="Kind" Content="{l:T 'Existing group'}" Checked="Option_Changed" Margin="0,0,0,6"/>
        <ComboBox x:Name="GroupBox" Margin="28,0,0,12" IsEditable="False" AutomationProperties.Name="{l:T 'Existing group'}"
                  SelectionChanged="GroupBox_SelectionChanged"/>
        <!-- Neue Gruppe -->
        <RadioButton x:Name="NewOption" GroupName="Kind" Content="{l:T 'New group'}" Checked="Option_Changed" Margin="0,0,0,6"/>
        <TextBox x:Name="NewBox" Margin="28,0,0,0" Tag="{l:T 'Name of the new group (subgroups with /)'}" GotFocus="NewBox_GotFocus"
                 AutomationProperties.Name="{l:T 'New group'}"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Status.Error}" FontSize="{StaticResource Font.Body}" Margin="28,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="96" />
            <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Apply'}" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
