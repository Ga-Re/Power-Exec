<Window x:Class="PowerExec.Views.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, StringFormat=Ausführen – {0}}" Style="{StaticResource AppWindow}"
        Width="1040" Height="820" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="1"/>
        </Style>
        <DataTemplate x:Key="MachineTemplate">
            <Border x:Name="Bd" CornerRadius="4" Padding="8,3,4,3" MinHeight="38" Background="Transparent">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding ToggleFavoriteCommand}"
                            ToolTip="Favorit umschalten">
                        <Grid>
                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" Foreground="{DynamicResource Star}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" Visibility="{Binding IsFavorite, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        </Grid>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastUsed}" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="8,0"/>
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock x:Name="TestInfo" Text="{Binding TestText}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="230" ToolTip="{Binding TestText}" Visibility="{Binding HasTest, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </CheckBox>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding TestOk}" Value="True">
                    <Setter TargetName="TestInfo" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TestOk}" Value="False">
                    <Setter TargetName="TestInfo" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="22" CornerRadius="4" Background="{DynamicResource Badge.PowerShell.Bg}" Margin="0,0,10,0"
                                    Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                                <TextBlock Text="PS1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Badge.PowerShell.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource Mono}" Foreground="{DynamicResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Synopsis}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProfileText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"
                                   Visibility="{Binding HasProfile, Converter={StaticResource Vis}}"/>
                        <Border Background="{DynamicResource Bg.CardAlt}" CornerRadius="4" Padding="8,6" Margin="0,8,0,0" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="11" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Text.Secondary}"/>
                                <TextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding RequirementsInfo}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding RequirementsInfo, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding ParseError, StringFormat=Hinweis: Das Script enthält einen Fehler ({0})}" FontSize="12" Foreground="{DynamicResource Status.Warning}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding ParseError, Converter={StaticResource Vis}}"/>
                    </StackPanel>

                    <!-- Parameter -->
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasParameters, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Parameter" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="aus param()-Block und .PARAMETER-Hilfe" Style="{StaticResource Caption}" Margin="8,2,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,16,14">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}" Margin="6,0,0,0"/>
                                                <TextBlock Text="Pflicht" FontSize="12" Foreground="{DynamicResource Status.Error}" Margin="6,0,0,0"
                                                           Visibility="{Binding IsMandatory, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="fest im Profil" FontSize="12" Foreground="{DynamicResource Accent}" Margin="6,0,0,0"
                                                           Visibility="{Binding IsFixed, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Placeholder}" IsEnabled="{Binding IsEditable}"
                                                     Visibility="{Binding IsPlainText, Converter={StaticResource Vis}}"/>
                                            <ComboBox IsEditable="True" ItemsSource="{Binding Suggestions}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsEditable}" ToolTip="Zuletzt verwendete Werte über den Pfeil auswählen"
                                                      Visibility="{Binding IsTextWithSuggestions, Converter={StaticResource Vis}}"/>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsEnabled="{Binding IsEditable}"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource Vis}}"/>
                                            <CheckBox IsChecked="{Binding BoolValue}" Content="Aktivieren" Margin="0,6,0,0" IsEnabled="{Binding IsEditable}"
                                                      Visibility="{Binding IsCheck, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="Wird nicht gespeichert oder übergeben – das Script fragt bei Bedarf selbst." Style="{StaticResource Caption}"
                                                       Visibility="{Binding IsSecure, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding HelpText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"
                                                       Visibility="{Binding HasHelp, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Validation}" Foreground="{DynamicResource Status.Error}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding Validation, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Ausführen als -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Ausführen als" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Aktueller Benutzer"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=CurrentUser}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Administrator"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Administrator}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Anderer Benutzer"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=OtherUser}"/>
                                </UniformGrid>
                            </Border>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,8,0" FontSize="13"/>
                                <TextBlock Text="{Binding ModeInfo}" Style="{StaticResource Caption}"/>
                            </DockPanel>

                            <WrapPanel Margin="0,14,0,0" Visibility="{Binding IsPowerShell, Converter={StaticResource Vis}}">
                                <StackPanel Width="250" Margin="0,0,24,0">
                                    <TextBlock Text="PowerShell-Version" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Engines}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Engine}"/>
                                    <TextBlock Text="{Binding EngineWarning}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"
                                               Visibility="{Binding EngineWarning, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom" Margin="0,8,0,0">
                                    <CheckBox Content="Konsole nach Ende offen lassen" IsChecked="{Binding NoExit}" Margin="0,0,0,8"
                                              Visibility="{Binding IsLocal, Converter={StaticResource Vis}}"/>
                                    <CheckBox Content="Ohne Profil starten (-NoProfile)" IsChecked="{Binding NoProfile}"
                                              Visibility="{Binding IsLocal, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Rechte Spalte: Ziel -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Ziel" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SegmentHost}" IsEnabled="{Binding SupportsRemote}">
                            <UniformGrid Columns="2">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Target" Content="Dieser PC" IsChecked="{Binding IsLocal}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Target" Content="Remote" IsChecked="{Binding IsRemote}"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Visibility="{Binding IsLocal, Converter={StaticResource Vis}}"
                                   Text="Das Script läuft auf diesem PC. Für einen oder mehrere andere Rechner auf „Remote“ wechseln. Bei mehreren Rechnern läuft es parallel auf allen."/>
                    </StackPanel>

                    <DockPanel Visibility="{Binding IsRemote, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Visibility="{Binding HasGroups, Converter={StaticResource Vis}}" Margin="0,0,0,6">
                                <TextBlock Text="Gruppen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn.Standard}" Command="{Binding Command}" Height="28" MinHeight="28" Padding="10,0" Margin="0,0,6,6"
                                                    FontSize="12" ToolTip="{Binding Members}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE902;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Text.Secondary}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedMachines}" Focusable="False" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28" CornerRadius="14" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1"
                                                Padding="10,0,2,0" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                                        ToolTip="Entfernen">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Hinzufügen" Margin="8,0,0,0" Command="{Binding AddMachineCommand}"/>
                                <TextBox x:Name="MachineBox" Text="{Binding NewMachine, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Rechnername(n), mit Komma getrennt" PreviewKeyDown="MachineBox_KeyDown"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Command="{Binding TestConnectionCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TestButtonText}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding SslHint}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                           ToolTip="Prüft WinRM, Anmeldung, PowerShell-Version und den Endpunkt PowerShell.7 für die ausgewählten Rechner. HTTPS stellst du unter Einstellungen › Ausführung ein."/>
                            </DockPanel>
                            <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg.CardAlt}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding CopyFolder}">
                                        <TextBlock Text="Scriptordner mitsenden" FontWeight="SemiBold"/>
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="26,2,0,0"
                                               Text="Kopiert Begleitdateien und Module über die Remote-Sitzung auf den Zielrechner und löscht sie danach. Der Zielrechner braucht keinen Zugriff auf die Freigabe."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ReadHostWarning}" FontSize="12" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding ReadHostWarning, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding ModulesInfo}" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,6"
                                       Visibility="{Binding ModulesInfo, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Favoriten" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="8,4,0,2"/>
                                <TextBlock Text="Noch keine Favoriten – Stern bei einem Rechner setzen." Style="{StaticResource Caption}" Margin="8,2,0,6"
                                           Visibility="{Binding FavoriteMachines.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                <ItemsControl ItemsSource="{Binding FavoriteMachines}" ItemTemplate="{StaticResource MachineTemplate}" Focusable="False"/>
                                <TextBlock Text="Zuletzt verwendet" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="8,10,0,2"/>
                                <ItemsControl ItemsSource="{Binding RecentMachines}" ItemTemplate="{StaticResource MachineTemplate}" Focusable="False"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Fußzeile -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel>
                <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Padding="12,8" MaxHeight="110">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" MinHeight="0" Foreground="{DynamicResource Text.Secondary}"/>
                    </ScrollViewer>
                </Border>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding RunCommand}" MinWidth="140" Height="34" Margin="8,0,0,0" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding RunLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96" Height="34" Click="Cancel_Click"/>
                    <TextBlock Text="{Binding FootNote}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
