<Window x:Class="PowerExec.Views.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anmeldedaten" Style="{StaticResource AppWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Ausführen als anderer Benutzer" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" Margin="0,4,0,16"/>

        <TextBlock Text="Benutzername" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="UserBox" Tag="DOMÄNE\benutzer oder benutzer@domäne"/>

        <TextBlock Text="Kennwort" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PasswordBox"/>

        <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                <TextBlock x:Name="Hint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Info.Text}"
                           Text="Die Anmeldedaten werden nur für diesen Start verwendet und nicht gespeichert."/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96"/>
            <Button Style="{StaticResource Btn.Accent}" Content="Starten" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
