<Window x:Class="PowerExec.Views.CredentialWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Credentials'}" Style="{StaticResource AppWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary Source="/Themes/Fluent.xaml"/>
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:T 'Run as different user'}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" Margin="0,4,0,16"/>

        <TextBlock Text="{l:T 'User name'}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="UserBox" Tag="{l:T 'DOMAIN\\user or user@domain'}"/>

        <TextBlock Text="{l:T 'Password'}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PasswordBox"/>

        <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Info.Bg}" BorderBrush="{DynamicResource Info.Border}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                <TextBlock x:Name="Hint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Info.Text}"
                           Text="{l:T 'The credentials are only used for this launch and are not saved.'}"/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="96" />
            <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Run'}" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
