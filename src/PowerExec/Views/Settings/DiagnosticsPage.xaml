<!-- Einstellungen › Hilfe › Diagnose und Daten. -->
<UserControl x:Class="PowerExec.Desktop.Views.Settings.DiagnosticsPage"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:v="clr-namespace:PowerExec.Desktop.Views"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=diag}">
        <TextBlock Text="{l:T 'Diagnostics'}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l:T 'Log for troubleshooting and folder scan times.'}" Style="{StaticResource Caption}"/>

        <TextBlock Text="{l:T 'Folder scanning'}" Style="{StaticResource SettingsSection}"/>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{l:T 'Folder'}" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding FolderTimes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock x:Name="Info" DockPanel.Dock="Right" Text="{Binding Text}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                    <Setter TargetName="Info" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SystemInfo}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T 'Log'}" Style="{StaticResource SettingsSection}"/>
        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Update'}" Command="{Binding RefreshLogCommand}" FontSize="{StaticResource Font.Body}" />
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Copy log'}" Command="{Binding CopyLogCommand}" FontSize="{StaticResource Font.Body}" Margin="8,0,0,0" />
                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Open folder'}" Command="{Binding OpenAppLogFolderCommand}" FontSize="{StaticResource Font.Body}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Log'}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding LogFile}" Style="{StaticResource Mono}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}"/>
                    </StackPanel>
                </DockPanel>
                <Border Background="{DynamicResource Bg.Code}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Height="280">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="10,8"
                             FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Caption}" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"/>
                </Border>
                <TextBlock Style="{StaticResource Caption}" FontSize="{StaticResource Font.Caption}" Margin="0,6,0,0"
                           Text="{l:T 'If there are problems, use “Copy log” and send the text along – it contains the version, folder status and the latest messages, but no passwords.'}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
