<!-- Einstellungen › Inhalte › Arbeitsbereiche. -->
<UserControl x:Class="PowerExec.Desktop.Views.Settings.WorkspacesPage"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:v="clr-namespace:PowerExec.Desktop.Views"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=workspaces}">
        <TextBlock Text="{l:T 'Workspaces'}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l:T 'Workspaces show a selection of your groups – e.g. per customer or task. Groups, folders and custom entries exist only once; each workspace has its own favorites, “Recently run”, launch profiles and collapsed groups. You can also switch in the panel header and the tray menu.'}"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <ItemsControl ItemsSource="{Binding Workspaces}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" MinHeight="0">
                        <StackPanel>
                            <DockPanel Margin="6,8,12,8">
                                <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                        ToolTip="{l:T 'Choose the groups of this workspace'}" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </ui:Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Status.Info.Bg}" CornerRadius="{DynamicResource Radius.Control}" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{l:T 'Active'}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Groups …'}" Command="{Binding ToggleCommand}" Margin="0,0,8,0" />
                                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Switch'}" Command="{Binding ActivateCommand}" Margin="0,0,8,0"
                                            ToolTip="{l:T 'Applies the settings and switches the workspace'}" />
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Delete'}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                    </ui:Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Width="280" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                    Background="{DynamicResource Bg.CardAlt}" Padding="20,10,16,12">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'These groups appear in the panel (Favorites, Recently run and Search show everything):'}" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="{l:T 'No groups created yet.'}" Style="{StaticResource Caption}"
                                               Visibility="{Binding Groups.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}" Margin="{Binding IndentLeft, Converter={StaticResource LeftMargin}}" Padding="6,0,0,0" MinHeight="30">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="18" Margin="0,0,8,0">
                                                            <c:IconPresenter Icon="{Binding Icon}" Size="15" Foreground="{DynamicResource Text.Primary}"
                                                                             Visibility="{Binding Icon, Converter={StaticResource Vis}}"/>
                                                            <TextBlock x:Name="WsGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Foreground="{DynamicResource Text.Tertiary}"
                                                                       Visibility="{Binding Icon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="6,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                                                   VerticalAlignment="Center" ToolTip="{l:T 'Fixed group'}" Visibility="{Binding IsFixed, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                        <Setter TargetName="WsGlyph" Property="Text" Value="{Binding FixedGlyph}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <c:SettingsCard Icon="&#xE710;" Header="{l:T 'New workspace'}" Description="{l:T '“Copy current” copies favorites, launch profiles and group selection.'}">
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="220" Text="{Binding NewWorkspace, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Name, e.g. Customer A'}" VerticalAlignment="Center"/>
                    <CheckBox Content="{l:T 'Copy current'}" IsChecked="{Binding CopyWorkspace}" Margin="12,0,0,0" VerticalAlignment="Center"
                              ToolTip="{l:T 'Copy favorites, launch profiles and group selection'}"/>
                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Create'}" Command="{Binding AddWorkspaceCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
        </c:SettingsCard>
    </StackPanel>
</UserControl>
