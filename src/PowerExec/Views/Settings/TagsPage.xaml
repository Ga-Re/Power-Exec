<!-- Einstellungen › Inhalte › Schlagworte. -->
<UserControl x:Class="PowerExec.Desktop.Views.Settings.TagsPage"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:v="clr-namespace:PowerExec.Desktop.Views"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=tags}">
    <StackPanel DataContext="{Binding TagList}">
        <TextBlock Text="{l:T 'Tags'}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l:T 'All tags of your entries. In the panel, #tag in the search filters by tag. Renaming to an existing name merges both.'}"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420">
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="{l:T 'Find tag'}"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
        </Grid>
        <TextBlock Text="{l:T 'No tags yet. You assign them in the entry dialog under “Sort”.'}" Style="{StaticResource Caption}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4" MinHeight="0">
                        <StackPanel>
                            <DockPanel Margin="6,6,8,6">
                                <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}" ToolTip="{l:T 'Show entries'}">
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </ui:Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="170" Margin="0,0,2,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding Color}" SelectedValuePath="Key" ToolTip="{l:T 'Tag color'}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                             Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                    <TextBlock Text="{Binding Value}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Margin="0,0,8,0" Command="{Binding CustomColorCommand}"
                                            ToolTip="{l:T 'Pick your own color in the color picker'}" AutomationProperties.Name="{l:T 'Custom color'}">
                                        <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="{l:T 'Rename or merge'}">
                                        <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding DeleteCommand}" ToolTip="{l:T 'Remove from all entries'}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                    </ui:Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Border Background="{Binding ChipColor, Converter={StaticResource ArgbBrush}, ConverterParameter=Bg.Chip}" infra:Pill.IsEnabled="True" Padding="10,2,10,3">
                                        <TextBlock Text="{Binding Tag, StringFormat=#{0}}" FontSize="{StaticResource Font.BodyStrong}"/>
                                    </Border>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                                    Background="{DynamicResource Bg.CardAlt}" Padding="44,8,16,10">
                                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel x:Name="TagEntryRow" Background="Transparent" Margin="0,1">
                                                <!-- ✕ nimmt nur diesem Eintrag das Schlagwort -->
                                                <ui:Button x:Name="TagEntryRemove" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Opacity="0.55"
                                                        Command="{Binding RemoveCommand}" ToolTip="{l:T 'Remove tag from this entry'}" AutomationProperties.Name="{l:T 'Remove'}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                                                </ui:Button>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="TagEntryRow" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TagEntryRemove" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </Grid>
</UserControl>
