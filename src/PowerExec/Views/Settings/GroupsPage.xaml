<!-- Einstellungen › Inhalte › Gruppen: Karten je Gruppe (rekursiv), Sortieren per Drag &amp; Drop. -->
<UserControl x:Class="PowerExec.Desktop.Views.Settings.GroupsPage"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:v="clr-namespace:PowerExec.Desktop.Views"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Gruppenkarte, rekursiv: Untergruppen liegen als Karten im Rahmen der übergeordneten Gruppe -->
        <DataTemplate x:Key="CategoryCardTemplate">
                                <!-- Gruppen ziehen: Lücke über/unter der Karte; die gezogene Gruppe macht Platz -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <c:DropGap IsOpen="{Binding GapBefore}" OpenHeight="44"
                                               Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                               Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" MinHeight="0"
                                        AllowDrop="True" DragOver="GroupCard_DragOver" DragLeave="GroupCard_DragLeave" Drop="GroupCard_Drop">
                                    <StackPanel>
                                        <DockPanel Margin="8,8,8,8" MinHeight="44" Background="Transparent" Cursor="SizeAll"
                                                   PreviewMouseLeftButtonDown="GroupCard_PreviewMouseDown" PreviewMouseMove="GroupCard_PreviewMouseMove"
                                                   ToolTip="{l:T 'Drag to move the group – dropped onto the middle of another group it becomes a subgroup. Right-click: new subgroup'}">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:T 'New subgroup …'}" Command="{Binding NewSubgroupCommand}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{l:T 'Rename …'}" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="{l:T 'Choose icon …'}" Command="{Binding ChooseIconCommand}"/>
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="2,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding ToggleCommand}"
                                                    ToolTip="{l:T 'Expand/collapse folders and entries'}" Visibility="{Binding IsSmart, Converter={StaticResource Vis}, ConverterParameter=hidden}">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandAngle}}"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ui:Button>
                                            <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Width="34" Height="34" MinHeight="34" Padding="0" Command="{Binding ChooseIconCommand}"
                                                    ToolTip="{l:T 'Choose icon'}" Margin="4,0,12,0">
                                                <Grid>
                                                    <c:IconPresenter Icon="{Binding Icon}" Size="18" Foreground="{DynamicResource Text.Primary}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                    <TextBlock x:Name="DefaultGlyph" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Foreground="{DynamicResource Text.Tertiary}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                                </Grid>
                                            </ui:Button>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Height="22" Padding="8,0" infra:Pill.IsEnabled="True" Background="{DynamicResource Status.Warning.Bg}" BorderBrush="{DynamicResource Status.Warning.Border}"
                                                        BorderThickness="1" Margin="0,0,8,0" Visibility="{Binding Folder.HasPending, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding Folder.PendingCount, StringFormat={}{0} neu}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                                                </Border>
                                                <ComboBox Width="150" Margin="0,0,4,0" ItemsSource="{Binding Colors}" SelectedValue="{Binding ColorOwn}" SelectedValuePath="Key"
                                                          ToolTip="{l:T 'Group color (subgroups inherit it)'}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                                                         Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                                                <TextBlock Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="28" Height="32" Command="{Binding CustomColorCommand}" ToolTip="{l:T 'Pick your own color in the color picker'}">
                                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                                </ui:Button>
                                                <ComboBox Width="125" Margin="4,0,8,0" ItemsSource="{Binding LayoutList}" SelectedValue="{Binding Layout}"
                                                          DisplayMemberPath="Value" SelectedValuePath="Key" ToolTip="{l:T 'How this group looks in the panel'}"/>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RenameCommand}" ToolTip="{l:T 'Rename (display name)'}">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding RemoveCommand}" ToolTip="{l:T 'Delete group (after confirmation)'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Display}" FontSize="{StaticResource Font.Subtitle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" FontSize="{StaticResource Font.Caption}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Smarte Gruppe: Ordner und seine Einträge -->
                                        <ContentControl Content="{Binding Folder}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSmart}" Value="True"/>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Ordner -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg.CardAlt}" Padding="16,12">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Detach folder'}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                                                                            ToolTip="{l:T 'Stop scanning the folder; the group stays as a normal group'}" />
                                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Browse …'}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                                                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" FontFamily="{DynamicResource MonoFont}" Tag="{l:T 'Path, e.g. C:\\Scripts or \\\\server\\share'}"/>
                                                                </DockPanel>
                                                                <WrapPanel Margin="0,12,0,0">
                                                                    <CheckBox Content="{l:T 'Include subfolders'}" IsChecked="{Binding Recursive}" Margin="0,0,20,8" VerticalAlignment="Center"/>
                                                                    <CheckBox Content="{l:T 'Subfolders as subgroups in the panel'}" IsChecked="{Binding SubfoldersAsGroups}" IsEnabled="{Binding Recursive}"
                                                                              Margin="0,0,20,8" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{l:T 'File extensions:'}" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{DynamicResource Text.Secondary}"/>
                                                                    <StackPanel Margin="0,0,0,8">
                                                                        <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Width="220"
                                                                                 Tag="{l:T 'empty = default; e.g. .ps1; .cmd'}" FontFamily="{DynamicResource MonoFont}"
                                                                                 ToolTip="{l:T 'Separated by semicolons, e.g. .ps1; .cmd; .exe'}"/>
                                                                        <TextBlock Text="{Binding ExtensionsError}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" MaxWidth="220"
                                                                                   Visibility="{Binding ExtensionsError, Converter={StaticResource Vis}}"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="{l:T ' · Last scan: '}"/><Run Text="{Binding Status, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Einträge -->
                                                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="16,12,16,16">
                                                            <StackPanel>
                                    <WrapPanel Margin="0,0,0,12">
                                        <TextBlock Text="{l:T 'New files:'}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"/>
                                        <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Padding="1" Width="330">
                                            <UniformGrid Columns="2">
                                                <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Show automatically'}" IsChecked="{Binding AutoShow}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                                <RadioButton Style="{StaticResource Segment}" Content="{l:T 'Only after approval'}" IsChecked="{Binding RequireApproval}" GroupName="{Binding Path, StringFormat={}{0}|mode}"/>
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </WrapPanel>

                                    <Border Visibility="{Binding HasPending, Converter={StaticResource Vis}}" Margin="0,0,0,12" Padding="12,8" CornerRadius="{DynamicResource Radius.Card}"
                                            Background="{DynamicResource Status.Info.Bg}" BorderBrush="{DynamicResource Status.Info.Border}" BorderThickness="1">
                                        <DockPanel>
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Approve all'}" Command="{Binding ApproveAllCommand}" Height="30" MinHeight="30" FontSize="{StaticResource Font.Body}" />
                                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Keep hidden'}" Command="{Binding DismissPendingCommand}" Height="30" MinHeight="30" FontSize="{StaticResource Font.Body}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Show all'}" Command="{Binding AllOnCommand}" Height="28" MinHeight="28" FontSize="{StaticResource Font.Body}" />
                                            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'None'}" Command="{Binding AllOffCommand}" Height="28" MinHeight="28" FontSize="{StaticResource Font.Body}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <Grid Width="240" Margin="0,0,12,0" DockPanel.Dock="Left">
                                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="28,0,8,0" Tag="{l:T 'Search in this folder'}" Height="30" MinHeight="30"/>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource Text.Secondary}"/>
                                        </Grid>
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'All'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=all}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Scripts'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=scripts}"/>
                                            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Programs'}" GroupName="{Binding Path, StringFormat={}{0}|type}"
                                                         IsChecked="{Binding TypeFilter, Converter={StaticResource Eq}, ConverterParameter=programs}"/>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:T 'Panel'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{l:T 'Entry'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{l:T 'Launch profiles'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{l:T 'Admin'}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding VisibleRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" MinHeight="50" Background="Transparent">
                                                    <Grid x:Name="RowGrid">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="250"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsVisibleInPanel}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat={}{0} im Panel anzeigen}"/>
                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Width="36" Height="22" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Badge.Other.Bg}"
                                                                    Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                                <TextBlock Text="{Binding Badge}" FontSize="{StaticResource Font.Micro}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Badge.Other.Fg}"/>
                                                            </Border>
                                                            <Image Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="22" Height="22" HorizontalAlignment="Left" Margin="7,0,0,0"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,12,8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <Border Margin="8,0,0,0" Padding="8,0" infra:Pill.IsEnabled="True" Background="{DynamicResource Accent}"
                                                                        Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                                                    <TextBlock Text="{l:T 'NEW'}" FontSize="{StaticResource Font.Micro}" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                                </Border>
                                                                <Border Margin="8,0,0,0" Padding="8,0" infra:Pill.IsEnabled="True" Background="{DynamicResource Status.Warning.Bg}" BorderBrush="{DynamicResource Status.Warning.Border}" BorderThickness="1"
                                                                        Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}"
                                                                        ToolTip="{l:T 'Downloaded from the internet – approve it in the panel via “Unblock”'}">
                                                                    <TextBlock Text="{l:T 'BLOCKED'}" FontSize="{StaticResource Font.Micro}" FontWeight="Bold" Foreground="{DynamicResource Status.Warning}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Info}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding ProfilesText}" FontSize="{StaticResource Font.Body}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProfileDetail}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsAdmin, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Foreground="{DynamicResource Status.Warning}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{l:T 'Yes'}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Status.Warning}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="5" Style="{StaticResource Btn.Icon}" Width="34" Height="34" Command="{Binding ConfigureCommand}"
                                                                ToolTip="{l:T 'Launch profiles'}" Visibility="{Binding CanToggle, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}"/>
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsVisibleInPanel}" Value="False">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l:T 'No entries for this search.'}" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding NoRows, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{l:T 'No entries yet – the folder is being scanned …'}" Style="{StaticResource Caption}" Margin="12,12,0,0"
                                               Visibility="{Binding HasNoEntries, Converter={StaticResource Vis}}"/>

                                    <WrapPanel Margin="0,12,0,0">
                                        <TextBlock Text="{l:T 'Pattern exclusions:'}" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"/>
                                        <ItemsControl ItemsSource="{Binding Exclusions}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="26" infra:Pill.IsEnabled="True" Background="{DynamicResource Status.Error.Bg}" BorderBrush="{DynamicResource Status.Error.Border}"
                                                            BorderThickness="1" Padding="12,0,2,0" Margin="0,0,8,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Kind}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Error.Text}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="{StaticResource Font.Caption}" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"/>
                                                            <ui:Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" MinHeight="22" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                                                    ToolTip="{l:T 'Remove exclusion'}" Foreground="{DynamicResource Status.Error.Text}">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XS}"/>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="28" MinHeight="28" Margin="0,0,8,8"
                                                 Tag="{l:T 'e.g. *.exe or *\\Archive\\*'}" FontSize="{StaticResource Font.Body}"/>
                                        <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T '+ Pattern'}" Command="{Binding AddExclusionCommand}" Height="28" MinHeight="28"
                                                FontSize="{StaticResource Font.Body}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="{StaticResource Font.Caption}" Text="{l:T 'Individual files are shown or hidden with the checkbox. Patterns apply immediately; the list updates after scanning.'}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <!-- Untergruppen im Rahmen dieser Gruppe; Lücke „als letzte Untergruppe“ -->
                                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource CategoryCardTemplate}" Focusable="False" Margin="16,2,12,0"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource Vis}}"/>
                                        <c:DropGap IsOpen="{Binding GapInside}" Margin="16,0,12,0" OpenHeight="44"
                                                   Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                                   Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                    </StackPanel>
                                </Border>
                                    <c:DropGap IsOpen="{Binding GapAfter}" OpenHeight="44"
                                               Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                                               Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSmart}" Value="True">
                                        <Setter TargetName="DefaultGlyph" Property="Text" Value="&#xE8B7;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Folder.IsHighlighted}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <!-- Gruppe wird hineingezogen: Rahmen der Zielgruppe hervorheben -->
                                    <DataTrigger Binding="{Binding GapInside}" Value="True">
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="GroupCard" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
        <!-- Feste Gruppe (Schloss): verschiebbar wie eine Gruppe, aber ohne Untergruppen, Farbe oder Löschen -->

        <DataTemplate x:Key="FixedCardTemplate">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <c:DropGap IsOpen="{Binding GapBefore}" OpenHeight="44"
                           Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
                <Border x:Name="GroupCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" MinHeight="0" Background="{DynamicResource Bg.CardAlt}"
                        AllowDrop="True" DragOver="GroupCard_DragOver" DragLeave="GroupCard_DragLeave" Drop="GroupCard_Drop">
                    <StackPanel>
                        <DockPanel Margin="8,8,12,8" MinHeight="44" Background="Transparent" Cursor="SizeAll"
                                   PreviewMouseLeftButtonDown="GroupCard_PreviewMouseDown" PreviewMouseMove="GroupCard_PreviewMouseMove"
                                   ToolTip="{l:T 'Fixed group – drag to move it. Show or hide per workspace.'}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.M}" Margin="2,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform Angle="90"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="34,0,12,0" CornerRadius="{DynamicResource Radius.Control}">
                                <TextBlock Text="{Binding FixedGlyph}" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.XL}" Foreground="{DynamicResource Text.Secondary}"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Zuletzt ausgeführt: wie viele -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecentFixed, Converter={StaticResource Vis}}">
                                    <Slider Width="140" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Value="{Binding DataContext.RecentRunsCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="{Binding DataContext.RecentRunsText, RelativeSource={RelativeSource AncestorType=Window}}" Width="80" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Manage …'}" Visibility="{Binding IsCustomFixed, Converter={StaticResource Vis}}"
                                        Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="custom" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="8,0,0,0" Foreground="{DynamicResource Text.Tertiary}"
                                               VerticalAlignment="Center" ToolTip="{l:T 'Fixed group: cannot be deleted'}" AutomationProperties.Name="{l:T 'Fixed group'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FixedDescription}" Style="{StaticResource Caption}" FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <c:DropGap IsOpen="{Binding GapAfter}" OpenHeight="44"
                           Label="{Binding DataContext.CategoryDragLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           DotBrush="{Binding DataContext.CategoryDragColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ArgbBrush}}"
                           Animate="{Binding DataContext.AnimateDropGap, RelativeSource={RelativeSource AncestorType=Window}}"
                           DragOver="CategoryGap_DragOver" Drop="CategoryGap_Drop"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=groups}"
                Background="Transparent" AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
        <DockPanel>
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Command="{Binding NewGroupCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}" Margin="0,0,8,0"/><TextBlock Text="{l:T 'New group'}"/></StackPanel>
            </ui:Button>
            <TextBlock Text="{l:T 'Groups'}" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="{l:T 'Groups organize the panel. Drag a group to another position or onto the middle of another group to make it a subgroup; right-click creates a subgroup. In the panel you drag entries into any group. Which groups a workspace shows is set under Workspaces.'}"/>

        <TextBlock Text="{l:T 'Your groups'}" Style="{StaticResource SettingsSection}"/>
        <TextBlock Style="{StaticResource Caption}" FontSize="{StaticResource Font.Caption}" Margin="4,0,0,8" TextWrapping="Wrap"
                   Text="{l:T 'Groups with a lock (Recently run, Favorites, Custom entries) are fixed: movable but not deletable. Whether they appear in the panel is set per workspace.'}"/>
        <TextBlock Text="{l:T 'No groups yet – “New group” at the top right or right-click in the panel.'}" Style="{StaticResource Caption}" Margin="4,0,0,8"
                   Visibility="{Binding Categories.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
        <ItemsControl x:Name="CategoryList" ItemsSource="{Binding CategoryRoots}" Focusable="False">
            <ItemsControl.ItemTemplateSelector>
                <v:CategoryTemplateSelector Group="{StaticResource CategoryCardTemplate}" Fixed="{StaticResource FixedCardTemplate}"/>
            </ItemsControl.ItemTemplateSelector>
        </ItemsControl>
        <TextBlock Style="{StaticResource Caption}" FontSize="{StaticResource Font.Caption}" Margin="2,2,0,0" TextWrapping="Wrap"
                   Text="{l:T 'Deleting removes the group including subgroups (after confirmation). Entries dragged in reappear in their smart group or under “Custom entries”; files stay unchanged.'}"/>

        <TextBlock Text="{l:T 'For all smart groups (folders)'}" Style="{StaticResource SettingsSection}"/>
        <c:SettingsCard Icon="&#xE8A5;" Header="{l:T 'Default file extensions'}" Description="{l:T 'Applies to smart groups without their own setting. Separated by semicolons, e.g. .ps1; .cmd; .exe'}">
                <StackPanel Width="300">
                    <TextBox Text="{Binding DefaultExtensions, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Tag="{l:T '.ps1; .cmd; .exe'}"/>
                    <TextBlock Text="{Binding DefaultExtensionsError}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding DefaultExtensionsError, Converter={StaticResource Vis}}"/>
                </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Icon="&#xE8D8;" Header="{l:T 'Global exclusions'}" Description="{l:T 'Apply to all folders, separated by semicolons. “Hide” in the panel creates exclusions on the respective folder.'}">
                <TextBox Width="300" Text="{Binding GlobalExcludes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" Tag="{l:T 'e.g. *.bak.ps1; *\\Old\\*'}"/>
        </c:SettingsCard>
        <c:SettingsCard Icon="&#xE72C;" Header="{l:T 'Rescan automatically on changes'}" Description="{l:T 'New, renamed or deleted files appear immediately.'}">
                <ui:ToggleSwitch IsChecked="{Binding AutoRescan}" AutomationProperties.Name="{l:T 'Rescan automatically on changes'}"/>
        </c:SettingsCard>
        <c:SettingsCard Icon="&#xE916;" Header="{l:T 'Timeout for unreachable folders'}" Description="{l:T 'If a folder (e.g. a network share) doesn\'t respond in time, the panel shows the last scanned state.'}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="180" Minimum="2" Maximum="60" TickFrequency="1" Value="{Binding ScanTimeoutSeconds}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScanTimeoutSeconds, StringFormat={}{0} s}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                </StackPanel>
        </c:SettingsCard>
    </StackPanel>
</UserControl>
