<Window x:Class="PowerExec.Views.WorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ablauf bearbeiten" Style="{StaticResource AppWindow}"
        Width="560" Height="520" MinWidth="440" MinHeight="360" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Ablauf" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Die Schritte starten nacheinander; jeder wartet, bis der vorige fertig ist. Lokale Scripte laufen dafür ohne -NoExit." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,0" AutomationProperties.Name="Name des Ablaufs"/>
            <CheckBox Content="Bei einem Fehler die restlichen Schritte nicht starten" IsChecked="{Binding StopOnError}" Margin="0,12,0,12"/>
            <TextBlock Text="Schritte" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96" Click="Cancel_Click"/>
            <Button Style="{StaticResource Btn.Standard}" Content="Speichern und starten" Command="{Binding RunCommand}" Margin="8,0,0,0"/>
            <Button Style="{StaticResource Btn.Accent}" Content="Speichern" Command="{Binding SaveCommand}" MinWidth="96" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ProfileName}" Width="130" Height="28" Margin="0,0,6,0"
                                                  Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}" ToolTip="Startprofil dieses Schritts"/>
                                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" ToolTip="Nach oben"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" ToolTip="Nach unten"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" ToolTip="Schritt entfernen"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Bg.Chip}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Status.Warning}"
                                                   Visibility="{Binding Status, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
