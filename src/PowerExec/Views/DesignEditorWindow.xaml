<Window x:Class="PowerExec.Desktop.Views.DesignEditorWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
        xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
        Title="{l:T 'Power-Exec – Edit design'}" Style="{StaticResource AppWindow}"
        Width="1160" Height="780" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <infra:HexBrushConverter x:Key="HexBrush"/>
    </Window.Resources>
    <DockPanel>
        <!-- Kopf: Name, Ausgangsdesign, Variante -->
        <DockPanel DockPanel.Dock="Top" Margin="28,20,28,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{l:T 'Light and dark variant'}" IsChecked="{Binding HasPair}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="{l:T 'The design switches with Windows between its light and its dark variant'}"/>
                <RadioButton Style="{StaticResource TabHeader}" GroupName="DesignVariant" Content="{l:T 'Light'}" IsChecked="{Binding EditLight}"/>
                <RadioButton Style="{StaticResource TabHeader}" GroupName="DesignVariant" Content="{l:T 'Dark'}" IsChecked="{Binding EditDark}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="{l:T 'Edit design'}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Name of the design'}"
                     AutomationProperties.Name="{l:T 'Name of the design'}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StartText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Fuß -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Content="{l:T 'Export as file …'}" Command="{Binding ExportCommand}"/>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Accent}" Content="{l:T 'Save'}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="96"/>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" Margin="0,0,8,0" MinWidth="96"/>
                <c:InfoBar DockPanel.Dock="Right" Severity="Error" Message="{Binding Error}" Margin="12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T 'The preview follows every change; the panel takes it over with Save.'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="28,0,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Farben -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Derive all from surface and accent'}" Command="{Binding DeriveAllCommand}"/>
                                <TextBlock Text="{Binding ColorsTitle}" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,8,8">
                                            <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding PickCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                       Padding="8" Height="Auto" AutomationProperties.Name="{Binding Label}" ToolTip="{l:T 'Choose color'}">
                                                <StackPanel>
                                                    <Border Height="28" CornerRadius="{DynamicResource Radius.Control}" Background="{Binding Hex, Converter={StaticResource HexBrush}}"
                                                            BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"/>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" FontFamily="{DynamicResource MonoFont}"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                                       Command="{Binding ClearCommand}" ToolTip="{l:T 'Derive this color again'}" AutomationProperties.Name="{l:T 'Derive this color again'}">
                                                <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.S}"/>
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="{l:T 'Accent color from Windows'}" IsChecked="{Binding UseWindowsAccent}" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Chip" Height="{StaticResource Height.Chip}" Padding="12,0" Margin="0,0,8,4" infra:Pill.IsEnabled="True"
                                                Background="{DynamicResource Status.Warning.Bg}" BorderBrush="{DynamicResource Status.Warning.Border}" BorderThickness="1">
                                            <TextBlock Text="{Binding Text}" FontSize="{StaticResource Font.Caption}" VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Status.Success.Bg}"/>
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Status.Success.Border}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Schrift -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Fonts'}" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{l:T 'Text'}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="TextFontBox" IsEditable="True" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:T 'Font for text'}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{l:T 'Paths and code'}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MonoFontBox" IsEditable="True" Text="{Binding MonoFontFamily, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:T 'Font for paths and code'}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{l:T 'Empty = font of the app. The size is set under Appearance › Font and element size.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Gruppenfarben -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Suggest a series'}" Command="{Binding SuggestGroupColorsCommand}"/>
                                <TextBlock Text="{l:T 'Group colors'}" FontWeight="SemiBold" FontSize="{StaticResource Font.Subtitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{l:T 'Groups without a color of their own get these in order; a group\'s own color always wins.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding GroupColors}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding PickCommand}" Width="36" Height="36" Margin="0,0,8,8" Cursor="Hand" ToolTip="{l:T 'Change color (right-click removes it)'}"
                                                    AutomationProperties.Name="{Binding Hex}">
                                                <Button.InputBindings>
                                                    <MouseBinding Gesture="RightClick" Command="{Binding RemoveCommand}"/>
                                                </Button.InputBindings>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Hex, Converter={StaticResource HexBrush}}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" infra:Pill.IsEnabled="True"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Style="{StaticResource Btn.Icon}" Width="36" Height="36" Command="{Binding AddGroupColorCommand}" ToolTip="{l:T 'Add color'}" AutomationProperties.Name="{l:T 'Add color'}">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/>
                                </ui:Button>
                            </WrapPanel>
                            <CheckBox Content="{l:T 'Also for tags without a color'}" IsChecked="{Binding GroupColorsForTags}" IsEnabled="{Binding HasGroupColors}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Übernommen vom Ausgangsstand -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Background and corners'}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Text="{Binding CarriedText, Mode=OneWay}"/><Run Text=" – "/><Run Text="{l:T 'taken from the current look; change it under Appearance before opening the editor.'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Vorschau: Panel der bearbeiteten Variante, daneben klein die andere -->
            <Border Grid.Column="2" CornerRadius="{DynamicResource Radius.Card}" Background="#6F8FB3" Padding="16,24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border x:Name="PreviewPanel" Width="300" CornerRadius="{DynamicResource Radius.Tile}" Padding="12" Background="{Binding SurfaceHex, Converter={StaticResource HexBrush}}"
                            BorderBrush="{Binding LineHex, Converter={StaticResource HexBrush}}" BorderThickness="1" TextElement.Foreground="{Binding TextHex, Converter={StaticResource HexBrush}}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="{DynamicResource Radius.Control}" Background="{Binding AccentHex, Converter={StaticResource HexBrush}}" Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="Standard" FontSize="{StaticResource Font.Caption}" Foreground="{Binding TextSecondaryHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                                <TextBlock Text="Power-Exec" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="30" Margin="0,12,0,0" Padding="12,0" infra:Pill.IsEnabled="True" Background="{Binding InputHex, Converter={StaticResource HexBrush}}"
                                    BorderBrush="{Binding LineHex, Converter={StaticResource HexBrush}}" BorderThickness="1">
                                <TextBlock Text="{l:T 'Search …'}" Foreground="{Binding TextSecondaryHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                <Ellipse Width="10" Height="10" Fill="{Binding Group1Hex, Converter={StaticResource HexBrush}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Favorites'}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border CornerRadius="{DynamicResource Radius.Card}" Padding="12,8" Background="{Binding SelectedHex, Converter={StaticResource HexBrush}}">
                                <StackPanel>
                                    <TextBlock Text="Cleanup.cmd" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'Cleans up'}" FontSize="{StaticResource Font.Caption}" Foreground="{Binding TextSecondaryHex, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock x:Name="PreviewMono" Text="C:\Scripts\Cleanup.cmd" FontSize="{StaticResource Font.Caption}" Foreground="{Binding TextSecondaryHex, Converter={StaticResource HexBrush}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Height="28" Padding="12,0" CornerRadius="{DynamicResource Radius.Control}" Background="{Binding AccentHex, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{l:T 'Run'}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding OnAccentHex, Converter={StaticResource HexBrush}}"/>
                                        </Border>
                                        <Border Height="28" Padding="12,0" Margin="8,0,0,0" CornerRadius="{DynamicResource Radius.Control}" BorderBrush="{Binding LineHex, Converter={StaticResource HexBrush}}" BorderThickness="1">
                                            <TextBlock Text="Admin" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                <Ellipse Width="10" Height="10" Fill="{Binding Group2Hex, Converter={StaticResource HexBrush}}" Margin="0,0,8,0"/>
                                <TextBlock Text="Admin" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border CornerRadius="{DynamicResource Radius.Card}" Padding="12,8" Background="{Binding CardHex, Converter={StaticResource HexBrush}}">
                                <TextBlock Text="Reset-Password.ps1"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                <Ellipse Width="10" Height="10" Fill="{Binding Group3Hex, Converter={StaticResource HexBrush}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Network'}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border CornerRadius="{DynamicResource Radius.Card}" Padding="12,8" Background="{Binding CardHex, Converter={StaticResource HexBrush}}">
                                <TextBlock Text="Flush-Dns.ps1"/>
                            </Border>
                            <Border BorderBrush="{Binding LineHex, Converter={StaticResource HexBrush}}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0">
                                <TextBlock Text="{l:T '13 entries · Standard'}" FontSize="{StaticResource Font.Caption}" Foreground="{Binding TextSecondaryHex, Converter={StaticResource HexBrush}}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,16,0,0" Width="140" Visibility="{Binding HasPair, Converter={StaticResource Vis}}">
                        <Border CornerRadius="{DynamicResource Radius.Card}" Padding="8" Background="{Binding OtherSurfaceHex, Converter={StaticResource HexBrush}}"
                                TextElement.Foreground="{Binding OtherTextHex, Converter={StaticResource HexBrush}}">
                            <StackPanel>
                                <TextBlock Text="Power-Exec" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}"/>
                                <Border CornerRadius="{DynamicResource Radius.Control}" Padding="8,4" Margin="0,8,0,0" Background="{Binding OtherCardHex, Converter={StaticResource HexBrush}}">
                                    <StackPanel>
                                        <TextBlock Text="Cleanup.cmd" FontSize="{StaticResource Font.Caption}"/>
                                        <Border Height="10" Width="48" HorizontalAlignment="Left" Margin="0,4,0,0" CornerRadius="{DynamicResource Radius.Control}" Background="{Binding OtherAccentHex, Converter={StaticResource HexBrush}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding OtherLabel}" Foreground="White" FontWeight="SemiBold" FontSize="{StaticResource Font.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
