<Window x:Class="PowerExec.Views.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        xmlns:infra="clr-namespace:PowerExec.Infrastructure"
        Title="Power-Exec Suche" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="Height" Width="640">
    <Border Margin="16" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Panel}" BorderThickness="1" CornerRadius="10" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBox x:Name="SearchBox" Height="44" FontSize="16" Padding="38,0,10,0" Tag="Suchen …"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         AutomationProperties.Name="Suchen"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource Text.Secondary}"/>
            </Grid>
            <TextBlock Text="{Binding Heading}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" Margin="6,10,0,4"/>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" Margin="6,6,6,10" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
            <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.RunSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Focusable="False" Cursor="Hand" ToolTip="{Binding ToolTipText}" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" CornerRadius="6" Padding="8,6" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Hover}"/></Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Selected}"/></DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="↵" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,4,0"
                                           Visibility="{Binding IsSelected, Converter={StaticResource Vis}}"/>
                                <Grid Width="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border CornerRadius="4" Width="32" Height="20" Background="{DynamicResource Bg.Chip}" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{Binding Icon, Converter={StaticResource IconImage}}" Width="22" Height="22" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <c:IconPresenter Icon="{Binding CustomIcon}" Size="20" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"
                                                     Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                                </Grid>
                                <StackPanel>
                                    <TextBlock infra:Highlight.Parts="{Binding NameParts}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock infra:Highlight.Parts="{Binding SynopsisParts}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="6,8,0,0" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource Text.Tertiary}">
                <TextBlock Text="↵ Starten" Margin="0,0,14,0"/>
                <TextBlock Text="Strg+↵ Admin" Margin="0,0,14,0"/>
                <TextBlock Text="Strg+Umschalt+↵ Anderer Benutzer" Margin="0,0,14,0"/>
                <TextBlock Text="Strg+R Remote" Margin="0,0,14,0"/>
                <TextBlock Text="Tab Volles Panel" Margin="0,0,14,0"/>
                <TextBlock Text="Esc Schließen"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
