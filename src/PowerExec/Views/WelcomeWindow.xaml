<Window x:Class="PowerExec.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Willkommen bei Power-Exec" Style="{StaticResource AppWindow}"
        Width="620" Height="520" MinWidth="520" MinHeight="460" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Themes/Fluent.xaml"/></ResourceDictionary.MergedDictionaries>
        <!-- Rand-Auswahl: Bildschirm mit markiertem Rand -->
        <Style x:Key="EdgeChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Width="120" Padding="10" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Bg.Card}">
                            <StackPanel>
                                <Grid Height="54" Background="{DynamicResource Bg.Subtle}">
                                    <Border x:Name="Strip" Background="{DynamicResource Accent}" CornerRadius="2"/>
                                </Grid>
                                <ContentPresenter Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Right">
                                <Setter TargetName="Strip" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Strip" Property="Width" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="0,10"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Left">
                                <Setter TargetName="Strip" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="Strip" Property="Width" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="0,10"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Top">
                                <Setter TargetName="Strip" Property="VerticalAlignment" Value="Top"/>
                                <Setter TargetName="Strip" Property="Height" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="20,0"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Bottom">
                                <Setter TargetName="Strip" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="Strip" Property="Height" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="20,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tip" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
      </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <!-- Fußzeile -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="24,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Subtle}" Content="Überspringen" Command="{Binding SkipCommand}"
                        ToolTip="Nichts ändern; später unter Einstellungen › Allgemein erneut starten" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource Btn.Standard}" Content="Zurück" Command="{Binding BackCommand}" MinWidth="96" />
                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding NextLabel}" Command="{Binding NextCommand}" MinWidth="96" Margin="8,0,0,0" IsDefault="True" />
                </StackPanel>
                <TextBlock Text="{Binding StepText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Schrittleiste -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="24,18,24,0">
            <Border x:Name="S0" Height="4" CornerRadius="2" Margin="0,0,6,0" Background="{DynamicResource Accent}"/>
            <Border Height="4" CornerRadius="2" Margin="0,0,6,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Bg.Chip}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep0}" Value="False"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border Height="4" CornerRadius="2" Margin="0,0,6,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep0}" Value="True"><Setter Property="Background" Value="{DynamicResource Bg.Chip}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsStep1}" Value="True"><Setter Property="Background" Value="{DynamicResource Bg.Chip}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border Height="4" CornerRadius="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Bg.Chip}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </UniformGrid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,12">
            <Grid>
                <!-- 1: Scripte -->
                <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource Vis}}">
                    <TextBlock Text="Wo liegen deine Scripte?" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,6,0,16"
                               Text="Power-Exec liest einen Ordner mit Scripten und Programmen ein und zeigt sie als smarte Gruppe im Panel. Neue Dateien erscheinen automatisch. Webseiten, Ordner, RDP und SSH legst du später per Rechtsklick im Panel an."/>
                    <ui:Button Style="{StaticResource Btn.Accent}" HorizontalAlignment="Left" Command="{Binding ChooseFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Ordner auswählen …"/>
                        </StackPanel>
                    </ui:Button>
                    <TextBlock Text="{Binding Folder, StringFormat=Gewählt: {0}}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasFolder, Converter={StaticResource Vis}}"/>
                    <CheckBox Content="Oder: Beispielordner mit Beispielscripten anlegen (Dokumente › Power-Exec › Scripte)" IsChecked="{Binding CreateSample}" Margin="0,16,0,0"
                              Visibility="{Binding HasFolder, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <TextBlock Text="{Binding ExistingFoldersText}" Style="{StaticResource Tip}" Margin="0,16,0,0"
                               Visibility="{Binding HasExistingFolders, Converter={StaticResource Vis}}"/>
                </StackPanel>

                <!-- 2: Rand -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource Vis}}">
                    <TextBlock Text="An welchem Rand soll das Panel erscheinen?" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,6,0,16"
                               Text="Fährt die Maus an diesen Rand, gleitet das Panel nach einer kurzen Verweilzeit heraus. Monitor, Länge und Verweilzeit stellst du später unter Panel › Verhalten ein."/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Left" Content="Links" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Left"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Left}"/>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Right" Content="Rechts" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Right"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Right}"/>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Top" Content="Oben" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Top"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Top}"/>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Bottom" Content="Unten" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Bottom"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Bottom}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding EdgeText}" Style="{StaticResource Tip}"/>
                </StackPanel>

                <!-- 3: Tastenkürzel und Start -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource Vis}}">
                    <TextBlock Text="Schneller per Tastatur" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,6,0,16"
                               Text="Mit dem Tastenkürzel öffnet sich das Panel überall, der Cursor steht im Suchfeld. Tippen, Enter – fertig."/>
                    <Border Padding="14,10" CornerRadius="6" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tastenkürzel:" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="HotkeyBox" Width="220" IsReadOnly="True" Text="{Binding HotkeyText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" AutomationProperties.Name="Tastenkürzel"
                                         ToolTip="Klicken und die gewünschte Tastenkombination drücken; Entf entfernt das Kürzel"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="Standard" Margin="8,0,0,0" Command="{Binding ResetHotkeyCommand}"
                                           ToolTip="Strg+Alt+Leertaste"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Tip}" Margin="0,6,0,0" Text="Zum Ändern ins Feld klicken und die Kombination drücken."/>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Mit Windows starten" IsChecked="{Binding StartWithWindows}" Margin="0,18,0,0"/>
                    <CheckBox Content="Akzentfarbe von Windows übernehmen" IsChecked="{Binding UseWindowsAccent}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 4: Fertig -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource Vis}}">
                    <TextBlock Text="Alles bereit" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,6,0,16" Text="Mit „Fertig“ wird alles übernommen und das Panel öffnet sich einmal zur Probe. Ein paar Tipps für den Anfang:"/>
                    <TextBlock Style="{StaticResource Tip}" Text="• Suchen: einfach tippen – auch Anfangsbuchstaben („gds“) und Filter wie typ:ps1 oder #schlagwort."/>
                    <TextBlock Style="{StaticResource Tip}" Text="• Enter startet, Strg+Enter als Administrator, Leertaste zeigt eine Vorschau."/>
                    <TextBlock Style="{StaticResource Tip}" Text="• Rechtsklick auf eine freie Fläche: neue Gruppe, Webseite, RDP, SSH, Snippet …"/>
                    <TextBlock Style="{StaticResource Tip}" Text="• Dateien und Links aus dem Explorer oder Browser einfach ins Panel ziehen."/>
                    <TextBlock Style="{StaticResource Tip}" Text="• F1 im Panel zeigt alle Tastenkürzel."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
