<Window x:Class="PowerExec.Desktop.Views.WelcomeWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Welcome to Power-Exec'}" Style="{StaticResource AppWindow}"
        Width="620" Height="520" MinWidth="520" MinHeight="460" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary>
        <!-- Rand-Auswahl: Bildschirm mit markiertem Rand -->
        <Style x:Key="EdgeChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Width="120" Padding="12" CornerRadius="{DynamicResource Radius.Card}" BorderThickness="2" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Bg.Card}">
                            <StackPanel>
                                <Grid Height="54" Background="{DynamicResource Bg.Subtle}">
                                    <Border x:Name="Strip" Background="{DynamicResource Accent}" CornerRadius="{DynamicResource Radius.Bar}"/>
                                </Grid>
                                <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Right">
                                <Setter TargetName="Strip" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Strip" Property="Width" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="0,10"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Left">
                                <Setter TargetName="Strip" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="Strip" Property="Width" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="0,10"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Top">
                                <Setter TargetName="Strip" Property="VerticalAlignment" Value="Top"/>
                                <Setter TargetName="Strip" Property="Height" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="20,0"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Bottom">
                                <Setter TargetName="Strip" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="Strip" Property="Height" Value="5"/>
                                <Setter TargetName="Strip" Property="Margin" Value="20,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tip" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
      </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <!-- Fußzeile -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Default}" Padding="24,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" Style="{StaticResource Btn.Subtle}" Content="{l:T 'Skip'}" Command="{Binding SkipCommand}"
                        ToolTip="{l:T 'Change nothing; run again later under Settings › General'}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Back'}" Command="{Binding BackCommand}" MinWidth="96" />
                    <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding NextLabel}" Command="{Binding NextCommand}" MinWidth="96" Margin="8,0,0,0" IsDefault="True" />
                </StackPanel>
                <TextBlock Text="{Binding StepText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" FontSize="{StaticResource Font.Body}"/>
            </DockPanel>
        </Border>

        <!-- Schrittleiste -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="24,20,24,0">
            <Border x:Name="S0" Height="4" CornerRadius="{DynamicResource Radius.Bar}" Margin="0,0,8,0" Background="{DynamicResource Accent}"/>
            <Border Height="4" CornerRadius="{DynamicResource Radius.Bar}" Margin="0,0,8,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Bg.Chip}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep0}" Value="False"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border Height="4" CornerRadius="{DynamicResource Radius.Bar}" Margin="0,0,8,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep0}" Value="True"><Setter Property="Background" Value="{DynamicResource Bg.Chip}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsStep1}" Value="True"><Setter Property="Background" Value="{DynamicResource Bg.Chip}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border Height="4" CornerRadius="{DynamicResource Radius.Bar}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Bg.Chip}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </UniformGrid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,12">
            <Grid>
                <!-- 1: Scripte -->
                <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Where are your scripts?'}" FontSize="{StaticResource Font.Header}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,8,0,16"
                               Text="{l:T 'Power-Exec scans a folder with scripts and programs and shows them as a smart group in the panel. New files appear automatically. You add websites, folders, RDP and SSH later with a right-click in the panel.'}"/>
                    <ui:Button Style="{StaticResource Btn.Accent}" HorizontalAlignment="Left" Command="{Binding ChooseFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T 'Select folder …'}"/>
                        </StackPanel>
                    </ui:Button>
                    <TextBlock Text="{Binding Folder, StringFormat=Gewählt: {0}}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasFolder, Converter={StaticResource Vis}}"/>
                    <CheckBox IsChecked="{Binding CreateSample}" Margin="0,16,0,0">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{l:T 'Create sample scripts'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{l:T 'Eight ready-made scripts (system info, network test, disk space, large files, installed programs, error log, temp cleanup, passwords) under Documents › Power-Exec › Scripts – shown in the panel as the group “Examples”.'}" Foreground="{DynamicResource Text.Secondary}"/>
                        </TextBlock>
                    </CheckBox>
                    <TextBlock Text="{Binding ExistingFoldersText}" Style="{StaticResource Tip}" Margin="0,16,0,0"
                               Visibility="{Binding HasExistingFolders, Converter={StaticResource Vis}}"/>
                </StackPanel>

                <!-- 2: Rand -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'On which edge should the panel appear?'}" FontSize="{StaticResource Font.Header}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,8,0,16"
                               Text="{l:T 'When the mouse reaches this edge, the panel slides out after a short dwell time. You can set the monitor, length and dwell time later under Panel › Behavior.'}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Left" Content="{l:T 'Left'}" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Left"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Left}"/>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Right" Content="{l:T 'Right'}" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Right"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Right}"/>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Top" Content="{l:T 'Top'}" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Top"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Top}"/>
                        <RadioButton Style="{StaticResource EdgeChoice}" Tag="Bottom" Content="{l:T 'Bottom'}" GroupName="Edge" Command="{Binding SetEdgeCommand}" CommandParameter="Bottom"
                                     IsChecked="{Binding Edge, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Bottom}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding EdgeText}" Style="{StaticResource Tip}"/>
                </StackPanel>

                <!-- 3: Tastenkürzel und Start -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'Faster with the keyboard'}" FontSize="{StaticResource Font.Header}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,8,0,16"
                               Text="{l:T 'With the hotkey the panel opens anywhere, the cursor is in the search box. Type, Enter – done.'}"/>
                    <Border Padding="16,12" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Hotkey:'}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="HotkeyBox" Width="220" IsReadOnly="True" Text="{Binding HotkeyText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" AutomationProperties.Name="{l:T 'Hotkey'}"
                                         ToolTip="{l:T 'Click and press the desired key combination; Del removes the shortcut'}"/>
                                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Default'}" Margin="8,0,0,0" Command="{Binding ResetHotkeyCommand}"
                                           ToolTip="{l:T 'Ctrl+Alt+Space'}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Tip}" Margin="0,8,0,0" Text="{l:T 'To change it, click into the field and press the combination.'}"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="{l:T 'Start with Windows'}" IsChecked="{Binding StartWithWindows}" Margin="0,20,0,0"/>
                    <CheckBox Content="{l:T 'Use Windows accent color'}" IsChecked="{Binding UseWindowsAccent}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- 4: Fertig -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource Vis}}">
                    <TextBlock Text="{l:T 'All set'}" FontSize="{StaticResource Font.Header}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Tip}" Margin="0,8,0,16" Text="{l:T '“Done” applies everything and opens the panel once as a trial. A few tips to get started:'}"/>
                    <TextBlock Style="{StaticResource Tip}" Text="{l:T '• Search: just type – initials too (“gds”) and filters like type:ps1 or #tag.'}"/>
                    <TextBlock Style="{StaticResource Tip}" Text="{l:T '• Enter runs, Ctrl+Enter as administrator, Space shows a preview.'}"/>
                    <TextBlock Style="{StaticResource Tip}" Text="{l:T '• Right-click an empty area: new group, website, RDP, SSH, snippet …'}"/>
                    <TextBlock Style="{StaticResource Tip}" Text="{l:T '• Simply drag files and links from Explorer or the browser into the panel.'}"/>
                    <TextBlock Style="{StaticResource Tip}" Text="{l:T '• F1 in the panel shows all keyboard shortcuts.'}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
