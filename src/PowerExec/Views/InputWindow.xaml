<Window x:Class="PowerExec.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power-Exec" Style="{StaticResource AppWindow}"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="Prompt" Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96"/>
            <Button x:Name="OkButton" Style="{StaticResource Btn.Accent}" Content="OK" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
