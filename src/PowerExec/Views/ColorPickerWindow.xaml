<Window x:Class="PowerExec.Views.ColorPickerWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{l:T 'Farbe wählen'}" Style="{StaticResource AppWindow}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary Source="/Themes/Fluent.xaml"/>
    </Window.Resources>
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{l:T 'Im Feld ziehen für Sättigung und Helligkeit, darunter den Farbton wählen – oder eine Vorlage bzw. #RRGGBB.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <!-- Sättigung (waagerecht) und Helligkeit (senkrecht) -->
        <Border CornerRadius="6" ClipToBounds="True" Height="180" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1">
            <Grid x:Name="SvArea" Background="Transparent" Cursor="Cross"
                  MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp">
                <Rectangle x:Name="HueFill" Fill="Red"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Farbton -->
        <Grid Height="18" Margin="0,10,0,0">
            <Border CornerRadius="4" Margin="0,3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Opacity="0.9" VerticalAlignment="Center" ValueChanged="Hue_ValueChanged"
                    AutomationProperties.Name="{l:T 'Farbton'}"/>
        </Grid>

        <!-- Vorlagen -->
        <ItemsControl x:Name="Presets" Margin="0,12,0,0" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" Cursor="Hand" ToolTip="{Binding Name}" Click="Preset_Click" Tag="{Binding Hex}"
                            AutomationProperties.Name="{Binding Name}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Sw" CornerRadius="13" Background="{Binding Hex, Converter={StaticResource HexBrush}}" BorderThickness="2" BorderBrush="Transparent"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource Text.Primary}"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Vorschau und Wert -->
        <DockPanel Margin="0,6,0,0">
            <Border x:Name="Preview" DockPanel.Dock="Left" Width="44" Height="32" CornerRadius="4" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" Margin="0,0,10,0"/>
            <TextBox x:Name="HexBox" Height="32" Padding="8,0" FontFamily="{StaticResource MonoFont}" TextChanged="Hex_TextChanged" AutomationProperties.Name="{l:T 'Farbwert #RRGGBB'}"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" Text="{l:T 'Bitte als #RRGGBB angeben, z. B. #3B82F6.'}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Abbrechen'}" IsCancel="True" MinWidth="96" />
            <ui:Button x:Name="OkButton" Style="{StaticResource Btn.Accent}" Content="{l:T 'Übernehmen'}" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
