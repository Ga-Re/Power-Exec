<Window x:Class="PowerExec.Views.PlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power-Exec" Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Werte für diesen Start eingeben." Style="{StaticResource Caption}" Margin="0,2,0,12"/>
        <ItemsControl x:Name="Fields" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox IsEditable="True" ItemsSource="{Binding History}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Zuletzt verwendete Werte über den Pfeil" Loaded="Field_Loaded"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource Btn.Standard}" Content="Abbrechen" IsCancel="True" MinWidth="96"/>
            <Button Style="{StaticResource Btn.Accent}" Content="Starten" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
