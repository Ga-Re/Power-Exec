<Window x:Class="PowerExec.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        Title="Power-Exec Mini-Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False" Focusable="False">
    <Window.Resources>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary Source="/Themes/Fluent.xaml"/>
    </Window.Resources>
    <Border x:Name="DockBorder" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Panel}" BorderThickness="1" Padding="3">
        <ItemsControl x:Name="Slots" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel x:Name="SlotPanel" Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="32" Height="32" Margin="1,2" Padding="0" Cursor="Hand" ToolTip="{Binding ToolTip}" Command="{Binding Command}"
                            AutomationProperties.Name="{Binding Name}" MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Pressed}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <!-- Programmsymbol, eigenes Symbol oder Typ-Kürzel -->
                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                            <c:IconPresenter Icon="{Binding CustomIcon}" Size="20" Foreground="{DynamicResource Text.Primary}"
                                             Visibility="{Binding HasCustomIcon, Converter={StaticResource Vis}}"/>
                            <Border CornerRadius="4" Width="28" Height="18" Background="{DynamicResource Bg.Chip}" Visibility="{Binding ShowBadge, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                            </Border>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Secondary}" Visibility="{Binding IsMore, Converter={StaticResource Vis}}"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
