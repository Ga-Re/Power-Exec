<UserControl x:Class="PowerExec.Views.CustomEntryForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PowerExec.Controls">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Resources>
    <!-- Felder eines eigenen Eintrags (Art, Ziel, Code, Browser, SSH …) – im Eintragsdialog oben -->
    <StackPanel>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Content="Testen" Command="{Binding TestCommand}" VerticalAlignment="Center"
                    ToolTip="Ohne Speichern starten (nicht bei Platzhaltern)"/>
                <Button DockPanel.Dock="Left" Width="44" Height="44" Style="{StaticResource Btn.Standard}" Padding="0" Margin="0,0,12,0"
                        Command="{Binding ChooseIconCommand}" ToolTip="Symbol wählen (Fluent 2, Heroicons, Emoji, eigenes Bild)">
                    <Grid>
                        <c:IconPresenter Icon="{Binding Icon}" Size="26" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    </Grid>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Symbol" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Style="{StaticResource Btn.Subtle}" Content="Symbol wählen …" Command="{Binding ChooseIconCommand}" FontSize="12" Padding="6,0" MinHeight="24" Height="24"/>
                        <Button Style="{StaticResource Btn.Subtle}" Content="Automatisch" Command="{Binding ClearIconCommand}" FontSize="12" Padding="6,0" MinHeight="24" Height="24"
                                ToolTip="Favicon, Programm- oder Ordnersymbol verwenden"/>
                    </StackPanel>
                </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Art" Style="{StaticResource Label}"/>
            <ComboBox Grid.Column="1" Style="{StaticResource Combo}" ItemsSource="{Binding KindList}" SelectedValue="{Binding Kind}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KindHelp}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding KindHelp, Converter={StaticResource Vis}}"/>

            <TextBlock Grid.Row="2" Text="Name" Style="{StaticResource Label}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Anzeigename im Panel" Margin="0,3"/>

            <!-- Ziel -->
            <TextBlock Grid.Row="3" Text="{Binding TargetLabel}" Style="{StaticResource Label}" Visibility="{Binding HasTarget, Converter={StaticResource Vis}}"/>
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3" Visibility="{Binding HasTarget, Converter={StaticResource Vis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseCommand}" Margin="8,0,0,0"
                        Visibility="{Binding CanBrowse, Converter={StaticResource Vis}}"/>
                <TextBox x:Name="TargetBox" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
            </DockPanel>

            <!-- SSH / RDP -->
            <TextBlock Grid.Row="4" Text="Benutzer" Style="{StaticResource Label}" Visibility="{Binding IsSsh, Converter={StaticResource Vis}}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Width="280" HorizontalAlignment="Left" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Tag="z. B. root oder admin"
                     Margin="0,3" Visibility="{Binding IsSsh, Converter={StaticResource Vis}}"/>
            <TextBlock Grid.Row="5" Text="Port" Style="{StaticResource Label}" Visibility="{Binding HasPort, Converter={StaticResource Vis}}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Tag="Standard"
                     Margin="0,3" Visibility="{Binding HasPort, Converter={StaticResource Vis}}"/>
            <TextBlock Grid.Row="6" Text="Schlüsseldatei" Style="{StaticResource Label}" Visibility="{Binding IsSsh, Converter={StaticResource Vis}}"/>
            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3" Visibility="{Binding IsSsh, Converter={StaticResource Vis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseKeyCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" Tag="optional (id_ed25519, .ppk für PuTTY)" FontFamily="{StaticResource MonoFont}"/>
            </DockPanel>
            <TextBlock Grid.Row="7" Text="Programm" Style="{StaticResource Label}" Visibility="{Binding IsSsh, Converter={StaticResource Vis}}"/>
            <ComboBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Combo}" ItemsSource="{Binding ClientList}" SelectedValue="{Binding Client}"
                      Visibility="{Binding IsSsh, Converter={StaticResource Vis}}"/>

            <!-- Webseite -->
            <TextBlock Grid.Row="8" Text="Browser" Style="{StaticResource Label}" Visibility="{Binding IsUrl, Converter={StaticResource Vis}}"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Visibility="{Binding IsUrl, Converter={StaticResource Vis}}">
                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding BrowserList}" SelectedValue="{Binding Browser}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3" Visibility="{Binding HasBrowserOptions, Converter={StaticResource Vis}}">
                    <CheckBox Content="Privates Fenster (InPrivate/Inkognito)" IsChecked="{Binding Private}" VerticalAlignment="Center"/>
                    <TextBox Width="170" Margin="16,0,0,0" Text="{Binding BrowserProfile, UpdateSourceTrigger=PropertyChanged}" Tag="Profil, z. B. Profile 1"
                             ToolTip="Edge/Chrome: Name des Profilordners (Default, Profile 1 …), Firefox: Profilname"/>
                </StackPanel>
            </StackPanel>

            <!-- Snippet -->
            <TextBlock Grid.Row="9" Text="Sprache" Style="{StaticResource Label}" Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}">
                <ComboBox Style="{StaticResource Combo}" Width="170" ItemsSource="{Binding LanguageList}" SelectedValue="{Binding Language}"/>
                <ComboBox Style="{StaticResource Combo}" Width="250" Margin="8,3,0,3" ItemsSource="{Binding ActionList}" SelectedValue="{Binding Action}"
                          ToolTip="Was ein Klick im Panel macht" Visibility="{Binding IsPowerShellSnippet, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <TextBlock Grid.Row="10" Text="Code" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}"/>
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     Height="190" Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,3"
                     Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}"/>

            <TextBlock Grid.Row="11" Text="Argumente" Style="{StaticResource Label}" Visibility="{Binding HasArguments, Converter={StaticResource Vis}}"/>
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Tag="optional" Margin="0,3"
                     FontFamily="{StaticResource MonoFont}" Visibility="{Binding HasArguments, Converter={StaticResource Vis}}"/>
            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding PlaceholderInfo}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
        </Grid>
    </StackPanel>
</UserControl>
