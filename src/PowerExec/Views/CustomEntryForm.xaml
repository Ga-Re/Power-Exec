<UserControl x:Class="PowerExec.Views.CustomEntryForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:PowerExec.Controls">
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Themes/Fluent.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Status.Error}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DisplayMemberPath" Value="Value"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="260"/>
        </Style>
        <Style x:Key="SegHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Chips zum Einfügen eingebauter Variablen -->
        <DataTemplate x:Key="BuiltinChip">
            <ui:Button Style="{StaticResource Btn.Subtle}" Content="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="6,0" Height="24" MinHeight="24"
                    Margin="0,0,4,4" Click="InsertIntoCode_Click" Tag="{Binding}" ToolTip="An der Cursorposition einfügen" />
        </DataTemplate>
      </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Kopf des Abschnitts: Art + Testen -->
        <DockPanel Margin="0,0,0,2" Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Command="{Binding TestCommand}" VerticalAlignment="Center"
                    ToolTip="Ohne Speichern einmal starten (mit dem eingestellten Standardverhalten; nicht bei abzufragenden Platzhaltern)">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Testen"/></StackPanel>
            </ui:Button>
            <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ===== Webseite ===== -->
        <StackPanel Visibility="{Binding IsUrl, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Titel abrufen" Command="{Binding FetchTitleCommand}" Margin="6,0,0,0"
                            ToolTip="Seitentitel als Anzeigename übernehmen" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{}{{…}}" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}"
                            Click="InsertPlaceholder_Click" ToolTip="Platzhalter einfügen – wird beim Start abgefragt, z. B. https://ticket/{{Nummer}}" />
                    <TextBox x:Name="UrlBox" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
                <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding TitleStatus}" Style="{StaticResource Hint}" Visibility="{Binding TitleStatus, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding PlaceholderInfo}" Style="{StaticResource Hint}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <TextBlock Text="Browser und Profil" Style="{StaticResource FieldLabel}"/>
                <WrapPanel>
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding BrowserList}" SelectedValue="{Binding Browser}" Margin="0,0,16,6"/>
                    <CheckBox Content="Privates Fenster" IsChecked="{Binding Private}" VerticalAlignment="Center" Margin="0,0,16,6"
                              Visibility="{Binding HasBrowserOptions, Converter={StaticResource Vis}}"/>
                    <ComboBox Style="{StaticResource Combo}" Width="260" ItemsSource="{Binding BrowserProfileList}" SelectedValue="{Binding BrowserProfile}" Margin="0,0,0,6"
                              ToolTip="Gefundene Profile des Browsers" Visibility="{Binding HasBrowserProfiles, Converter={StaticResource Vis}}"/>
                </WrapPanel>
                <CheckBox Content="Als App-Fenster öffnen (ohne Tabs und Adressleiste)" IsChecked="{Binding AppWindow}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding AppWindowHint}" Style="{StaticResource Hint}" Visibility="{Binding AppWindowHint, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Ordner ===== -->
        <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Pfad" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
                <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding TargetStatus}" Style="{StaticResource Hint}" Visibility="{Binding TargetStatus, Converter={StaticResource Vis}}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <TextBlock Text="Öffnen mit" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Explorer" Width="110" IsChecked="{Binding OpenWith, Converter={StaticResource Eq}, ConverterParameter=Explorer}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Neues Fenster" Width="110" IsChecked="{Binding OpenWith, Converter={StaticResource Eq}, ConverterParameter=NewWindow}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Programm" Width="110" IsChecked="{Binding OpenWith, Converter={StaticResource Eq}, ConverterParameter=Program}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Terminal" Width="110" IsChecked="{Binding OpenWith, Converter={StaticResource Eq}, ConverterParameter=Terminal}"/>
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding IsOpenWithProgram, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseOpenWithCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding OpenWithProgram, UpdateSourceTrigger=PropertyChanged}" Tag="z. B. C:\Program Files\totalcmd\TOTALCMD64.EXE" FontFamily="{StaticResource MonoFont}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OpenWithProgramError}" Style="{StaticResource FieldError}" Visibility="{Binding OpenWithProgramError, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ===== Remotedesktop ===== -->
        <StackPanel Visibility="{Binding IsRdp, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource SegHost}" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Verbindung angeben" Width="170" IsChecked="{Binding UseRdpFields}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Vorhandene .rdp-Datei" Width="170" IsChecked="{Binding UseRdpFile}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding UseRdpFields, Converter={StaticResource Vis}}">
                <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Rechner" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding PortHint}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding PortError}" Style="{StaticResource FieldError}" Visibility="{Binding PortError, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Benutzer (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Tag="FIRMA\admin – nur vorbelegt, ohne Kennwort"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RD-Gateway (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" Tag="gateway.firma.de"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Anzeige" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel>
                        <Border Style="{StaticResource SegHost}" Margin="0,0,12,6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Standard" Width="100" IsChecked="{Binding Screen, Converter={StaticResource Eq}, ConverterParameter=Default}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Vollbild" Width="100" IsChecked="{Binding Screen, Converter={StaticResource Eq}, ConverterParameter=Fullscreen}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Fenster" Width="100" IsChecked="{Binding Screen, Converter={StaticResource Eq}, ConverterParameter=Window}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6" Visibility="{Binding IsRdpWindow, Converter={StaticResource Vis}}">
                            <TextBox Width="80" Text="{Binding ScreenWidthText, UpdateSourceTrigger=PropertyChanged}" Tag="1600"/>
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBox Width="80" Text="{Binding ScreenHeightText, UpdateSourceTrigger=PropertyChanged}" Tag="900"/>
                        </StackPanel>
                        <CheckBox Content="Alle Monitore verwenden" IsChecked="{Binding AllMonitors}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ScreenSizeError}" Style="{StaticResource FieldError}" Visibility="{Binding ScreenSizeError, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <StackPanel Visibility="{Binding UseRdpFile, Converter={StaticResource Vis}}">
                    <TextBlock Text=".rdp-Datei" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseRdpFileCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding RdpFile, UpdateSourceTrigger=PropertyChanged}" Tag="\\server\verbindungen\Server A.rdp" FontFamily="{StaticResource MonoFont}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding RdpFileError}" Style="{StaticResource FieldError}" Visibility="{Binding RdpFileError, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="Alle Einstellungen (Rechner, Anzeige, Gateway …) kommen aus der Datei." Style="{StaticResource Hint}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <CheckBox Content="Admin-Sitzung (/admin, Konsolensitzung)" IsChecked="{Binding AdminSession}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding RdpHint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== SSH ===== -->
        <StackPanel Visibility="{Binding IsSsh, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Rechner" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding PortHint}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding PortError}" Style="{StaticResource FieldError}" Visibility="{Binding PortError, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <TextBlock Text="Benutzer" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Tag="root" Width="260" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Schlüsseldatei (optional)" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseKeyCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" Tag="%USERPROFILE%\.ssh\id_ed25519" FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Öffnen in" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource Combo}" Width="220" ItemsSource="{Binding ClientList}" SelectedValue="{Binding Client}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Visibility="{Binding IsTerminalClient, Converter={StaticResource Vis}}">
                        <TextBlock Text="Windows-Terminal-Profil (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TerminalProfile, UpdateSourceTrigger=PropertyChanged}" Tag="z. B. „Produktion“ – eigenes Farbschema"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Befehl nach dem Login (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding RemoteCommand, UpdateSourceTrigger=PropertyChanged}" Tag="z. B. sudo -i  oder  tail -f /var/log/syslog" FontFamily="{StaticResource MonoFont}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sprungserver (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding JumpHost, UpdateSourceTrigger=PropertyChanged}" Tag="admin@bastion.firma.de" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port-Weiterleitung (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortForward, UpdateSourceTrigger=PropertyChanged}" Tag="8080:localhost:80; 5432:db:5432" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PortForwardError}" Style="{StaticResource FieldError}" Visibility="{Binding PortForwardError, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Weitere Argumente (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Tag="z. B. -o ServerAliveInterval=30" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <TextBlock Text="Kennwörter werden nicht gespeichert – SSH fragt sie beim Verbinden ab." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== PowerShell-Snippet ===== -->
        <StackPanel Visibility="{Binding IsPsSnippet, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Code" Style="{StaticResource FieldLabel}"/>
                <Border BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Bg.Code}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="LineScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" Height="{Binding ActualHeight, ElementName=PsCodeBox}">
                            <TextBlock Text="{Binding LineNumbers}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource Text.Tertiary}"
                                       TextAlignment="Right" Padding="8,7,8,7" MinWidth="34"/>
                        </ScrollViewer>
                        <TextBox x:Name="PsCodeBox" Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, Delay=200}" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13" MinHeight="220" MaxHeight="420" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="6"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.ScrollChanged="CodeBox_ScrollChanged"
                                 Tag="param([string]$Rechner = 'localhost')&#x0a;Test-Connection $Rechner -Count 1"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding CodeError}" Style="{StaticResource FieldError}" Visibility="{Binding CodeError, Converter={StaticResource Vis}}"/>
                <ItemsControl ItemsSource="{Binding SyntaxErrors}" Focusable="False" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap">
                                <Run Text="{Binding Line, Mode=OneWay, StringFormat=Zeile {0}:}"/> <Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ParameterPreview}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                <TextBlock Text="Eingebaute Variablen" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding Builtins}" ItemTemplate="{StaticResource BuiltinChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False"/>
                <TextBlock Text="{Binding PlaceholderInfo}" Style="{StaticResource Hint}"/>
                <CheckBox Content="Beim Klick nur in die Zwischenablage kopieren (statt ausführen)" IsChecked="{Binding CopyInsteadOfRun}" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Text-Snippet ===== -->
        <StackPanel Visibility="{Binding IsTextSnippet, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TextCodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, Delay=200}" AcceptsReturn="True" AcceptsTab="True"
                         MinHeight="180" MaxHeight="380" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,6"
                         Tag="Viele Grüße&#x0a;{{$Benutzer}}"/>
                <TextBlock Text="{Binding CodeError}" Style="{StaticResource FieldError}" Visibility="{Binding CodeError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="Variablen einfügen" Style="{StaticResource FieldLabel}"/>
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding Builtins}" ItemTemplate="{StaticResource BuiltinChip}" ItemsPanel="{StaticResource TagPanel}" Focusable="False"/>
                    <ui:Button Style="{StaticResource Btn.Subtle}" Content="{}{{Abfrage}}" FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="6,0" Height="24" MinHeight="24"
                            Margin="0,0,4,4" Click="InsertIntoCode_Click" Tag="{}{{Name}}" ToolTip="Platzhalter, der beim Kopieren abgefragt wird" />
                </WrapPanel>
                <TextBlock Text="{Binding PlaceholderInfo}" Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowOptions, Converter={StaticResource Vis}}">
                <CheckBox Content="Als formatierten Text (HTML) kopieren – z. B. für Outlook-Signaturen" IsChecked="{Binding CopyAsHtml}" Margin="0,12,0,0"/>
                <TextBlock Text="Der Text ist dann HTML (&lt;b&gt;fett&lt;/b&gt;, &lt;br&gt; …). Zusätzlich liegt er als reiner Text in der Zwischenablage." Style="{StaticResource Hint}" Margin="26,2,0,0"
                           Visibility="{Binding CopyAsHtml, Converter={StaticResource Vis}}"/>
                <CheckBox Content="Nach dem Kopieren direkt in das vorher aktive Fenster einfügen" IsChecked="{Binding PasteAfterCopy}" Margin="0,8,0,0"/>
                <TextBlock Text="Bei Fenstern, die mit Administratorrechten laufen, blockiert Windows das Einfügen – dann bleibt der Text nur kopiert." Style="{StaticResource Hint}" Margin="26,2,0,0"
                           Visibility="{Binding PasteAfterCopy, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Windows-Werkzeug ===== -->
        <StackPanel Visibility="{Binding IsTool, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Werkzeug auswählen" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <TextBox Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="28,0,8,0" Tag="Suchen: Dienste, DNS, Firewall, ms-settings …"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
                </Grid>
                <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                    <ListBox ItemsSource="{Binding ToolChoices}" Height="190" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             x:Name="ToolList" SelectionChanged="ToolList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <c:IconPresenter Icon="{Binding Icon}" Size="18" Foreground="{DynamicResource Text.Primary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Werkzeug" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Argumente (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="z. B. /computer=SRV-01"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Befehl ===== -->
        <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Programm" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
                <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding TargetStatus}" Style="{StaticResource Hint}" Visibility="{Binding TargetStatus, Converter={StaticResource Vis}}"/>
                <TextBlock Text="Argumente (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Tag="z. B. /k ipconfig /all  oder  {{Rechner}}"/>
                <TextBlock Text="{Binding PlaceholderInfo}" Style="{StaticResource Hint}"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Datei ===== -->
        <StackPanel Visibility="{Binding IsFile, Converter={StaticResource Vis}}">
            <StackPanel Visibility="{Binding ShowBase, Converter={StaticResource Vis}}">
                <TextBlock Text="Datei" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="Durchsuchen …" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="{Binding TargetHint}" FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
                <TextBlock Text="{Binding TargetError}" Style="{StaticResource FieldError}" Visibility="{Binding TargetError, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding TargetStatus}" Style="{StaticResource Hint}" Visibility="{Binding TargetStatus, Converter={StaticResource Vis}}"/>
                <TextBlock Text="Scripte verhalten sich wie gefundene Dateien: Parameter-Dialog, Remote, Startprofile." Style="{StaticResource Hint}"/>
            </StackPanel>
        </StackPanel>

        <!-- Befehl, Datei, Werkzeug: Arbeitsordner und Fenster -->
        <Grid>
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsProgramLike}" Value="True"/><Condition Binding="{Binding ShowOptions}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Arbeitsordner (optional)" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="…" Command="{Binding BrowseWorkDirCommand}" Margin="6,0,0,0" Width="34" ToolTip="Ordner wählen" />
                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Tag="leer = automatisch" FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Fenster" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource Combo}" Width="160" ItemsSource="{Binding WindowStateList}" SelectedValue="{Binding WindowState}"/>
            </StackPanel>
        </Grid>

        <!-- Hinweise, die das Speichern nicht verhindern -->
        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource Warn.Bg}" BorderBrush="{DynamicResource Warn.Border}" BorderThickness="1"
                Visibility="{Binding Warnings, Converter={StaticResource Vis}}">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Status.Warning}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="12"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
