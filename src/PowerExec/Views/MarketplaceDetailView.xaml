<!--
    Detailseite eines Marktplatz-Eintrags (Datenkontext: MarketplaceViewModel, Inhalt: OpenItem).
    Designs: links eine feste Spalte mit „← Entdecken“, großer Live-Vorschau und dem Umschalter hell/dunkel; rechts (scrollt)
    Kopf mit allen Aktionen, Farben, Gruppenpalette, Schrift sowie Form und Hintergrund. Ist es schmal, steht die linke
    Spalte als Block über dem Inhalt (MarketplaceDetailView.xaml.cs).
    Einträge und Scripte: Kopf mit Aktionen, darunter was sie ausführen und welche Variablen sie brauchen.
-->
<UserControl x:Class="PowerExec.Desktop.Views.MarketplaceDetailView"
             xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
             xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
             xmlns:vm="clr-namespace:PowerExec.UI.ViewModels;assembly=PowerExec.UI.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <infra:CornerRadiusConverter x:Key="Radius"/>

        <!-- Karte eines Abschnitts -->
        <Style x:Key="DetailCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>

        <!-- Zeile einer Variante (Farben, Gruppenpalette): die gezeigte ist hervorgehoben, die andere tritt zurück; ein Klick zeigt sie -->
        <Style x:Key="VariantRow" TargetType="Border">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="infra:NavigationMotion.FadeTo" Value="0.62"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="infra:NavigationMotion.FadeTo" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Farbfeld: Name, Farbe, Hexwert; Klick kopiert den Hexwert -->
        <DataTemplate x:Key="SwatchTemplate" DataType="{x:Type vm:DesignSwatch}">
            <Button Click="Swatch_Click" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="{l:T 'Click to copy'}" AutomationProperties.Name="{Binding Name}" FocusVisualStyle="{StaticResource FocusVisual}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Padding="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                <Border Height="30" Margin="0,4" CornerRadius="{DynamicResource Radius.Control}" Background="{Binding Color, Converter={StaticResource ArgbBrush}}"
                                        BorderBrush="{DynamicResource Border.Control}" BorderThickness="1"/>
                                <TextBlock Text="{Binding Hex}" FontSize="{StaticResource Font.Caption}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Text.Tertiary}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Beispielgruppe: Farbbalken links, Name in der Gruppenfarbe, getönte Fläche -->
        <DataTemplate x:Key="PillTemplate" DataType="{x:Type vm:DesignGroupPill}">
            <Border Background="{Binding Background, Converter={StaticResource ArgbBrush}}" BorderBrush="{Binding Border, Converter={StaticResource ArgbBrush}}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Control}" Padding="8,6" ToolTip="{Binding Hex}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" Height="14" CornerRadius="{DynamicResource Radius.Bar}" Background="{Binding Color, Converter={StaticResource ArgbBrush}}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Name}" Foreground="{Binding Color, Converter={StaticResource ArgbBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid DataContext="{Binding OpenItem}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linke Spalte (nur Designs): zurück, Live-Vorschau, hell/dunkel – scrollt nicht mit -->
        <Border x:Name="SideHost" Margin="24,20,0,24" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}">
            <DockPanel x:Name="Sidebar" Width="280">
                <ui:Button DockPanel.Dock="Top" Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Left" Margin="-8,0,0,12"
                           Content="{Binding DataContext.BackText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Border DockPanel.Dock="Bottom" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1" Padding="1" Margin="0,12,0,0" IsEnabled="{Binding HasBothVariants}" ToolTip="{Binding VariantHint}">
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource Segment}" GroupName="DesignDetailVariant" Content="{l:T '☀ Light'}" IsChecked="{Binding IsPreviewLight}"
                                     AutomationProperties.Name="{l:T 'Light variant'}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="DesignDetailVariant" Content="{l:T '☾ Dark'}" IsChecked="{Binding IsPreviewDark}"
                                     AutomationProperties.Name="{l:T 'Dark variant'}"/>
                    </UniformGrid>
                </Border>
                <c:DesignPreview x:Name="Preview" Detailed="True" Design="{Binding DesignPreset}" ShowDark="{Binding ShowsDark}" MinHeight="330"
                                 ToolTip="{Binding DesignBackdropText}"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,20,24,28">
                <!-- Schmal: die linke Spalte steht hier als Block über dem Inhalt -->
                <ContentControl x:Name="SideSlot" Focusable="False" Margin="0,0,0,16" Visibility="Collapsed"/>
                <ui:Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Left" Margin="-8,0,0,12"
                           Content="{Binding DataContext.BackText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Visibility="{Binding HasDesign, Converter={StaticResource Vis}, ConverterParameter=invert}"/>

                <!-- Kopf: Name und Angaben links, alle Aktionen rechts (wird es eng, darunter) -->
                <Grid x:Name="Hero" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Display}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MetaText}" FontSize="{StaticResource Font.BodyStrong}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Status.Success}" Margin="0,4,0,0"
                                   Visibility="{Binding IsEntryOrScript, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <WrapPanel x:Name="Actions" Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0">
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding TryCommand}" Margin="0,0,8,8" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Try out'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Margin="0,0,8,8"
                                   Visibility="{Binding ShowApply, Converter={StaticResource Vis}}"/>
                        <Border Height="{StaticResource Height.Control}" Padding="12,0" Margin="0,0,8,8" CornerRadius="{DynamicResource Radius.Control}"
                                Background="{DynamicResource Status.Success.Bg}" BorderBrush="{DynamicResource Status.Success.Border}" BorderThickness="1"
                                Visibility="{Binding IsActiveDesign, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T '✓ Active'}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>
                        <ui:Button Style="{StaticResource Btn.Accent}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" Margin="0,0,8,8"
                                   Visibility="{Binding ShowInstall, Converter={StaticResource Vis}}"/>
                        <ui:Button Style="{StaticResource Btn.Standard}" Command="{Binding UninstallCommand}" Margin="0,0,8,8" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Uninstall'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </Grid>

                <!-- Farben: je Variante sieben Felder, nebeneinander oder sauber umbrochen (4 + 3) -->
                <Border x:Name="ColorsCard" Style="{StaticResource DetailCard}" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Colors'}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding DesignColorRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DesignSwatchRow}">
                                    <Border Style="{StaticResource VariantRow}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}"/>
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ItemsControl ItemsSource="{Binding Swatches}" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><c:CardGridPanel MinItemWidth="84" MaxItemWidth="112" Gap="6" Balanced="True"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Gruppenpalette: je Variante sechs Beispielgruppen auf der Panelfläche (3 + 3, wenn es eng wird) -->
                <Border x:Name="GroupsCard" Style="{StaticResource DetailCard}" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T 'Group palette'}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding GroupPaletteHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DesignGroupRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DesignSwatchRow}">
                                    <Border Style="{StaticResource VariantRow}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}"/>
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border CornerRadius="{DynamicResource Radius.Control}" Background="{Binding Surface, Converter={StaticResource ArgbBrush}}" Padding="8">
                                                <ItemsControl ItemsSource="{Binding Pills}" ItemTemplate="{StaticResource PillTemplate}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><c:CardGridPanel MinItemWidth="102" MaxItemWidth="136" Gap="6" Balanced="True"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Schrift sowie Form und Hintergrund: nebeneinander ab etwa 680 px, sonst untereinander -->
                <c:CardGridPanel x:Name="BottomCards" MinItemWidth="332" Gap="16" Visibility="{Binding HasDesign, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource DetailCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Fonts'}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="{l:T 'Interface'}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{x:Static vm:MarketplaceItemRow.FontSample}" FontFamily="{Binding DesignFont}" FontSize="{StaticResource Font.Large}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding DesignFontText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <TextBlock Text="{l:T 'Code'}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                            <TextBlock Text="{x:Static vm:MarketplaceItemRow.CodeSample}" FontFamily="{Binding DesignMonoFont}" FontSize="{StaticResource Font.Subtitle}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding DesignMonoText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Form and background'}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <!-- Ecken: Fläche der Variante mit Akzentrahmen und dem Radius der Karten -->
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Left" Width="44" Height="32" Margin="0,0,12,0" BorderThickness="1.5"
                                        Background="{Binding PreviewSurface, Converter={StaticResource ArgbBrush}}" BorderBrush="{Binding PreviewAccent, Converter={StaticResource ArgbBrush}}"
                                        CornerRadius="{Binding PreviewCornerRadius, Converter={StaticResource Radius}}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Corners'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DesignFormText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Hintergrund: Schachbrett hinter der Fläche mit echter Deckkraft und Milchglas -->
                            <DockPanel Margin="0,0,0,12">
                                <Grid DockPanel.Dock="Left" Width="44" Height="32" Margin="0,0,12,0">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,44,32" RadiusX="{StaticResource Radius.Control.Value}" RadiusY="{StaticResource Radius.Control.Value}"/>
                                    </Grid.Clip>
                                    <Border Background="{DynamicResource Bg.Input}"/>
                                    <Path Fill="{DynamicResource Text.Tertiary}"
                                          Data="M0,0h8v8h-8z M16,0h8v8h-8z M32,0h8v8h-8z M8,8h8v8h-8z M24,8h8v8h-8z M40,8h8v8h-8z M0,16h8v8h-8z M16,16h8v8h-8z M32,16h8v8h-8z M8,24h8v8h-8z M24,24h8v8h-8z M40,24h8v8h-8z"/>
                                    <Border Background="{Binding PreviewSurface, Converter={StaticResource ArgbBrush}}" Opacity="{Binding PreviewOpacity}"/>
                                    <Border Background="White" Opacity="{Binding PreviewFrost}"/>
                                    <Border BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Background'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DesignBackgroundText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Akzentfarbe: eigene des Designs oder die von Windows -->
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="44" Height="32" Margin="0,0,12,0" CornerRadius="{DynamicResource Radius.Control}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding PreviewAccent, Converter={StaticResource ArgbBrush}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UsesWindowsAccent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T 'Accent color'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AccentText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </c:CardGridPanel>

                <!-- Einträge und Scripte: was sie ausführen, benötigte Variablen -->
                <Border x:Name="EntryCard" Style="{StaticResource DetailCard}" Visibility="{Binding IsEntryOrScript, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EntryKindText}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource Font.Body}"
                                 MaxHeight="420" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="VariablesCard" Style="{StaticResource DetailCard}" Visibility="{Binding HasVariables, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Required variables'}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding VariablesText}" FontSize="{StaticResource Font.Body}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
