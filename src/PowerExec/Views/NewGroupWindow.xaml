<Window x:Class="PowerExec.Views.NewGroupWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        Title="{l:T 'Power-Exec'}" Style="{StaticResource AppWindow}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary Source="/Themes/Fluent.xaml"/>
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Text="{l:T 'New group'}"/>
        <TextBlock x:Name="Prompt" Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="{l:T 'You then drag entries in with drag &amp; drop – also files, folders and links from Explorer or the browser.'}"/>

        <!-- Symbol und Name -->
        <TextBlock Text="{l:T 'Name and icon'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel>
            <ui:Button x:Name="IconButton" DockPanel.Dock="Left" Style="{StaticResource Btn.Standard}" Width="40" Height="34" MinHeight="34" Padding="0" Margin="0,0,8,0"
                    Click="Icon_Click" ToolTip="{l:T 'Choose icon or image'}" AutomationProperties.Name="{l:T 'Choose icon or image'}">
                <Grid>
                    <c:IconPresenter x:Name="IconPreview" Size="18" Foreground="{DynamicResource Text.Primary}" Visibility="Collapsed"/>
                    <TextBlock x:Name="IconPlaceholder" Text="&#xE8EC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Text.Tertiary}"/>
                </Grid>
            </ui:Button>
            <TextBox x:Name="NameBox" Tag="{l:T 'Group name'}" AutomationProperties.Name="{l:T 'Group name'}" TextChanged="NameBox_TextChanged"/>
        </DockPanel>

        <!-- Ordner: macht daraus eine smarte Gruppe -->
        <TextBlock Text="{l:T 'Folder (optional)'}" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <DockPanel>
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Content="{l:T 'Browse …'}" Margin="8,0,0,0" Click="Browse_Click" />
            <ui:Button x:Name="ClearFolderButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Margin="4,0,0,0"
                    Click="ClearFolder_Click" ToolTip="{l:T 'Remove folder'}" Visibility="Collapsed" AutomationProperties.Name="{l:T 'Remove folder'}">
                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
            </ui:Button>
            <TextBox x:Name="FolderBox" IsReadOnly="True" Tag="{l:T 'No folder'}" AutomationProperties.Name="{l:T 'Folder'}"/>
        </DockPanel>
        <TextBlock x:Name="FolderHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{l:T 'With a folder, the group automatically shows its scripts and programs – new files appear by themselves.'}"/>

        <!-- Farbe und Darstellung -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:T 'Color'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Margin="4,0,0,0" Click="CustomColor_Click"
                            ToolTip="{l:T 'Pick your own color in the color picker'}" AutomationProperties.Name="{l:T 'Custom color'}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="12"/>
                    </ui:Button>
                    <ComboBox x:Name="ColorBox" SelectedValuePath="Key" AutomationProperties.Name="{l:T 'Color'}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" Stroke="{DynamicResource Border.Control}" StrokeThickness="1"
                                             Fill="{Binding Key, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock Text="{Binding Value}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:T 'Appearance'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="LayoutBox" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="{l:T 'Appearance'}"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Status.Error}" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="96" />
            <ui:Button x:Name="OkButton" Style="{StaticResource Btn.Accent}" Content="{l:T 'Create'}" IsDefault="True" MinWidth="96" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
