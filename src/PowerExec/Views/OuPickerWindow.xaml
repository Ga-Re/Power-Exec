<Window x:Class="PowerExec.Desktop.Views.OuPickerWindow"
        xmlns:l="clr-namespace:PowerExec.Desktop.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:cfg="clr-namespace:PowerExec.Core.Config;assembly=PowerExec.Core"
        Title="{l:T 'Power-Exec'}" Style="{StaticResource AppWindow}"
        Width="560" Height="620" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T 'Select OU'}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"
                       Text="{l:T 'The group searches from this organizational unit (with all sub-OUs). The domain at the top stands for “everywhere”.'}"/>
            <TextBox x:Name="Filter" Tag="{l:T 'Filter OUs …'}" Margin="0,0,0,8" TextChanged="Filter_TextChanged" AutomationProperties.Name="{l:T 'Filter OUs'}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Selected" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Secondary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
                <ui:Button x:Name="Ok" Style="{StaticResource Btn.Accent}" Content="{l:T 'Apply'}" IsDefault="True" MinWidth="96" Click="Ok_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Bg.Card}">
            <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" SelectedItemChanged="Tree_SelectedItemChanged"
                      MouseDoubleClick="Tree_MouseDoubleClick" AutomationProperties.Name="{l:T 'OU tree'}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type cfg:OuNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="{StaticResource Icon.L}" Margin="0,0,8,0" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </DockPanel>
</Window>
