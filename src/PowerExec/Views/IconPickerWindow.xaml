<Window x:Class="PowerExec.Views.IconPickerWindow"
        xmlns:l="clr-namespace:PowerExec.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:c="clr-namespace:PowerExec.Controls"
        Title="{l:T 'Choose icon'}" Style="{StaticResource AppWindow}"
        Width="640" Height="600" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <!-- Fluent-Bedienelemente (WPF UI), siehe Themes/Fluent.xaml -->
        <ResourceDictionary Source="/Themes/Fluent.xaml"/>
    </Window.Resources>
    <DockPanel Margin="20,16,20,16">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Text="{l:T 'Choose icon'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Fluent 2'}" GroupName="Src" Tag="fluent" Checked="Source_Checked" x:Name="FluentTab"/>
            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Heroicons'}" GroupName="Src" Tag="hero" Checked="Source_Checked" x:Name="HeroTab"/>
            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Segoe'}" GroupName="Src" Tag="glyph" Checked="Source_Checked" x:Name="GlyphTab"/>
            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Emoji'}" GroupName="Src" Tag="emoji" Checked="Source_Checked" x:Name="EmojiTab"/>
            <RadioButton Style="{StaticResource Chip}" Content="{l:T 'Custom image'}" GroupName="Src" Tag="file" Checked="Source_Checked" x:Name="FileTab"/>
        </WrapPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Padding="28,0,8,0" Tag="{l:T 'Search (English names, e.g. server, folder, shield)'}" TextChanged="Search_Changed"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Text.Secondary}"/>
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Control}" Margin="0,0,10,0">
                <c:IconPresenter x:Name="Preview" Size="28" Foreground="{DynamicResource Text.Primary}"/>
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Style="{StaticResource Btn.Subtle}" Content="{l:T 'No icon'}" Click="None_Click" Margin="0,0,8,0" />
                <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Cancel'}" IsCancel="True" MinWidth="90" />
                <ui:Button Style="{StaticResource Btn.Accent}" Content="{l:T 'Apply'}" IsDefault="True" MinWidth="100" Margin="8,0,0,0" Click="Ok_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="License" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <StackPanel x:Name="FilePanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="{l:T 'PNG, ICO, JPG or GIF – ideally square, at least 32 × 32 pixels. The file is not copied; it must stay reachable.'}"
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            <ui:Button Style="{StaticResource Btn.Standard}" Content="{l:T 'Choose image file …'}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="BrowseImage_Click" />
        </StackPanel>

        <TextBlock x:Name="MoreText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/>
        <Border BorderThickness="1" BorderBrush="{DynamicResource Border.Default}" CornerRadius="6" x:Name="ResultBorder">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Results" Margin="6" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Width="44" Height="44" Margin="2" Padding="0" ToolTip="{Binding Name}" Click="Icon_Click" MouseDoubleClick="Icon_DoubleClick"
                                    Style="{StaticResource Btn.Subtle}">
                                <c:IconPresenter Icon="{Binding Key}" Size="24"/>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
