<!-- Gemeinsame Stile der Einstellungsseiten (Views/Settings/). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
    </Style>

    <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="260"/>
        <Setter Property="DisplayMemberPath" Value="Value"/>
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
</ResourceDictionary>
