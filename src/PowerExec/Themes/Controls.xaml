<!--
    Vorlagen der eigenen Controls (Controls/). Die Controls sind „lookless“: Verhalten in C#, Aussehen hier.
    Die Einstellungs-Karten (SettingsCard, SettingsExpander) bauen auf WPF UI auf und stehen deshalb in Fluent.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:PowerExec.Desktop.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
                    xmlns:l="clr-namespace:PowerExec.Desktop.Localization">

    <!-- Rückmeldung wie die InfoBar in Windows 11: farbiger Streifen mit Symbol und Text -->
    <Style TargetType="{x:Type c:InfoBar}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Margin" Value="0,6,0,4"/>
        <Setter Property="Padding" Value="{StaticResource Inset.InfoBar}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Status.Info.Bg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Info.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:InfoBar}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Card}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource Icon.L}"
                                       Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Status.Info}"/>
                            <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource Status.Success.Bg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Success.Border}"/>
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource Status.Warning.Bg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning.Border}"/>
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource Status.Error.Bg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Error.Border}"/>
                            <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Error}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lücke beim Verschieben von Gruppen: gestrichelter Platzhalter mit Farbpunkt und Namen der gezogenen Gruppe -->
    <Style TargetType="{x:Type c:DropGap}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:DropGap}">
                    <Grid Margin="0,3,0,3">
                        <Rectangle RadiusX="{DynamicResource Radius.Card.Value}" RadiusY="{DynamicResource Radius.Card.Value}" StrokeThickness="1.5" StrokeDashArray="4 3"
                                   Stroke="{DynamicResource Accent}" Fill="{DynamicResource Bg.Selected}"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,12,0">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{TemplateBinding DotBrush}"/>
                            <TextBlock Text="{TemplateBinding Label}" FontSize="{StaticResource Font.Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vorschlagsliste unter einer Eingabe (TagBox, MachineBox) -->
    <Style x:Key="SuggestionPopupBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Menu}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
    </Style>

    <!-- Schlagworte als Chips mit Eingabe am Ende -->
    <Style TargetType="{x:Type c:TagBox}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="MinHeight" Value="{StaticResource Height.Control}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
        <Setter Property="ChipTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Background="{DynamicResource Bg.Chip}" Height="{StaticResource Height.Chip}" Margin="2" Cursor="Arrow" infra:Pill.IsEnabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StringFormat='#{0}'}" VerticalAlignment="Center" FontSize="{StaticResource Font.Body}" Margin="8,0,2,1"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <ui:Button Style="{DynamicResource Btn.Icon}" Width="20" Height="20" MinHeight="20" Padding="0" Margin="0,0,2,0" Focusable="False" Cursor="Hand"
                                       Command="{x:Static c:TagBox.RemoveTagCommand}" CommandParameter="{Binding}" ToolTip="{l:T 'Remove'}" AutomationProperties.Name="{l:T 'Remove'}">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource Icon.XS}"/>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:TagBox}">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Grid>
                            <WrapPanel x:Name="PART_Panel" Margin="4,2">
                                <TextBox x:Name="PART_Input" BorderThickness="0" Background="Transparent" MinWidth="120" MinHeight="26" Padding="2,0" Margin="2"
                                         VerticalContentAlignment="Center"/>
                            </WrapPanel>
                            <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Input}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource SuggestionPopupBorder}" MinWidth="180">
                                    <ListBox x:Name="PART_List" MaxHeight="180" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text.Primary}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_Input" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rechnernamen mit @Gruppen-Vorschlägen und Knopf „Gruppe einfügen“ -->
    <Style TargetType="{x:Type c:MachineBox}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MachineBox}">
                    <DockPanel>
                        <ui:Button x:Name="PART_Button" DockPanel.Dock="Right" Style="{DynamicResource Btn.Standard}" Margin="6,0,0,0" Content="{l:T 'Insert group ▾'}"
                                   ToolTip="{l:T 'Insert computer group (resolved at launch)'}"/>
                        <TextBox x:Name="PART_Input" FontFamily="{DynamicResource MonoFont}" Tag="{TemplateBinding Placeholder}"/>
                        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Input}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource SuggestionPopupBorder}">
                                <ListBox x:Name="PART_List" MaxHeight="220" MinWidth="220"/>
                            </Border>
                        </Popup>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
