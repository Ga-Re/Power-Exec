<!--
    Fluent-Bedienelemente (WPF UI) für Einstellungen und Dialoge. Wird pro Fenster eingebunden, nicht in App.xaml:
    Panel, Hover-Zonen und Mini-Docks behalten ihr eigenes Aussehen. Design (hell/dunkel/Kontrast), Akzentfarbe und
    die Zuordnung der eigenen Farben setzt Infrastructure/FluentTheme (Aufruf FluentTheme.Attach im Fenster).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:c="clr-namespace:PowerExec.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark"/>
        <ui:ControlsDictionary/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Eingabefelder: Fluent-Aussehen von WPF UI plus Hinweistext aus „Tag“ (wie bisher im ganzen Programm),
        einzeilig mittig, mehrzeilig oben; Eckenradius über TextBox.CornerRadius (Suchfelder setzen ihn größer).
    -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="10,0,8,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ContentBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource TextBox.CornerRadius}" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                           Margin="{TemplateBinding Padding}" Padding="2,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                <!-- Kein Margin: TextBox wendet Padding selbst auf den Textbereich an -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                            </Grid>
                        </Border>
                        <!-- Fluent: Linie unten, beim Fokus in Akzentfarbe und dicker -->
                        <Border x:Name="AccentBorder" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                CornerRadius="{DynamicResource TextBox.CornerRadius}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/>
                            <Setter TargetName="AccentBorder" Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource TextControlFocusedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}"/>
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="10,6,8,6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Kontrollkästchen ohne Beschriftung (z. B. Auswahlspalte in Listen): ohne den Innenabstand von WPF UI
        (11 px links), sonst ist das Kästchen in schmalen Spalten nur halb zu sehen.
    -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Menüeintrag mit optionaler Trennlinie darüber (Tag="Separator"), für Menüs aus ItemsSource (z. B. Gruppenfarben:
        Farben, dann „Eigene Farbe …“). Die Fluent-Menüeinträge von WPF UI kennen das nicht; gleiche Maße und Farben.
    -->
    <Style x:Key="Menu.ItemWithRule" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <DockPanel>
                        <Border x:Name="TopRule" DockPanel.Dock="Top" Height="1" Margin="4,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed"/>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,1" Padding="10,0" MinHeight="32" MinWidth="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <!-- Aktive Auswahl (Darstellung, Farbe …): Häkchen in Akzentfarbe -->
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Separator">
                            <Setter TargetName="TopRule" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Umschaltbare Symbol-Schaltfläche (z. B. Verlauf, Anheften): dezent, eingeschaltet in Akzentfarbe -->
    <Style x:Key="Toggle.Icon" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Split-Schaltfläche (Starten mit Standardprofil | Profil wählen): zwei Akzent-Schaltflächen mit gemeinsamer Form -->
    <Style x:Key="Btn.SplitLeft" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4,0,0,4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.SplitRight" TargetType="Button" BasedOn="{StaticResource Btn.SplitLeft}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 1 px Abstand zur linken Hälfte -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,4,4,0" SnapsToDevicePixels="True" Margin="1,0,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Die bisherigen Schaltflächen-Stile als Fluent-Schaltflächen (gleiche Namen, damit das Layout bleibt) -->
    <Style x:Key="Btn.Standard" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style x:Key="Btn.Accent" TargetType="ui:Button" BasedOn="{StaticResource Btn.Standard}">
        <Setter Property="Appearance" Value="Primary"/>
    </Style>
    <Style x:Key="Btn.Subtle" TargetType="ui:Button" BasedOn="{StaticResource Btn.Standard}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Btn.Icon" TargetType="ui:Button" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- Einstellungs-Karten (im Stil der Windows-Einstellungen); Aufklapp-Schaltfläche als Fluent-Schaltfläche -->
    <Style TargetType="c:SettingsCard">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsCard">
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6"
                            Padding="16,12" Margin="0,0,0,3" MinHeight="66">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconText" Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20" Width="40"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap"/>
                                <ContentPresenter x:Name="Desc" Content="{TemplateBinding Description}" Margin="0,2,0,0" TextElement.FontSize="12"
                                                  TextElement.Foreground="{DynamicResource Text.Secondary}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SettingsExpander">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsExpander">
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,3">
                        <StackPanel>
                            <!-- Gleiche Höhe wie SettingsCard (Padding 12 + 42 = 66) -->
                            <Grid MinHeight="42" Margin="16,12,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IconText" Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20" Width="40"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap"/>
                                    <ContentPresenter x:Name="Desc" Content="{TemplateBinding Description}" Margin="0,2,0,0" TextElement.FontSize="12"
                                                      TextElement.Foreground="{DynamicResource Text.Secondary}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center"/>
                                <ui:Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Margin="8,0,0,0" Command="{Binding ToggleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="Weitere Optionen">
                                    <TextBlock x:Name="Chevron" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"/>
                                </ui:Button>
                            </Grid>
                            <Border x:Name="Body" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg.CardAlt}"
                                    CornerRadius="0,0,6,6" Padding="56,6,16,6" Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
