<!--
    Fluent-Bedienelemente (WPF UI) für Einstellungen und Dialoge. Wird pro Fenster eingebunden, nicht in App.xaml:
    Panel, Hover-Zonen und Mini-Docks behalten ihr eigenes Aussehen. Design (hell/dunkel/Kontrast), Akzentfarbe und
    die Zuordnung der eigenen Farben setzt Infrastructure/FluentTheme (Aufruf FluentTheme.Attach im Fenster).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark"/>
        <ui:ControlsDictionary/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Die bisherigen Schaltflächen-Stile als Fluent-Schaltflächen (gleiche Namen, damit das Layout bleibt) -->
    <Style x:Key="Btn.Standard" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style x:Key="Btn.Accent" TargetType="ui:Button" BasedOn="{StaticResource Btn.Standard}">
        <Setter Property="Appearance" Value="Primary"/>
    </Style>
    <Style x:Key="Btn.Subtle" TargetType="ui:Button" BasedOn="{StaticResource Btn.Standard}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Btn.Icon" TargetType="ui:Button" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
</ResourceDictionary>
