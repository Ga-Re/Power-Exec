<!--
    Programmweite Grundlagen: Schriften, Fensterstil, Textstile, Chips/Segmente/Navigation und Karten.
    Die Bedienelemente (Schaltflächen, Eingabefelder, Schalter, Auswahllisten, Menüs, Bildlaufleisten, Tooltips,
    Einstellungs-Karten) kommen aus Themes/Fluent.xaml (WPF UI); Radien, Schriftgrößen und Dauern aus Themes/Tokens.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure">

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Fenster -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Bg.Window}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodyStrong}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- Symbol (Segoe Fluent Icons) -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="{DynamicResource Radius.Card.Value}" RadiusY="{DynamicResource Radius.Card.Value}" Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter-Chips -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{DynamicResource Bg.Chip}" infra:Pill.IsEnabled="True" Height="28" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab-Kopf (Marktplatz): Text mit Akzent-Unterstrich -->
    <Style x:Key="TabHeader" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Padding="12,0">
                        <Grid Height="36">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Line" Height="3" CornerRadius="{DynamicResource Radius.Bar}" Width="20" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segment-Schaltfläche (Ausführen als / Ziel) -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Height="32" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Pressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigationseintrag in den Einstellungen -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Height="38" Margin="0,1">
                        <Grid>
                            <Border x:Name="Mark" Width="3" Height="16" CornerRadius="{DynamicResource Radius.Bar}" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eckenradius der Eingabefelder (Themes/Fluent.xaml); Suchfelder setzen ihn in ihren Resources größer -->
    <CornerRadius x:Key="TextBox.CornerRadius">4</CornerRadius>

    <!-- Karte für Einstellungszeilen -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="MinHeight" Value="66"/>
    </Style>

    <!-- Einstellungen im PowerToys-Stil -->
    <Style x:Key="SettingsSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,24,0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <!-- Schlagwort als Chip (Anzeige) -->
    <infra:TagBrushConverter x:Key="TagBrush"/>
    <DataTemplate x:Key="TagChip">
        <Border x:Name="Chip" Background="{DynamicResource Bg.Chip}" infra:Pill.IsEnabled="True" Padding="8,1,8,2" Margin="0,2,4,2">
            <TextBlock Text="{Binding StringFormat=#{0}}" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.Primary}"/>
        </Border>
        <DataTemplate.Triggers>
            <!-- Farbiges Schlagwort (Einstellungen › Schlagworte) -->
            <DataTrigger Binding="{Binding Converter={StaticResource TagBrush}, ConverterParameter=has}" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{Binding Converter={StaticResource TagBrush}}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="TagPanel"><WrapPanel/></ItemsPanelTemplate>

    <!-- Zeile innerhalb einer aufgeklappten Karte -->
    <Style x:Key="SubSetting" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="LastChildFill" Value="True"/>
    </Style>

</ResourceDictionary>
