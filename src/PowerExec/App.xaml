<Application x:Class="PowerExec.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:PowerExec.Desktop.Infrastructure"
             xmlns:svc="clr-namespace:PowerExec.Desktop.Services"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: Farbschema, wird vom ThemeService ausgetauscht -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <!-- Radien, Abstände, Schrift, Höhen, Bewegung -->
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
                <!-- Fluent-Bedienelemente (WPF UI) samt eigener Anpassungen – einmal für alle Fenster -->
                <ResourceDictionary Source="Themes/Fluent.xaml"/>
                <!-- Gemeinsame Stile der Einstellungsseiten -->
                <ResourceDictionary Source="Themes/Settings.xaml"/>
                <!-- Vorlagen der eigenen Controls -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infra:VisibilityConverter x:Key="Vis"/>
            <infra:EqualsConverter x:Key="Eq"/>
            <infra:ExpandAngleConverter x:Key="ExpandAngle"/>
            <infra:EqualsVisibilityConverter x:Key="EqVis"/>
            <infra:HexBrushConverter x:Key="HexBrush"/>
            <infra:ArgbBrushConverter x:Key="ArgbBrush"/>
            <infra:ScrollBarAutoConverter x:Key="ScrollBarAuto"/>
            <infra:LeftMarginConverter x:Key="LeftMargin"/>
            <svc:IconImageConverter x:Key="IconImage"/>
            <infra:AllEqualConverter x:Key="StringEquals"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
