<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PowerExec</RootNamespace>
    <AssemblyName>PowerExec</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PowerExec.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- WFAC010/WFO0003 (neuer Name ab .NET 9) betreffen WinForms-Apps; für WPF ist die DPI-Angabe im Manifest richtig. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>
  <!-- Einzeldatei-Veröffentlichung (siehe .github/workflows/release.yml) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <!-- Seit .NET 9 gibt es System.Windows.ThemeMode (Fluent-Theme von WPF); gemeint ist immer die eigene Einstellung -->
    <Using Include="PowerExec.Core.Config.ThemeMode" Alias="ThemeMode" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PowerExec.ico" />
    <EmbeddedResource Include="Assets\icons.json" LogicalName="PowerExec.icons.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerExec.Core\PowerExec.Core.csproj" />
    <ProjectReference Include="..\PowerExec.UI.Core\PowerExec.UI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Beispiel-Script für den Einführungs-Assistenten -->
    <EmbeddedResource Include="..\..\samples\Get-DiskSpace.ps1" LogicalName="PowerExec.Sample.Get-DiskSpace.ps1" Link="Assets\Get-DiskSpace.ps1" />
  </ItemGroup>
</Project>
