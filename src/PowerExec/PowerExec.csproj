<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows-SDK 22000 für die Windows-Composition (Glas: eigener Weichzeichner). Lauffähig bleibt die App ab
      Windows 10 1809; dort und ohne Transparenzeffekte fällt Glas auf Klarglas zurück (PanelBackdrops.Effective).
    -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PowerExec.Desktop</RootNamespace>
    <!-- LibraryImport erzeugt die Übergänge zu Win32 zur Übersetzungszeit (Interop/NativeMethods.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PowerExec</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PowerExec.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- WFAC010/WFO0003 (neuer Name ab .NET 9) betreffen WinForms-Apps; für WPF ist die DPI-Angabe im Manifest richtig. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>
  <!--
    Oberflächen-Selbsttest (SelfTest/, Aufruf mit dem Schalter „selftest“): in Debug-Builds und in der CI (Eigenschaft SelfTest=true)
    enthalten, nicht in der ausgelieferten EXE.
  -->
  <PropertyGroup>
    <SelfTest Condition="'$(SelfTest)' == '' and '$(Configuration)' == 'Debug'">true</SelfTest>
    <DefineConstants Condition="'$(SelfTest)' == 'true'">$(DefineConstants);SELFTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SelfTest)' != 'true'">
    <Compile Remove="SelfTest\**" />
  </ItemGroup>
  <!-- Einzeldatei-Veröffentlichung (siehe .github/workflows/release.yml) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <!-- App-Kern (AppController, AppPanel) -->
    <Using Include="PowerExec.UI" />
    <!-- Seit .NET 9 gibt es System.Windows.ThemeMode (Fluent-Theme von WPF); gemeint ist immer die eigene Einstellung -->
    <Using Include="PowerExec.Core.Config.ThemeMode" Alias="ThemeMode" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PowerExec.ico" />
    <EmbeddedResource Include="Assets\icons.json" LogicalName="PowerExec.icons.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fluent-Bedienelemente (WPF UI, MIT); zunächst nur im Einstellungsfenster, siehe Infrastructure/FluentTheme.cs -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerExec.Core\PowerExec.Core.csproj" />
    <ProjectReference Include="..\PowerExec.UI.Core\PowerExec.UI.Core.csproj" />
  </ItemGroup>
</Project>
