# Power-Exec – einheitliche Formatierung (siehe CONTRIBUTING.md)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xaml,csproj,props,targets,json,yml,yaml,iss}]
indent_size = 2

[*.xaml]
indent_size = 4

# Zeilenenden regelt .gitattributes

[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 160
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = false
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
csharp_prefer_braces = false:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Private Felder: _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# ── Analyzer ───────────────────────────────────────────────────────────────────────────
# Der Build läuft mit AnalysisLevel=latest-recommended und Warnungen als Fehler (Directory.Build.props).
# Die folgenden Regeln sind bewusst nur Hinweise:

# Kultur bei Vergleichen und Formatierung: jede Stelle gibt sie ausdrücklich an. Gleichheit von Namen (Gruppen, Tags,
# Variablen) ist ordinal ohne Groß-/Kleinschreibung, damit Einstellungsdateien auf jedem Rechner gleich gelesen werden;
# Sortierung und Anzeige von Datum/Zeit folgen der Sprache des Benutzers, Protokoll und Dateien sind invariant.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
# ViewModel-Eigenschaften werden gebunden und müssen Instanzmitglieder bleiben
dotnet_diagnostic.CA1822.severity = suggestion
# Mikro-Optimierungen ohne messbaren Nutzen im Panel
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1861.severity = suggestion
dotnet_diagnostic.CA1826.severity = suggestion
dotnet_diagnostic.CA1827.severity = suggestion
dotnet_diagnostic.CA1869.severity = suggestion
# Win32: Rückgabewerte von DWM-/GDI-Aufrufen sind an diesen Stellen ohne Belang (Optik, kein Fehlerweg)
dotnet_diagnostic.CA1806.severity = suggestion
dotnet_diagnostic.CA1838.severity = suggestion
# Fenster und ViewModels geben ihre Mittel beim Schließen frei, nicht über IDisposable
dotnet_diagnostic.CA1001.severity = suggestion
dotnet_diagnostic.CA1816.severity = suggestion
# Namensregeln, die mit eingeführten Namen kollidieren (Enum-Werte, Parameter in Schnittstellen)
dotnet_diagnostic.CA1707.severity = suggestion
dotnet_diagnostic.CA1711.severity = suggestion
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1720.severity = suggestion
dotnet_diagnostic.CA1725.severity = suggestion
dotnet_diagnostic.CA1051.severity = suggestion
